14370        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_VL(L)=VAL(TOKEN$):'vl
14380        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_RE(L)=VAL(TOKEN$):'RE
