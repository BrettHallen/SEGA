 7800 *FUNC_SYS
 7810 SYS_MES_TITLE$="":SYS_MES_MESSAGE$="ｼｭｳﾘｮｳｼﾏｽｶ ?":SYS_MES_NAME$(0)="No":SYS_MES_NAME$(1)="Yes"
 7820 SYS_MES_MODE=&B100010011:GOSUB *SYS_MESSAGEBOX:COLOR,0,0
