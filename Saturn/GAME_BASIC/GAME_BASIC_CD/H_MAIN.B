15030 *SET_PCM_SUB
15040 USERDATA TOKEN$
15060 *SET_PCM_SUB1
15070 GOSUB *GET_TOKEN:USERDATA TOKEN$
15080 GOSUB *GET_TOKEN:USERDATA "20",0:'
15090 GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'
15100 GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'sn
15110 GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'en
15120 GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'bn
15130 RETURN
15150 *SET_PCM_SUB2
15160 A$=A$+STR$(L)+" DATA "+TOKEN$+",":L=L+10
15180 *SET_PCM_SUB3
15190 GOSUB *GET_TOKEN:A$=A$+CHR$(34)+TOKEN$+CHR$(34)+","
15200 GOSUB *GET_TOKEN:A$=A$+TOKEN$+","
15210 GOSUB *GET_TOKEN:A$=A$+TOKEN$+","
15220 GOSUB *GET_TOKEN:A$=A$+TOKEN$+","
15230 GOSUB *GET_TOKEN:A$=A$+TOKEN$+","
15240 GOSUB *GET_TOKEN:A$=A$+TOKEN$+CHR$(13)+CHR$(10)
15250 RETURN
15260 '---------------------
15270 'ﾈｲﾛ ｦ ｻｸｼﾞｮｽﾙ(ﾘｽﾄｶﾗ)
15280 '---------------------
15290 'ENTRY:
15300 '       ARG1 :音色番号
15310 '       ARG2$:ﾌｧｲﾙ ﾒｲ
15330 *NEIRO_DEL
15340 GOSUB *NEIRO_MAXNO:RET=RET-1
15350 IF RET<=0 OR RET<(ARG1+1) THEN RETURN
15360 L1$=LIST_$(ARG1,1)
15370 L2$=LIST_$(ARG1,2)
15380 J=0
15390 FOR I=0 TO RET-1
15400  IF LIST_$(I,1)<>L1$ OR LIST_$(I,2)<>L2$ THEN
15410   LIST_$(J,0)=LIST_$(I,0):LIST_$(J,1)=LIST_$(I,1):LIST_$(J,2)=MID$(STR$(J+1),2)
15420   J=J+1
15430  ENDIF
15440 NEXT
15450 MAX_NEIRO=J
15460 OPEN ARG2$ FOR OUTPUT AS #1
15470 IF MAX_NEIRO>0 THEN
15480  FOR I=0 TO MAX_NEIRO-1
15490   FWRITE #1,LIST_$(I,0)+","+LIST_$(I,1)+","+LIST_$(I,2)+CHR$(13)+CHR$(10)
15500  NEXT
15510 ENDIF
15520 CLOSE #1
15530 A$=""
15540 OPEN L1$ FOR INPUT AS #1
15550 B$="":C$=""
15560 FOR I=1 TO VAL(L2$)
15580 *ADLA0:B$=B$+C$:FREAD #1,C$,1:IF C$<>"@" AND LOF(1)>LOC(1) GOTO *ADLA0
15590 NEXT
15600 B$=B$+A$
15610 IF LOF(1)>LOC(1) THEN
15630 *ADLA1:FREAD #1,C$,1:IF C$<>"@" AND LOF(1)>LOC(1) GOTO *ADLA1
15640 ENDIF
15650 IF LOF(1)>LOC(1) THEN
15670 *ADLA2:B$=B$+C$:FREAD #1,C$,1:IF LOF(1)>LOC(1) GOTO *ADLA2
15680  B$=B$+C$
15690 ENDIF
15700 CLOSE #1
15710 OPEN L1$ FOR OUTPUT AS #1
15720 FWRITE #1,B$
15730 CLOSE #1
15740 B$=""
15750 RETURN
15760 '---------------------
15770 'ﾈｲﾛ ｦ ｺｳｼﾝｽﾙ
15780 '---------------------
15790 'ENTRY:
15800 '       ARG1 :音色番号
15810 '       ARG2$:名前
15820 '       ARG3$:ﾌｧｲﾙﾒｲ
15840 *NEIRO_UPDATE
15850 GOSUB *SET_FM_LAYER_FILE:'ｻｸｾｲ
15860 '
15870 GOSUB *NEIRO_MAXNO:RET=RET-1
15880 IF RET<=0 OR RET<(ARG1+1) THEN RETURN
15890 LIST_$(ARG1,0)="#"+ARG2$
15900 ON ERROR GOTO *NE_UP_ERR0
15910 OPEN ARG3$ FOR OUTPUT AS #1
15920 ON ERROR GOTO *NE_UP_ERR1
15930 FOR I=0 TO MAX_NEIRO-1
15940  FWRITE #1,LIST_$(I,0)+","+LIST_$(I,1)+","+LIST_$(I,2)+CHR$(13)+CHR$(10)
15950 NEXT
15960 ON ERROR GOTO *NE_UP_ERR2
15970 CLOSE #1
15980 ON ERROR GOTO *NE_UP_ERR0
15990 OPEN LIST_$(ARG1,1) FOR INPUT AS #1
16000 ON ERROR GOTO *NE_UP_ERR1
16010 B$="":C$=""
16020 FOR I=1 TO VAL(L2$)
16040 *ADL0:B$=B$+C$:FREAD #1,C$,1:IF C$<>"@" AND LOF(1)>LOC(1) GOTO *ADL0
16050 NEXT
16060 B$=B$+A$
16070 IF LOF(1)>LOC(1) THEN
16090 *ADL1:FREAD #1,C$,1:IF C$<>"@" AND LOF(1)>LOC(1) GOTO *ADL1
16100 ENDIF
16110 IF LOF(1)>LOC(1) THEN
16130 *ADL2:B$=B$+C$:FREAD #1,C$,1:IF LOF(1)>LOC(1) GOTO *ADL2
16140  B$=B$+C$
16150 ENDIF
16160 ON ERROR GOTO *NE_UP_ERR2
16170 CLOSE #1
16180 ON ERROR GOTO *NE_UP_ERR0
16190 OPEN L1$ FOR OUTPUT AS #1
16200 ON ERROR GOTO *NE_UP_ERR1
16210 FWRITE #1,B$
16220 ON ERROR GOTO *NE_UP_ERR2
16240 *NE_UP_EX1
16250 CLOSE #1
16260 B$=""
16280 *NE_UP_EX0
16290 RETURN
16310 *NE_UP_ERR0:RESUME *NE_UP_EX0
16330 *NE_UP_ERR1:RESUME *NE_UP_EX1
16350 *NE_UP_ERR2:RESUME *NE_UP_EX0
16360 '
16370 '初期設定
16380 '
16400 *INIT
16410 PALETTE 0,15,RGB(31,31,31)
16420 PALETTE 0,128,RGB(27,26,25)
16430 PALETTE 0,9  ,RGB(16,15,14)
16440 PALETTE 0,8  ,RGB(10, 9, 8)
16450 PALETTE 0,7  ,RGB(10, 9, 8)
16460 DIM SC$(20),BG$(3)
16470 GLOAD LD_DEV$+"HIBIKI_0",1
16480 ACTIVE 1:GCOPY (0,0)-(319,127) TO BG$(0):GCOPY (0,128)-(319,255) TO BG$(1)
16490 RETURN
16500 '
16510 'GLOADなどで壊れたスプライトデータを修復する
16520 '
16540 *HOT_INIT
16550 RETURN
16560 '-------------------
16570 'フェードアウト
16580 '-------------------
16600 *FADE_OUT :COLOROFS ON 0,1,4,10:FOR S_I=0 TO -255 STEP -5:COLOROFS (S_I,S_I,S_I):VSYNC :NEXT :RETURN
16620 *FADE_OUT0:COLOROFS ON 0,1,4,10:COLOROFS (-255,-255,-255):RETURN
16630 '-------------------
16640 'フェードイン
16650 '-------------------
16670 *FADE_IN :COLOROFS ON 0,1,4,10:FOR S_I=-255 TO 0 STEP 5:COLOROFS (S_I,S_I,S_I):VSYNC :NEXT :RETURN
16690 *FADE_IN0:COLOROFS ON 0,1,4,10:COLOROFS (0,0,0):RETURN
16700 '
16710 'テキストのスクロール
16720 '
16740 *TEXT_PRINT_MOUSE
16750 MAX_TEXT_X=(LEN(SC$(0))-38)
16760 SX=(EVENTX-24)*MAX_TEXT_X/258
16780 *TEXT_PRINT
16790 MAX_TEXT_X=(LEN(SC$(0))-38)
16800 IF MAX_TEXT_X<0 THEN MAX_TEXT_X=0
16810 IF SX<0 THEN SX=0
16820 IF SX>MAX_TEXT_X THEN SX=MAX_TEXT_X
16830 FOR Y=0 TO 17
16840  LOCATE 0,Y+4:PRINT MID$(SC$(SY+Y),SX+1,38);
16850 NEXT
16860 IF MAX_TEXT_X<>0 THEN OBJ(24,4)=24+SX/MAX_TEXT_X*258 ELSE OBJ(24,4)=24
16870 RETURN
16880 '
16890 'トレイのスクロール
16900 '
16920 *TRAY_PRINT_MOUSE
16930 TY=(EVENTY-27)/151*(MAX_TY-19)
16950 *TRAY_PRINT
16960 IF TY>MAX_TY-19 THEN TY=MAX_TY-19
16970 IF TY<0 THEN TY=0
16980 ACTIVE 22:COLOR,15,-1
16990 FOR KKK=0 TO 18
17000  IF (KKK+TY)<MAX_TY THEN
17010   KPRINT (2,8*KKK,0,-8,0),FIX RIGHT$("00"+MID$(STR$(INT(TY+KKK)),2),3)+"."+LEFT$(MID$(TRAY$(TY+KKK,0),2)+STRING$(16," "),16)
17020  ENDIF
17030 NEXT
17040 IF MAX_TY<=19 THEN
17050  OBJ(20,20)=20
17060  WIN(9,4)=0
17070  WIN(10,4)=0
17080 ELSE
17090  OBJ(20,20)=18
17100  OBJ(20,4)=49+(TY/(MAX_TY-19))*151
17110  WIN(9,4)=1
17120  WIN(10,4)=1
17130 ENDIF
17140 RETURN
17150 '----------------------------------
17160 '画面の設定
17170 '----------------------------------
17180 'SCREEN_MODE  0...NEIRO
17190 '             1...LAYER
17200 '             2...TEXT
17210 '             3...FM EDIT
17230 *SHOW_SCREEN
17240 GOSUB *FADE_OUT
17250 COLOR 7,15,0:CLS -1
17260 IF SCREEN_MODE=3 THEN
17270  FOR I=16 TO 26:OBJ(I,20)=-1:NEXT
17280  P=0:GOSUB *FM_SHOW_INIT
17290  ACTIVE 1:GCOPY BG$(0) TO (0,0):GCOPY BG$(1) TO (0,128)
17300  GOSUB *FADE_IN
17310  RETURN
17320 ENDIF
17330 ON SCREEN_MODE+1 RESTORE *NEIROSELECT_WINDATA0,*NEIROSELECT_WINDATA1
17340 '背景描画
17350 READ FIL$
17360 IF FIL$<>"" THEN
17370  ACTIVE 1:GCOPY BG$(0) TO (0,0):GCOPY BG$(1) TO (0,128)
17380  SPRWINDOW,,,,,0,0
17390  OBJ(1,0)=7:OBJ(1,16)=0,0:OBJ(1,20)=0
17400  OBJ(255,0)=7,,,,-10,-10
17410 ENDIF
17420 ACTIVE 1:FOR X=0 TO 320 STEP 4:LINE (X,8*4)-(X,8*24),7:NEXT :ACTIVE 0
17430 '文字描画
17450 *SHOW_NEIROSELECT_L0
17460 READ X
17470 IF X>=0 THEN
17480   READ Y,S,FIL$:KPRINT (X,Y),FIL$,,S
17490   GOTO *SHOW_NEIROSELECT_L0
17500 ENDIF
17510 '音色グループトレイ
17520 OBJ(16,0)=7,,,,0,-4,5,,,,,,,,,,9,9               :'上のバー（親）グループトレイを動かすときはこれ
17530 OBJ(17,0)=7,,,,0,197,5,,,,,,,,,,9,9,,,16         :'下のバー
17540 OBJ(18,0)=7,,,, 24,-16,10,,,,.25,,,,,,10,10,,,16:'左のスクロールバー
17550 OBJ(19,0)=7,,,,160,-16,10,,,,.25,,,,,,10,10,,,16:'右のスクロールバー
17560 OBJ(20,0)=7,,,,49,0,,,,,,,,,,,11,11,,,18         :'左のバー（親）バーを動かすときはこれ
17570 OBJ(21,0)=7,,,,0,-136,,,,,,,,,,,11,11,,,20       :'右のバー
17580 OBJ(22,0)=7,,,,20,33,10,,,,,,,,,,12,12,,,16:CLS 22:'描画部分
17590 OBJ(27,0)=7,,,, 0, 0, 1,,,,,,,,,,13,12,,,22      :'背景部分
17600 '音色セットトレイ
17610 OBJ(23,0)=7,,,,0,8*3,20,,,,,,,,,,10,10           :'上のスクロールバー
17620 OBJ(24,0)=7,,,,0,0,,,,,,,,,,,11,11,,,23          :'上のバー（親）バーを動かすときはこれ
17630 OBJ(25,0)=7,,,,0,8*23,20,,,,,,,,,,10,10          :'下のスクロールバー
17640 OBJ(26,0)=7,,,,0,8*20,,,,,,,,,,,11,11,,,24       :'下のバー
17650 'ウインドウ初期化
17660 FOR X=7 TO 17:FOR Y=0 TO 7:READ WIN(X,Y):NEXT Y,X
17670 GOSUB *SET_SYSMENUPOS
17680 'キーボード
17690 OBJ(32,0)=7,,,,0,8*20,,,,,,,,,,,14,14,,,32       :'キーボード
17700 WIN(2,6)=32
17710 '
17720 WIN(20,0)=0
17730 WIN(20,1)=319
17740 WIN(20,2)=35
17750 WIN(20,3)=185
17760 WIN(20,4)=1   :'Enabled
17770 WIN(20,5)=83  :'Obj. No.
17780 WIN(20,6)=0   :'Kind
17790 WIN(20,7)=0   :'Work
17800 '
17810 IF SCREEN_MODE=0 THEN
17820   CLS
17830   GOSUB *TEXT_PRINT
17840   GOSUB *TRAY_PRINT
17850 ENDIF
17860 GOSUB *FADE_IN
17870 RETURN
17890 *SELECT_NEIRO
17900 RET$=MID$(NEIRO$,80*NEIRO+1,80)
17910 RETURN
17920 'システムメニューバー
17940 *SET_SYSMENUPOS
17950 SETATR 13,1,(0,1,1,13,0,&H100)
17960 'SETATR 13,1,(0,1,1,13,0,0)
17970 OBJ(64,0)=7,,,,100,50,1,,,,,,18,8,,,13,13
17980 FOR X=0 TO 5
17990  'ﾎﾞﾀﾝ(ﾄﾞﾀﾞｲ)
18000  OBJ(65+X*2,0)=7,,,,X*24, 8,,,,,,,,,,,1  ,  1,,,64
18010  'ﾎﾞﾀﾝ ﾉ ｴ
18020  OBJ(66+X*2,0)=7,,,,   0, 0,,,,,,,,,,,3+X,3+X,,,65+X*2
18030 NEXT
18050 *SET_SYSMENUPOS0
18060 FOR X=0 TO 5
18070   WIN(X,0)=OBJ(65+X*2,4)+OBJ(64,4)
18080   WIN(X,1)=WIN(X,0)+23
18090   WIN(X,2)=OBJ(65+X*2,5)+OBJ(64,5)
18100   WIN(X,3)=WIN(X,2)+23
18110   WIN(X,4)=1     :'Enabled
18120   WIN(X,5)=65+X*2:'Obj. No.
18130   WIN(X,6)=0     :'Kind
18140   WIN(X,7)=0     :'Work
18150 NEXT
18160 '
18170 WIN(6,0)=OBJ(64,4)
18180 WIN(6,1)=WIN(6,0)+24*6
18190 WIN(6,2)=OBJ(64,5)
18200 WIN(6,3)=WIN(6,2)+8
18210 WIN(6,4)=1     :'Enabled
18220 WIN(6,5)=65    :'Obj. No.
18230 WIN(6,6)=0     :'Kind
18240 WIN(6,7)=0     :'Work
18250 RETURN
