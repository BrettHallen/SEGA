25340 DATA 1,1,0, 1,1,0, 1,1,0, 2,3,7
25350 '
25370 *NEIROINIT
25380 RETURN
25390 'ﾈｲﾛｦｾｯﾃｲｽﾙ
25410 *SET_NEIROLIST
25420 NEIROSETFILENAME$=FILE$
25430 NEIROSETFILENAME2$=FILE$:MID$(NEIROSETFILENAME2$,INSTR(NEIROSETFILENAME2$,".")-1,1)="_"
25440 ON ERROR GOTO *NEIROLIST_OPENERR
25450 OPEN FILE$ FOR INPUT AS #1
25460 ON ERROR GOTO 0
25470 FOR I=0 TO 17:SC$(I)="":NEXT
25480 M=0:I=0:N=0:NN=0:KKK=0
25500 *SETNEIROL0
25510 GOSUB *GET_TOKEN
25520 IF INSTR("@#",LEFT$(TOKEN$,1))<>0 THEN
25530  LIST_$(N,0)=TOKEN$
25540  GOSUB *GET_TOKEN:LIST_$(N,1)=TOKEN$
25550  GOSUB *GET_TOKEN:LIST_$(N,2)=TOKEN$
25560  IF LEN(LIST_$(N,0))>M THEN M=LEN(LIST_$(N,0))-1
25570  N=N+1
25580  I=I+1
25590  IF I>17 THEN
25600   FOR J=0 TO 17
25610    SC$(J)=SC$(J)+LEFT$(RIGHT$("   "+MID$(STR$(J+NN),2),4)+"."+MID$(LIST_$(J+NN,0),2)+STRING$(M," "),M+5)
25620   NEXT
25630   LSTSE(KKK)=LEN(SC$(0))
25640   NN=NN+18
25650   M=0:I=0:KKK=KKK+1
25660  ENDIF
25670 ENDIF
25680 IF LOF(1)>LOC(1) GOTO *SETNEIROL0
25690 '
25700 IF USER_NEIRO=1 THEN
25710  LIST_$(N,0)="--- ｼﾝｷｻｸｾｲ ---"
25720  LIST_$(N,1)=""
25730  LIST_$(N,2)=""
25740  IF LEN(LIST_$(N,0))>M THEN M=LEN(LIST_$(N,0))-1
25750  N=N+1
25760  I=I+1
25770  IF I>17 THEN
25780   FOR J=0 TO 17
25790    SC$(J)=SC$(J)+LEFT$(RIGHT$("   "+MID$(STR$(J+NN),2),4)+"."+MID$(LIST_$(J+NN,0),2)+STRING$(M," "),M+5)
25800   NEXT
25810   LSTSE(KKK)=LEN(SC$(0))
25820   NN=NN+18
25830   M=0:I=0:KKK=KKK+1
25840  ENDIF
25850 ENDIF
25860 '
25870 IF I>1 THEN
25880   FOR J=0 TO I-1
25890     SC$(J)=SC$(J)+LEFT$(RIGHT$("   "+MID$(STR$(J+NN),2),4)+"."+MID$(LIST_$(J+NN,0),2)+STRING$(M," "),M+5)
25900   NEXT
25910   FOR I=J TO 17
25920     SC$(I)=SC$(I)+STRING$(M+5," ")
25930   NEXT
25940   LSTSE(KKK)=LEN(SC$(0))
25950 ENDIF
25960 MAX_NEIRO=N
25970 CLOSE #1
25980 'FOR I=0 TO 17:SC$(I)=SC$(I)+STRING$(38," "):NEXT
26000 *EXIT1
26010 RETURN
26020 'ｴﾗｰｼｮﾘ
26040 *NEIROLIST_OPENERR
26050 RESUME *EXIT1
26060 'ファイルから１トークン取得する
26080 *GET_TOKEN
26090 TOKEN$="":ON ERROR GOTO *GET_TOKENERR
26110 *GET_TOKENL:IF LOF(1)<LOC(1) OR LEN(TOKEN$)>128 THEN TOKEN$="ﾀﾞﾒ":RETURN
26120 FREAD #1,C$,1:IF C$=CHR$(13) GOTO *GET_TOKENL
26130 IF INSTR(","+CHR$(10)+CHR$(13),C$)<>0 THEN
26140  RETURN
26150 ENDIF
26160 TOKEN$=TOKEN$+C$
26170 GOTO *GET_TOKENL
26171 *GET_TOKENERR
26172 TOKEN$="ﾀﾞﾒ"
26173 RESUME *GET_TOKEN_EXIT
26174 *GET_TOKEN_EXIT:RETURN
26180 '
26190 '
26210 *NEIRO_LAYER_SET
26220 RET=0
26230 TEMP=ASC(MID$(NEIRO$,NE_NO*64+1,1))
26240 IF TEMP>=0 OR TEMP<=1 THEN
26250   '内蔵音源
26260   TEMP$=MID$(NEIRO$,NE_NO*80+ 3, 8)+" "
26270   TEMP$=LEFT$(TEMP$,INSTR(TEMP$," ")-1)
26280   USERDATA TEMP$                  :'音色セット名
26290   TEMP=ASC(MID$(NEIRO$,NE_NO*80+11, 1)):IF TEMP<0  OR TEMP>127 THEN RET=-1:RETURN
26300   USERDATA STR$(TEMP),0 :'音色番号
26310   TEMP=ASC(MID$(NEIRO$,NE_NO*80+12, 1)):IF TEMP<0  OR TEMP>127 THEN RET=-1:RETURN
26320   USERDATA STR$(TEMP),0 :'レイヤー番号
26330   TEMP=ASC(MID$(NEIRO$,NE_NO*80+18, 1)):IF               TEMP>127 THEN RET=-1:RETURN
26340   USERDATA STR$(TEMP),0 :'スタートノート
26350   TEMP=ASC(MID$(NEIRO$,NE_NO*80+19, 1)):IF               TEMP>127 THEN RET=-1:RETURN
26360   USERDATA STR$(TEMP),0 :'エンドノート
26370   TEMP=ASC(MID$(NEIRO$,NE_NO*80+20, 1)):IF               TEMP>127 THEN RET=-1:RETURN
26380   USERDATA STR$(TEMP),0 :'ベースノート
26390 ELSE
26400   IF TEMP>=16 OR TEMP<=17 THEN
26410     '作成音源
26420     IF TEMP=16 THEN
26430       '作成音源ＰＣＭ
26440       USERDATA "FILE"
26450       TEMP=ASC(MID$(NEIRO$,NE_NO*80+2, 1)):IF TEMP<0  OR TEMP>5 THEN RET=-1:RETURN
26460       USERDATA DEV$(TEMP)+MID$(NEIRO$,NE_NO*80+ 2, 8)  :'ファイル名
26470       USERDATA "20",0:USERDATA "0",0
26480       TEMP=ASC(MID$(NEIRO$,NE_NO*80+17, 1)):IF                TEMP>127 THEN RET=-1:RETURN
26490       USERDATA STR$(TEMP),0 :'スタートノート
26500       TEMP=ASC(MID$(NEIRO$,NE_NO*80+18, 1)):IF                TEMP>127 THEN RET=-1:RETURN
26510       USERDATA STR$(TEMP),0 :'エンドノート
26520       TEMP=ASC(MID$(NEIRO$,NE_NO*80+19, 1)):IF                TEMP>127 THEN RET=-1:RETURN
26530       USERDATA STR$(TEMP),0 :'ベースノート
26540     ELSE
26550       '作成音源ＦＭ
26560       USERDATA "FM"
26570       TEMP=ASC(MID$(NEIRO$,NE_NO*80+51, 1)):IF TEMP<1  OR TEMP>32  THEN RET=-1:RETURN
26580       USERDATA STR$(TEMP),0 :'OP番号
26590       TEMP=ASC(MID$(NEIRO$,NE_NO*80+52, 1)):IF                TEMP>4   THEN RET=-1:RETURN
26600       USERDATA STR$(TEMP),0 :'W ウエーブフォーマット
26610       TEMP=ASC(MID$(NEIRO$,NE_NO*80+53, 1)):IF TEMP<0  OR TEMP>1   THEN RET=-1:RETURN
26620       USERDATA STR$(TEMP),0 :'C キャリア
26630       TEMP=ASC(MID$(NEIRO$,NE_NO*80+42, 1)):IF TEMP<0  OR TEMP>32  THEN RET=-1:RETURN
26640       USERDATA STR$(TEMP),0 :'X
26650       TEMP=ASC(MID$(NEIRO$,NE_NO*80+43, 1)):IF TEMP<0  OR TEMP>32  THEN RET=-1:RETURN
26660       USERDATA STR$(TEMP),0 :'Y
26670       TEMP=ASC(MID$(NEIRO$,NE_NO*80+54, 1)):IF TEMP<0  OR TEMP>32  THEN RET=-1:RETURN
26680       USERDATA STR$(TEMP),0 :'M 変調度
26690       TEMP=ASC(MID$(NEIRO$,NE_NO*80+47, 1)):IF TEMP<0  OR TEMP>7   THEN RET=-1:RETURN
26700       USERDATA STR$(TEMP),0 :'S ダイレクトデータ送信レベル
26710       TEMP=ASC(MID$(NEIRO$,NE_NO*80+22, 1)):IF TEMP<0  OR TEMP>31  THEN RET=-1:RETURN
26720       USERDATA STR$(TEMP),0 :'AR
26730       TEMP=ASC(MID$(NEIRO$,NE_NO*80+23, 1)):IF TEMP<0  OR TEMP>31  THEN RET=-1:RETURN
26740       USERDATA STR$(TEMP),0 :'D1R
26750       TEMP=ASC(MID$(NEIRO$,NE_NO*80+24, 1)):IF TEMP<0  OR TEMP>31  THEN RET=-1:RETURN
26760       USERDATA STR$(TEMP),0 :'D2R
26770       TEMP=ASC(MID$(NEIRO$,NE_NO*80+25, 1)):IF TEMP<0  OR TEMP>31  THEN RET=-1:RETURN
26780       USERDATA STR$(TEMP),0 :'RR
26790       TEMP=ASC(MID$(NEIRO$,NE_NO*80+26, 1)):IF TEMP<0  OR TEMP>31  THEN RET=-1:RETURN
26800       USERDATA STR$(TEMP),0 :'DL
26810       TEMP=ASC(MID$(NEIRO$,NE_NO*80+55, 1))
26820       USERDATA STR$(TEMP),0 :'TL
26830       TEMP=ASC(MID$(NEIRO$,NE_NO*80+18, 1)):IF TEMP<-1 OR TEMP>127 THEN RET=-1:RETURN
26840       USERDATA STR$(TEMP),0 :'sn
26850       TEMP=ASC(MID$(NEIRO$,NE_NO*80+19, 1)):IF TEMP<-1 OR TEMP>127 THEN RET=-1:RETURN
26860       USERDATA STR$(TEMP),0 :'en
26870       TEMP=ASC(MID$(NEIRO$,NE_NO*80+20, 1)):IF TEMP<-1 OR TEMP>127 THEN RET=-1:RETURN
26880       USERDATA STR$(TEMP),0 :'bn
26890       TEMP=ASC(MID$(NEIRO$,NE_NO*80+21, 1))-64
26900       USERDATA STR$(TEMP),0 :'ft
26910     ENDIF
26920   ELSE
26930     '未定義
26940     RET=-1
26950     RETURN
26960   ENDIF
26970 ENDIF
26980 RETURN
