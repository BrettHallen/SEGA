 7970 *FUNC_NEIROSEL
 7980 IF PASS_LEVEL<>0 THEN SYS_SAVEFLAG=1 ELSE SYS_SAVEFLAG=0
 7990 SYS_EXT=1
 8000 SYS_B$=       "STANDARD         ORCHEST          "
 8010 SYS_B$=SYS_B$+"ROCK             DANCE            "
 8020 SYS_B$=SYS_B$+"PIANO            ETHNIC           "
 8030 SYS_B$=SYS_B$+"METAL            MBOXPO           "
 8040 SYS_B$=SYS_B$+"EXTRA1           EXTRA2           "
 8050 SYS_B$=SYS_B$+"EXTRA3           EXTRA4           "
 8060 SYS_B$=SYS_B$+"GM_FM1           GM_FM2           "
 8070 SYS_B$=SYS_B$+"GM_FM3           GM_FM4           "
 8080 GOSUB *SYS_FILESELECT:COLOR,0,0:SYS_EXT=0
 8090 SYS_B$="":IF SYS_FILENAME$="" THEN RETURN
 8100 '
 8110 USER_NEIRO=1
 8120 FILE$=SYS_FILENAME$
 8130 FILE_$=SYS_DEV$+SYS_FILENAME$
 8140 IF FILE$="STANDARD  " THEN FILE_$=LD_DEV$+"LST1_00.D":USER_NEIRO=0
 8150 IF FILE$="ORCHEST   " THEN FILE_$=LD_DEV$+"LST1_01.D":USER_NEIRO=0
 8160 IF FILE$="ROCK      " THEN FILE_$=LD_DEV$+"LST1_02.D":USER_NEIRO=0
 8170 IF FILE$="DANCE     " THEN FILE_$=LD_DEV$+"LST1_03.D":USER_NEIRO=0
 8180 IF FILE$="PIANO     " THEN FILE_$=LD_DEV$+"LST1_04.D":USER_NEIRO=0
 8190 IF FILE$="METAL     " THEN FILE_$=LD_DEV$+"LST1_05.D":USER_NEIRO=0
 8200 IF FILE$="ETHNIC    " THEN FILE_$=LD_DEV$+"LST1_06.D":USER_NEIRO=0
 8210 IF FILE$="MBOXPO    " THEN FILE_$=LD_DEV$+"LST1_07.D":USER_NEIRO=0
 8220 IF FILE$="EXTRA1    " THEN FILE_$=LD_DEV$+"LST1_08.D":USER_NEIRO=0
 8230 IF FILE$="EXTRA2    " THEN FILE_$=LD_DEV$+"LST1_09.D":USER_NEIRO=0
 8240 IF FILE$="EXTRA3    " THEN FILE_$=LD_DEV$+"LST1_10.D":USER_NEIRO=0
 8250 IF FILE$="EXTRA4    " THEN FILE_$=LD_DEV$+"LST1_11.D":USER_NEIRO=0
 8260 IF FILE$="GM_FM1    " THEN FILE_$=LD_DEV$+"LST1_12.D":USER_NEIRO=0
 8270 IF FILE$="GM_FM2    " THEN FILE_$=LD_DEV$+"LST1_13.D":USER_NEIRO=0
 8280 IF FILE$="GM_FM3    " THEN FILE_$=LD_DEV$+"LST1_14.D":USER_NEIRO=0
 8290 IF FILE$="GM_FM4    " THEN FILE_$=LD_DEV$+"LST1_15.D":USER_NEIRO=0
 8300 'ﾈｲﾛｦｾｯﾃｲｽﾙ
 8310 GOSUB *FADE_OUT
 8320 FILE$=FILE_$:GOSUB *SET_NEIROLIST
 8330 CLS :GOSUB *TEXT_PRINT
 8340 GOSUB *FADE_IN
 8350 RETURN
 8360 '==============================
 8370 'ｺﾏﾝﾄﾞﾎﾞﾀﾝ ﾉ ﾃﾞﾌｫﾙﾄ ﾉ ｼｮﾘ
 8380 ' RET:
 8390 '    FLAG_CLICK=1 ﾎﾞﾀﾝ ｶﾞ ｵｻﾚﾀ
 8400 '==============================
 8420 *DEF_BTN
 8430 FLAG_CLICK=0
 8440 IF EVENT=1 THEN
 8450   IF CAPTURE=J AND WIN(J,0)<=EVENTX AND WIN(J,1)>=EVENTX AND WIN(J,2)<=EVENTY AND WIN(J,3)>=EVENTY THEN FLAG_CLICK=1
 8460   CAPTURE=-1:OBJ(WIN(J,5),16)=SPR_BTNUP:OBJ(OBJ(WIN(J,5),21),4)=0,0:RETURN
 8470 ENDIF
 8480 IF EVENT=0 AND CAPTURE=-1 THEN CAPTURE=J:OBJ(WIN(J,5),16)=SPR_BTNDOWN:OBJ(OBJ(WIN(J,5),21),4)=-2,2
 8490 RETURN
 8500 '----------------
 8510 'ﾈｲﾛ ｼﾝｷｻｸｾｲ ｼｮﾘ
 8520 '----------------
 8540 *NEW_NEIRO
 8550 SYS_MES_TITLE$="":SYS_MES_MESSAGE$="ﾄﾞﾚｦｻｸｾｲｼﾏｽｶ ?":SYS_MES_NAME$(0)="FM":SYS_MES_NAME$(1)="PCM"
 8560 SYS_MES_MODE=&B100010011:GOSUB *SYS_MESSAGEBOX:COLOR,0,0
 8570 IF SYS_I=0 THEN
 8580  'FM
 8590  FM_NAME$="________________"
 8600  FM_PROGRAM=-1
 8610  GOSUB *NEW_FM
 8620 ELSE
 8630  'PCM
 8640  GOSUB *NEW_PCM
 8650 ENDIF
 8660 RETURN
 8670 '
 8680 'PCM ｦ ﾂｸﾙ
 8690 '
 8710 *NEW_PCM
 8720 'PCM ﾌｧｲﾙﾒｲ ｦ ｴﾙ
 8730 SYS_SAVEFLAG=0:GOSUB *SYS_FILESELECT:COLOR,0,0:IF SYS_FILENAME$="" THEN RETURN
 8740 'ﾈｲﾛﾘｽﾄﾆﾂｲｶｽﾙ
 8750 GOSUB *NEIRO_ADD_PCM
 8760 'ｻｲﾋﾞｮｳｶﾞ
 8770 FILE$=NEIROSETFILENAME$:GOSUB *SET_NEIROLIST
 8780 IF SCREEN_MODE=0 THEN
 8790   CLS
 8800   GOSUB *TEXT_PRINT
 8810   'GOSUB *TRAY_PRINT
 8820 ENDIF
 8830 RETURN
 8840 '
 8850 'FM ｦ ﾂｸﾙ
 8860 '
 8880 *NEIRO_ADD_FM
 8890 F=1:GOTO *NEIRO_ADD_
 8900 '
 8910 'ENTRY:
 8920 ' NEIROSETFILENAME$:ﾈｲﾛｾｯﾄﾌｧｲﾙﾒｲ
 8930 ' SYS_FILENAME$    :ｳｴｰﾌﾞﾌｧｲﾙﾒｲ
 8950 *NEIRO_ADD_PCM
 8960 F=0
 8980 *NEIRO_ADD_
 8990 ARG$=NEIROSETFILENAME2$    :GOSUB *SPCUT:N2$=RET$
 9000 ARG$=SYS_DEV$+SYS_FILENAME$:GOSUB *SPCUT:SYS_FILENAME$=RET$
 9010 ARG$=NEIROSETFILENAME$     :GOSUB *SPCUT:N1$=RET$
 9020 GOSUB *NEIRO_MAXNO
 9030 IF F=0 THEN
 9040  A$="#"+SYS_FILENAME$+","+N2$+","+MID$(STR$(RET),2)+CHR$(13)+CHR$(10)
 9050 ELSE
 9060  A$="#"+FM_NAME$+","+N2$+","+MID$(STR$(RET),2)+CHR$(13)+CHR$(10)
 9070 ENDIF
 9080 ON ERROR GOTO *NEIRO_ADDERR1
 9090 OPEN N1$ FOR APPEND AS #1
 9100 ON ERROR GOTO *NEIRO_ADDERR2
 9110 FWRITE #1,A$
 9130 *NEIRO_EXIT2
 9140 CLOSE #1
 9160 *NEIRO_EXIT1
 9170 ON ERROR GOTO 0
 9180 IF F=0 THEN
 9190  A$="@PCM"+CHR$(13)+CHR$(10)+"FILE,"+SYS_FILENAME$+",0,0,0,127,-1"+CHR$(13)+CHR$(10)
 9200 ELSE
 9210  GOSUB *SET_FM_LAYER_FILE:'ｻｸｾｲ
 9220 ENDIF
 9230 ON ERROR GOTO *NEIRO_ADDERR3
 9240 OPEN N2$ FOR APPEND AS #1
 9250 ON ERROR GOTO *NEIRO_ADDERR4
 9260 FWRITE #1,A$
 9280 *NEIRO_EXIT4
 9290 CLOSE #1
 9310 *NEIRO_EXIT3
 9320 ON ERROR GOTO 0
 9330 RETURN
 9340 'ｴﾗｰｼｮﾘ
 9360 *NEIRO_ADDERR1
 9370 RESUME *NEIRO_EXIT1
 9390 *NEIRO_ADDERR2
 9400 RESUME *NEIRO_EXIT2
 9420 *NEIRO_ADDERR3
 9430 RESUME *NEIRO_EXIT3
 9450 *NEIRO_ADDERR4
 9460 RESUME *NEIRO_EXIT4
 9470 '
 9480 'ｽﾍﾟｰｽｦｶｯﾄｽﾙ
 9490 '
 9510 *SPCUT
 9520 RET$=""
 9530 FOR I=1 TO LEN(ARG$)
 9540  IF MID$(ARG$,I,1)<>" " THEN RET$=RET$+MID$(ARG$,I,1)
 9550 NEXT
 9560 RETURN
 9570 '
 9580 'ﾈｲﾛﾉｻｲﾀﾞｲｽｳ
 9590 '
 9610 *NEIRO_MAXNO:RET=MAX_NEIRO:RETURN
 9620 '
 9630 'FM ｦ ﾂｸﾙ
 9640 '
 9660 *NEW_FM
 9670 GOSUB *FM_PARAM_INIT
 9680 GOSUB *SET_FM1
 9690 SCREEN_MODE=3:GOSUB *SHOW_SCREEN
 9700 RETURN
 9710 '
 9720 '
 9730 '
 9750 *GET_NO
 9760 X=(EVENTX \ 8)+INT(SX)
 9770 Y=(EVENTY \ 8)-5
 9780 FOR I=0 TO 8
 9790  IF (X-1)<=LSTSE(I) THEN RET=Y+I*18:I=10
 9800 NEXT
 9810 RETURN
 9830 *CLIENT
 9840 IF EVENT=-2 AND CAPTURE<>-1 THEN
 9850   IF C_MODE=1 THEN
 9860     SX=HSX1+HSX-(EVENTX \ 8)
 9870     GOSUB *TEXT_PRINT
 9880   ENDIF
 9890   RETURN
 9900 ENDIF
 9910 '左ダブルクリック（音色をトレイに追加）
 9920 IF EVENT=3 AND EVENTX>8 AND EVENTY<182 AND EVENTY>38 AND MAX_TY<128 THEN
 9930   GOSUB *NEIRO_MAXNO:ARG1=RET
 9940   GOSUB *GET_NO
 9950   IF RET>=ARG1 THEN RETURN
 9960   IF USER_NEIRO=1 AND RET=ARG1-1 GOTO *NEW_NEIRO
 9970   TRAY$(MAX_TY,0)=LIST_$(RET,0)
 9980   TRAY$(MAX_TY,1)=LIST_$(RET,1)
 9990   TRAY$(MAX_TY,2)=LIST_$(RET,2)
10000   MAX_TY=MAX_TY+1
10010   GOSUB *TRAY_PRINT
10020   RETURN
10030 ENDIF
10040 '左クリック（音色を設定）
10050 IF EVENT=2 AND EVENTX>8 AND EVENTY<182 AND EVENTY>38 THEN
10060   GOSUB *NEIRO_MAXNO:ARG1=RET
10070   GOSUB *GET_NO
10080   IF RET>=ARG1 THEN RETURN
10090   IF USER_NEIRO=1 AND RET=ARG1-1 GOTO *NEW_NEIRO
10100   IF RET<>N_NE THEN N_NE=RET:GOSUB *SET_NEIRO_LIST
10110   RETURN
10120 ENDIF
10130 '中ボタンドラック
10140 IF EVENT=8 AND CAPTURE=-1 THEN
10150  C_MODE=1
10160  CAPTURE=J
10170  HSX=(EVENTX \ 8)
10180  HSX1=SX
10190  RETURN
10200 ENDIF
10210 IF EVENT=9 AND CAPTURE<>-1 THEN
10220  C_MODE=0
10230  CAPTURE=-1
10240  SX=HSX1+HSX-(EVENTX \ 8)
10250  GOSUB *TEXT_PRINT
10260  WIN(14,0)=OBJ(WIN(14,5),4)
10270  WIN(14,1)=WIN(14,0)+15
10280  WIN(15,0)=WIN(14,0)
10290  WIN(15,1)=WIN(14,1)
10300  RETURN
10310 ENDIF
10320 'ﾐｷﾞﾎﾞﾀﾝｸﾘｯｸ
10330 IF EVENT=6 AND CAPTURE=-1 AND USER_NEIRO=1 THEN
10340  GOSUB *NEIRO_MAXNO:ARG1=RET
10350  GOSUB *GET_NO
10360  IF RET>=ARG1 THEN RETURN
10370  GOSUB *DEL_SUB
10380  RETURN
10390 ENDIF
10400 IF EVENT=12 AND CAPTURE=-1 AND USER_NEIRO=1 THEN
10410  GOSUB *NEIRO_MAXNO:ARG1=RET
10420  GOSUB *GET_NO
10430  IF RET>=ARG1 THEN RETURN
10440  IF LEFT$(LIST_$(RET,0),1)="#" THEN
10450   FM_PROGRAM=RET
10460   N_NE=RET:GOSUB *SET_NEIRO_LIST
10470   IF F_FM=1 THEN
10480    'FM_MODE
10490    FM_NAME$=LEFT$(MID$(LIST_$(RET,0),2),16)
10500    SCREEN_MODE=3:GOSUB *SHOW_SCREEN
10510   ENDIF
10520  ENDIF
10530  RETURN
10540 ENDIF
10550 RETURN
10570 *DEL_SUB
10580 'ｻｸｼﾞｮｶｸﾆﾝ
10590 SYS_MES_TITLE$=""
10600 SYS_MES_MESSAGE$=MID$(LIST_$(RET,0),2,14)+CHR$(10)+CHR$(13)+"ｻｸｼﾞｮｼﾏｽｶ?"
10610 SYS_MES_NAME$(0)="No":SYS_MES_NAME$(1)="Yes"
10620 SYS_MES_MODE=&B100010011:GOSUB *SYS_MESSAGEBOX:COLOR,0,0
10630 IF SYS_I=0 THEN RETURN
10640 ARG1=RET
10650 ARG2$=NEIROSETFILENAME$
10660 GOSUB *NEIRO_DEL
10670 'ｻｲﾋﾞｮｳｶﾞ
10680 FILE$=NEIROSETFILENAME$:GOSUB *SET_NEIROLIST
10690 IF SCREEN_MODE=0 THEN
10700   CLS
10710   GOSUB *TEXT_PRINT
10720   'GOSUB *TRAY_PRINT
10730 ENDIF
10740 RETURN
10750 '======================
10760 'ﾄﾚｲｶﾝｹｲ
10770 '======================
10790 *TRA
10800 IF EVENT=-2 AND CAPTURE<>-1 THEN
10810   OBJ(16,4)=EVENTX-HSX
10820   RETURN
10830 ENDIF
10840 IF EVENT=0 AND CAPTURE=-1 THEN
10850   CAPTURE=J
10860   HSX=EVENTX-OBJ(16,4)
10870   RETURN
10880 ENDIF
10890 IF EVENT=1 AND CAPTURE<>-1 THEN
10900   WIN(7,0)=OBJ(16,4)
10910   WIN(7,1)=OBJ(16,4)+159
10920   WIN(8,0)=WIN(7,0)
10930   WIN(8,1)=WIN(7,1)
10940 '
10950   WIN(9,0)=WIN(7,0)+11
10960   WIN(9,1)=WIN(9,0)+9
10970 '
10980   WIN(10,0)=WIN(7,0)+146
10990   WIN(10,1)=WIN(10,0)+9
11000 '
11010   WIN(11,0)=WIN(7,0)+12
11020   WIN(11,1)=WIN(11,0)+7
11030 '
11040   WIN(12,0)=WIN(7,0)+147
11050   WIN(12,1)=WIN(12,0)+7
11060 '
11070   WIN(13,0)=WIN(7,0)+13
11080   WIN(13,1)=WIN(7,0)+146
11090 '
11100   CAPTURE=-1
11110   RETURN
11120 ENDIF
11130 RETURN
11140 '
11150 '
11160 '
11180 *HSCR_BAR1
11190 IF EVENT=-2 AND CAPTURE<>-1 THEN EVENTX=EVENTX-HSX:GOTO *TEXT_PRINT_MOUSE
11200 IF EVENT=0  AND CAPTURE=-1  THEN CAPTURE=J:HSX=EVENTX-WIN(J,0):RETURN
11210 IF EVENT=1  AND CAPTURE<>-1 THEN
11220  CAPTURE=-1
11230  EVENTX=EVENTX-HSX:GOSUB *TEXT_PRINT_MOUSE
11240  WIN(14,0)=OBJ(WIN(14,5),4):WIN(14,1)=WIN(14,0)+15:WIN(15,0)=WIN(14,0):WIN(15,1)=WIN(14,1)
11250  RETURN
11260 ENDIF
11270 RETURN
11280 '
11290 '
11300 '
11320 *HSCR_BAR2
11330 IF EVENT=2 THEN
11340   IF EVENTX>WIN(14,0) THEN SX=SX+20 ELSE SX=SX-20
11350   GOSUB *TEXT_PRINT
11360   WIN(14,0)=OBJ(WIN(14,5),4)
11370   WIN(14,1)=WIN(14,0)+15
11380   WIN(15,0)=WIN(14,0)
11390   WIN(15,1)=WIN(14,1)
11400   RETURN
11410 ENDIF
11420 IF EVENT=10 THEN
11430   GOSUB *TEXT_PRINT_MOUSE
11440   WIN(14,0)=OBJ(WIN(14,5),4)
11450   WIN(14,1)=WIN(14,0)+15
11460   WIN(15,0)=WIN(14,0)
11470   WIN(15,1)=WIN(14,1)
11480   RETURN
11490 ENDIF
11500 RETURN
11510 '
11520 '
11530 '
11550 *VSCR_BAR1
11560 IF EVENT=-2 AND CAPTURE<>-1 THEN
11570   EVENTY=EVENTY-VSY
11580   GOSUB *TRAY_PRINT_MOUSE
11590   RETURN
11600 ENDIF
11610 IF EVENT=0 AND CAPTURE=-1 THEN CAPTURE=J:VSY=EVENTY-WIN(J,2):RETURN
11620 IF EVENT=1 AND CAPTURE<>-1 THEN
11630  CAPTURE=-1
11640  EVENTY=EVENTY-VSY
11650  GOSUB *TRAY_PRINT_MOUSE
11660  WIN(9,2)=OBJ(20,4)-20
11670  WIN(9,3)=WIN(9,2)+13
11680  WIN(10,2)=WIN(9,2)
11690  WIN(10,3)=WIN(9,3)
11700  RETURN
11710 ENDIF
11720 RETURN
11730 '
11740 '
11750 '
11770 *VSCR_BAR2
11780 IF EVENT=2 THEN
11790  IF EVENTY>WIN(9,2) THEN TY=TY+18 ELSE TY=TY-18
11800  GOSUB *TRAY_PRINT
11810  WIN(9,2)=OBJ(20,4)-20
11820  WIN(9,3)=WIN(9,2)+15
11830  WIN(10,2)=WIN(9,2)
11840  WIN(10,3)=WIN(9,3)
11850  RETURN
11860 ENDIF
11870 IF EVENT=10 THEN
11880  GOSUB *TRAY_PRINT_MOUSE
11890  WIN(9,2)=OBJ(20,4)-20
11900  WIN(9,3)=WIN(9,2)+15
11910  WIN(10,2)=WIN(9,2)
11920  WIN(10,3)=WIN(9,3)
11930  RETURN
11940 ENDIF
11950 RETURN
11960 '
11970 '
11980 '
12000 *GET_TRAYNO
12010 RET=TY+((EVENTY-4)\8)-4
12020 IF RET>=MAX_TY THEN RET=MAX_TY-1
12030 RETURN
12050 *T_CLIENT
12060 '右ボタンクリック（削除）
12070 IF EVENT=6 AND CAPTURE=-1 THEN
12080  GOSUB *GET_TRAYNO:IF RET<0 THEN RETURN : '場所を調べる
12090  'ｻｸｼﾞｮｶｸﾆﾝ
12100  SYS_MES_TITLE$=""
12110  SYS_MES_MESSAGE$=MID$(TRAY$(RET,0),2,14)+CHR$(10)+CHR$(13)+"ｻｸｼﾞｮｼﾏｽｶ?"
12120  SYS_MES_NAME$(0)="No":SYS_MES_NAME$(1)="Yes"
12130  SYS_MES_MODE=&B100010011:GOSUB *SYS_MESSAGEBOX:COLOR,0,0
12140  IF SYS_I=0 THEN RETURN
12150  FOR KKK=RET TO MAX_TY-2          : 'ｻｸｼﾞｮｽﾙ
12160   TRAY$(KKK,0)=TRAY$(KKK+1,0)
12170   TRAY$(KKK,1)=TRAY$(KKK+1,1)
12180   TRAY$(KKK,2)=TRAY$(KKK+1,2)
12190   TRAY$(KKK,3)=TRAY$(KKK+1,3)
12200  NEXT
12210  IF MAX_TY>0 THEN MAX_TY=MAX_TY-1
12220  CLS 22:GOSUB *TRAY_PRINT              : '表示
12230  WIN(9,2)=OBJ(20,4)-20
12240  WIN(9,3)=WIN(9,2)+15
12250  WIN(10,2)=WIN(9,2)
12260  WIN(10,3)=WIN(9,3)
12270  RETURN
12280 ENDIF
12290 '左ボタンクリック
12300 IF EVENT=2 AND CAPTURE=-1 THEN
12310  GOSUB *GET_TRAYNO:IF RET<0 THEN RETURN : '場所を調べる
12320  GOSUB *SET_NEIRO_TRAY            : '音色を設定する
12330  RETURN
12340 ENDIF
12350 '左ボタンダブルクリック
12360 IF EVENT=3 AND CAPTURE=-1 THEN
12370  GOSUB *GET_TRAYNO:IF RET<0 THEN RETURN : '場所を調べる
12380  'モードを切り替える
12390  'CDの時は変更不可
12400  IF LEFT$(TRAY$(RET,0),1)="#" AND USER_NEIRO=1 THEN
12410   'FM_MODE
12420   FM_NAME$=LEFT$(MID$(TRAY$(RET,0),2),16)
12430   FM_PROGRAM=-1
12440   K=MAX_TY:IF K>MAX_NEIRO THEN K=MAX_NEIRO
12450   FOR I=0 TO K-1
12460    IF TRAY$(I,0)=LIST_$(I,0) AND TRAY$(I,1)=LIST_$(I,1) AND TRAY$(I,2)=LIST_$(I,2) THEN FM_PROGRAM=I
12470   NEXT
12480   IF FM_PROGRAM>=0 THEN SCREEN_MODE=3:GOSUB *SHOW_SCREEN
12490   'PCM_MODE
12500  ENDIF
12510  RETURN
12520 ENDIF
12530 '中ボタンドラッグ
12540 IF EVENT=-2 AND CAPTURE<>-1 THEN
12550   IF C_MODE=1 THEN
12560     TY=VSY1+VSY-(EVENTY \ 8)
12570     GOSUB *TRAY_PRINT
12580   ENDIF
12590   RETURN
12600 ENDIF
12610 IF EVENT=8 AND CAPTURE=-1 THEN
12620   C_MODE=1
12630   CAPTURE=J
12640   VSY=(EVENTY \ 8)
12650   VSY1=TY
12660   RETURN
12670 ENDIF
12680 IF EVENT=9 AND CAPTURE<>-1 THEN
12690  C_MODE=0
12700  CAPTURE=-1
12710  TY=VSY1+VSY-(EVENTY \ 8)
12720  GOSUB *TRAY_PRINT
12730  WIN(9,2)=OBJ(20,4)-20
12740  WIN(9,3)=WIN(9,2)+15
12750  WIN(10,2)=WIN(9,2)
12760  WIN(10,3)=WIN(9,3)
12770  RETURN
12780 ENDIF
12790 RETURN
12800 '-------------------------------------------------------------
12810 '音色設定
12820 '-------------------------------------------------------------
12830 'リスト内の音を設定する
12840 'ENTRY:RET
12860 *SET_NEIRO_LIST
12870 IF SCREEN_MODE=0 THEN
12880  IF LEFT$(LIST_$(RET,0),1)="@" THEN
12890   'ＣＤに内蔵している音
12900   USERDATA 0,0,LIST_$(RET,1)
12910   USERDATA LIST_$(RET,2),0
12920   USERDATA "ENDARRANGE"
12930   TARG READ
12940   USERDATA END
12950  ELSE
12960   '自作した音
12970   OPEN LIST_$(RET,1) FOR INPUT AS #1
12980   FOR I=1 TO VAL(LIST_$(RET,2))
13000 *SET_NEIRO_LISTL0
13010     GOSUB *GET_TOKEN
13020     IF LEFT$(TOKEN$,1)<>"@" GOTO *SET_NEIRO_LISTL0
13030   NEXT
13040   F_FM=0
13050   IF TOKEN$="@FM" THEN
13060     F_FM=1
13070     GOSUB *GET_TOKEN:USERDATA 0,0,TOKEN$:'BUILDLAYER
13080     FOR L=0 TO 3
13090      GOSUB *GET_TOKEN:USERDATA TOKEN$  :'FM
13100      A$=TOKEN$
13110      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'OP#
13120      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_W(L)=VAL(TOKEN$):'W
13130      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_X(L)=VAL(TOKEN$):'X
13140      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_Y(L)=VAL(TOKEN$):'Y
13150      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_M(L)=VAL(TOKEN$):'M
13160      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_S(L)=VAL(TOKEN$):'S
13170      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_AR(L)=VAL(TOKEN$):'AR
13180      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_DR(L)=VAL(TOKEN$):'DR
13190      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_SR(L)=VAL(TOKEN$):'SR
13200      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_RR(L)=VAL(TOKEN$):'RR
13210      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_DL(L)=VAL(TOKEN$):'SL
13220      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_TL(L)=VAL(TOKEN$):'TL
13230      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_ML1(L)=VAL(TOKEN$):'ml1
13240      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_ML2(L)=VAL(TOKEN$):'ml2
13250      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_DT(L)=VAL(TOKEN$):'dt
13260      GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_KS(L)=VAL(TOKEN$):'KS
13270      IF A$="FMEXT" THEN
13280        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_SN(L)=VAL(TOKEN$):'sn
13290        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_EN(L)=VAL(TOKEN$):'en
13300        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_VL(L)=VAL(TOKEN$):'vl
13310        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_RE(L)=VAL(TOKEN$):'RE
13320        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_LF(L)=VAL(TOKEN$):'LF
13330        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_AW(L)=VAL(TOKEN$):'AW
13340        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_AS(L)=VAL(TOKEN$):'AS
13350        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_PW(L)=VAL(TOKEN$):'PW
13360        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_PS(L)=VAL(TOKEN$):'PS
13370        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_MX(L)=VAL(TOKEN$):'MX
13380        GOSUB *GET_TOKEN:USERDATA TOKEN$,0:FM_DP(L)=VAL(TOKEN$):'DP
13390      ELSE
13400        FM_SN(L)=0  :'sn
13410        FM_EN(L)=127:'en
13420        FM_VL(L)=0  :'vl
13430        FM_RE(L)=0  :'RE
13440        FM_LF(L)=0  :'LF
13450        FM_AW(L)=0  :'AW
13460        FM_AS(L)=0  :'AS
13470        FM_PW(L)=0  :'PW
13480        FM_PS(L)=0  :'PS
13490        FM_MX(L)=0  :'MX
13500        FM_DP(L)=0  :'DP
13510      ENDIF
13520     NEXT
13530     GOSUB *GET_TOKEN:USERDATA TOKEN$:'ENDLAYER
13540   ELSE
13550    'PCM
13560    GOSUB *GET_TOKEN
13570    IF TOKEN$="BUILDLAYER" THEN
13580      USERDATA 0,0,TOKEN$
13590      GOSUB *GET_TOKEN
13610 *SET_NEIRO_LISTL1
13620      GOSUB *SET_PCM_SUB
13630      GOSUB *GET_TOKEN
13640      IF TOKEN$<>"ENDLAYER" GOTO *SET_NEIRO_LISTL1
13650      USERDATA TOKEN$
13660    ELSE
13670      USERDATA 0,0,TOKEN$
13680      GOSUB *SET_PCM_SUB1
13690    ENDIF
13700   ENDIF
13710   USERDATA "ENDARRANGE"
13720   CLOSE #1
13730   TARG READ
13740   USERDATA END
13750  ENDIF
13760 ELSE
13770  IF 1 THEN
13780   'ＣＤに内蔵している音
13790   USERDATA 0,0,"BUILDLAYER"
13800   USERDATA LIST_$(RET,1)
13810   USERDATA LIST_$(RET,2),0
13820   USERDATA LIST_$(RET,3),0
13830   USERDATA "-1",0
13840   USERDATA "-1",0
13850   USERDATA "-1",0
13860   USERDATA "ENDLAYER"
13870   USERDATA "ENDARRANGE"
13880   TARG READ
13890   USERDATA END
13900  ELSE
13910   '自作した音
13920  ENDIF
13930 ENDIF
13940 RETURN
13950 'トレイ内の音を設定する
