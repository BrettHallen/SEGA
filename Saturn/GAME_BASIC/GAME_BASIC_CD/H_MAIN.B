18530 DATA 104,224, 16, 23, 1,  0,   0,   0 :' プログラム番号
18540 DATA 104,224, 24, 31, 1,  0,   0,   0 :' 名前
18550 '
18560 DATA  96,152, 40, 47, 1,  0,   0,   0 :' FM/FMEXT
18570 DATA   8, 88, 40, 79, 1,  0,   0,   0 :' WINDOW
18580 DATA  96,319, 48, 79, 1,  0,   0,   0 :' LAYER TEXT
18590 '
18600 DATA  96,152, 80, 87, 1,  0,   0,   0 :' FM/FMEXT
18610 DATA   8, 88, 80,119, 1,  0,   0,   0 :' WINDOW
18620 DATA  96,319, 88,119, 1,  0,   0,   0 :' LAYER TEXT
18630 '
