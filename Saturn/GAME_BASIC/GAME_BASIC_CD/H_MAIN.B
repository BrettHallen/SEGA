18650 DATA   8, 88,120,159, 1,  0,   0,   0 :' WINDOW
18660 DATA  96,319,128,159, 1,  0,   0,   0 :' LAYER TEXT
18670 '
18680 DATA  96,152,160,167, 1,  0,   0,   0 :' FM/FMEXT
18690 DATA   8, 88,160,199, 1,  0,   0,   0 :' WINDOW
18700 DATA  96,319,168,199, 1,  0,   0,   0 :' LAYER TEXT
18710 '-----------------------------
18720 'ＦＭのアルゴリズムを描画する
18730 '-----------------------------
18740 'ENTRY:FM_ALGO
18760 *FM_ALGO_DRAW
18770 IF FM_ALGO>=0 THEN
18780   LOCATE 0,0:PRINT "Algo.";:PRINT USING "##";FM_ALGO
18790   ON FM_ALGO+1 RESTORE *ALGODATA0,*ALGODATA1,*ALGODATA2,*ALGODATA3,*ALGODATA4,*ALGODATA5,*ALGODATA6,*ALGODATA7,*ALGODATA8
18800   READ X,Y:B$=STRW$(1,X)+STRW$(1,Y)
18820 *FM_ALGO_DRAWL0
18830   READ A$:IF A$<>"END" THEN B$=B$+HEXBIN$(A$):GOTO *FM_ALGO_DRAWL0
18840   ACTIVE 0:GCOPY B$ TO (8,16):A$=""
18850   'ALGO
18860   FOR L=0 TO 3
18870     READ FM_X(L),FM_Y(L),FM_S(L)
18880   NEXT
18890   GOSUB  *LAYER_DRAW_TEXT
18900 ELSE
18910   LOCATE 1,0:PRINT "       "
18920   ACTIVE 0:LINE (8,16)-(88,40),-1,BF
18930 ENDIF
18940 RETURN
18950 '-----------------------------------
18960 'プログラム、プログラム名を描画する
18970 '-----------------------------------
18980 'ENTRY:FM_PROGRAM
19000 *FM_PROGRAM_DRAW
19010 COLOR 7
19020 IF FM_PROGRAM<0 THEN
19030  LOCATE 12,1:PRINT "Program No.";:PRINT " ｼﾝｷ"
19040 ELSE
19050  LOCATE 12,1:PRINT "Program No.";:PRINT USING "####";FM_PROGRAM
19060 ENDIF
19070 LOCATE 12,2:PRINT "Name:[                ]";
19080 LOCATE 18,2:PRINT LEFT$(FM_NAME$,16)
19090 RETURN
19100 '----------------
19110 'レイヤー表示
19120 '----------------
19140 *LAYER_DRAW
19150 X=0
19160 L=0
19170 FOR Y=4 TO 19 STEP 5
19180  GOSUB *LAYER_DRAW1
19190  GOSUB *ENV_DRAW
19200  L=L+1
19210 NEXT
19220 RETURN
19230 '----------------
19240 'レイヤー表示テキストのみ
19250 '----------------
19270 *LAYER_DRAW_TEXT
19280 X=0
19290 L=0
19300 FOR Y=4 TO 19 STEP 5
19310  GOSUB *LAYER_DRAW2
19320  L=L+1
19330 NEXT
19340 RETURN
19350 '----------------
19360 '1レイヤーのみ表示
19370 '----------------
19390 *LAYER_DRAW1
19400 ACTIVE 0
19410 LINE (X*8  ,Y*8+8)-(X*8+319,Y*8+39+8),8,BF
19420 LINE (X*8+1,Y*8+8)-(X*8+319,Y*8+38+8),128,BF
19430 LINE (X*8+1,Y*8+9)-(X*8+318,Y*8+38+8),9,BF
19440 '----------------
19450 '1レイヤーのみ表示（テキスト）
19460 '----------------
19480 *LAYER_DRAW2
19490 IF P<0 THEN P=0
19500 IF P>14 THEN P=14
19510 LOCATE X,Y
19520 COLOR 5:A$="           ["+MID$(STR$(L),2)
19530 IF FM_EXT(L)=0 THEN PRINT A$+".Nor]" ELSE PRINT A$+".EXT]"
19540 COLOR 7
19550 A$="AR:"+RIGHT$(" "+MID$(STR$(FM_AR(L)),2),2)
19560 A$=A$+" DL:" +RIGHT$("  "+MID$(STR$(FM_DL(L)),2),3)
19570 A$=A$+" ml1:"+RIGHT$("  "+STR$(FM_ML1(L)),3)
19580 A$=A$+" sn:" +RIGHT$("  "+MID$(STR$(FM_SN(L)),2),3)
19590 A$=A$+" RE:" +RIGHT$("  "+MID$(STR$(FM_RE(L)),2),3)
19600 A$=A$+" PW:" +RIGHT$("  "+MID$(STR$(FM_PW(L)),2),3)
19610 PRINT "           "+MID$(A$,P+1,27);
19620 '
19630 A$="DR:"+RIGHT$(" "+MID$(STR$(FM_DR(L)),2),2)
19640 A$=A$+" TL:" +RIGHT$("  "+MID$(STR$(FM_TL(L)),2),3)
19650 A$=A$+" ml2:"+RIGHT$("  "+MID$(STR$(FM_ML2(L)),2),3)
19660 A$=A$+" en:" +RIGHT$("  "+MID$(STR$(FM_EN(L)),2),3)
19670 A$=A$+" LF:" +RIGHT$("  "+MID$(STR$(FM_LF(L)),2),3)
19680 A$=A$+" PS:" +RIGHT$("  "+MID$(STR$(FM_PS(L)),2),3)
19690 PRINT "           "+MID$(A$,P+1,27);
19700 '
19710 A$="SR:"+RIGHT$(" "+MID$(STR$(FM_SR(L)),2),2)
19720 A$=A$+"  W:" +RIGHT$("  "+MID$(STR$(FM_W(L)),2),3)
19730 A$=A$+"   S:"+RIGHT$("  "+MID$(STR$(FM_S(L)),2),3)
19740 A$=A$+" dt" +RIGHT$("   "+STR$(FM_DT(L)),4)
19750 A$=A$+" AW:" +RIGHT$("  "+MID$(STR$(FM_AW(L)),2),3)
19760 A$=A$+" MX:" +RIGHT$("  "+MID$(STR$(FM_MX(L)),2),3)
19770 PRINT "           "+MID$(A$,P+1,27);
19780 '
19790 A$="RR:"+RIGHT$(" "+MID$(STR$(FM_RR(L)),2),2)
19800 A$=A$+"  M:" +RIGHT$("  "+MID$(STR$(FM_M(L)),2),3)
19810 A$=A$+"  KS:"+RIGHT$("  "+STR$(FM_KS(L)),3)
19820 A$=A$+" vl:" +RIGHT$("  "+MID$(STR$(FM_VL(L)),2),3)
19830 A$=A$+" AS:" +RIGHT$("  "+MID$(STR$(FM_AS(L)),2),3)
19840 A$=A$+" DP:" +RIGHT$("  "+MID$(STR$(FM_DP(L)),2),3)
19850 PRINT "           "+MID$(A$,P+1,27);
19860 RETURN
19870 '
19890 *SET_FM_LAYER_FILE
19900 A$="@FM"+CHR$(13)+CHR$(10)+"BUILDLAYER"+CHR$(13)+CHR$(10)
19910 FOR L=0 TO 3
19920  IF FM_EXT(L)=0 THEN
19930     A$=A$+"FM,"
19940  ELSE
19950     A$=A$+"FMEXT,"
19960  ENDIF
19970  A$=A$+STR$(L+1)+" ,":'OP#
19980  A$=A$+RIGHT$( " "+STR$(FM_W(L)),2)+" ,":'W
19990  A$=A$+RIGHT$("  "+STR$(FM_X(L)),3)+" ,":'X
20000  A$=A$+RIGHT$("  "+STR$(FM_Y(L)),3)+" ,":'Y
20010  A$=A$+RIGHT$("  "+STR$(FM_M(L)),3)+" ,":'M
20020  A$=A$+RIGHT$("  "+STR$(FM_S(L)),3)+" ,":'S
20030  A$=A$+RIGHT$("  "+STR$(FM_AR(L)),3)+" ,":'AR
20040  A$=A$+RIGHT$("  "+STR$(FM_DR(L)),3)+" ,":'DR
20050  A$=A$+RIGHT$("  "+STR$(FM_SR(L)),3)+" ,":'SR
20060  A$=A$+RIGHT$("  "+STR$(FM_RR(L)),3)+" ,":'RR
20070  A$=A$+RIGHT$("  "+STR$(FM_DL(L)),3)+" ,":'SL
20080  A$=A$+RIGHT$("   "+STR$(FM_TL(L)),4)+" ,":'TL
20090  A$=A$+RIGHT$("  "+STR$(FM_ML1(L)),3)+" ,":'ML1
20100  A$=A$+RIGHT$("  "+STR$(FM_ML2(L)),3)+" ,":'ML2
20110  A$=A$+RIGHT$("   "+STR$(FM_DT(L)),4)+" ,":'DT
20120  A$=A$+STR$(FM_KS(L))                     :'KS
20130  IF FM_EXT(L)<>0 THEN
20140   A$=A$+" ,"
20150   A$=A$+RIGHT$("   "+STR$(FM_SN(L)),4)+" ,":'SN
20160   A$=A$+RIGHT$("   "+STR$(FM_EN(L)),4)+" ,":'EN
20170   A$=A$+RIGHT$( "  "+STR$(FM_VL(L)),3)+" ,":'vl
20180   A$=A$+RIGHT$( "  "+STR$(FM_RE(L)),3)+" ,":'RE
20190 '
20200   A$=A$+RIGHT$( "  "+STR$(FM_LF(L)),3)+" ,":'LF
20210   A$=A$+RIGHT$( "  "+STR$(FM_AW(L)),3)+" ,":'AW
20220   A$=A$+RIGHT$( "  "+STR$(FM_AS(L)),3)+" ,":'AS
20230   A$=A$+RIGHT$( "  "+STR$(FM_PW(L)),3)+" ,":'PW
20240   A$=A$+RIGHT$( "  "+STR$(FM_PS(L)),3)+" ,":'PS
20250   A$=A$+RIGHT$( "  "+STR$(FM_MX(L)),4)+" ,":'MX
20260   A$=A$+RIGHT$( "  "+STR$(FM_DP(L)),4)     :'DP
20270  ENDIF
20280  A$=A$+CHR$(13)+CHR$(10)
20290 NEXT
20300 A$=A$+"ENDLAYER"+CHR$(13)+CHR$(10)
20310 RETURN
20330 *SET_FM1
20340 USERDATA 0,0,"BUILDLAYER"
20350 FOR L=0 TO 3
20360  IF FM_EXT(L)=0 THEN
20370    USERDATA "FM"
20380  ELSE
20390    USERDATA "FMEXT"
20400  ENDIF
20410  USERDATA MID$(STR$(L+1),2),0:'OP#
20420  USERDATA MID$(STR$(FM_W(L)),2),0:'W
20430  USERDATA MID$(STR$(FM_X(L)),2),0:'X
20440  USERDATA MID$(STR$(FM_Y(L)),2),0:'Y
20450  USERDATA MID$(STR$(FM_M(L)),2),0:'M
20460  USERDATA MID$(STR$(FM_S(L)),2),0:'S
20470  USERDATA MID$(STR$(FM_AR(L)),2),0:'AR
20480  USERDATA MID$(STR$(FM_DR(L)),2),0:'DR
20490  USERDATA MID$(STR$(FM_SR(L)),2),0:'SR
20500  USERDATA MID$(STR$(FM_RR(L)),2),0:'RR
20510  USERDATA MID$(STR$(FM_DL(L)),2),0:'SL
20520  USERDATA MID$(STR$(FM_TL(L)),2),0:'TL
20530  USERDATA STR$(FM_ML1(L)),0:'ML1
20540  USERDATA MID$(STR$(FM_ML2(L)),2),0:'ML2
20550  USERDATA STR$(FM_DT(L)),0:'DT
20560  USERDATA STR$(FM_KS(L)),0:'KS
20570  IF FM_EXT(L)<>0 THEN
20580    USERDATA MID$(STR$(FM_SN(L)),2),0:'sn
20590    USERDATA MID$(STR$(FM_EN(L)),2),0:'en
20600    USERDATA MID$(STR$(FM_VL(L)),2),0:'vl
20610    USERDATA MID$(STR$(FM_RE(L)),2),0:'RE
20620    USERDATA MID$(STR$(FM_LF(L)),2),0:'LF
20630    USERDATA MID$(STR$(FM_AW(L)),2),0:'AW
20640    USERDATA MID$(STR$(FM_AS(L)),2),0:'AS
20650    USERDATA MID$(STR$(FM_PW(L)),2),0:'PW
20660    USERDATA MID$(STR$(FM_PS(L)),2),0:'PS
20670    USERDATA MID$(STR$(FM_MX(L)),2),0:'MX
20680    USERDATA MID$(STR$(FM_DP(L)),2),0:'DP
20690  ENDIF
20700 NEXT
20710 USERDATA "ENDLAYER"
20720 USERDATA "ENDARRANGE"
20730 TARG READ
20740 RETURN
20750 '
20760 'FM PARAM INIT
20770 '
20790 *FM_PARAM_INIT
20800 FOR L=0 TO 3
20810  FM_EXT(L)=0  :'FM mode
