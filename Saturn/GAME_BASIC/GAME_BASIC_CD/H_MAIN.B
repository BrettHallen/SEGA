21330 *ENV_DRAW
21340 ACTIVE 0
21350 COLOR,15
21360 LINE (X*8+8,Y*8+8)-(X*8+79+8,Y*8+39+8),8,BF
21370 LINE (X*8+9,Y*8+8)-(X*8+79+8,Y*8+38+8),128,BF
21380 LINE (X*8+9,Y*8+9)-(X*8+78+8,Y*8+38+8),9,BF
21390 PSET (X*8+8,Y*8+38+8)
21400 IF FM_AR(L)=0 THEN
21410  LINE -(X*8+38+8,Y*8+38+8)
21420  RETURN
21430 ELSE
21440  AT=&H400/FM_AR(L)
21450 ENDIF
21460 IF FM_DR(F)=0 THEN
21470  IF FM_DL(L)=0 THEN
21480   DT1=0
21490  ELSE
21500   DT1=AT
21510  ENDIF
21520 ELSE
21530  DT1=(FM_DL(L))*&H10/FM_DR(L)
21540 ENDIF
21550 DT2=(AT+DT1)/2
21560 IF FM_RR(L)=0 THEN
21570  RT=AT/2
21580 ELSE
21590  RT=(&H400-FM_SR(L)*DT2-(FM_DL(L)*&H10))/FM_RR(L)
21600 ENDIF
21610 T=AT+DT1+DT2+RT
21620 'AR
21630 LINE -(X*8+9+AT/T*80,Y*8+9)
21640 'DT1
21650 YY=FM_DL(L)*&H10/&H400*40:IF YY>40 THEN YY=40
21660 LINE -(X*8+9+(AT+DT1)/T*80,Y*8+9+YY)
21670 'DT2
21680 YY=(FM_DL(L)*&H10+DT2*FM_SR(L))/&H400*40:IF YY>40 THEN YY=40
21690 LINE -(X*8+9+(AT+DT1+DT2)/T*80,Y*8+8+YY)
21700 'RR
21710 LINE -(X*8+8+79,Y*8+8+38)
21720 RETURN
21730 '
21750 *WAV_DRAW
21760 ACTIVE 0
21770 LINE (X*8+8,Y*8+8)-(X*8+79+8,Y*8+39+8),8,BF
21780 LINE (X*8+9,Y*8+8)-(X*8+79+8,Y*8+38+8),128,BF
21790 LINE (X*8+9,Y*8+9)-(X*8+78+8,Y*8+38+8),9,BF
21800 LINE (X*8+9,Y*8+9+20)-(X*8+78+8,Y*8+9+20)
21810 ON W+1 GOSUB *LFO0,*LFO1,*LFO2,*LFO3
21820 COLOR,15,9
21830 IF W_MODE=1 THEN KPRINT (X*8+34,Y*8+32),FIX "AW LFO"
21840 IF W_MODE=2 THEN KPRINT (X*8+34,Y*8+32),FIX "PW LFO"
21850 RETURN
21860 '0 SAW
21880 *LFO0
21890 PSET (X*8+9,Y*8+9+20),15
21900 LINE -(X*8+9,Y*8+10),15
21910 LINE -(X*8+78+8,Y*8+37+8),15
21920 LINE -(X*8+78+8,Y*8+9+20),15
21930 RETURN
21940 '1 PLUSE
21960 *LFO1
21970 PSET (X*8+9,Y*8+9+20),15
21980 LINE -(X*8+9,Y*8+10),15
21990 LINE -(X*8+39+8,Y*8+10),15
22000 LINE -(X*8+39+8,Y*8+37+8),15
22010 LINE -(X*8+78+8,Y*8+37+8),15
22020 LINE -(X*8+78+8,Y*8+9+20),15
22030 RETURN
22040 '2 RECT
22060 *LFO2
22070 PSET (X*8+9,Y*8+9+20),15
22080 LINE -(X*8+20+8,Y*8+10),15
22090 LINE -(X*8+60+8,Y*8+37+8),15
22100 LINE -(X*8+78+8,Y*8+9+20),15
22110 RETURN
22120 '3 NOISE
22140 *LFO3
22150 PSET (X*8+8,Y*8+9+20),15
22160 FOR XX=0 TO 79 
22170  LINE -(XX+X*8+8,Y*8+10+RND(37)),15
22180 NEXT
22190 RETURN
22200 '
22210 '0 SIN
22220 PSET (X*8+8,Y*8+9+20),15
22230 FOR XX=0 TO 79 
22240  LINE -(XX+X*8+8,Y*8+38+8-XSIN(XX/79)*18-18),15
22250 NEXT
22260 RETURN
