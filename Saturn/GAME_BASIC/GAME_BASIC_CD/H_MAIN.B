18440 'ウインドウ初期化
18450 RESTORE *FM_WINDATA
18460 FOR X=7 TO 21:FOR Y=0 TO 7:READ WIN(X,Y):NEXT Y,X
18470 GOSUB *SET_SYSMENUPOS
