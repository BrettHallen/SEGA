27280 '--[SYS_INIT]---------------------------
27290 ' ｼｽﾃﾑ ｦ ｼｮｷｶｼﾃﾂｶｴﾙﾖｳﾆｽﾙ
27300 ' WORK :
27310 '    SYS_I,SYS_J,A$
27320 ' RETURN :
27330 '---------------------------------------
27350 *SYS_INIT
27360 DIM EV(255,2)        :'ﾒｯｾｰｼﾞｷｭｰ ﾖｳ
27370 DIM SYS_MES_NAME$(2) :'ﾒｯｾｰｼﾞﾎﾞｯｸｽ ﾉ ﾎﾞﾀﾝﾉ ｷｬﾌﾟｼｮﾝｶｸﾉｳﾖｳ
27380 DIM SYS_DEV$(7)      :'ﾌｧｲﾙｾﾝﾀｸﾃﾞﾊﾞｲｽﾖｳ
27390 PRINT "GAME BASIC for SEGASATURN        "
27395 PRINT "                System for Sofiya"
27400 PRINT "                     Version 1.00"
27410 PRINT :VSYNC 30
27420 SPRWINDOW,,,,,0,0
27430 'ｶｰｿﾙﾖｳﾉ ﾃｸｽﾁｬｦ ｾｯﾃｲｽﾙ
27440 RESTORE *SYS_DATA:READ SYS_K:DIM SYS_PATTERN$(SYS_K+1)
27450 FOR SYS_I=0 TO SYS_K:FOR SYS_J=1 TO 32
27460  READ A$:SYS_PATTERN$(SYS_I)=SYS_PATTERN$(SYS_I)+HEXBIN$(A$)
27470 NEXT :NEXT :A$=""
27480 'ﾒｯｾｰｼﾞﾎﾞｯｸｽﾖｳﾉ ｱｲｺﾝｦ ｾｯﾃｲｽﾙ
27490 READ SYS_K:DIM SYS_MSGICON$(SYS_K)
27500 FOR SYS_I=0 TO SYS_K-1
27520 *SYS_LOP1:READ A$:IF A$<>"ENDTEX" THEN SYS_MSGICON$(SYS_I)=SYS_MSGICON$(SYS_I)+HEXBIN$(A$):GOTO *SYS_LOP1
27530 NEXT :A$=""
27540 GOSUB *SYS_DEVICECHECK
27550 'ｼｽﾃﾑｳｲﾝﾄﾞｳﾖｳﾉﾃｸｽﾁｬｦｶｸﾎｽﾙ
27560 SYS_I=VERTEXID(-1):SETVERTEX,4,(-80,-20,0),(80,-20,0),(80,20,0),(-80,20,0)
27570 SYS_POLYGONID=POLYGONID(-1):SETPOLYGON,1,SYS_I,,(0,1,2,3)
27580 SYS_I=VERTEXID(-1):SETVERTEX,4,(-120,-40,0),(120,-40,0),(120,40,0),(-120,40,0)
27590 SYS_POLYGONID1=POLYGONID(-1):SETPOLYGON,1,SYS_I,,(0,1,2,3)
27600 SYS_TEXID=TEXID(-1):SETTEX,160,40,256
27610 SYS_TEXID1=TEXID(-1):SETTEX,240,80,256
27620 SYS_WINDOW=ATRID(-1):SETATR,1,(0,0,3,SYS_TEXID,0,0)
27630 SYS_WINDOW1=ATRID(-1):SETATR,1,(0,0,3,SYS_TEXID1,0,0)
27640 OBJ(255,0)=7,,,,-10,-10:RETURN
27650 '--[SYS_MOUSEPOINTER]-------------------
27660 ' ﾏｳｽﾎﾟｲﾝﾀ ﾉ ｹｲｼﾞｮｳｦｶｴﾙ
27670 ' ENTRY :
27680 '    MOUSEPOINTER  0  ﾌﾂｳﾉﾎﾟｲﾝﾀ
27690 '                  1  ｼｮﾘﾏﾁﾉﾎﾟｲﾝﾀ
27700 ' WORK :
27710 ' RETURN :
27720 '---------------------------------------
27740 *SYS_MOUSEPOINTER
27750 LOCK
27760 IF MOUSEPOINTER=0 THEN
27770   INTERVAL (1) OFF
27780   SYS_POINTERTYPE=0:SETTEX 0,32,32,16,SYS_PATTERN$(0)
27790 ELSE
27800   INTERVAL (1) ON,5
27810   SYS_POINTERTYPE=1:SYS_POINTERANIME=0:SETTEX 0,32,32,16,SYS_PATTERN$(1)
27820 ENDIF
27830 UNLOCK :RETURN
27850 *SYS_ANIME
27860 IF SYS_POINTERTYPE=1 THEN
27870   LOCK :SETTEX 0,32,32,16,SYS_PATTERN$(SYS_POINTERANIME+1):SYS_POINTERANIME=SYS_POINTERANIME XOR 1:UNLOCK
27880 ENDIF
27890 RETURN
27900 '--[SYS_DEVICECHECK]--------------------
27910 'ﾆｭｳﾘｮｸｿｳﾁ ﾉ ｹﾝｼｭﾂ
27920 '
27930 ' WORK :
27940 '     SYS_I,SYS_J
27950 '
27960 ' RETURN :
27970 '     SPADMODE
27980 '     SKEYMODE
27990 '     SPADNO
28000 '     SKEYNO
28010 '---------------------------------------
28030 *SYS_DEVICECHECK
28040 PRINT "ﾆｭｳﾘｮｸ ｿｳﾁ ｹﾝｼｭﾂ":PRINT
28050 FOR SYS_I=28 TO 0 STEP -1
28060   SYS_J=PAD(SYS_I,0)
28070   IF SYS_J>=&H0  AND SYS_J<=&HF   AND SPADMODE<>2 THEN SPADNO=SYS_I:SPADMODE=1:PRINT "#";SYS_I;" ｺﾝﾄﾛｰﾙﾊﾟｯﾄﾞ ｦ ﾆﾝｼｷｼﾏｼﾀ｡"
28080   IF SYS_J>=&HE0 AND SYS_J<=&HFE THEN SPADNO=SYS_I:SPADMODE=2:PRINT "#";SYS_I;" ｼｬﾄﾙﾏｳｽ ｦ ﾆﾝｼｷｼﾏｼﾀ｡"
28090   IF SYS_J>=&H30 AND SYS_J<=&HDF THEN SKEYNO=SYS_I:SKEYMODE=1:PRINT "#";SYS_I;" ｾｶﾞｻﾀｰﾝｷｰﾎﾞｰﾄﾞ ｦ ﾆﾝｼｷｼﾏｼﾀ｡"
28100 NEXT
28110 IF SPADMODE<>0 THEN
28120   OBJ(1,0)=7:OBJ(1,16)=0,0:OBJ(1,20)=0:OBJ(1,12)=.5,.5
28130   ON INTERVAL (1) GOSUB *SYS_ANIME
28140   IF SPADMODE=1 THEN ON INTERVAL (0) GOSUB *SYS_PAD
28150   IF SPADMODE=2 THEN ON INTERVAL (0) GOSUB *SYS_MOUSE
28160 ENDIF
28170 VSYNC 30:RETURN
28180 '========================
28190 ' ﾊﾟｯﾄﾞﾉ ﾆｭｳﾘｮｸｼｮﾘ
28200 '========================
28210 ' 
28220 ' WORK :
28230 '     MB..PAD         ﾉ ｼﾞｮﾀｲ 
28240 '     MX..ﾏｳｽﾎﾟｲﾝﾀ X ｻﾞﾋｮｳ
28250 '     MY..ﾏｳｽﾎﾟｲﾝﾀ Y ｻﾞﾋｮｳ
28260 '     BR..ﾐｷﾞﾎﾞﾀﾝ (C) ﾉ ｼﾞｮｳﾀｲ
28270 '     BC..ﾏﾝﾅｶﾎﾞﾀﾝ(B) ﾉ ｼﾞｮｳﾀｲ
28280 '     BL..ﾋﾀﾞﾘﾎﾞﾀﾝ(A) ﾉ ｼﾞｮｳﾀｲ
28290 '     BS..ｽﾀｰﾄﾎﾞﾀﾝ    ﾉ ｼﾞｮｳﾀｲ
28300 '
28310 '     MX2..ﾏｳｽﾎﾟｲﾝﾀ X ｻﾞﾋｮｳ (ﾏｴ)
28320 '     MY2..ﾏｳｽﾎﾟｲﾝﾀ Y ｻﾞﾋｮｳ (ﾏｴ)
28330 '     MR..ﾐｷﾞﾎﾞﾀﾝ (C) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28340 '     MC..ﾏﾝﾅｶﾎﾞﾀﾝ(B) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28350 '     ML..ﾋﾀﾞﾘﾎﾞﾀﾝ(A) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28360 '     MS..ｽﾀｰﾄﾎﾞﾀﾝ    ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28370 '
28380 '     TR..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28390 '     TC..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28400 '     TL..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28410 '     TS..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28420 '
28440 *SYS_PAD
28450 LOCK :MB=PAD(SPADNO,1)
28460 IF (MB AND &H40) THEN MV=8 ELSE MV=1
28470 IF (MB AND &H8000) THEN MX=MX+MV+1 ELSE IF (MB AND &H4000) THEN MX=MX-MV-1
28480 IF (MB AND &H2000) THEN MY=MY+MV+1 ELSE IF (MB AND &H1000) THEN MY=MY-MV-1
28490 IF MX<0 THEN MX=0 ELSE IF MX>319 THEN MX=319
28500 IF MY<0 THEN MY=0 ELSE IF MY>223 THEN MY=223
28510 OBJ(1,4)=MX,MY
28520 BR=MB AND &H200:BC=MB AND &H100:BL=MB AND &H400:BS=MB AND &H800
28530 IF MX2<>MX OR MY2<>MY THEN EV(EW,0)=-2:GOSUB *QIN:MX2=MX:MY2=MY
28540 IF MR AND BR=0 THEN EV(EW,0)=5:GOSUB *QIN
28550 IF (MR=0) AND BR THEN EV(EW,0)=4:GOSUB *QIN:TR=15 ELSE TR=TR+(TR>0)
28560 IF (BR=0) AND MR AND TR>1 THEN EV(EW,0)=6:GOSUB *QIN:TR=0
28570 IF ML AND BL=0 THEN EV(EW,0)=1:MDC1L=0:GOSUB *QIN
28580 IF (ML=0) AND BL THEN EV(EW,0)=0:GOSUB *QIN:TL=14:MDXL=MX:MDYL=MY ELSE TL=TL+(TL>0):IF TL=0 THEN MDCL=0
28590 IF (BL=0) AND ML AND (TL>1) AND MDC1L=0 THEN
28600   IF (ABS(MDXL-MX)<=2) AND ABS(MDYL-MY)<=2 THEN
28610     MDCL=MDCL+1:MDC1L=1
28620     IF MDCL=1 THEN EV(EW,0)=2:GOSUB *QIN
28630     IF MDCL=2 THEN EV(EW,0)=3:GOSUB *QIN:TL=0
28640   ELSE
28650     MDC1L=0:TL=0
28660   ENDIF
28670 ENDIF
28680 '
28690 IF MC AND BC=0 THEN EV(EW,0)=9:GOSUB *QIN
28700 IF (MC=0) AND BC THEN EV(EW,0)=8:GOSUB *QIN:TC=15:MDXC=MX:MDYC=MY ELSE TC=TC+(TC>0)
28710 IF (BC=0) AND MC AND (TC>1) AND (ABS(MDXC-MX)<=2) AND ABS(MDYC-MY)<=2 THEN EV(EW,0)=10:GOSUB *QIN:TC=0
28720 IF (MS=0) AND BS THEN TS=15 ELSE TS=TS+(TS>0)
28730 IF (BS=0) AND MS AND TS>1 THEN TS=0:EV(EW,0)=12:GOSUB *QIN
28740 MR=BR:ML=BL:MC=BC:MS=BS:UNLOCK :RETURN
28750 '========================
28760 ' ﾏｳｽ ﾉ ﾆｭｳﾘｮｸ ｼｮﾘ
28770 '========================
28780 '
28790 ' WORK :
28800 '     MB..PAD         ﾉ ｼﾞｮﾀｲ 
28810 '     MX..ﾏｳｽﾎﾟｲﾝﾀ X ｻﾞﾋｮｳ
28820 '     MY..ﾏｳｽﾎﾟｲﾝﾀ Y ｻﾞﾋｮｳ
28830 '     BR..ﾐｷﾞﾎﾞﾀﾝ (C) ﾉ ｼﾞｮｳﾀｲ
28840 '     BC..ﾏﾝﾅｶﾎﾞﾀﾝ(B) ﾉ ｼﾞｮｳﾀｲ
28850 '     BL..ﾋﾀﾞﾘﾎﾞﾀﾝ(A) ﾉ ｼﾞｮｳﾀｲ
28860 '     BS..ｽﾀｰﾄﾎﾞﾀﾝ    ﾉ ｼﾞｮｳﾀｲ
28870 '
28880 '     MX2..ﾏｳｽﾎﾟｲﾝﾀ X ｻﾞﾋｮｳ (ﾏｴ)
28890 '     MY2..ﾏｳｽﾎﾟｲﾝﾀ Y ｻﾞﾋｮｳ (ﾏｴ)
28900 '     MR..ﾐｷﾞﾎﾞﾀﾝ (C) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28910 '     MC..ﾏﾝﾅｶﾎﾞﾀﾝ(B) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28920 '     ML..ﾋﾀﾞﾘﾎﾞﾀﾝ(A) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28930 '     MS..ｽﾀｰﾄﾎﾞﾀﾝ    ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28940 '
28950 '     TR..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28960 '     TC..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28970 '     TL..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28980 '     TS..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28990 '
29010 *SYS_MOUSE
29020 LOCK :MX1=PAD(SPADNO,3):MY1=PAD(SPADNO,4)
29030 MXV=MX1-MX0:IF MXV<-384 THEN MXV=65535-MX0+MX1 ELSE IF MXV>384 THEN MXV=65535+MX0-MX1
29040 MYV=MY1-MY0:IF MYV<-384 THEN MYV=65535-MY0+MY1 ELSE IF MYV>384 THEN MYV=65535+MY0-MY1
29050 MX=MX+MXV:MY=MY+MYV
29060 IF MX<0 THEN MX=0 ELSE IF MX>319 THEN MX=319
29070 IF MY<0 THEN MY=0 ELSE IF MY>223 THEN MY=223
29080 OBJ(1,4)=MX,MY
29090 MX0=MX1:MY0=MY1
29100 MB=PAD(SPADNO,1):BR=MB AND &H200:BC=MB AND &H100:BL=MB AND &H400:BS=MB AND &H800
29110 IF MX2<>MX OR MY2<>MY THEN EV(EW,0)=-2:GOSUB *QIN_M:MX2=MX:MY2=MY
29120 IF MR AND BR=0 THEN EV(EW,0)=5:GOSUB *QIN
29130 IF MR=0 AND BR THEN EV(EW,0)=4:GOSUB *QIN:TR=15 ELSE TR=TR+(TR>0)
29140 IF BR=0 AND MR AND TR>1 THEN EV(EW,0)=6:GOSUB *QIN:TR=0
29150 IF ML AND BL=0 THEN EV(EW,0)=1:MDC1L=0:GOSUB *QIN
29160 IF BL AND ML=0 THEN EV(EW,0)=0:GOSUB *QIN:TL=14:MDXL=MX:MDYL=MY ELSE TL=TL+(TL>0):IF TL=0 THEN MDCL=0
29170 IF ML AND BL=0 AND TL>1 AND MDC1L=0 THEN
29180   IF ABS(MDXL-MX)<=2 AND ABS(MDYL-MY)<=2 THEN
29190     MDCL=MDCL+1:MDC1L=1
29200     IF MDCL=1 THEN EV(EW,0)=2:GOSUB *QIN
29210     IF MDCL=2 THEN EV(EW,0)=3:GOSUB *QIN:TL=0
29220   ELSE
29230       MDC1L=0:TL=0
29240   ENDIF
29250 ENDIF
29260 IF MC AND BC=0 THEN EV(EW,0)=9:GOSUB *QIN
29270 IF MC=0 AND BC THEN EV(EW,0)=8:GOSUB *QIN:TC=15 ELSE TC=TC+(TC>0)
29280 IF BC=0 AND MC AND TC>1 THEN EV(EW,0)=10:GOSUB *QIN:TC=0
29290 IF MS=0 AND BS THEN TS=15 ELSE TS=TS+(TS>0)
29300 IF BS=0 AND MS AND TS>1 THEN TS=0:EV(EW,0)=12:GOSUB *QIN
29310 MR=BR:ML=BL:MC=BC:MS=BS:UNLOCK :RETURN
29320 'ﾒｯｾｰｼﾞ ｷｭｰ ﾆ ﾒｯｾｰｼﾞ ｦ ｶｷｺﾑ
29340 *QIN_M
29350 IF EW<>0 THEN
29360  IF EV(EW-1,0)=-2 THEN EW=EW-1
29370 ELSE
29380  IF EV(255,0)=-2 THEN EW=255
29390 ENDIF
29410 *QIN:EV(EW,1)=MX:EV(EW,2)=MY:EW=(EW+1) AND 255:RETURN
29420 'ﾒｯｾｰｼﾞ ｷｭｰ ｶﾗ ﾒｯｾｰｼﾞｦ ﾖﾐｺﾑ
29440 *QOUT
29450 MMF$=INKEY$:IF MMF$<>"" THEN EVENT=-3:MMF=1:EVENTX=ASC(MMF$):RETURN
29460 IF MMF$="" AND MMF=1 THEN MMF=0:EVENT=-3:EVENTX=-1:RETURN
29470 IF ER=EW GOTO *QOUT
29480 EVENT=EV(ER,0):EVENTX=EV(ER,1):EVENTY=EV(ER,2):EV(ER,0)=-99:ER=(ER+1) AND 255:RETURN
29500 *QOUT1:IF ER=EW THEN RETURN
29510 EVENT=EV(ER,0):EVENTX=EV(ER,1):EVENTY=EV(ER,2):ER=(ER+1) AND 255:RETURN
29520 'ﾒｯｾｰｼﾞ ｷｭｰ ｦｸﾘｱｽﾙ
29540 *QCLEAR:LOCK :ER=EW:UNLOCK :RETURN
29550 '--[SYS_DEVICECHECK]--------------------
29560 'ﾒｯｾｰｼﾞﾎﾞｯｸｽｦﾋｮｳｼﾞｽﾙ
29570 '
29580 ' ENTRY :
29590 '     SYS_MES_TITLE$   ﾀｲﾄﾙﾆﾋｮｳｼﾞｽﾙ ﾓｼﾞﾚﾂ
29600 '     SYS_MES_MESSAGE$ ﾋｮｳｼﾞｽﾙﾒｯｾｰｼﾞ
29610 '     SYS_MES_MODE
29620 '            1 ... ｶｲﾃﾝ  ﾋｮｳｼﾞ
29630 '            2 ... ｶｸﾀﾞｲ ﾋｮｳｼﾞ
29640 '            3 ... ---- (ｶｸﾁｮｳ ﾖｳ)
29650 '            4 ... ｵﾄｦ ﾀﾞｻﾅｲ
29660 '          5-7 ... ｱｲｺﾝﾉｼｭﾙｲ
29670 '                  0..ﾅｼ
29680 '                  1..ｹｲｺｸ
29690 '                  2..ﾄｲｶｹ
29700 '                  3..ｷｹﾝ(?)
29710 '                  4..----
29720 '                  5..----
29730 '                  6..----
29740 '                  7..----
29750 '          8-9 ... ﾎﾞﾀﾝ
29760 '                  0..ﾅｼ(ﾔｸ2ﾋﾞｮｳｶﾝﾋｮｳｼﾞ)
29770 '                  1..1ｺ
29780 '                  2..2ｺ
29790 '                  3..---
29800 ' WORK :
29810 '     SYS_I,SYS_J
29820 ' RETURN :
29830 '---------------------------------------
29850 *SYS_MESSAGEBOX
29860 SYS_OBJ=255
29870 GOSUB *SYS_MES_DRAW
29880 GOSUB *SYS_MES_SHOW
29890 'ﾆｭｳﾘｮｸﾏﾁ
29900 SYS_J=0
29910 IF SYS_MES_MODE AND &H180 THEN
29920   GOSUB *QCLEAR
29940 *SYS_MES_LOOP00
29950   GOSUB *QOUT 
29960   IF SYS_J<>0 THEN
29970     IF EVENT=1 THEN
29980       SYS_I=SYS_J-1:SYS_B=0:GOSUB *SYS_MES_BUTTONSUB
29990       IF ABS(EVENTX-209+SYS_I*56)<=25 AND ABS(EVENTY-124)<=5 THEN
30000         OBJ(SYS_OBJ,20)=SYS_OBJ:VSYNC :GOTO *QCLEAR
30010       ENDIF
30020       SYS_J=0
30030     ENDIF
30040     GOTO *SYS_MES_LOOP00
30050   ENDIF
30060   IF ABS(EVENTX-160)>80 OR ABS(EVENTY-112)>20 THEN
30070     IF MOUSEPOINTER=0 THEN MOUSEPOINTER=1:GOSUB *SYS_MOUSEPOINTER
30080     IF (EVENT MOD 4)=0 THEN BGM 0
30090     GOTO *SYS_MES_LOOP00
30100   ENDIF
30110   'ﾎﾞﾀﾝﾋｯﾄﾁｪｯｸ
30120   IF EVENT=0 AND ABS(EVENTY-124)<=5 THEN
30130     FOR SYS_I=0 TO (SYS_MES_MODE AND &H180)/&H80-1
30140       IF ABS(EVENTX-209+SYS_I*56)<=25 THEN SYS_B=1:GOSUB *SYS_MES_BUTTONSUB:SYS_J=SYS_I+1
30150     NEXT
30160   ENDIF
30170   IF SYS_J=0 AND MOUSEPOINTER=1 THEN MOUSEPOINTER=0:GOSUB *SYS_MOUSEPOINTER
30180   GOTO *SYS_MES_LOOP00
30190 ENDIF
30200 SYS_I=MOUSEPOINTER
30210 MOUSEPOINTER=1:GOSUB *SYS_MOUSEPOINTER:VSYNC 120
30220 MOUSEPOINTER=SYS_I:GOSUB *SYS_MOUSEPOINTER
30230 OBJ(SYS_OBJ,20)=SYS_OBJ:VSYNC :GOTO *QCLEAR
30240 '
30260 *SYS_MES_BUTTONSUB
30270 SYS_MES$=SYS_MES_NAME$(SYS_I):SYS_X=104-SYS_I*56:GOTO *SYS_DRAW_BUTTON
30280 '
30300 *SYS_MES_SHOW
30310 SYS_I=1-(SYS_MES_MODE AND &H1):OBJ(SYS_OBJ,10)=0,,SYS_I,SYS_I
30320 IF SYS_MES_MODE AND &H3 THEN
30330   OBJ(SYS_OBJ,20)=0
30340   FOR SYS_I=0 TO 29
30350     IF SYS_MES_MODE AND &H1 THEN OBJ(SYS_OBJ,12)=SYS_I/29,SYS_I/29
30360     IF SYS_MES_MODE AND &H2 THEN OBJ(SYS_OBJ,10)=SYS_I/29
30370     VSYNC
30380   NEXT
30390 ENDIF
30400 IF (SYS_MES_MODE AND &H8)=0 THEN BGM 0
30410 OBJ(SYS_OBJ,20)=0:FOR SYS_I=0 TO 8:OBJ(SYS_OBJ,12)=1+(SYS_I AND 3)/160,1+(SYS_I AND 3)/160:VSYNC :NEXT :RETURN
30420 '
30440 *SYS_MES_DRAW
30450 OBJ(SYS_OBJ,4)=-1000,-1000:OBJ(SYS_OBJ,16)=SYS_WINDOW,SYS_POLYGONID
30460 ACTIVE 10+SYS_TEXID
30470 SYS_X=0:SYS_Y=0:SYS_SX=159:SYS_SY=39:SYS_B=0:SYS_MES$="":GOSUB *SYS_DRAW_BUTTON
30480 SYS_Y=28:SYS_SX=50:SYS_SY=10:COLOR,15,8
30490 IF SYS_MES_MODE AND &H70 THEN
30500   IF (SYS_MES_MODE AND &H70)<=&H30 THEN GCOPY SYS_MSGICON$((SYS_MES_MODE AND &H70)/&H10-1) TO (4,4)
30510   KPRINT (40,2,0,-8,-8),FIX SYS_MES_TITLE$
30520 ELSE
30530   KPRINT (8,2,0,-8,-8),FIX SYS_MES_TITLE$
30540 ENDIF
30550 KPRINT FIX SYS_MES_MESSAGE$
30560 IF SYS_MES_MODE AND &H180 THEN
30570   FOR SYS_I=0 TO (SYS_MES_MODE AND &H180)/&H80-1
30580     SYS_MES$=SYS_MES_NAME$(SYS_I):SYS_X=104-SYS_I*56:GOSUB *SYS_DRAW_BUTTON
30590   NEXT
30600 ENDIF
30610 OBJ(SYS_OBJ,4)=160,112:RETURN
30620 '------------------------------
30630 'ﾌｧｲﾙｾﾝﾀｸ ﾀﾞｲｱﾛｸﾞｦﾋｮｳｼﾞｽﾙ
30640 '------------------------------
30660 *SYS_FILESELECT
30670 SYS_DEV$(0)="BRAM":SYS_DEV$(1)="CRAM":SYS_DEV$(2)="FD0":SYS_DEV$(3)="FD1":SYS_DEV$(4)="COM":SYS_DEV$(5)="CD"
30680 OBJ(254,16)=SYS_WINDOW1,SYS_POLYGONID1:OBJ(254,4)=160,112,0:OBJ(254,20)=0:OBJ(254,0)=7
30690 ACTIVE 10+SYS_TEXID1
30700 SYS_X=0:SYS_Y=0:SYS_SX=239:SYS_SY=79:SYS_B=0:SYS_MES$="":GOSUB *SYS_DRAW_BUTTON
30710 GOSUB *SYS_FLS_BUTTONDRAW:GOSUB *SYS_FLS_FILEDRAW
30720 SYS_X=184:SYS_Y=50:SYS_SX=52:SYS_SY=10:SYS_B=0:SYS_MES$="Ok":GOSUB *SYS_DRAW_BUTTON
30730 SYS_Y=64:SYS_MES$="Cancel":GOSUB *SYS_DRAW_BUTTON
30740 GOSUB *QCLEAR:SYS_CAPTURE=-1
30760 *SYS_FLS_LOP00
30770 GOSUB *QOUT
30780 IF SYS_CAPTURE=0 THEN GOSUB *SYS_FLS_UP:GOTO *SYS_FLS_LOP00
30790 IF SYS_CAPTURE=1 THEN GOSUB *SYS_FLS_DOWN:GOTO *SYS_FLS_LOP00
30800 IF SYS_CAPTURE=2 THEN GOSUB *SYS_FLS_OK:IF FLAG_CLICK=1 THEN GOTO *SYS_FLS_EXIT ELSE GOTO *SYS_FLS_LOP00
30810 IF SYS_CAPTURE=3 THEN GOSUB *SYS_FLS_CANCEL:IF FLAG_CLICK=1 THEN GOTO *SYS_FLS_EXIT ELSE GOTO *SYS_FLS_LOP00
30820 'HIT CHECK
30830 IF (EVENTX>226) AND EVENTX<278 THEN
30840   FLAG_CLICK=0
30850   IF (EVENTY>=123) AND EVENTY<=133 THEN GOSUB *SYS_FLS_OK
30860   IF (EVENTY>=137) AND EVENTY<=147 THEN GOSUB *SYS_FLS_CANCEL
30870 ENDIF
30880 IF (LEN(SYS_A$)>238) AND (EVENTX>=223) AND EVENTX<=235 THEN
30890   IF (EVENTY>=89)  AND EVENTY<=101 THEN GOSUB *SYS_FLS_UP:GOTO *SYS_FLS_LOP00
30900   IF (EVENTY>=102) AND EVENTY<=114 THEN GOSUB *SYS_FLS_DOWN:GOTO *SYS_FLS_LOP00
30910 ENDIF
30920 '
30930 IF EVENT=0 THEN
30940   IF (EVENTY>=77) AND (EVENTY<=86) AND INT((EVENTX-43)/32)<=5 THEN
30950     SYS_FLS_SEL=0:SYS_BASE=0
30960     IF INT((EVENTX-43)/32)<>SYS_TEMP THEN
30970       SYS_TEMP=INT((EVENTX-43)/32)
30980       GOSUB *SYS_FLS_BUTTONDRAW
30990     ENDIF
31000     GOSUB *SYS_FLS_FILEDRAW
31010   ENDIF
31020   IF (EVENTY>=90) AND (EVENTY<=145) AND (EVENTX>=44) AND EVENTX<=220 THEN
31030     SYS_FLS_SEL=INT((EVENTY-90)/8)*2-(EVENTX>=132)+SYS_BASE
31040     GOSUB *SYS_FLS_FILEDRAW1
31050     IF MID$(SYS_A$,SYS_FLS_SEL*17+1,10)="*ｼﾝｷ ｻｸｾｲ*" THEN
31060       SYS_X=7+(SYS_FLS_SEL AND 1)*88:SYS_Y=20+INT((SYS_FLS_SEL-SYS_BASE)/2)*8:GOSUB *SYS_FILENAMEINPUT
31070       IF SYS_CU=0 THEN SYS_FILENAME$=FILENAME$:GOTO *SYS_FLS_EXIT
31080       GOSUB *SYS_FLS_FILEDRAW:SYS_FILENAME$=""
31090       GOSUB *QCLEAR
31100     ENDIF
31110   ENDIF
31120 ENDIF
31130 'ﾀﾞﾌﾞﾙｸﾘｯｸ ﾉ ｼｮﾘ
31140 IF EVENT=3 THEN
31150   IF (EVENTY>=90) AND (EVENTY<=145) AND (EVENTX>=44) AND EVENTX<=220 THEN
31160     SYS_FLS_SEL=INT((EVENTY-90)/8)*2-(EVENTX>=132)+SYS_BASE
31170     GOSUB *SYS_FLS_FILEDRAW1
31180     FLAG_CLICK=1:GOSUB *SYS_FLS_OK1:GOTO *SYS_FLS_EXIT
31190   ENDIF
31200 ENDIF
31210 GOTO *SYS_FLS_LOP00
31230 *SYS_FLS_EXIT
31240 OBJ(254,20)=254
31250 GOSUB *QCLEAR
31260 RETURN
31280 *SYS_FLS_FILEDRAW
31290 SYS_X=2:SYS_Y=18:SYS_SX=176:SYS_SY=58:SYS_B=1:SYS_MES$="":GOSUB *SYS_DRAW_BUTTON
31300 ON ERROR GOTO *SYS_FLS_ERR1:SYS_DEV$=SYS_DEV$(SYS_TEMP)+":":IF SYS_EXT=0 THEN SYS_B$=""
31310 IF PASS_LEVEL=0 AND SYS_EXT=1 THEN SYS_A$=SYS_B$ ELSE SYS_A$=SYS_B$+FILES$(SYS_DEV$+"*.D")
31320 IF (SYS_TEMP<>5) AND SYS_SAVEFLAG=1 THEN SYS_A$=SYS_A$+"*ｼﾝｷ ｻｸｾｲ*       "
31340 *SYS_FLS_EXIT1:ON ERROR GOTO 0
31360 *SYS_FLS_FILEDRAW1
31370 IF LEN(SYS_A$)>17*14+1 THEN
31380   SYS_X=181:SYS_Y=18:SYS_SX=12:SYS_SY=12:SYS_B=0:SYS_MES$=CHR$(250):GOSUB *SYS_DRAW_BUTTON
31390   SYS_Y=32:SYS_MES$=CHR$(251):GOSUB *SYS_DRAW_BUTTON
31400 ELSE
31410   LINE (181,18)-(193,44),8,BF
31420 ENDIF
31430 COLOR,1
31440 FOR SYS_I=0 TO 13
31450   COLOR,,14+(SYS_I<>SYS_FLS_SEL-SYS_BASE)*6
31460   IF MID$(SYS_A$,(SYS_I+SYS_BASE)*17+1,10)="*ｼﾝｷ ｻｸｾｲ*" THEN COLOR,4 ELSE COLOR,1
31470   KPRINT (7+(SYS_I AND 1)*88,20+INT(SYS_I/2)*8,0,-8,-8),FIX RIGHT$("          "+MID$(SYS_A$,(SYS_I+SYS_BASE)*17+1,10),10)
31480 NEXT
31490 COLOR,,-1
31500 RETURN
31520 *SYS_FLS_UP
31530 SYS_I=0
31540 SYS_X=181:SYS_Y=18:SYS_SX=12:SYS_SY=12:SYS_MES$=CHR$(250):GOSUB *DEF_BTN_FLS
31550 IF FLAG_CLICK=1 THEN
31560   SYS_BASE=SYS_BASE+(SYS_BASE>1)*2
31570   IF SYS_FLS_SEL>(SYS_BASE+13) THEN SYS_FLS_SEL=SYS_BASE+12+(SYS_FLS_SEL AND 1)
31580   GOSUB *SYS_FLS_FILEDRAW1
31590 ENDIF
31600 RETURN
31620 *SYS_FLS_DOWN
31630 SYS_I=1
31640 SYS_X=181:SYS_Y=32:SYS_SX=12:SYS_SY=12:SYS_MES$=CHR$(251):GOSUB *DEF_BTN_FLS
31650 IF (FLAG_CLICK=1) AND (LEN(SYS_A$)/17-14)>SYS_BASE THEN
31660   SYS_BASE=SYS_BASE+2:IF SYS_FLS_SEL<SYS_BASE THEN SYS_FLS_SEL=SYS_BASE+(SYS_FLS_SEL AND 1)
31670   GOSUB *SYS_FLS_FILEDRAW1
31680 ENDIF
31690 RETURN
31710 *SYS_FLS_OK
31720 SYS_I=2
31730 SYS_X=184:SYS_Y=50:SYS_SX=52:SYS_SY=10:SYS_MES$="Ok":GOSUB *DEF_BTN_FLS
31750 *SYS_FLS_OK1
31760 IF FLAG_CLICK=1 THEN SYS_FILENAME$=MID$(SYS_A$,SYS_FLS_SEL*17+1,10):IF SYS_FILENAME$="*ｼﾝｷ ｻｸｾｲ*" THEN SYS_FILENAME$=""
31770 RETURN
31790 *SYS_FLS_CANCEL
31800 SYS_I=3
31810 SYS_X=184:SYS_Y=64:SYS_SX=52:SYS_SY=10:SYS_MES$="Cancel":GOSUB *DEF_BTN_FLS
31820 IF FLAG_CLICK=1 THEN SYS_FILENAME$=""
31830 RETURN
31840 'ﾎﾞﾀﾝﾉﾋﾞｮｳｶﾞ
31860 *SYS_FLS_BUTTONDRAW
31870 FOR SYS_I=0 TO 5:SYS_B=-(SYS_TEMP=SYS_I):GOSUB *SYS_FLS_BUTTONSUB1:NEXT :RETURN
31890 *SYS_FLS_ERR1
31900 SYS_A$="":BEEP
31910 RESUME *SYS_FLS_EXIT1
31930 *SYS_FLS_ERR0
31940 SYS_MES_TITLE$="ｴﾗｰｶﾞﾊｯｾｲｼﾏｼﾀ"
31950 SYS_MES_MESSAGE$="ERROR No."+STR$(ERR)+CHR$(13)+CHR$(10)
31960 SYS_MES_MODE=&B100110011
31970 SYS_MES_NAME$(0)="ﾁｭｳｼ"
31980 SYS_MES_NAME$(1)="ｻｲｼｺｳ"
31990 GOSUB *SYS_MESSAGEBOX
32000 IF SYS_I=1 THEN RESUME ELSE RESUME *SYS_FLS_EXIT
32020 *SYS_FLS_BUTTONSUB1
32030 SYS_MES$=SYS_DEV$(SYS_I)
32040 SYS_X=SYS_I*32+3:SYS_Y=4:SYS_SX=32:SYS_SY=10:GOSUB *SYS_DRAW_BUTTON
32050 RETURN
32060 '
32070 'ﾎﾞﾀﾝｦ ﾋﾞｮｳｶﾞｽﾙ
32080 '
32100 *SYS_DRAW_BUTTON
32110 COLOR,15,8
32120 LINE (SYS_X,SYS_Y)-(SYS_X+SYS_SX,SYS_Y+SYS_SY),7-(SYS_B<>0)*8,B
32130 LINE (SYS_X+1,SYS_Y)-(SYS_X+SYS_SX,SYS_Y+SYS_SY-1),15+(SYS_B<>0)*8,B
32140 LINE (SYS_X+1,SYS_Y+1)-(SYS_X+SYS_SX-1,SYS_Y+SYS_SY-1),8,BF
32150 KPRINT (SYS_X+1-SYS_B+(SYS_SX-LEN(SYS_MES$)*8)/2,SYS_Y+1+SYS_B,0,-8,-8),FIX SYS_MES$
32160 RETURN
32180 *DEF_BTN_FLS
32190 FLAG_CLICK=0
32200 IF SYS_CAPTURE=SYS_I AND SYS_X<=(EVENTX-40) AND (SYS_X+SYS_SX)>=(EVENTX-40) AND SYS_Y<=(EVENTY-72) AND (SYS_Y+SYS_SY)>=(EVENTY-72) AND EVENT=1 THEN
32210   SYS_CAPTURE=-1
32220   SYS_B=0
32230   GOSUB *SYS_DRAW_BUTTON
32240   FLAG_CLICK=1
32250   RETURN
32260 ENDIF
32270 IF EVENT=1 THEN SYS_CAPTURE=-1:SYS_B=0:GOSUB *SYS_DRAW_BUTTON:RETURN
32280 IF (EVENT=0) AND SYS_CAPTURE=-1 THEN SYS_CAPTURE=SYS_I:SYS_B=1:GOSUB *SYS_DRAW_BUTTON:RETURN
32290 RETURN
32300 '
32320 *SYS_FILENAMEINPUT
32330 SYS_CU=1:SYS_C=1:SYS_C$="_0123456789ABCDEFGHIJLKMNOPQRSTUVWXYZ"
32340 FILENAME$="_       .D"
32360 *SYS_KEYCLEAR:IF INKEY$<>"" GOTO *SYS_KEYCLEAR
32370 GOSUB *QCLEAR
32380 SYS_X1=SYS_X:SYS_Y1=SYS_Y
32400 *FILESELECTLOP
32410 COLOR,1,14
32420 KPRINT (SYS_X1,SYS_Y1,0,-8,-8),FIX FILENAME$
32430 IF SKEYMODE=0 THEN
32440   COLOR,4
32450   KPRINT (SYS_X1+(SYS_CU-1)*8,SYS_Y1,0,-8,-8),FIX MID$(FILENAME$,SYS_CU,1)
32460   COLOR,1
32470   GOSUB *QOUT
32480   IF EVENT=6 THEN
32490     SYS_C=SYS_C+1:IF SYS_C>LEN(SYS_C$) THEN SYS_C=1
32500     MID$(FILENAME$,SYS_CU,1)=MID$(SYS_C$,SYS_C,1)
32510   ENDIF
32520   IF EVENT=10 THEN
32530     IF SYS_CU=1 THEN RETURN
32540     IF SYS_CU>1 THEN MID$(FILENAME$,SYS_CU,1)=" ":SYS_CU=SYS_CU-1:SYS_C=INSTR(SYS_C$,MID$(FILENAME$,SYS_CU,1))
32550   ENDIF
32560   IF (EVENT=0) AND SYS_CU<8 THEN SYS_CU=SYS_CU+1:MID$(FILENAME$,SYS_CU,1)=MID$(SYS_C$,SYS_C,1)
32570   IF EVENT=12 THEN SYS_CU=0:RETURN :' OK
32580 ELSE
32590   GOSUB *QOUT1
32600   SYS_K$=INKEY$
32610    'ｶｰｿﾙ ﾉ ｼｮﾘ
32620   IF SYS_CAPTURE=2 THEN GOSUB *SYS_FLS_OK_ENT    :IF FLAG_CLICK=1 THEN SYS_K$=CHR$(13)
32630   IF SYS_CAPTURE=3 THEN GOSUB *SYS_FLS_CANCEL_ENT:IF FLAG_CLICK=1 THEN SYS_K$=CHR$(27)
32640   'HIT CHECK
32650   IF (EVENTX>226) AND (EVENTX<278) AND SYS_CAPTURE=-1 THEN
32660     FLAG_CLICK=0
32670     IF (EVENTY>=123) AND EVENTY<=133 THEN GOSUB *SYS_FLS_OK_ENT    :IF FLAG_CLICK=1 THEN SYS_K$=CHR$(13)
32680     IF (EVENTY>=137) AND EVENTY<=147 THEN GOSUB *SYS_FLS_CANCEL_ENT:IF FLAG_CLICK=1 THEN SYS_K$=CHR$(27)
32690   ENDIF
32700   'ｷｰﾎﾞｰﾄﾞ ﾉ ｼｮﾘ
32710   IF SYS_K$="" GOTO *FILESELECTLOP
32715   IF SYS_K$>="a" AND SYS_K$<="z" THEN SYS_K$=CHR$(ASC(SYS_K$)-ASC("a")+ASC("A"))
32720   IF INSTR(SYS_C$,SYS_K$)<>0 THEN
32730     IF SYS_CU<=8 THEN MID$(FILENAME$,SYS_CU,1)=SYS_K$
32740     SYS_CU=SYS_CU-(SYS_CU<9)
32750   ENDIF
32760   IF SYS_K$=CHR$(8) OR SYS_K$=CHR$(29) THEN
32770     IF SYS_CU>1 THEN SYS_CU=SYS_CU-1:MID$(FILENAME$,SYS_CU,1)=" "
32780   ENDIF
32790   IF SYS_K$=CHR$(13) THEN SYS_CU=0:RETURN :' OK
32800   IF SYS_K$=CHR$(27) THEN SYS_CU=1:RETURN :' CANCEL
32810 ENDIF
32820 GOTO *FILESELECTLOP
32840 *SYS_FLS_OK_ENT    :SYS_I=2:SYS_X=184:SYS_Y=50:SYS_SX=52:SYS_SY=10:SYS_MES$="Ok"    :GOTO *DEF_BTN_FLS
32860 *SYS_FLS_CANCEL_ENT:SYS_I=3:SYS_X=184:SYS_Y=64:SYS_SX=52:SYS_SY=10:SYS_MES$="Cancel":GOTO *DEF_BTN_FLS
32870 '
