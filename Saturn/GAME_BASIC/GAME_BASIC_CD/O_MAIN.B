10850 *IN_TEMPO
10860 IF EVENT<>2 THEN RETURN
10870 IF SC_MODE=0 THEN X=2:Y=2 ELSE X=7:Y=1
10880 A$="0123456789":RET$=RIGHT$("000"+MID$(STR$(S_TEMPO),2),3):ED=1:S=3:GOSUB *TEXT_INPUT_L:S_TEMPO=VAL(RET$)
10890 IF S_TEMPO<40 THEN S_TEMPO=40 ELSE IF S_TEMPO>300 THEN S_TEMPO=300
10900 GOTO *DRAW_TEMPO
