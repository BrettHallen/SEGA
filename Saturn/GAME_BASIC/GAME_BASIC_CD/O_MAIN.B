11950 *DRAW5000:PALETTE 1,30,RGB(28,28,29),RGB(10,10,31)
11960 GOSUB *GRID_OFF
11970 LOCK :ACTIVE 30:ACTIVE 1
11980 FOR I=0 TO 31:PALETTE 1,I+32,0:LINE (I*8+TAMA_X,0)-(I*8+TAMA_X,223),31:LINE (I*8+TAMA_X+1,0)-(I*8+TAMA_X+7,223),I+32,BF:NEXT
11990 FOR I=0 TO 4:LINE (0,TAMA_Y-I*6-6)-(320,TAMA_Y-I*6-6),30:LINE (0,TAMA_Y+I*6+18)-(320,TAMA_Y+I*6+18),30:NEXT
12000 FOR I=5 TO 16:LINE (TAMA_X,TAMA_Y-I*6-6)-(TAMA_X+255,TAMA_Y-I*6-6),31:NEXT :'ｳｴｶﾞﾜ
12010 FOR I=5 TO 10:LINE (TAMA_X,TAMA_Y+I*6+18)-(TAMA_X+255,TAMA_Y+I*6+18),31:NEXT :'ｼﾀｶﾞﾜ
12020 OBJ(220,0)=7,,,,0, 74,,,,,,,.8,.653,,,123,123,,,0
12030 OBJ(221,0)=7,,,,0,122,,,,,,,.8,.653,,,124,124,,,0
12040 UNLOCK :RETURN
