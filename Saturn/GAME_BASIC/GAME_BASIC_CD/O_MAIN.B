 3220 '--------
 3230 'ﾌﾚｰｽﾞ+1
 3240 '--------
 3260 *MV_FR_PLUS
 3270 IF G_FR>=MAX_F THEN
 3280  SYS_MES_TITLE$="ｼｮｳｾﾂｽｳ":SYS_MES_MESSAGE$=STR$(MAX_F)+"ｼｮｳｾﾂ"+CHR$(13)+CHR$(10)+"ﾏﾃﾞﾃﾞｽ"
 3290  SYS_MES_MODE=&B11010:GOSUB *SYS_MESSAGEBOX:COLOR,0,0
 3300  RETURN
 3310 ENDIF
 3320 DA_CH=G_TR:DA_FR=G_FR:GOSUB *PUT_TRACK_OTO
 3330 G_FR=G_FR+1
 3340 IF G_FR>=G_MAX_FR(G_TR) THEN
 3350  TMP=ED_TAMA(0,5):TMP1=GLOBAL_PRPTY(G_FR-1,1)
 3360  DA_CH=G_TR:DA_DATA$="":GOSUB *DALINK_ADD
 3370  DA_CH=G_TR:DA_FR=G_FR:GOSUB *GET_TRACK_OTO:S_NEIRO=TMP:GOSUB *SETNEIRO2ED_TAMA:DA_CH=G_TR:DA_FR=G_FR:GLOBAL_PRPTY(G_FR,1)=TMP1:GOSUB *PUT_TRACK_OTO
 3400 ENDIF
 3410 ARG1=G_TR:ARG2=G_FR:GOSUB *PRINT_FR
 3430 IF G_FR>=G_MAX_FR(0) THEN FOR I=0 TO G_FR-G_MAX_FR(0):DA_CH=0:DA_DATA$="":GOSUB *DALINK_ADD:NEXT
 3440 RETURN
