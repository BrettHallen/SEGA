10760 *SYS_TIMER
10770 LOCK
10780 IF WIN(12,7)=1 THEN OBJ(WIN(12,5),5)=OBJ(WIN(12,5),5)+3:IF OBJ(WIN(12,5),5)>=0 THEN OBJ(WIN(12,5),5)=0:WIN(12,7)=2:WIN(12,3)=24
10790 IF WIN(12,7)=3 THEN OBJ(WIN(12,5),5)=OBJ(WIN(12,5),5)-4:IF OBJ(WIN(12,5),5)<=-23 THEN OBJ(WIN(12,5),5)=-23:WIN(12,7)=0:WIN(12,3)=1
10800 UNLOCK
10810 RETURN
