10980 *DEF_BTN
10990 FLAG_CLICK=0
11000 IF EVENT=1 THEN
11010   IF CAPTURE=J AND WIN(J,0)<=EVENTX AND WIN(J,1)>=EVENTX AND WIN(J,2)<=EVENTY AND WIN(J,3)>=EVENTY THEN FLAG_CLICK=1
11020   CAPTURE=-1:OBJ(WIN(J,5),16)=SPR_BTNUP:OBJ(OBJ(WIN(J,5),21),4)=0,0:RETURN
11030 ENDIF
11040 IF EVENT=0 AND CAPTURE=-1 THEN CAPTURE=J:OBJ(WIN(J,5),16)=SPR_BTNDOWN:OBJ(OBJ(WIN(J,5),21),4)=-1,1
11050 RETURN
