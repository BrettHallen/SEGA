11350 *DRAWLINE
11360 LOCK
11370 OBJ(96,20)=0:OBJ(96,4)=15,TAMA_Y-1,100,,,,,,,,,,15,15:'3 KEY
11380 A=8
11390 ACTIVE 30:ACTIVE 1
11400 FOR I=0 TO 21
11410  FOR J=TAMA_X TO 319 STEP A+((I MOD 7)=0)*4
11420   LINE (J,TAMA_Y+I*8-1)-(J+A-2,TAMA_Y+I*8-1),9-((I MOD 7)=0)*6
11430  NEXT
11440 NEXT
11450 FOR I=0 TO TAMA_Q
11460  FOR J=TAMA_Y TO TAMA_Y+164 STEP 4+((I MOD 4)=0)*3
11470   LINE (TAMA_X+I*A,J)-(TAMA_X+I*A,J+2),8-((I MOD 8)=0)*7
11480  NEXT
11490 NEXT
11500 UNLOCK
11510 RETURN
11520 '
