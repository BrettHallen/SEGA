 3890 *DRAW_FR_INF
 3900 IF SC_MODE=0 THEN
 3910  'NOTE MODE
 3920  LOCATE 0,3:COLOR 6:PRINT " ﾄﾗｯｸ":COLOR 7
 3930  LOCATE 0,4:PRINT USING "   ##";G_TR+1
 3940  LOCATE 0,5:COLOR 5:PRINT "ﾌﾚｰｽﾞ":COLOR 7
 3950  LOCATE 0,6:PRINT USING "  ###";G_FR+1
 3960  '
 3970  WIN(21,0)=8   :WIN(21,1)=WIN(21,0)+40
 3980  WIN(21,2)=24+8:WIN(21,3)=WIN(21,2)+16
 3990  WIN(21,4)=1
 4000  WIN(22,0)=8   :WIN(22,1)=WIN(22,0)+40
 4010  WIN(22,2)=40+8:WIN(22,3)=WIN(22,2)+16
 4020  WIN(22,4)=1
 4030 ELSE
 4040  'LINE MODE
 4050  LOCATE 20,1:COLOR 6:PRINT "ﾄﾗｯｸ";:COLOR 7:PRINT USING " ##";G_TR+1;
 4060  COLOR 5:PRINT " ﾌﾚｰｽﾞ";:COLOR 7:PRINT USING " ###";G_FR+1
 4070  '
 4080  WIN(21,0)=26*8:WIN(21,1)=WIN(21,0)+16
 4090  WIN(21,2)=8+8 :WIN(21,3)=WIN(21,2)+8
 4100  WIN(21,4)=1
 4110  WIN(22,0)=35*8:WIN(22,1)=WIN(22,0)+24
 4120  WIN(22,2)=8+8 :WIN(22,3)=WIN(22,2)+8
 4130  WIN(22,4)=1
 4140 ENDIF
 4150 RETURN
