 3680 G_TR=G_TR-1:IF G_FR>=G_MAX_FR(G_TR) THEN FOR I=0 TO G_FR-G_MAX_FR(G_TR):DA_CH=G_TR:DA_DATA$="":GOSUB *DALINK_ADD:NEXT
 3690 ARG1=G_TR:ARG2=G_FR:GOTO *PRINT_FR
