 3720 '-----------
 3740 *PRINT_FR
 3750 DA_CH=ARG1:DA_FR=ARG2:GOSUB *GET_TRACK_OTO
 3760 GOSUB *DRAW_TEMPO:GOSUB *DRAW_NEIRO
 3770 J=17:GOSUB *DRAW_SUBWINDOW_CNT
