16680 '
16700 *DRAW_POINTER_INFO:ACTIVE 30:COLOR,15,0:CLS 30:COLOR,15,1:KPRINT (0,0),FIX A$:RETURN
16720 *CNV_NOTE2TEXT
16730 IF (ARG1 MOD 12)=0 THEN A$="C"
16740 IF (ARG1 MOD 12)=1 THEN A$="C#"
16750 IF (ARG1 MOD 12)=2 THEN A$="D"
16760 IF (ARG1 MOD 12)=3 THEN A$="D#"
16770 IF (ARG1 MOD 12)=4 THEN A$="E"
16780 IF (ARG1 MOD 12)=5 THEN A$="F"
16790 IF (ARG1 MOD 12)=6 THEN A$="F#"
16800 IF (ARG1 MOD 12)=7 THEN A$="G"
16810 IF (ARG1 MOD 12)=8 THEN A$="G#"
16820 IF (ARG1 MOD 12)=9 THEN A$="A"
16830 IF (ARG1 MOD 12)=10 THEN A$="A#"
16840 IF (ARG1 MOD 12)=11 THEN A$="B"
16850 A$=A$+MID$(STR$((ARG1\12)-1),2)
16860 RETURN
16870 '---------------
16880 'ﾃﾝﾎﾟｦﾋﾞｮｳｶﾞｽﾙ
16890 '---------------
16910 *DRAW_TEMPO
16920 LOCK
16930 COLOR 2:LOCATE 0,1:PRINT "TEMPO"
16940 IF SC_MODE=0 THEN
16950  WIN(19,0)=16:WIN(19,1)=40:WIN(19,2)=24:LOCATE 0,2
16960 ELSE
16970  WIN(19,0)=64:WIN(19,1)=88:WIN(19,2)=16:LOCATE 5,1
16980 ENDIF
16990 WIN(19,3)=WIN(19,2)+7:WIN(19,4)=1
17000 COLOR 7:PRINT USING "  ###";S_TEMPO
17010 UNLOCK
17020 RETURN
17030 '---------------
17040 'ﾈｲﾛｦﾋﾞｮｳｶﾞｽﾙ
17050 '---------------
17070 *DRAW_NEIRO
17080 IF ED_TAMA(0,5)<0 THEN ED_TAMA(0,5)=0 ELSE IF ED_TAMA(0,5)>TPROP(0,0,2) THEN ED_TAMA(0,5)=TPROP(0,0,2)
17090 COLOR 7:IF SC_MODE=0 THEN LOCATE 20,1:WIN(15,0)=20*8:WIN(15,2)=16 ELSE LOCATE 17,0:WIN(15,0)=17*8:WIN(15,2)=8
17100 WIN(15,1)=WIN(15,0)+8*18:WIN(15,3)=WIN(15,2)+7:WIN(15,4)=1
17110 PRINT "["+MID$(LIST_$(ED_TAMA(0,5),0)+"                ",2,16)+"]"
17120 IF SC_MODE=0 THEN LOCATE 20,0 ELSE LOCATE 0,0
17130 PRINT LEFT$(N_FILE$+"          ",10);:PRINT "No.";:PRINT USING "###";ED_TAMA(0,5)
17140 RETURN
17150 '-----------------
17160 'ｵｸﾀｰﾌﾞｦﾋﾞｮｳｶﾞｽﾙ
17170 '-----------------
17190 *DRAW_OCT
17200 IF DRAW_RANGE_O<2 THEN DRAW_RANGE=2 ELSE IF DRAW_RANGE_O>7 THEN DRAW_RANGE_O=7
17210 LOCK :COLOR 4:LOCATE 11,1:PRINT "Octave ";:COLOR 7:PRINT USING "#";DRAW_RANGE_O:UNLOCK
17220 RETURN
17230 '------------------------------
17240 'MMLﾆ ｺﾝﾊﾞｰﾄ ｽﾙ
17250 '------------------------------
17270 *MU_CNVMML
17280 SYS_OBJ=255:SYS_MES_MODE=&B1000
17290 SYS_MES_TITLE$="MML ﾍﾝｶﾝﾁｭｳ":SYS_MES_MESSAGE$=""
17300 GOSUB *SYS_MES_DRAW:GOSUB *SYS_MES_SHOW
17310 N_TEMPO=0
17320 LI=4000
17330 MU_TMP=0
17340 ON ERROR GOTO *MU_CNVMML_ERR0
17350 OPEN SYS_FILENAME$ FOR OUTPUT AS #1
17360 ON ERROR GOTO *MU_CNVMML_ERR1
17370 FWRITE #1,NEI$
17390 *MMLCNVLOOP
17400 FLAG=1
17410 FOR MU_TMP1=0 TO 15
17420  MML$=""
17430  IF G_MAX_FR(MU_TMP1)>MU_TMP THEN
17440   MML$="O4L4V10q1/1P64"
17450   DA_CH=MU_TMP1:DA_FR=MU_TMP:GOSUB *GET_TRACK_OTO
17460   IF MU_TMP1=0 THEN ARG1=MU_TMP:GOSUB *GLOBAL2MML_L
17470   GOSUB *CNVOTO2MML
17480   IF MU_TMP1=0 THEN ARG1=MU_TMP:GOSUB *GLOBAL2MML_R
17490   SYS_MES_MESSAGE$="ﾄﾗｯｸ :"+MID$(STR$(MU_TMP1+1)+"   ",2,3)+CHR$(13)+CHR$(10)+"ﾌﾚｰｽﾞ:"+MID$(STR$(MU_TMP+1)+"   ",2,3)+"/"+MID$(STR$(G_MAX_FR(MU_TMP1))+"   ",2,3)
17500   GOSUB *SYS_MES_DRAW1
17510   FLAG=0
17520  ENDIF
17530  FWRITE #1,STR$(LI)+" DATA "+CHR$(34)+MML$+CHR$(34)+CHR$(13)+CHR$(10):LI=LI+10
17540 NEXT
17550 FWRITE #1,STR$(LI)+" DATA NEXT"+CHR$(13)+CHR$(10):LI=LI+10
17560 MU_TMP=MU_TMP+1
17570 IF FLAG=0 GOTO *MMLCNVLOOP
17580 FWRITE #1,STR$(LI)+" DATA ENDSONG"+CHR$(13)+CHR$(10):LI=LI+10
17590 DA_CH=G_TR:DA_FR=G_FR:GOSUB *GET_TRACK_OTO
17600 FWRITE #1,STR$(LI)+" SETSONG"+CHR$(13)+CHR$(10):LI=LI+10
17610 FWRITE #1,STR$(LI)+" BGM"+CHR$(13)+CHR$(10):LI=LI+10
17630 *MU_CNVMML_EXIT1
17640 ON ERROR GOTO *MU_CNVMML_ERR2
17650 CLOSE #1
17670 *MU_CNVMML_EXIT0
17680 ON ERROR GOTO 0
17690 OBJ(SYS_OBJ,20)=SYS_OBJ
17700 ARG1=G_TR:ARG2=G_FR:GOTO *PRINT_FR
17710 'ｴﾗｰｼｮﾘ
17730 *MU_CNVMML_ERR0
17740 SYS_MES_MESSAGE$="ﾌｧｲﾙ ｦ ﾋﾗｹﾏｾﾝ"
17750 GOSUB *SYS_MES_DRAW1:VSYNC 60
17760 RESUME *MU_CNVMML_EXIT0
17780 *MU_CNVMML_ERR1
17790 SYS_MES_MESSAGE$="ｶｷｺﾐ ﾁｭｳﾆ ｴﾗｰｶﾞ" + CHR$(13) + CHR$(10) + "ﾊｯｾｲｼﾏｼﾀ"
17800 GOSUB *SYS_MES_DRAW1:VSYNC 60
17810 RESUME *MU_CNVMML_EXIT1
17830 *MU_CNVMML_ERR2:
17840 SYS_MES_MESSAGE$="CLOSEﾆｼｯﾊﾟｲｼﾏｼﾀ"
17850 GOSUB *SYS_MES_DRAW1:VSYNC 60
17860 RESUME *MU_CNVMML_EXIT0
17870 '------------------------------
17880 '
17890 '------------------------------
17910 *MU_QUICK_PLAY_ALL
17920 SYS_OBJ=255:SYS_MES_MODE=&B1000
17930 SYS_MES_TITLE$="ｻｲｾｲ ｼﾞｭﾝﾋﾞ ﾁｭｳ":SYS_MES_MESSAGE$=""
17940 GOSUB *SYS_MES_DRAW:GOSUB *SYS_MES_SHOW
17950 N_TEMPO=0
17960 FOR MU_TMP1=0 TO 15
17970  MML$="O4L4V10q1/1P64"
17980  IF G_MAX_FR(MU_TMP1)>0 THEN
17990   FOR MU_TMP=0 TO G_MAX_FR(MU_TMP1)-1
18000    DA_CH=MU_TMP1:DA_FR=MU_TMP:GOSUB *GET_TRACK_OTO
18010    IF MU_TMP1=0 THEN ARG1=MU_TMP:GOSUB *GLOBAL2MML_L
18020    GOSUB *CNVOTO2MML
18030    IF MU_TMP1=0 THEN ARG1=MU_TMP:GOSUB *GLOBAL2MML_R
18040    MML$=MML$+"O4L4V10q1/1P64"
18050    SYS_MES_MESSAGE$="ﾄﾗｯｸ :"+MID$(STR$(MU_TMP1+1)+"   ",2,3)+CHR$(13)+CHR$(10)+"ﾌﾚｰｽﾞ:"+MID$(STR$(MU_TMP+1)+"   ",2,3)+"/"+MID$(STR$(G_MAX_FR(MU_TMP1))+"   ",2,3)
18060    GOSUB *SYS_MES_DRAW1
18070   NEXT
18080  ENDIF
18090  MML$(MU_TMP1)=MML$+"%0L128q1/1R"
18100 NEXT
18110 OBJ(SYS_OBJ,20)=SYS_OBJ
18120 ON ERROR GOTO *EFFECTERROR1
18130 LOCATE 0,10
18140 EFFECT -1,MML$(0),MML$(1),MML$(2),MML$(3),MML$(4),MML$(5),MML$(6),MML$(7),MML$(8),MML$(9),MML$(10),MML$(11),MML$(12),MML$(13),MML$(14),MML$(15)
18160 *ERRRET1
18170 ON ERROR GOTO 0
18180 ARG1=G_TR:ARG2=G_FR:GOTO *PRINT_FR
18210 *EFFECTERROR1
18220 LOCATE 0,10:PRINT STRING$(36," ")
18230 SYS_OBJ=255:SYS_MES_MODE=&B1000
18240 SYS_MES_TITLE$="ｴﾗｰ":SYS_MES_MESSAGE$="ｻｲｾｲﾁｭｳﾆｴﾗｰｶﾞ"+CHR$(13)+CHR$(10)+"ﾊｯｾｲｼﾏｼﾀ"
18250 GOSUB *SYS_MESSAGEBOX
18260 RESUME *ERRRET1
18270 '------------------------------
18280 '
18290 '------------------------------
18310 *MU_QUICK_PLAY_1
18320 N_TEMPO=0
18330 FOR MU_TMP=0 TO 15
18340  MML$="O4L4V10q1/1P64"
18350  IF G_MAX_FR(MU_TMP)>G_FR THEN
18360   DA_CH=MU_TMP:DA_FR=G_FR:GOSUB *GET_TRACK_OTO
18370   GOSUB *CNVOTO2MML
18380  ENDIF
18390  MML$(MU_TMP)=MML$+"%0L128q1/1R"
18400 NEXT
18410 ON ERROR GOTO *EFFECTERROR1
18420 LOCATE 0,10
18430 EFFECT -1,"T"+STR$(S_TEMPO)+MML$(0),MML$(1),MML$(2),MML$(3),MML$(4),MML$(5),MML$(6),MML$(7),MML$(8),MML$(9),MML$(10),MML$(11),MML$(12),MML$(13),MML$(14),MML$(15)
18450 ON ERROR GOTO 0
18460 ARG1=G_TR:ARG2=G_FR:GOTO *PRINT_FR
18470 '------------------------------
18480 '1 ﾄﾗｯｸ ｾﾞﾝﾀｲｦｴﾝｿｽﾙ
18490 '------------------------------
18510 *MU_QUICK_PLAY_1ALL
18520 IF G_MAX_FR(G_TR)<=0 THEN RETURN
18530 SYS_OBJ=255:SYS_MES_MODE=&B1000
18540 SYS_MES_TITLE$="ｻｲｾｲ ｼﾞｭﾝﾋﾞ ﾁｭｳ":SYS_MES_MESSAGE$=""
18550 N_TEMPO=0
18560 GOSUB *SYS_MES_DRAW:GOSUB *SYS_MES_SHOW
18570 MML$="O4L4V10q1/1P64"
18580 FOR MU_TMP=0 TO G_MAX_FR(G_TR)-1
18590  DA_CH=G_TR:DA_FR=MU_TMP:GOSUB *GET_TRACK_OTO
18600  ARG1=MU_TMP:GOSUB *GLOBAL2MML_L
18610  GOSUB *CNVOTO2MML
18620  ARG1=MU_TMP:GOSUB *GLOBAL2MML_R
18630  MML$=MML$+"O4L4V10q1/1P64"
18640  SYS_MES_MESSAGE$="ﾄﾗｯｸ :"+MID$(STR$(G_TR+1)+"   ",2,3)+CHR$(13)+CHR$(10)+"ﾌﾚｰｽﾞ:"+MID$(STR$(MU_TMP+1)+"   ",2,3)+"/"+MID$(STR$(G_MAX_FR(MU_TMP1))+"   ",2,3)
18650  GOSUB *SYS_MES_DRAW1
18660 NEXT
18670 OBJ(SYS_OBJ,20)=SYS_OBJ
18680 ON ERROR GOTO *EFFECTERROR1
18690 LOCATE 0,10
18700 EFFECT -1,MML$+"q1/1R128"
18710 ON ERROR GOTO 0
18720 ARG1=G_TR:ARG2=G_FR:GOTO *PRINT_FR
18740 '------------------------------
18750 '1 ﾄﾗｯｸﾉ 1ｼｮｳｾﾂ ﾀﾞｹ ｦ ｴﾝｿｳｽﾙ
18760 '------------------------------
18780 *MU_QUICK_PLAY
18790 MML$=""
18800 GOSUB *CNVOTO2MML
18810 EFFECT -1,"O4L4V10q1/1P64T"+STR$(S_TEMPO)+MML$+"q1/1R128"
18820 RETURN
18830 '
18850 *CNVOTO2MML
18860 O=4:L=8:V=10:P=64:I=0
18870 'MML$=MML$+"S"+MID$(STR$(SIG_*SIG),2)
18880 IF ED_TAMA(0,5)>TPROP(0,0,2) THEN MML$=MML$+"@"+MID$(STR$(TPROP(0,0,2)),2) ELSE MML$=MML$+"@"+MID$(STR$(ED_TAMA(0,5)),2)
18900 *CNVOTO2MML_L
18910 GOSUB *QUERY_1TAMA
18920 IF TAMA_LEN>0 THEN
18930  GOSUB *QUERY_MODE
18940  GOSUB *TAMA2MML
18950  I=I+TAMA_LEN
18960  IF I<TAMA_Q GOTO *CNVOTO2MML_L
18970 ENDIF
18980 RETURN
18990 '1ｵﾝﾋﾛｯﾃｸﾙ
19010 *QUERY_1TAMA:TAMA_LEN=-1:TAMA_NOTE=-1
19030 *QUERY_1TAMA_L
19040 IF ED_TAMA(I,1)<>-1 THEN
19050  TAMA_LEN=ED_TAMA(I,1):TAMA_NOTE=ED_TAMA(I,0)
19060  RETURN
19070 ENDIF
19080 I=I+1:IF I<TAMA_Q GOTO *QUERY_1TAMA_L
19090 RETURN
19100 '単一の音かどうかを調べる。
19110 'CNV_MODE=0 音符モード
19120 'CNV_MODE=1 音量
19130 'CNV_MODE=2 パン
19140 'CNV_MODE=3 音量＆パン
19150 'CNV_MODE=4 ピッチベンド
19160 'CNV_MODE=5 ピッチベンド＆音量
19170 'CNV_MODE=6 ピッチベンド＆パン
19180 'CNV_MODE=7 ピッチベンド＆音量＆パン
19200 *QUERY_MODE
19210 CNV_MODE=0
19220 IF TAMA_LEN=1 THEN RETURN
19230 FOR K=I+1 TO I+TAMA_LEN-1
19240  IF ED_TAMA(K,2)<>ED_TAMA(I,2) THEN CNV_MODE=CNV_MODE OR 1:'音量
19250  IF ED_TAMA(K,3)<>ED_TAMA(I,3) THEN CNV_MODE=CNV_MODE OR 2:'パン
19260  IF ED_TAMA(K,4)<>ED_TAMA(I,4) THEN CNV_MODE=CNV_MODE OR 4:'ピッチベンド
19270 NEXT
19280 RETURN
19290 '
19310 *TAMA2MML
19320 GOSUB *TAMA2MML_OCT
19330 'IF CNV_MODE=1 OR CNV_MODE=2 OR CNV_MODE=3 THEN
19340 IF CNV_MODE<>0 THEN
19350  ARG1=I:GOSUB *TAMA2MML_VOL:GOSUB *TAMA2MML_PAN
19360  MML$=MML$+"L32q"+MID$(STR$(TAMA_LEN),2)+"/1"
19370  L=1
19380  IF TAMA_NOTE>0 THEN
19390   IF (TAMA_NOTE MOD 12)=0  THEN MML$=MML$+"C"
19400   IF (TAMA_NOTE MOD 12)=1  THEN MML$=MML$+"C#"
19410   IF (TAMA_NOTE MOD 12)=2  THEN MML$=MML$+"D"
19420   IF (TAMA_NOTE MOD 12)=3  THEN MML$=MML$+"D#"
19430   IF (TAMA_NOTE MOD 12)=4  THEN MML$=MML$+"E"
19440   IF (TAMA_NOTE MOD 12)=5  THEN MML$=MML$+"F"
19450   IF (TAMA_NOTE MOD 12)=6  THEN MML$=MML$+"F#"
19460   IF (TAMA_NOTE MOD 12)=7  THEN MML$=MML$+"G"
19470   IF (TAMA_NOTE MOD 12)=8  THEN MML$=MML$+"G#"
19480   IF (TAMA_NOTE MOD 12)=9  THEN MML$=MML$+"A"
19490   IF (TAMA_NOTE MOD 12)=10 THEN MML$=MML$+"A#"
19500   IF (TAMA_NOTE MOD 12)=11 THEN MML$=MML$+"B"
19510  ELSE
19520   MML$=MML$+"R"
19530  ENDIF
19540  GOSUB *TAMA2MML_PIT
19550  MML$=MML$+"q1/1"
19560  '
19570  FOR K=I+1 TO I+TAMA_LEN-1
19580   ARG1=K:GOSUB *TAMA2MML_VOL:GOSUB *TAMA2MML_PAN
19590   MML$=MML$+"R"
19600   GOSUB *TAMA2MML_PIT
19610  NEXT
19620  RETURN
19630 ENDIF
19640 IF CNV_MODE=0 THEN
19650  '音符そのままモード
19660  IF TAMA_LEN<>L THEN
19670    L=TAMA_LEN
19680    IF L=1 THEN MML$=MML$+"L32"
19690    IF L=2 THEN MML$=MML$+"L16"
19700    IF L=3 THEN MML$=MML$+"L16."
19710    IF L=4 THEN MML$=MML$+"L8"
19720    IF L>=5 THEN MML$=MML$+"Ll"+MID$(STR$(TAMA_LEN*60),2)
19730  ENDIF
19740  ARG1=I:GOSUB *TAMA2MML_VOL:GOSUB *TAMA2MML_PAN
19750  IF TAMA_NOTE>0 THEN
19760   IF (TAMA_NOTE MOD 12)=0  THEN MML$=MML$+"C"
19770   IF (TAMA_NOTE MOD 12)=1  THEN MML$=MML$+"C#"
19780   IF (TAMA_NOTE MOD 12)=2  THEN MML$=MML$+"D"
19790   IF (TAMA_NOTE MOD 12)=3  THEN MML$=MML$+"D#"
19800   IF (TAMA_NOTE MOD 12)=4  THEN MML$=MML$+"E"
19810   IF (TAMA_NOTE MOD 12)=5  THEN MML$=MML$+"F"
19820   IF (TAMA_NOTE MOD 12)=6  THEN MML$=MML$+"F#"
19830   IF (TAMA_NOTE MOD 12)=7  THEN MML$=MML$+"G"
19840   IF (TAMA_NOTE MOD 12)=8  THEN MML$=MML$+"G#"
19850   IF (TAMA_NOTE MOD 12)=9  THEN MML$=MML$+"A"
19860   IF (TAMA_NOTE MOD 12)=10 THEN MML$=MML$+"A#"
19870   IF (TAMA_NOTE MOD 12)=11 THEN MML$=MML$+"B"
19880  ELSE
19890   MML$=MML$+"R"
19900  ENDIF
19910  GOSUB *TAMA2MML_PIT
19920  RETURN
19930 ENDIF
19940 RETURN
19950 'ｵｸﾀｰﾌﾞ ｦ ｾｯﾃｲｽﾙ
19970 *TAMA2MML_OCT
19980 TMP=(TAMA_NOTE \ 12)-1
19990 IF TMP<>O AND TAMA_NOTE>0 THEN
20000  IF ABS(O-TMP)<=1 THEN
20010   IF O>TMP THEN MML$=MML$+"<" ELSE MML$=MML$+">"
20020  ELSE
20030   MML$=MML$+"O"+MID$(STR$(TMP),2)
20040  ENDIF
20050  O=TMP
20060 ENDIF
20070 RETURN
20080 'ﾎﾞﾘｭｰﾑ ｦ ｾｯﾃｲｽﾙ
20100 *TAMA2MML_VOL:IF ED_TAMA(ARG1,2)<>V     THEN V=ED_TAMA(ARG1,2)  :MML$=MML$+"V"+MID$(STR$(V),2)
20110 RETURN
20120 'ﾊﾟﾝ ｦ ｾｯﾃｲｽﾙ
20140 *TAMA2MML_PAN:IF ED_TAMA(ARG1,3)*8<>P   THEN P=ED_TAMA(ARG1,3)*8:MML$=MML$+"P"+MID$(STR$(P),2)
20150 RETURN
20160 'ﾋﾟｯﾁ ｦ ｾｯﾃｲｽﾙ
20180 *TAMA2MML_PIT:IF ED_TAMA(ARG1,4)*8<>PIT THEN PIT=ED_TAMA(ARG1,4)*8:MML$=MML$+"~"+";"+MID$(STR$(PIT),2)+";"
20190 RETURN
20200 '
20210 'ｾｲｷﾞｮｺｰﾄﾞﾉｳﾒｺﾐ
20230 *GLOBAL2MML_L
20240 IF (GLOBAL_PRPTY(ARG1,1)<>N_TEMPO) THEN N_TEMPO=GLOBAL_PRPTY(ARG1,1):MML$=MML$+"T"+MID$(STR$(N_TEMPO),2)
20250 IF (GLOBAL_PRPTY(ARG1,0) \ 16)=1 THEN MML$=MML$+"|:"
20260 IF (GLOBAL_PRPTY(ARG1,0) \ 16)=2 THEN MML$=MML$+"|1"
20270 IF (GLOBAL_PRPTY(ARG1,0) \ 16)=3 THEN MML$=MML$+":|2"
20280 IF (GLOBAL_PRPTY(ARG1,0) \ 16)=4 THEN MML$=MML$+"$"
20290 IF (GLOBAL_PRPTY(ARG1,0) \ 16)=5 THEN MML$=MML$+"*"
20300 RETURN
20320 *GLOBAL2MML_R
20330 IF (GLOBAL_PRPTY(ARG1,0) AND 15)=1 THEN MML$=MML$+":|"
20340 IF (GLOBAL_PRPTY(ARG1,0) AND 15)=2 THEN MML$=MML$+"ds"
20350 RETURN
20360 '
20370 'ﾈｲﾛﾘｽﾄｦｾｯﾃｲｽﾙ
20380 '
20400 *SET_NEIROLIST
20410 RET=0:FOR I=0 TO 127:LIST_$(I,0)="":NEXT
20420 FILE_$=FILE$
20430 IF FILE$="STANDARD  " THEN FILE_$=WK$+"LST1_00.D"
20440 IF FILE$="ORCHEST   " THEN FILE_$=WK$+"LST1_01.D"
20450 IF FILE$="ROCK      " THEN FILE_$=WK$+"LST1_02.D"
20460 IF FILE$="DANCE     " THEN FILE_$=WK$+"LST1_03.D"
20470 IF FILE$="PIANO     " THEN FILE_$=WK$+"LST1_04.D"
20480 IF FILE$="METAL     " THEN FILE_$=WK$+"LST1_05.D"
20490 IF FILE$="ETHNIC    " THEN FILE_$=WK$+"LST1_06.D"
20500 IF FILE$="MBOXPO    " THEN FILE_$=WK$+"LST1_07.D"
20510 IF FILE$="EXTRA1    " THEN FILE_$=WK$+"LST1_08.D"
20520 IF FILE$="EXTRA2    " THEN FILE_$=WK$+"LST1_09.D"
20530 IF FILE$="EXTRA3    " THEN FILE_$=WK$+"LST1_10.D"
20540 IF FILE$="EXTRA4    " THEN FILE_$=WK$+"LST1_11.D"
20550 IF FILE$="GM_FM1    " THEN FILE_$=WK$+"LST1_12.D"
20560 IF FILE$="GM_FM2    " THEN FILE_$=WK$+"LST1_13.D"
20570 IF FILE$="GM_FM3    " THEN FILE_$=WK$+"LST1_14.D"
20580 IF FILE$="GM_FM4    " THEN FILE_$=WK$+"LST1_15.D"
20590 RET=0
20600 ON ERROR GOTO *SET_NEIROLIST_ERR
20610 OPEN FILE_$ FOR INPUT AS #1
20620 ON ERROR GOTO *SET_NEIROLIST_ERR1
20630 I=0
20650 *SETNEIROL0
20660 GOSUB *GET_TOKEN
20670 IF INSTR("@#",LEFT$(TOKEN$,1))<>0 THEN
20680  LIST_$(I,0)=TOKEN$
20690  GOSUB *GET_TOKEN:LIST_$(I,1)=TOKEN$
20700  GOSUB *GET_TOKEN:LIST_$(I,2)=TOKEN$
20710  I=I+1
20720  IF LOF(1)>LOC(1) GOTO *SETNEIROL0
20730 ELSE
20740  RET=1
20750 ENDIF
20770 *SET_NEIROLIST_EXIT1
20780 ON ERROR GOTO *SET_NEIROLIST_ERR1
20790 CLOSE #1
20810 *SET_NEIROLIST_EXIT
20820 ON ERROR GOTO 0
20830 IF RET<>0 THEN
20840  FOR I=0 TO 127:LIST_$(I,0)=" ** Unknown **":NEXT
20850 ENDIF
20860 RETURN
20880 *SET_NEIROLIST_ERR:RET=1:RESUME *SET_NEIROLIST_EXIT
20900 *SET_NEIROLIST_ERR1:RET=1:RESUME *SET_NEIROLIST_EXIT1
20910 'ファイルから１トークン取得する
20930 *GET_TOKEN:ON ERROR GOTO *GET_TOKEN_ERR
20940 TOKEN$=""
20960 *GET_TOKENL:IF LOF(1)<LOC(1) THEN TOKEN$="ﾀﾞﾒﾀﾞﾒ":ON ERROR GOTO 0:RETURN
20970 FREAD #1,C$,1:IF C$=CHR$(13) GOTO *GET_TOKENL
20980 IF INSTR(","+CHR$(10)+CHR$(13),C$)<>0 THEN ON ERROR GOTO 0:RETURN
20990 TOKEN$=TOKEN$+C$:GOTO *GET_TOKENL
21010 *GET_TOKEN_ERR:TOKEN$="ﾀﾞﾒﾀﾞﾒ":RESUME *GET_TOKEN_EXIT
21030 *GET_TOKEN_EXIT
21040 ON ERROR GOTO 0:RETURN
21050 '-------------------------------------------------------------
21060 '音色設定
21070 '-------------------------------------------------------------
21080 'リスト内の音を設定する
21100 *SET_NEIROSET
21110 LI=1000
21120 NEI$=""
21130 IF RIGHT$(FILE$,2)<>".D" THEN
21140  ON ERROR GOTO *SET_NEIROSET_EXIT
21150  PLAYINIT FILE$
21160  ARG1$="PLAYINIT "+CHR$(34)+FILE$+CHR$(34):GOSUB *WRITELINE1
21170  RET=0
21180  ON ERROR GOTO 0
21190  RETURN
21200 ENDIF
21210 RET=0:F=0
21230 *SET_NEIROSETL0
21240 IF LIST_$(RET,0)<>"" THEN
21250  GOSUB *SET_NEIROSETSUB
21260  RET=RET+1
21270  GOTO *SET_NEIROSETL0
21280 ENDIF
21290 USERDATA "ENDARRANGE":ARG1$="ENDARRANGE":ARG2=1:GOSUB *WRITELINE
21300 ON ERROR GOTO *SET_NEIROSET_EXIT
21310 TARG READ 0,0
21320 ARG1$="TARG READ 0,0":GOSUB *WRITELINE1
21330 RET=0
21350 *SET_NEIROSET_EXIT_1
21360 USERDATA END
21370 ON ERROR GOTO 0
21380 RETURN
21400 *SET_NEIROSET_EXIT:RET=1:RESUME *SET_NEIROSET_EXIT_1
21410 '
21430 *SET_NEIROSETSUB
21440 IF LEFT$(LIST_$(RET,0),1)="@" THEN
21450  '
21460  IF F=0 THEN F=1:USERDATA 0,0,LIST_$(RET,1) ELSE USERDATA LIST_$(RET,1)
21470  USERDATA LIST_$(RET,2),0
21480  ARG1$=CHR$(34)+LIST_$(RET,1)+CHR$(34)+","+LIST_$(RET,2):ARG2=0:GOSUB *WRITELINE
21490 ELSE
21500  '自作した音
21501  ON ERROR GOTO *ERR001
21510  OPEN LIST_$(RET,1) FOR INPUT AS #1
21511  ON ERROR GOTO *ERR002
21520  FOR I=1 TO VAL(LIST_$(RET,2))
21540 *SET_NEIRO_LISTL0
21550    GOSUB *GET_TOKEN
21560    IF LEFT$(TOKEN$,1)<>"@" GOTO *SET_NEIRO_LISTL0
21570  NEXT
21580  IF TOKEN$="@FM" THEN
21590    GOSUB *GET_TOKEN
21600    'BUILDLAYER
21610    IF F=0 THEN F=1:USERDATA 0,0,TOKEN$ ELSE USERDATA TOKEN$
21620    ARG1$=TOKEN$:ARG2=1:GOSUB *WRITELINE
21630    FOR L=0 TO 3
21640     GOSUB *GET_TOKEN:USERDATA TOKEN$  :'FM
21650     ARG1$=TOKEN$:ARG2=1:GOSUB *WRITELINE
21660     A$=TOKEN$
21670     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'OP#
21680     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21690     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'W
21700     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21710     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'X
21720     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21730     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'Y
21740     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21750     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'M
21760     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21770     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'S
21780     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21790     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'AR
21800     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21810     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'DR
21820     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21830     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'SR
21840     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21850     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'RR
21860     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21870     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'SL
21880     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21890     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'TL
21900     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21910     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'ml1
21920     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21930     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'ml2
21940     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21950     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'dt
21960     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21970     GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'KS
21980     ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
21990     IF A$="FMEXT" THEN
22000       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'sn
22010       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22020       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'en
22030       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22040       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'vl
22050       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22060       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'RE
22070       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22080       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'LF
22090       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22100       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'AW
22110       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22120       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'AS
22130       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22140       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'PW
22150       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22160       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'PS
22170       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22180       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'MX
22190       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22200       GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'DP
22210       ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22220     ENDIF
22230    NEXT
22240    GOSUB *GET_TOKEN:USERDATA TOKEN$:'ENDLAYER
22250    ARG1$=TOKEN$:ARG2=1:GOSUB *WRITELINE
22260  ELSE
22270   'PCM
22280   GOSUB *GET_TOKEN
22290   IF TOKEN$="BUILDLAYER" THEN
22300     IF F=0 THEN F=1:USERDATA 0,0,TOKEN$ ELSE USERDATA TOKEN$
22310     ARG1$=TOKEN$:ARG2=1:GOSUB *WRITELINE
22320     GOSUB *GET_TOKEN
22340 *SET_NEIRO_LISTL1
22350     GOSUB *SET_PCM_SUB
22360     GOSUB *GET_TOKEN
22370     IF TOKEN$<>"ENDLAYER" GOTO *SET_NEIRO_LISTL1
22380     USERDATA TOKEN$
22390     ARG1$=TOKEN$:ARG2=1:GOSUB *WRITELINE
22400   ELSE
22410     IF F=0 THEN F=1:USERDATA 0,0,TOKEN$ ELSE USERDATA TOKEN$
22420     ARG1$=TOKEN$:ARG2=1:GOSUB *WRITELINE
22430     GOSUB *SET_PCM_SUB1
22440   ENDIF
22450  ENDIF
22460  CLOSE #1
22470 ENDIF
22480 RETURN
22481 *ERR001:RESUME *ERR001EXIT
22482 *ERR001EXIT:ON ERROR GOTO 0:RETURN
22483 *ERR002:RESUME *ERR002EXIT
22484 *ERR002EXIT:ON ERROR GOTO 0:CLOSE #1:RETURN
22500 *SET_PCM_SUB
22510 USERDATA TOKEN$
22520 ARG1$=TOKEN$:ARG2=1:GOSUB *WRITELINE
22540 *SET_PCM_SUB1
22550 GOSUB *GET_TOKEN:USERDATA TOKEN$
22560 ARG1$=TOKEN$:ARG2=1:GOSUB *WRITELINE
22570 GOSUB *GET_TOKEN:USERDATA "20",0:'
22580 ARG1$="20":ARG2=0:GOSUB *WRITELINE
22590 GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'
22600 ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22610 GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'sn
22620 ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22630 GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'en
22640 ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22650 GOSUB *GET_TOKEN:USERDATA TOKEN$,0:'bn
22660 ARG1$=TOKEN$:ARG2=0:GOSUB *WRITELINE
22670 RETURN
22690 *WRITELINE
22700 IF ARG2=0 THEN ARG1$="DATA "+ARG1$ ELSE ARG1$="DATA "+CHR$(34)+ARG1$+CHR$(34)
22720 *WRITELINE1
22730 NEI$=NEI$+STR$(LI)+" "+ARG1$+CHR$(13)+CHR$(10)
22740 '? ARG1$
22750 LI=LI+10:RETURN
22760 '--------------------------------------
22770 '音楽データ操作部分
22780 '            Version 0.01
22790 '               Programed by Sofiya.
22800 '--------------------------------------
22810 'ｼｮｷｶ
22830 *INIT_TRACK
22840 MAX_F=255:DIM DA_NOTE$(12),DATA_TRACK$(16,MAX_F)
22860 *DA_RES_NOTE:RESTORE *DA_RES_NOTE:DATA "C","C#","D","D#","E","F","F#","G","G#","A","A#","B"
22870 FOR DA_TMP=0 TO 11:READ DA_NOTE$(DA_TMP):NEXT :GOTO *CLEAR_ALL_TRACK
22880 '-----[ CLEAR_ALL_TRACK ]-----
22890 ' ｽﾍﾞﾃﾉﾃﾞｰﾀｦｼｮｷｶｽﾙ
22910 *CLEAR_ALL_TRACK
22920 FOR DA_TEMP1=0 TO 15
22930  G_MAX_FR(DA_TEMP1)=0
22940  DATA_TRACK$(DA_TEMP1,0)=STRW$(2,65535)+CHR$(0)+CHR$(0)+CHR$(0)
22950  FOR DA_TEMP0=1 TO MAX_F:DATA_TRACK$(DA_TEMP1,DA_TEMP0)="":NEXT
22960 NEXT
22970 FOR DA_TEMP1=0 TO MAX_F
22980  GLOBAL_PRPTY(DA_TEMP1,0)=0:'ﾘｬｯｷ
22990  GLOBAL_PRPTY(DA_TEMP1,1)=S_TEMPO:'ﾃﾝﾎﾟ
23000  GLOBAL_PRPTY(DA_TEMP1,2)=0:'ｶｸﾁｮｳﾖｳ
23010  GLOBAL_PRPTY(DA_TEMP1,3)=0:'ｶｸﾁｮｳﾖｳ
23020 NEXT
23030 RETURN
23040 '-----[ DALINK_SEARCH ]-----
23050 ' DA_FRｼｮｳｾﾂﾒ ｦ ｻｶﾞｽ
23060 ' ENTRY:
23080 *DALINK_SEARCH
23090 DA_TEMP1=ASC(MID$(DATA_TRACK$(DA_CH,0),2,1))+ASC(MID$(DATA_TRACK$(DA_CH,0),1,1))*256
23100 IF DA_FR=0 OR DA_TEMP1>60000 THEN DA_FR=DA_TEMP1:RETURN
23110 FOR DA_CNT=1 TO DA_FR
23120  DA_TEMP1=ASC(MID$(DATA_TRACK$(DA_CH,DA_TEMP1),2,1))+ASC(MID$(DATA_TRACK$(DA_CH,DA_TEMP1),1,1))*256
23130  IF DA_TEMP1>60000 THEN DA_CNT=DA_FR+1
23140 NEXT
23150 DA_FR=DA_TEMP1
23160 RETURN
23170 '-----[ DALINK_NEXT ]-----
23180 ' DA_FR ﾉ ﾂｷﾞ ﾉ ｼｮｳｾﾂ
23190 ' ENTRY:
23210 *DALINK_NEXT:DA_FR=ASC(MID$(DATA_TRACK$(DA_CH,DA_FR),2,1))+ASC(MID$(DATA_TRACK$(DA_CH,DA_FR),1,1))*256:RETURN
23220 '-----[ DALINK_PREV ]-----
23230 ' DA_FR ﾉ ﾏｴ ﾉ ｼｮｳｾﾂ
23240 ' ENTRY:
23260 *DALINK_PREV:DA_FR=ASC(MID$(DATA_TRACK$(DA_CH,DA_FR),4,1))+ASC(MID$(DATA_TRACK$(DA_CH,DA_FR),3,1))*256:RETURN
23270 '-----[ DALINK_DELETE ]-----
23280 ' DA_FRｼｮｳｾﾂﾒ ｦ ｻｸｼﾞｮｽﾙ
23300 *DALINK_DELETE
23310 GOSUB *DALINK_SEARCH
23320 DA_TEMP1=ASC(MID$(DATA_TRACK$(DA_CH,DA_FR),2,1))+ASC(MID$(DATA_TRACK$(DA_CH,DA_FR),1,1))*256
23330 DA_TEMP2=ASC(MID$(DATA_TRACK$(DA_CH,DA_FR),4,1))+ASC(MID$(DATA_TRACK$(DA_CH,DA_FR),3,1))*256
23340 IF DA_TEMP1<=60000 THEN MID$(DATA_TRACK$(DA_CH,DA_TEMP1),1,2)=DA_TEMP2
23350 MID$(DATA_TRACK$(DA_CH,DA_TEMP2),1,2)=DA_TEMP1:DATA_TRACK$(DA_CH,DA_FR)=""
23360 G_MAX_FR(DA_CH)=G_MAX_FR(DA_CH)-1:RETURN
23370 '-----[ DALINK_ADD ]-----
23380 ' DA_FRｼｮｳｾﾂﾒ ｦ ﾂｲｶｽﾙ
23400 *DALINK_ADD
23410 RET=0
23420 'ﾊｲﾚﾂｦｶｸﾎ
23430 DA_TEMP0=0
23450 *DALINK_ADD_LOOP00
23460   DA_TEMP0=DA_TEMP0+1
23470   IF DA_TEMP0>MAX_F THEN RET=1:RETURN :'ﾓｳｺﾚｲｼﾞｮｳﾂｲｶﾃﾞｷﾅｲ
23480   IF DATA_TRACK$(DA_CH,DA_TEMP0)<>"" GOTO *DALINK_ADD_LOOP00
23490 'ｻｲｺﾞ ﾉ ﾄﾗｯｸ ｦ ｴﾙ
23500   DA_TEMP1=ASC(MID$(DATA_TRACK$(DA_CH,0),3,1))*256+ASC(MID$(DATA_TRACK$(DA_CH,0),4,1))
23510   IF DA_TEMP1>60000 THEN
23520     MID$(DATA_TRACK$(DA_CH,0),1,4)=STRW$(1,DA_TEMP0)+STRW$(1,DA_TEMP0)
23530     DATA_TRACK$(DA_CH,DA_TEMP0)=STRW$(2,65535)+DA_DATA$
23540   ELSE
23550     DATA_TRACK$(DA_CH,DA_TEMP0)=STRW$(1,65535)+STRW$(1,DA_TEMP1)+DA_DATA$
23560     MID$(DATA_TRACK$(DA_CH,DA_TEMP1),1,2)=STRW$(1,DA_TEMP0)
23570     MID$(DATA_TRACK$(DA_CH,0),3,2)=STRW$(1,DA_TEMP0)
23580   ENDIF
23590 G_MAX_FR(DA_CH)=G_MAX_FR(DA_CH)+1
23600 RETURN
23610 '-----[ DA_SAVE ]-----------
23620 ' 音内部形式をセーブする
23630 ' ENTRY
23640 '   DA_FILE_START:始めのフレーズ
23650 '   DA_FILE_END  :終わりのフレーズ
23660 '                      65535で終わりまで
23670 '   DA_FILE_TRACK:セーブするトラック
23680 '                      BITでMSBが15トラック
23690 '                           LSBが0トラック
23700 '   FILENAME$    :ふぁいる名
23710 '
23730 *DA_SAVE
23740 IF DA_FILE_START>DA_FILE_END THEN RET=-1:RETURN
23750 RET=0:IF DA_FILE_TRACK=0 THEN RETURN
23760 ON ERROR GOTO *DA_SAVE_FILE_OPEN_ERR
23770 OPEN FILENAME$ FOR OUTPUT AS #1
23780 ON ERROR GOTO *DA_SAVE_FWRITE_ERR
23790 SYS_OBJ=255:SYS_MODE=&B1000
23800 SYS_MES_TITLE$="ｵﾝｶﾞｸﾃﾞｰﾀ ｶｷｺﾐ":SYS_MES_MESSAGE$=""
23810 GOSUB *SYS_MES_DRAW:GOSUB *SYS_MES_SHOW
23820 FWRITE #1,"音000"    :'ﾏｼﾞｯｸﾅﾝﾊﾞｰﾉｶｷｺﾐ
23830 FWRITE #1,STRW$(1,80+LEN(N_FILE$)):'ヘッダーの長さ
23840 FWRITE #1,LEFT$(COPYRIGHT$+STRING$(80," "),80)
23850 FWRITE #1,N_FILE$
23860 '
23870 FWRITE #1,STRW$(1,MAX_F+1)
23880 FOR DA_TRK=0 TO MAX_F
23890  FWRITE #1,STRW$(1,GLOBAL_PRPTY(DA_TRK,0)):'ﾘｬｯｷ
23900  FWRITE #1,STRW$(1,GLOBAL_PRPTY(DA_TRK,1)):'ﾃﾝﾎﾟ
23910  FWRITE #1,STRW$(1,GLOBAL_PRPTY(DA_TRK,2)):'ｶｸﾁｮｳﾖｳ
23920  FWRITE #1,STRW$(1,GLOBAL_PRPTY(DA_TRK,3)):'ｶｸﾁｮｳﾖｳ
23930 NEXT
23940 '
23950 DA_TEMP=DA_FILE_START-1
23960 DA_TEMP0=0
23980 *DA_SAVE_LOOP00
23990 DA_F=0
24000 DA_TEMP=DA_TEMP+1
24010 DA_TEMP0=DA_TEMP0+1
24020 FOR DA_TRK=0 TO 15
24030  IF (DA_FILE_TRACK AND (2^DA_TRK)) THEN
24040   DA_CH=DA_TRK
24050   DA_FR=DA_TEMP:GOSUB *DALINK_SEARCH
24060   IF DA_FR<=60000 THEN
24070    DA_F=1
24080    FWRITE #1,CHR$(DA_CH)+STRW$(1,DA_TEMP0)
24090    FWRITE #1,STRW$(1,LEN(DATA_TRACK$(DA_CH,DA_FR))-4)
24100    FWRITE #1,MID$(DATA_TRACK$(DA_CH,DA_FR),5)
24110    SYS_MES_MESSAGE$=CHR$(13)+CHR$(10)+"ﾄﾗｯｸ :"+MID$(STR$(DA_CH+1)+"  ",2,3)+CHR$(13)+CHR$(10)+"ﾌﾚｰｽﾞ:"+MID$(STR$(DA_FR)+"  ",2,3)
24120    GOSUB *SYS_MES_DRAW1
24130   ENDIF
24140  ENDIF
24150 NEXT
24160 IF DA_F=1 AND DA_TEMP<DA_FILE_END THEN GOTO *DA_SAVE_LOOP00
24170 ON ERROR GOTO *DA_SAVE_FILE_CLOSE_ERR
24190 *DA_SAVE_EXIT_CLOSE
24200 CLOSE #1
24210 ON ERROR GOTO 0
24230 *DA_SAVE_EXIT
24240 OBJ(SYS_OBJ,20)=SYS_OBJ
24250 RETURN
24260 'ERROR ｼｮﾘ
24280 *DA_SAVE_FILE_OPEN_ERR
24300 *DA_SAVE_FILE_CLOSE_ERR:RET=1
24310 RESUME *DA_SAVE_EXIT
24330 *DA_SAVE_FWRITE_ERR:RET=1
24340 RESUME *DA_SAVE_EXIT_CLOSE
24350 '-----[ DA_LOAD ]-----------
24360 ' 音内部形式をロードする
24370 ' ENTRY
24380 '   DA_FILE_TRACK:ロードするトラック
24390 '                      BITでMSBが15トラック
24400 '                           LSBが0トラック
24410 '   FILENAME$    :ふぁいる名
24420 '
24440 *DA_LOAD
24450 RET=0:IF DA_FILE_TRACK=0 THEN RETURN
24460 Y=0
24470 ON ERROR GOTO *DA_LOAD_FILE_OPEN_ERR
24480 OPEN FILENAME$ FOR INPUT AS #1
24490 ON ERROR GOTO *DA_LOAD_FREAD_ERR
24500 SYS_OBJ=255:SYS_MES_MODE=&B1000
24510 SYS_MES_TITLE$="ｵﾝｶﾞｸ ﾃﾞｰﾀ ﾖﾐｺﾐ":SYS_MES_MESSAGE$=""
24520 GOSUB *SYS_MES_DRAW:GOSUB *SYS_MES_SHOW
24530 FREAD #1,F$,5:IF F$<>"音000" THEN ERROR 1     :'音形式?
24540 FREAD #1,F$,2
24550 'HEADERﾌﾞﾌﾞﾝﾉﾖﾐｺﾐ
24560 DA_LOAD_L=ASC(LEFT$(F$,1))*256+ASC(RIGHT$(F$,1))
24570 FREAD #1,F$,80:COPYRIGHT$=LEFT$(F$,80)
24580 '
24590 IF DA_LOAD_L<>80 THEN
24600  FREAD #1,FILE$,(DA_LOAD_L-80):N_FILE$=FILE$
24610 ENDIF
24620 '
24630 FREAD #1,F$,2:MAX_F=ASC(LEFT$(F$,1))*256+ASC(RIGHT$(F$,1))-1
24640 FOR DA_TRK=0 TO MAX_F
24650  FREAD #1,F$,2:GLOBAL_PRPTY(DA_TRK,0)=ASC(LEFT$(F$,1))*256+ASC(RIGHT$(F$,1))
24660  FREAD #1,F$,2:GLOBAL_PRPTY(DA_TRK,1)=ASC(LEFT$(F$,1))*256+ASC(RIGHT$(F$,1)):'ﾃﾝﾎﾟ
24670  FREAD #1,F$,2:GLOBAL_PRPTY(DA_TRK,2)=ASC(LEFT$(F$,1))*256+ASC(RIGHT$(F$,1)):'ｶｸﾁｮｳﾖｳ
24680  FREAD #1,F$,2:GLOBAL_PRPTY(DA_TRK,3)=ASC(LEFT$(F$,1))*256+ASC(RIGHT$(F$,1)):'ｶｸﾁｮｳﾖｳ
24690 NEXT
24700 'ｵﾝｶﾞｸﾌﾞﾌﾞﾝﾉﾖﾐｺﾐ
24710 DA_FILE_START=0:DA_FILE_END=65535
24720 DA_TEMP=DA_FILE_START-1
24740 *DA_LOAD_LOOP00
24750  FREAD #1,F$,5
24760  DA_LOAD_L=ASC(MID$(F$,4,1))*256+ASC(MID$(F$,5,1))
24770  DA_CH=ASC(LEFT$(F$,1))
24780  IF DA_LOAD_L<>0 THEN
24790   FREAD #1,DA_DATA$,DA_LOAD_L
24800   IF (DA_FILE_TRACK AND (2^DA_CH)) THEN
24810    GOSUB *DALINK_ADD:Y=1
24820    SYS_MES_MESSAGE$="           "+CHR$(13)+CHR$(10)+"ﾄﾗｯｸ :"+MID$(STR$(DA_CH+1)+"  ",2,3)+CHR$(13)+CHR$(10)+"ﾌﾚｰｽﾞ:"+MID$(STR$(G_MAX_FR(DA_CH))+"  ",2,3)
24830    GOSUB *SYS_MES_DRAW1
24840   ENDIF
24850  ENDIF
24860 IF LOF(#1)>LOC(#1) GOTO *DA_LOAD_LOOP00
24870 '
24880 ON ERROR GOTO *DA_LOAD_FILE_CLOSE_ERR
24900 *DA_LOAD_EXIT_CLOSE
24910 CLOSE #1
24930 *DA_LOAD_EXIT
24940 ON ERROR GOTO 0
24950 IF RET=0 THEN SYS_MES_MESSAGE$="ﾈｲﾛｾｯﾄ:LIST":GOSUB *SYS_MES_DRAW:GOSUB *SET_NEIROLIST
24960 IF RET=0 THEN SYS_MES_MESSAGE$="ﾈｲﾛｾｯﾄ:TARG":GOSUB *SYS_MES_DRAW:GOSUB *SET_NEIROSET
24970 OBJ(SYS_OBJ,20)=SYS_OBJ
24980 IF Y=0 THEN DA_CH=0:DA_DATA$="":GOSUB *DALINK_ADD
24982 GOSUB *DRAW_NEIRO
24984 GOSUB *SETNEIRO2ED_TAMA
24990 RETURN
25000 'ERROR ｼｮﾘ
25020 *DA_LOAD_FILE_OPEN_ERR
25040 *DA_LOAD_FILE_CLOSE_ERR:RET=1
25050 RESUME *DA_LOAD_EXIT
25070 *DA_LOAD_FREAD_ERR:RET=1
25080 RESUME *DA_LOAD_EXIT_CLOSE
25090 '-----[ GET_TRACK_OTO ]-----
25100 '1ｼｮｳｾﾂ ｦ OTOｹｲｼｷﾃﾞ ｼｭﾄｸ ｽﾙ
25110 '  ENTRY: DA_CH : ﾄﾗｯｸ  ﾊﾞﾝｺﾞｳ
25120 '         DA_FR : ｼｮｳｾﾂ ﾊﾞﾝｺﾞｳ
25130 '  RETURN:ED_TAMA(x,0) : TONE   (-1 - 127)
25140 '         ED_TAMA(x,1) : LENGTH (-1 - 32)
25150 '         ED_TAMA(x,2) : VOLUME ( 0 - 15)
25160 '         ED_TAMA(x,3) : PANPOT ( 0 - 15)
25170 '         ED_TAMA(x,4) : PITCH  ( 0 - 15)
25180 '         ED_TAMA(x,5) : PROGRAM( 0 - 127)
25190 '         ED_TAMA(x,6) : DAMPER( 0 - 127)
25210 *GET_TRACK_OTO
25220 GOSUB *DALINK_SEARCH : 'ｼｮｳｾﾂ ｦ ｻｰﾁ RET:DA_FR
25230 GOSUB *DA_TRK2OTO    : 'ｶｸﾉｳｹｲｼｷ => OTOｹｲｼｷ
25240 PAT_L=GLOBAL_PRPTY(G_FR,0) \ 16    :'ﾋﾀﾞﾘｶﾞﾜﾘｬｯｷ
25250 PAT_R=GLOBAL_PRPTY(G_FR,0) AND &HF :'ﾐｷﾞｶﾞﾜﾘｬｯｷ
25260 S_TEMPO=GLOBAL_PRPTY(G_FR,1)       :'ﾃﾝﾎﾟ
25270 RETURN
25280 '  ENTRY: DA_FR : ｼｮｳｾﾂ ﾊﾞﾝｺﾞｳ
25290 '         DA_CH : ﾄﾗｯｸ  ﾊﾞﾝｺﾞｳ
25310 *DA_TRK2OTO
25320 'ｼｮｷｶ
25330 FOR I=0 TO TAMA_Q-1
25340  ED_TAMA(I,0)=-1:ED_TAMA(I,1)=-1
25350  FOR K=2 TO 7:ED_TAMA(I,K)=ED_TAMA(TAMA_Q,K):NEXT
25360 NEXT
25370 'ﾊﾟﾗﾒｰﾀ ﾊﾝｲｶﾞｲ
25380 IF DA_FR<0 OR DA_FR>60000 OR DA_CH<0 OR DA_CH>15 THEN RETURN
25390 DAT2M_$=DATA_TRACK$(DA_CH,DA_FR)
25400 DAT2M_I=5
25410 V=127
25420 P=64
25430 S_NEIRO=0
25440 D=0
25450 PIT=64
25470 *DA_TRK2MMLLOP0
25480 IF LEN(DAT2M_$)>=DAT2M_I THEN
25490  DAT2M_TMP=ASC(MID$(DAT2M_$,DAT2M_I,1))
25500  IF DAT2M_TMP>=&H80 AND DAT2M_TMP<>255 THEN
25510    KKK=ASC(MID$(DAT2M_$,DAT2M_I+1,1))
25520    'ﾌﾟﾛﾊﾟﾃｨ
25530    IF DAT2M_TMP=&H80 THEN
25540      POSI=ASC(MID$(DAT2M_$,DAT2M_I+1,1))*256+ASC(MID$(DAT2M_$,DAT2M_I+2,1)):'OFFSET
25550      DAT2M_I=DAT2M_I+1
25560    ENDIF
25570    I=POSI \ 60
25580    IF DAT2M_TMP=&H81 THEN V=KKK:FOR KKK=I TO TAMA_Q-1:ED_TAMA(KKK,2)=V\8:NEXT :'ﾍﾞﾛｼﾁ
25590    IF DAT2M_TMP=&H82 THEN P=KKK:FOR KKK=I TO TAMA_Q-1:ED_TAMA(KKK,3)=P\8:NEXT :'ﾊﾟﾝ
25600    IF DAT2M_TMP=&H84 THEN S_NEIRO=KKK:FOR KKK=I TO TAMA_Q-1:ED_TAMA(KKK,5)=S_NEIRO:NEXT :'ﾈｲﾛ
25610    IF DAT2M_TMP=&H85 THEN D=KKK:FOR KKK=I TO TAMA_Q-1:ED_TAMA(KKK,6)=D:NEXT :'ﾀﾞﾝﾊﾟｰｽｲｯﾁ
25620    IF DAT2M_TMP=&H90 THEN PIT=KKK:FOR KKK=I TO TAMA_Q-1:ED_TAMA(KKK,4)=PIT\8:NEXT
25630    IF DAT2M_TMP=&HA0 THEN KKK=KKK-128:SIG_=SGN(KKK):SIG=ABS(KKK):IF SIG_=0 THEN SIG_=1
25640    DAT2M_I=DAT2M_I+2
25650  ELSE
25660    'ｵﾀﾏｼﾞｬｸｼ
25670    TAMA_NOTE=DAT2M_TMP:IF TAMA_NOTE=255 THEN TAMA_NOTE=-1
25680    L=ASC(MID$(DAT2M_$,DAT2M_I+1,1))*256+ASC(MID$(DAT2M_$,DAT2M_I+2,1))
25690    GOSUB *DAT2O_SET
25700    DAT2M_I=DAT2M_I+3
25710  ENDIF
25720  GOTO *DA_TRK2MMLLOP0
25730 ENDIF
25740 '
25750 RETURN
25760 'ﾀﾏ ｦ ｵｸ
25780 *DAT2O_SET
25790 I=(POSI \ 60)
25800 ED_TAMA(I,0)=TAMA_NOTE
25810 ED_TAMA(I,1)=L \ 60
25820 FOR KKK=0 TO ED_TAMA(I,1)-1
25830  IF (I+KKK) <= TAMA_Q THEN
25835   ED_TAMA(I+KKK,2)=V\8
25840   ED_TAMA(I+KKK,3)=P\8
25850   ED_TAMA(I+KKK,4)=PIT\8
25860   ED_TAMA(I+KKK,5)=S_NEIRO
25870   ED_TAMA(I+KKK,6)=D
25875  ENDIF
25880 NEXT
25890 RETURN
25900 '-----[ GET_TRACK_OTO ]-----
25910 '1ｼｮｳｾﾂ ｦ OTOｹｲｼｷﾃﾞ ｼｭﾄｸ ｽﾙ
25920 '  ENTRY: DA_CH : ﾄﾗｯｸ  ﾊﾞﾝｺﾞｳ
25930 '         DA_FR : ｼｮｳｾﾂ ﾊﾞﾝｺﾞｳ
25940 '         ED_TAMA(x,0) : TONE   (-1 - 127)
25950 '         ED_TAMA(x,1) : LENGTH (-1 - 32)
25960 '         ED_TAMA(x,2) : VOLUME ( 0 - 15)
25970 '         ED_TAMA(x,3) : PANPOT ( 0 - 15)
25980 '         ED_TAMA(x,4) : PITCH  ( 0 - 15)
25990 '         ED_TAMA(x,5) : PROGRAM( 0 - 127)
26000 '         ED_TAMA(x,6) : DAMPER( 0 - 127)
26020 *PUT_TRACK_OTO
26030 V=127
26040 P=64
26050 S_NEIRO=0
26060 D=0
26070 PIT=64
26080 DA_DATA$=""
26090 'ﾁｮｳ 0xA0 128+[MML S command]
26100 DA_DATA$=DA_DATA$+CHR$(&HA0)+CHR$(SIG_*SIG+128)
26110 '
26120 GLOBAL_PRPTY(G_FR,0)=PAT_L*16+PAT_R
26130 GLOBAL_PRPTY(G_FR,1)=S_TEMPO
26140 '
26150 FOR I=0 TO TAMA_Q-1
26160  DA_DATA$=DA_DATA$+CHR$(&H80)+STRW$(1,I*60)
26170  'ﾌﾟﾛﾊﾟﾃｨ
26180  IF V<>(ED_TAMA(I,2)*8) THEN V=ED_TAMA(I,2)*8:DA_DATA$=DA_DATA$+CHR$(&H81)+CHR$(ED_TAMA(I,2)*8)
26190  IF P<>(ED_TAMA(I,3)*8) THEN P=ED_TAMA(I,3)*8:DA_DATA$=DA_DATA$+CHR$(&H82)+CHR$(ED_TAMA(I,3)*8)
26200  IF S_NEIRO<>ED_TAMA(I,5) THEN S_NEIRO=ED_TAMA(I,5):DA_DATA$=DA_DATA$+CHR$(&H84)+CHR$(S_NEIRO)
26210  IF D<>ED_TAMA(I,6) THEN D=ED_TAMA(I,6):DA_DATA$=DA_DATA$+CHR$(&H85)+CHR$(ED_TAMA(I,6))
26220  IF PIT<>(ED_TAMA(I,4)*8) THEN PIT=ED_TAMA(I,4)*8:DA_DATA$=DA_DATA$+CHR$(&H90)+CHR$(ED_TAMA(I,4)*8)
26230  '
26240  IF ED_TAMA(I,1)<>-1 THEN
26250   IF ED_TAMA(I,0)=-1 THEN
26260    DA_DATA$=DA_DATA$+CHR$(255)+STRW$(1,ED_TAMA(I,1)*60)
26270   ELSE
26280    DA_DATA$=DA_DATA$+CHR$(ED_TAMA(I,0))+STRW$(1,ED_TAMA(I,1)*60)
26290   ENDIF
26300  ENDIF
26310 NEXT
26320 GOSUB *DALINK_SEARCH
26330 MID$(DATA_TRACK$(DA_CH,DA_FR),5)=DA_DATA$
26340 RETURN
26350 '-------------------
26360 'フェードアウト
26370 '-------------------
26390 *FADE_OUT :COLOROFS ON 0,1,4,10:FOR S_I=0 TO -255 STEP -5:COLOROFS (S_I,S_I,S_I):VSYNC :NEXT :RETURN
26410 *FADE_OUT0:COLOROFS ON 0,1,4,10:COLOROFS (-255,-255,-255):RETURN
26420 '-------------------
26430 'フェードイン
26440 '-------------------
26460 *FADE_IN :COLOROFS ON 0,1,4,10:FOR S_I=-255 TO 0 STEP 5:COLOROFS (S_I,S_I,S_I):VSYNC :NEXT :RETURN
26480 *FADE_IN0:COLOROFS ON 0,1,4,10:COLOROFS (0,0,0):RETURN
26490 '
26500 'ｷｰﾎﾞｰﾄﾞｱｸｾﾗﾚｰﾀﾉdata
26510 '
26530 *KEY_DEF
26540 DATA 99,99,99,99,99,99,99,99,99, 5,99, 0,99,99,99,99:'00
26550 DATA 99,99,99,99,99,99,99,99, 1,99,99,99, 3, 2,10,11:'10
26560 DATA 21,31,32,33,34,35,36,37,38,39,99,99,99,99,99,99:'20
26570 DATA 99,41,42,43,44,45,46,47,48,49,99,99,99,99,99,99:'30
26580 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'40
26590 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'50
26600 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'60
26610 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'70
26620 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'80
26630 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'90
26640 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'A0
26650 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'B0
26660 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'C0
26670 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'D0
26680 DATA 99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99:'E0
26690 DATA 99,99,99,99,99,99,99,99,99,99,13,12,99,99,99,99:'F0
26700 '=======================================
26710 '
26720 ' SB SYSTEM for Sofiya
26730 '            Version 0.03
26740 '
26750 ' Version 0.00
26760 '   ･｢ｶﾐ｣ﾖｳ ﾆ ｼｬﾄﾙﾏｳｽﾉﾆｭｳﾘｮｸﾙｰﾁﾝｦﾂｸｯﾀ
26770 '
26780 ' Version 0.01
26790 '   ･ｺﾝﾄﾛｰﾙﾊﾟｯﾄﾞ ﾓ ﾂｶｴﾙﾖｳﾆｼﾀ
26800 '
26810 ' Version 0.02
26820 '   ･LOCK,UNLOCKﾒｲﾚｲｶﾞ ﾃﾞｷﾀﾉﾃﾞｿﾚﾆﾀｲｵｳｼﾀ
26830 '   ･ｼｮｷｶﾙｰﾁﾝ ｦ ﾂｸｯﾀ
26840 '   ･ｼｮﾘﾁｭｳ ｶｰｿﾙ ｦ ﾂｲｶｼﾀ
26850 '   ･ｶﾝｲ ﾒｯｾｰｼﾞｳｲﾝﾄﾞｳ ｦ ﾂｲｶｼﾀ
26860 '             (ｿｰｽｶﾞｷﾀﾅｲｹﾄﾞｳｺﾞｸﾚﾍﾞﾙ)
26870 ' Version 0.03
26880 '   ･ﾁｮｯﾄﾀﾞｹｻｲﾃｷｶｼﾀ(ｿｰｽｶﾞｻﾗﾆｷﾀﾅｸﾅﾙ)
26890 '
26900 ' Version 0.04
26910 '   ･ﾋﾀﾞﾘﾎﾞﾀﾝﾀﾞﾌﾞﾙｸﾘｯｸﾆﾀｲｵｳｼﾀ
26920 '   ･ｼｬﾄﾙﾏｳｽﾉｲﾄﾞｳﾘｮｳｹｲｻﾝﾉﾐｽｦｼｭｳｾｲ
26930 '
26940 '=======================================
26950 '--[SYS_INIT]---------------------------
26960 ' ｼｽﾃﾑ ｦ ｼｮｷｶｼﾃﾂｶｴﾙﾖｳﾆｽﾙ
26970 ' WORK :
26980 '    SYS_I,SYS_J,A$
26990 ' RETURN :
27000 '---------------------------------------
27020 *SYS_INIT
27030 DIM EV(255,2)        :'ﾒｯｾｰｼﾞｷｭｰ ﾖｳ
27040 DIM SYS_MES_NAME$(2) :'ﾒｯｾｰｼﾞﾎﾞｯｸｽ ﾉ ﾎﾞﾀﾝﾉ ｷｬﾌﾟｼｮﾝｶｸﾉｳﾖｳ
27050 DIM SYS_DEV$(6)      :'ﾌｧｲﾙｾﾝﾀｸﾃﾞﾊﾞｲｽﾖｳ
27060 PRINT "GAME BASIC for SEGASATURN System "
27065 PRINT "                    for Sofiya   "
27070 PRINT "                     Version 1.20"
27080 PRINT :VSYNC 60
27090 SPRWINDOW,,,,,0,0
27100 'ｶｰｿﾙﾖｳﾉ ﾃｸｽﾁｬｦ ｾｯﾃｲｽﾙ
27110 RESTORE *SYS_DATA:READ SYS_K:DIM SYS_PATTERN$(SYS_K+1)
27120 FOR SYS_I=0 TO SYS_K:FOR SYS_J=1 TO 32
27130   READ A$:SYS_PATTERN$(SYS_I)=SYS_PATTERN$(SYS_I)+HEXBIN$(A$)
27140 NEXT :NEXT :A$=""
27150 'ﾒｯｾｰｼﾞﾎﾞｯｸｽﾖｳﾉ ｱｲｺﾝｦ ｾｯﾃｲｽﾙ
27160 READ SYS_K:DIM SYS_MSGICON$(SYS_K-1+1)
27170 FOR SYS_I=0 TO SYS_K-1
27190 *SYS_LOP1:READ A$:IF A$<>"ENDTEX" THEN SYS_MSGICON$(SYS_I)=SYS_MSGICON$(SYS_I)+HEXBIN$(A$):GOTO *SYS_LOP1
27200 NEXT :A$=""
27210 GOSUB *SYS_DEVICECHECK
27220 'ｼｽﾃﾑｳｲﾝﾄﾞｳﾖｳﾉﾃｸｽﾁｬｦｶｸﾎｽﾙ
27230 SYS_I=VERTEXID(-1):SETVERTEX,4,(-80,-20,0),(80,-20,0),(80,20,0),(-80,20,0)
27240 SYS_POLYGONID=POLYGONID(-1):SETPOLYGON,1,SYS_I,,(0,1,2,3)
27250 SYS_I=VERTEXID(-1):SETVERTEX,4,(-120,-40,0),(120,-40,0),(120,40,0),(-120,40,0)
27260 SYS_POLYGONID1=POLYGONID(-1):SETPOLYGON,1,SYS_I,,(0,1,2,3)
27270 SYS_TEXID=TEXID(-1):SETTEX,160,40,256
27280 SYS_TEXID1=TEXID(-1):SETTEX,240,80,256
27290 SYS_WINDOW=ATRID(-1):SETATR,1,(0,0,3,SYS_TEXID,0,0)
27300 SYS_WINDOW1=ATRID(-1):SETATR,1,(0,0,3,SYS_TEXID1,0,0)
27310 OBJ(255,0)=7,,,,-16,-16:RETURN
27320 '--[SYS_MOUSEPOINTER]-------------------
27330 ' ｼｬﾄﾙﾏｳｽ ﾉ ﾎﾟｲﾝﾀ ﾉ ｹｲｼﾞｮｳｦｶｴﾙ
27340 ' ENTRY :
27350 '    MOUSEPOINTER  0  ﾌﾂｳﾉﾎﾟｲﾝﾀ
27360 '                  1  ｼｮﾘﾏﾁﾉﾎﾟｲﾝﾀ
27370 ' WORK :
27380 ' RETURN :
27390 '---------------------------------------
27410 *SYS_MOUSEPOINTER
27420 LOCK
27430 IF MOUSEPOINTER=0 THEN
27440  INTERVAL (1) OFF
27450  SYS_POINTERTYPE=0:SETTEX 0,32,32,16,SYS_PATTERN$(0)
27460 ELSE
27470  INTERVAL (1) ON,5
27480  SYS_POINTERTYPE=1:SYS_POINTERANIME=0:SETTEX 0,32,32,16,SYS_PATTERN$(1)
27490 ENDIF
27500 UNLOCK :RETURN
27520 *SYS_ANIME
27530 IF SYS_POINTERTYPE=1 THEN
27540  LOCK :SETTEX 0,32,32,16,SYS_PATTERN$(SYS_POINTERANIME+1):SYS_POINTERANIME=SYS_POINTERANIME XOR 1:UNLOCK
27550 ENDIF
27560 RETURN
27570 '--[SYS_DEVICECHECK]--------------------
27580 'ﾆｭｳﾘｮｸｿｳﾁ ﾉ ｹﾝｼｭﾂ
27590 '
27600 ' WORK :
27610 '     SYS_I,SYS_J
27620 '
27630 ' RETURN :
27640 '     SPADMODE
27650 '     SKEYMODE
27660 '     SPADNO
27670 '     SKEYNO
27680 '---------------------------------------
27700 *SYS_DEVICECHECK
27710 PRINT "ﾆｭｳﾘｮｸ ｿｳﾁ ｹﾝｼｭﾂ":PRINT
27720 FOR SYS_I=28 TO 0 STEP -1
27730  SYS_J=PAD(SYS_I,0)
27740  IF SYS_J>=&H0  AND SYS_J<=&HF   AND SPADMODE<>2 THEN SPADNO=SYS_I:SPADMODE=1:PRINT "#";SYS_I;" ｺﾝﾄﾛｰﾙﾊﾟｯﾄﾞ ｦ ﾆﾝｼｷｼﾏｼﾀ｡"
27750  IF SYS_J>=&HE0 AND SYS_J<=&HFE THEN SPADNO=SYS_I:SPADMODE=2:PRINT "#";SYS_I;" ｼｬﾄﾙﾏｳｽ ｦ ﾆﾝｼｷｼﾏｼﾀ｡"
27760  IF SYS_J>=&H30 AND SYS_J<=&HDF THEN SKEYNO=SYS_I:SKEYMODE=1:PRINT "#";SYS_I;" ｾｶﾞｻﾀｰﾝｷｰﾎﾞｰﾄﾞ ｦ ﾆﾝｼｷｼﾏｼﾀ｡"
27770 NEXT
27780 IF SPADMODE<>0 THEN
27790  OBJ(1,0)=7:OBJ(1,16)=0,0:OBJ(1,20)=0:OBJ(1,12)=.5,.5:OBJ(1,6)=-4
27800  COLOR,15,0:CLS 30:OBJ(100,0)=7,,,,6,-4,,,,,,,,,,,20,20,,,1
27810  ON INTERVAL (1) GOSUB *SYS_ANIME
27820  IF SPADMODE=1 THEN ON INTERVAL (0) GOSUB *SYS_PAD
27830  IF SPADMODE=2 THEN ON INTERVAL (0) GOSUB *SYS_MOUSE
27840 ELSE
27850  COLOR 2:PRINT "ﾆｭｳﾘｮｸ ｿｳﾁ ｶﾞ ﾐﾂｶﾘﾏｾﾝ":COLOR 7:SCREEN 0:END
27860 ENDIF
27870 VSYNC 20:RETURN
27880 '========================
27890 'ｺﾝﾄﾛｰﾙﾊﾟｯﾄﾞﾉ ﾆｭｳﾘｮｸｼｮﾘ
27900 '========================
27910 ' 
27920 ' WORK :
27930 '   MB..PAD         ﾉ ｼﾞｮﾀｲ 
27940 '   MX..ｼｬﾄﾙﾏｳｽ ﾎﾟｲﾝﾀ X ｻﾞﾋｮｳ
27950 '   MY..ｼｬﾄﾙﾏｳｽ ﾎﾟｲﾝﾀ Y ｻﾞﾋｮｳ
27960 '   BR..ﾐｷﾞﾎﾞﾀﾝ (C) ﾉ ｼﾞｮｳﾀｲ
27970 '   BC..ﾏﾝﾅｶﾎﾞﾀﾝ(B) ﾉ ｼﾞｮｳﾀｲ
27980 '   BL..ﾋﾀﾞﾘﾎﾞﾀﾝ(A) ﾉ ｼﾞｮｳﾀｲ
27990 '   BS..ｽﾀｰﾄﾎﾞﾀﾝ    ﾉ ｼﾞｮｳﾀｲ
28000 '
28010 '   MX2..ｼｬﾄﾙﾏｳｽ ﾎﾟｲﾝﾀ X ｻﾞﾋｮｳ (ﾏｴ)
28020 '   MY2..ｼｬﾄﾙﾏｳｽ ﾎﾟｲﾝﾀ Y ｻﾞﾋｮｳ (ﾏｴ)
28030 '   MR..ﾐｷﾞﾎﾞﾀﾝ (C) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28040 '   MC..ﾏﾝﾅｶﾎﾞﾀﾝ(B) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28050 '   ML..ﾋﾀﾞﾘﾎﾞﾀﾝ(A) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28060 '   MS..ｽﾀｰﾄﾎﾞﾀﾝ    ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28070 '
28080 '   TR..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28090 '   TC..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28100 '   TL..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28110 '   TS..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28120 '
28130 '   EV(x,0)..ｲﾍﾞﾝﾄ ﾉ ｼｭﾙｲ
28140 '   EV(x,1)..ｲﾍﾞﾝﾄﾉｵｷﾀ ｼｬﾄﾙﾏｳｽﾉ X ｻﾞﾋｮｳ
28150 '   EV(x,2)..ｲﾍﾞﾝﾄﾉｵｷﾀ ｼｬﾄﾙﾏｳｽﾉ Y ｻﾞﾋｮｳ
28160 '
28180 *SYS_PAD
28190 LOCK :MB=PAD(SPADNO,1)
28200 IF (MB AND &H40) THEN MV=8 ELSE MV=1
28210 IF (MB AND &H8000) THEN MX=MX+MV+1 ELSE IF (MB AND &H4000) THEN MX=MX-MV-1
28220 IF (MB AND &H2000) THEN MY=MY+MV+1 ELSE IF (MB AND &H1000) THEN MY=MY-MV-1
28230 IF MX<0 THEN MX=0 ELSE IF MX>319 THEN MX=319
28240 IF MY<0 THEN MY=0 ELSE IF MY>223 THEN MY=223
28250 OBJ(1,4)=MX,MY
28260 BR=MB AND &H200:BC=MB AND &H100:BL=MB AND &H400:BS=MB AND &H800
28270 IF MX2<>MX OR MY2<>MY THEN EV(EW,0)=-2:GOSUB *QIN_M:MX2=MX:MY2=MY
28280 IF MR AND BR=0 THEN EV(EW,0)=5:GOSUB *QIN
28290 IF MR=0 AND BR THEN EV(EW,0)=4:GOSUB *QIN:TR=15 ELSE TR=TR+(TR>0)
28300 IF BR=0 AND MR AND TR>1 THEN EV(EW,0)=6:GOSUB *QIN:TR=0
28310 IF ML AND BL=0 THEN EV(EW,0)=1:MDC1L=0:GOSUB *QIN
28320 IF BL AND ML=0 THEN EV(EW,0)=0:GOSUB *QIN:TL=14:MDXL=MX:MDYL=MY ELSE TL=TL+(TL>0):IF TL=0 THEN MDCL=0
28330 IF ML AND BL=0 AND TL>1 AND MDC1L=0 THEN
28340   IF ABS(MDXL-MX)<=2 AND ABS(MDYL-MY)<=2 THEN
28350     MDCL=MDCL+1:MDC1L=1
28360     IF MDCL=1 THEN EV(EW,0)=2:GOSUB *QIN
28370     IF MDCL=2 THEN EV(EW,0)=3:GOSUB *QIN:TL=0
28380   ELSE
28390       MDC1L=0:TL=0
28400   ENDIF
28410 ENDIF
28420 IF MC AND BC=0 THEN EV(EW,0)=9:GOSUB *QIN
28430 IF MC=0 AND BC THEN EV(EW,0)=8:GOSUB *QIN:TC=15 ELSE TC=TC+(TC>0)
28440 IF BC=0 AND MC AND TC>1 THEN EV(EW,0)=10:GOSUB *QIN:TC=0
28450 IF MS=0 AND BS THEN TS=15 ELSE TS=TS+(TS>0)
28460 IF BS=0 AND MS AND TS>1 THEN TS=0:EV(EW,0)=12:GOSUB *QIN
28470 MR=BR:ML=BL:MC=BC:MS=BS:UNLOCK :RETURN
28480 '========================
28490 ' ｼｬﾄﾙﾏｳｽ ﾉ ﾆｭｳﾘｮｸ ｼｮﾘ
28500 '========================
28510 '
28520 ' WORK :
28530 '   MB..PAD         ﾉ ｼﾞｮﾀｲ 
28540 '   MX..ｼｬﾄﾙﾏｳｽ ﾎﾟｲﾝﾀ X ｻﾞﾋｮｳ
28550 '   MY..ｼｬﾄﾙﾏｳｽ ﾎﾟｲﾝﾀ Y ｻﾞﾋｮｳ
28560 '   BR..ﾐｷﾞﾎﾞﾀﾝ (C) ﾉ ｼﾞｮｳﾀｲ
28570 '   BC..ﾏﾝﾅｶﾎﾞﾀﾝ(B) ﾉ ｼﾞｮｳﾀｲ
28580 '   BL..ﾋﾀﾞﾘﾎﾞﾀﾝ(A) ﾉ ｼﾞｮｳﾀｲ
28590 '   BS..ｽﾀｰﾄﾎﾞﾀﾝ    ﾉ ｼﾞｮｳﾀｲ
28600 '
28610 '   MX2..ｼｬﾄﾙﾏｳｽ ﾎﾟｲﾝﾀ X ｻﾞﾋｮｳ (ﾏｴ)
28620 '   MY2..ｼｬﾄﾙﾏｳｽ ﾎﾟｲﾝﾀ Y ｻﾞﾋｮｳ (ﾏｴ)
28630 '   MR..ﾐｷﾞﾎﾞﾀﾝ (C) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28640 '   MC..ﾏﾝﾅｶﾎﾞﾀﾝ(B) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28650 '   ML..ﾋﾀﾞﾘﾎﾞﾀﾝ(A) ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28660 '   MS..ｽﾀｰﾄﾎﾞﾀﾝ    ﾉ ｼﾞｮｳﾀｲ(ﾏｴ)
28670 '
28680 '   TR..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28690 '   TC..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28700 '   TL..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28710 '   TS..ﾐｷﾞﾎﾞﾀﾝ ﾀｲﾏ (ｸﾘｯｸ ﾆ ｼﾖｳ)
28720 '
28730 '   EV(x,0)..ｲﾍﾞﾝﾄ ﾉ ｼｭﾙｲ
28740 '   EV(x,1)..ｲﾍﾞﾝﾄﾉｵｷﾀ ｼｬﾄﾙﾏｳｽﾉ X ｻﾞﾋｮｳ
28750 '   EV(x,2)..ｲﾍﾞﾝﾄﾉｵｷﾀ ｼｬﾄﾙﾏｳｽﾉ Y ｻﾞﾋｮｳ
28760 '
28780 *SYS_MOUSE
28790 LOCK :MX1=PAD(SPADNO,3):MY1=PAD(SPADNO,4)
28800 MXV=MX1-MX0:IF MXV<-384 THEN MXV=65535-MX0+MX1 ELSE IF MXV>384 THEN MXV=65535+MX0-MX1
28810 MYV=MY1-MY0:IF MYV<-384 THEN MYV=65535-MY0+MY1 ELSE IF MYV>384 THEN MYV=65535+MY0-MY1
28820 MX=MX+MXV:MY=MY+MYV
28830 IF MX<0 THEN MX=0 ELSE IF MX>319 THEN MX=319
28840 IF MY<0 THEN MY=0 ELSE IF MY>223 THEN MY=223
28850 OBJ(1,4)=MX,MY
28860 MX0=MX1:MY0=MY1
28870 MB=PAD(SPADNO,1):BR=MB AND &H200:BC=MB AND &H100:BL=MB AND &H400:BS=MB AND &H800
28880 IF MX2<>MX OR MY2<>MY THEN EV(EW,0)=-2:GOSUB *QIN_M:MX2=MX:MY2=MY
28890 IF MR AND BR=0 THEN EV(EW,0)=5:GOSUB *QIN
28900 IF MR=0 AND BR THEN EV(EW,0)=4:GOSUB *QIN:TR=15 ELSE TR=TR+(TR>0)
28910 IF BR=0 AND MR AND TR>1 THEN EV(EW,0)=6:GOSUB *QIN:TR=0
28920 IF ML AND BL=0 THEN EV(EW,0)=1:MDC1L=0:GOSUB *QIN
28930 IF BL AND ML=0 THEN EV(EW,0)=0:GOSUB *QIN:TL=14:MDXL=MX:MDYL=MY ELSE TL=TL+(TL>0):IF TL=0 THEN MDCL=0
28940 IF ML AND BL=0 AND TL>1 AND MDC1L=0 THEN
28950   IF ABS(MDXL-MX)<=2 AND ABS(MDYL-MY)<=2 THEN
28960     MDCL=MDCL+1:MDC1L=1
28970     IF MDCL=1 THEN EV(EW,0)=2:GOSUB *QIN
28980     IF MDCL=2 THEN EV(EW,0)=3:GOSUB *QIN:TL=0
28990   ELSE
29000       MDC1L=0:TL=0
29010   ENDIF
29020 ENDIF
29030 IF MC AND BC=0 THEN EV(EW,0)=9:GOSUB *QIN
29040 IF MC=0 AND BC THEN EV(EW,0)=8:GOSUB *QIN:TC=15 ELSE TC=TC+(TC>0)
29050 IF BC=0 AND MC AND TC>1 THEN EV(EW,0)=10:GOSUB *QIN:TC=0
29060 IF MS=0 AND BS THEN TS=15 ELSE TS=TS+(TS>0)
29070 IF BS=0 AND MS AND TS>1 THEN TS=0:EV(EW,0)=12:GOSUB *QIN
29080 MR=BR:ML=BL:MC=BC:MS=BS:UNLOCK :RETURN
29090 'ﾒｯｾｰｼﾞ ｷｭｰ ﾆ ﾒｯｾｰｼﾞ ｦ ｶｷｺﾑ
29110 *QIN_M
29120 IF EW<>0 THEN
29130  IF EV(EW-1,0)=-2 THEN EW=EW-1
29140 ELSE
29150  IF EV(255,0)=-2 AND ER<>0 THEN EW=255
29160 ENDIF
29180 *QIN:EV(EW,1)=MX:EV(EW,2)=MY:EW=(EW+1) AND 255:RETURN
29190 'ﾒｯｾｰｼﾞ ｷｭｰ ｶﾗ ﾒｯｾｰｼﾞｦ ﾖﾐｺﾑ
29210 *QOUT
29220 MMF$=INKEY$:IF MMF$<>"" THEN EVENT=-3:MMF=1:EVENTX=ASC(MMF$):RETURN
29230 IF MMF$="" AND MMF=1 THEN MMF=0:EVENT=-3:EVENTX=-1:RETURN
29240 IF ER=EW GOTO *QOUT
29250 LOCK :EVENT=EV(ER,0):EVENTX=EV(ER,1):EVENTY=EV(ER,2):EV(ER,0)=-99:ER=(ER+1) AND 255:UNLOCK :RETURN
29252 *QOUT1:IF ER=EW THEN RETURN
29254 EVENT=EV(ER,0):EVENTX=EV(ER,1):EVENTY=EV(ER,2):ER=(ER+1) AND 255:RETURN
29260 'ﾒｯｾｰｼﾞ ｷｭｰ ｦｸﾘｱｽﾙ
29280 *QCLEAR:LOCK :ER=EW:UNLOCK :RETURN
29290 '--[SYS_DEVICECHECK]--------------------
29300 'ﾒｯｾｰｼﾞﾎﾞｯｸｽｦﾋｮｳｼﾞｽﾙ
29310 '
29320 ' ENTRY :
29330 '     SYS_MES_TITLE$   ﾀｲﾄﾙﾆﾋｮｳｼﾞｽﾙ ﾓｼﾞﾚﾂ
29340 '     SYS_MES_MESSAGE$ ﾋｮｳｼﾞｽﾙﾒｯｾｰｼﾞ
29350 '     SYS_MES_MODE
29360 '            1 ... ｶｲﾃﾝ  ﾋｮｳｼﾞ
29370 '            2 ... ｶｸﾀﾞｲ ﾋｮｳｼﾞ
29380 '            3 ... ---- (ｶｸﾁｮｳ ﾖｳ)
29390 '            4 ... ｵﾄｦ ﾀﾞｻﾅｲ
29400 '          5-7 ... ｱｲｺﾝﾉｼｭﾙｲ
29410 '                  0..ﾅｼ
29420 '                  1..ｹｲｺｸ
29430 '                  2..ﾄｲｶｹ
29440 '                  3..ｷｹﾝ(?)
29450 '                  4..----
29460 '                  5..----
29470 '                  6..----
29480 '                  7..----
29490 '          8-9 ... ﾎﾞﾀﾝ
29500 '                  0..ﾅｼ(ﾔｸ2ﾋﾞｮｳｶﾝﾋｮｳｼﾞ)
29510 '                  1..1ｺ
29520 '                  2..2ｺ
29530 '                  3..---
29540 ' WORK :
29550 '     SYS_I,SYS_J
29560 ' RETURN :
29570 '---------------------------------------
29590 *SYS_MESSAGEBOX
29600 SYS_OBJ=255
29610 GOSUB *SYS_MES_DRAW
29620 GOSUB *SYS_MES_SHOW
29630 'ﾆｭｳﾘｮｸﾏﾁ
29640 SYS_J=0
29650 IF SYS_MES_MODE AND &H180 THEN
29660  GOSUB *QCLEAR
29680 *SYS_MES_LOOP00
29690  GOSUB *QOUT 
29700  IF SYS_J<>0 THEN
29710    IF EVENT=1 THEN
29720      SYS_I=SYS_J-1:SYS_B=0:GOSUB *SYS_MES_BUTTONSUB
29730      IF ABS(EVENTX-209+SYS_I*56)<=25 AND ABS(EVENTY-124)<=5 THEN
29740        OBJ(SYS_OBJ,20)=SYS_OBJ:VSYNC :GOTO *QCLEAR
29750      ENDIF
29760      SYS_J=0
29770    ENDIF
29780    GOTO *SYS_MES_LOOP00
29790  ENDIF
29800  IF ABS(EVENTX-160)>80 OR ABS(EVENTY-112)>20 THEN
29810    IF MOUSEPOINTER=0 THEN MOUSEPOINTER=1:GOSUB *SYS_MOUSEPOINTER
29820    IF (EVENT MOD 4)=0 THEN BGM 0
29830    GOTO *SYS_MES_LOOP00
29840  ENDIF
29850  'ﾎﾞﾀﾝﾋｯﾄﾁｪｯｸ
29860  IF EVENT=0 AND ABS(EVENTY-124)<=5 THEN
29870    FOR SYS_I=0 TO (SYS_MES_MODE AND &H180)/&H80-1
29880      IF ABS(EVENTX-209+SYS_I*56)<=25 THEN SYS_B=1:GOSUB *SYS_MES_BUTTONSUB:SYS_J=SYS_I+1
29890    NEXT
29900  ENDIF
29910  IF SYS_J=0 AND MOUSEPOINTER=1 THEN MOUSEPOINTER=0:GOSUB *SYS_MOUSEPOINTER
29920  GOTO *SYS_MES_LOOP00
29930 ENDIF
29940 SYS_I=MOUSEPOINTER
29950 MOUSEPOINTER=1:GOSUB *SYS_MOUSEPOINTER:VSYNC 120
29960 MOUSEPOINTER=SYS_I:GOSUB *SYS_MOUSEPOINTER
29970 OBJ(SYS_OBJ,20)=SYS_OBJ:VSYNC :RETURN
29980 '
30000 *SYS_MES_BUTTONSUB
30010 SYS_MES$=SYS_MES_NAME$(SYS_I):SYS_X=104-SYS_I*56:GOTO *SYS_DRAW_BUTTON
30020 '
30040 *SYS_MES_SHOW
30050 SYS_I=1-(SYS_MES_MODE AND &H1):OBJ(SYS_OBJ,10)=0,,SYS_I,SYS_I
30060 IF SYS_MES_MODE AND &H3 THEN
30070   OBJ(SYS_OBJ,20)=0
30080   FOR SYS_I=0 TO 29
30090     IF SYS_MES_MODE AND &H1 THEN OBJ(SYS_OBJ,12)=SYS_I/29,SYS_I/29
30100     IF SYS_MES_MODE AND &H2 THEN OBJ(SYS_OBJ,10)=SYS_I/29
30110     VSYNC
30120   NEXT
30130 ENDIF
30140 IF (SYS_MES_MODE AND &H8)=0 THEN BGM 0
30150 OBJ(SYS_OBJ,20)=0:FOR SYS_I=0 TO 8:OBJ(SYS_OBJ,12)=1+(SYS_I AND 3)/160,1+(SYS_I AND 3)/160:VSYNC :NEXT :RETURN
30160 '
30180 *SYS_MES_DRAW
30190 OBJ(SYS_OBJ,4)=-1000,-1000:VSYNC 3:OBJ(SYS_OBJ,16)=SYS_WINDOW,SYS_POLYGONID
30200 ACTIVE 10+SYS_TEXID
30210 SYS_X=0:SYS_Y=0:SYS_SX=159:SYS_SY=39:SYS_B=0:SYS_MES$="":GOSUB *SYS_DRAW_BUTTON
30230 *SYS_MES_DRAW1
30240 SYS_Y=28:SYS_SX=50:SYS_SY=10:COLOR,15,8
30250 IF SYS_MES_MODE AND &H70 THEN
30260   IF (SYS_MES_MODE AND &H70)<=&H30 THEN GCOPY SYS_MSGICON$((SYS_MES_MODE AND &H70)/&H10-1) TO 10+SYS_TEXID,(4,4)
30270   KPRINT (40,2,0,-8,-8),FIX SYS_MES_TITLE$
30280 ELSE
30290   KPRINT (8,2,0,-8,-8),FIX SYS_MES_TITLE$
30300 ENDIF
30310 KPRINT FIX SYS_MES_MESSAGE$
30320 IF SYS_MES_MODE AND &H180 THEN
30330   FOR SYS_I=0 TO (SYS_MES_MODE AND &H180)/&H80-1
30340     SYS_MES$=SYS_MES_NAME$(SYS_I):SYS_X=104-SYS_I*56:GOSUB *SYS_DRAW_BUTTON
30350   NEXT
30360 ENDIF
30370 OBJ(SYS_OBJ,4)=160,112,-1:RETURN
30380 '------------------------------
30390 'ﾌｧｲﾙｾﾝﾀｸ ﾀﾞｲｱﾛｸﾞｦﾋｮｳｼﾞｽﾙ
30400 '------------------------------
30420 *SYS_FILESELECT:SYS_BASE=0:SYS_FLS_SEL=0
30430 SYS_DEV$(0)="BRAM":SYS_DEV$(1)="CRAM":SYS_DEV$(2)="FD0":SYS_DEV$(3)="FD1":SYS_DEV$(4)="COM":SYS_DEV$(5)="CD"
30440 OBJ(254,16)=SYS_WINDOW1,SYS_POLYGONID1:OBJ(254,4)=160,112,-1:OBJ(254,20)=0:OBJ(254,0)=7
30450 ACTIVE 10+SYS_TEXID1
30460 SYS_X=0:SYS_Y=0:SYS_SX=239:SYS_SY=79:SYS_B=0:SYS_MES$="":GOSUB *SYS_DRAW_BUTTON
30470 GOSUB *SYS_FLS_BUTTONDRAW:GOSUB *SYS_FLS_FILEDRAW
30480 SYS_X=184:SYS_Y=50:SYS_SX=52:SYS_SY=10:SYS_B=0:SYS_MES$="Ok":GOSUB *SYS_DRAW_BUTTON
30490 SYS_Y=64:SYS_MES$="Cancel":GOSUB *SYS_DRAW_BUTTON
30500 GOSUB *QCLEAR:SYS_CAPTURE=-1
30520 *SYS_FLS_LOP00
30530 GOSUB *QOUT
30540 IF SYS_CAPTURE=0 THEN GOSUB *SYS_FLS_UP:GOTO *SYS_FLS_LOP00
30550 IF SYS_CAPTURE=1 THEN GOSUB *SYS_FLS_DOWN:GOTO *SYS_FLS_LOP00
30560 IF SYS_CAPTURE=2 THEN GOSUB *SYS_FLS_OK:IF FLAG_CLICK=1 THEN GOTO *SYS_FLS_EXIT ELSE GOTO *SYS_FLS_LOP00
30570 IF SYS_CAPTURE=3 THEN GOSUB *SYS_FLS_CANCEL:IF FLAG_CLICK=1 THEN GOTO *SYS_FLS_EXIT ELSE GOTO *SYS_FLS_LOP00
30580 'HIT CHECK
30590 IF (EVENTX>226) AND EVENTX<278 THEN
30600   FLAG_CLICK=0
30610   IF (EVENTY>=123) AND EVENTY<=133 THEN GOSUB *SYS_FLS_OK
30620   IF (EVENTY>=137) AND EVENTY<=147 THEN GOSUB *SYS_FLS_CANCEL
30630 ENDIF
30640 IF (LEN(SYS_A$)>238) AND (EVENTX>=223) AND EVENTX<=235 THEN
30650   IF (EVENTY>=89)  AND EVENTY<=101 THEN GOSUB *SYS_FLS_UP:GOTO *SYS_FLS_LOP00
30660   IF (EVENTY>=102) AND EVENTY<=114 THEN GOSUB *SYS_FLS_DOWN:GOTO *SYS_FLS_LOP00
30670 ENDIF
30680 '
30690 IF EVENT=0 THEN
30700   IF (EVENTY>=77) AND (EVENTY<=86) AND INT((EVENTX-43)/32)<=5 THEN
30710     SYS_FLS_SEL=0:SYS_BASE=0
30720     IF INT((EVENTX-43)/32)<>SYS_TEMP THEN
30730       SYS_TEMP=INT((EVENTX-43)/32)
30740       GOSUB *SYS_FLS_BUTTONDRAW
30750     ENDIF
30760     GOSUB *SYS_FLS_FILEDRAW
30770   ENDIF
30780   IF (EVENTY>=90) AND (EVENTY<=145) AND (EVENTX>=44) AND EVENTX<=220 THEN
30790     SYS_FLS_SEL=INT((EVENTY-90)/8)*2-(EVENTX>=132)+SYS_BASE
30800     GOSUB *SYS_FLS_FILEDRAW1
30810     IF MID$(SYS_A$,SYS_FLS_SEL*17+1,10)="*ｼﾝｷ ｻｸｾｲ*" THEN
30820       SYS_X=7+(SYS_FLS_SEL AND 1)*88:SYS_Y=20+INT((SYS_FLS_SEL-SYS_BASE)/2)*8:GOSUB *SYS_FILENAMEINPUT
30830       IF SYS_CU=0 THEN SYS_FILENAME$=FILENAME$:GOTO *SYS_FLS_EXIT
30840       GOSUB *SYS_FLS_FILEDRAW:SYS_FILENAME$=""
30850       GOSUB *QCLEAR
30860     ENDIF
30870   ENDIF
30880 ENDIF
30890 'ﾀﾞﾌﾞﾙｸﾘｯｸ ﾉ ｼｮﾘ
30900 IF EVENT=3 THEN
30910   IF (EVENTY>=90) AND (EVENTY<=145) AND (EVENTX>=44) AND EVENTX<=220 THEN
30920     SYS_FLS_SEL=INT((EVENTY-90)/8)*2-(EVENTX>=132)+SYS_BASE
30930     GOSUB *SYS_FLS_FILEDRAW1
30940     FLAG_CLICK=1:GOSUB *SYS_FLS_OK1:GOTO *SYS_FLS_EXIT
30950   ENDIF
30960 ENDIF
30970 GOTO *SYS_FLS_LOP00
30990 *SYS_FLS_EXIT
31000 OBJ(254,20)=254
31010 GOSUB *QCLEAR
31020 RETURN
31040 *SYS_FLS_FILEDRAW
31050 SYS_X=2:SYS_Y=18:SYS_SX=176:SYS_SY=58:SYS_B=1:SYS_MES$="":GOSUB *SYS_DRAW_BUTTON
31060 ON ERROR GOTO *SYS_FLS_ERR1:SYS_DEV$=SYS_DEV$(SYS_TEMP)+":":IF SYS_EXT=0 THEN SYS_B$=""
31070 SYS_A$=SYS_B$+FILES$(SYS_DEV$+"*.D")
31080 IF (SYS_TEMP<>5) AND SYS_SAVEFLAG=1 THEN SYS_A$=SYS_A$+"*ｼﾝｷ ｻｸｾｲ*       "
31100 *SYS_FLS_EXIT1:ON ERROR GOTO 0
31120 *SYS_FLS_FILEDRAW1
31130 IF LEN(SYS_A$)>17*14+1 THEN
31140   SYS_X=181:SYS_Y=18:SYS_SX=12:SYS_SY=12:SYS_B=0:SYS_MES$=CHR$(250):GOSUB *SYS_DRAW_BUTTON
31150   SYS_Y=32:SYS_MES$=CHR$(251):GOSUB *SYS_DRAW_BUTTON
31160 ELSE
31170   LINE (181,18)-(193,44),8,BF
31180 ENDIF
31190 COLOR,1
31200 FOR SYS_I=0 TO 13
31210   COLOR,,14+(SYS_I<>SYS_FLS_SEL-SYS_BASE)*6
31220   IF MID$(SYS_A$,(SYS_I+SYS_BASE)*17+1,10)="*ｼﾝｷ ｻｸｾｲ*" THEN COLOR,4 ELSE COLOR,1
31230   KPRINT (7+(SYS_I AND 1)*88,20+INT(SYS_I/2)*8,0,-8,-8),FIX RIGHT$("          "+MID$(SYS_A$,(SYS_I+SYS_BASE)*17+1,10),10)
31240 NEXT
31250 COLOR,,-1
31260 RETURN
31280 *SYS_FLS_UP
31290 SYS_I=0
31300 SYS_X=181:SYS_Y=18:SYS_SX=12:SYS_SY=12:SYS_MES$=CHR$(250):GOSUB *DEF_BTN_FLS
31310 IF FLAG_CLICK=1 THEN
31320   SYS_BASE=SYS_BASE+(SYS_BASE>1)*2
31330   IF SYS_FLS_SEL>(SYS_BASE+13) THEN SYS_FLS_SEL=SYS_BASE+12+(SYS_FLS_SEL AND 1)
31340   GOSUB *SYS_FLS_FILEDRAW1
31350 ENDIF
31360 RETURN
31380 *SYS_FLS_DOWN
31390 SYS_I=1
31400 SYS_X=181:SYS_Y=32:SYS_SX=12:SYS_SY=12:SYS_MES$=CHR$(251):GOSUB *DEF_BTN_FLS
31410 IF (FLAG_CLICK=1) AND (LEN(SYS_A$)/17-14)>SYS_BASE THEN
31420   SYS_BASE=SYS_BASE+2:IF SYS_FLS_SEL<SYS_BASE THEN SYS_FLS_SEL=SYS_BASE+(SYS_FLS_SEL AND 1)
31430   GOSUB *SYS_FLS_FILEDRAW1
31440 ENDIF
31450 RETURN
31470 *SYS_FLS_OK
31480 SYS_I=2
31490 SYS_X=184:SYS_Y=50:SYS_SX=52:SYS_SY=10:SYS_MES$="Ok":GOSUB *DEF_BTN_FLS
31510 *SYS_FLS_OK1
31520 IF FLAG_CLICK=1 THEN SYS_FILENAME$=MID$(SYS_A$,SYS_FLS_SEL*17+1,10):IF SYS_FILENAME$="*ｼﾝｷ ｻｸｾｲ*" THEN SYS_FILENAME$=""
31530 RETURN
31550 *SYS_FLS_CANCEL
31560 SYS_I=3
31570 SYS_X=184:SYS_Y=64:SYS_SX=52:SYS_SY=10:SYS_MES$="Cancel":GOSUB *DEF_BTN_FLS
31580 IF FLAG_CLICK=1 THEN SYS_FILENAME$=""
31590 RETURN
31600 'ﾎﾞﾀﾝﾉﾋﾞｮｳｶﾞ
31620 *SYS_FLS_BUTTONDRAW
31630 FOR SYS_I=0 TO 5:SYS_B=-(SYS_TEMP=SYS_I):GOSUB *SYS_FLS_BUTTONSUB1:NEXT :RETURN
31650 *SYS_FLS_ERR1
31660 SYS_A$="":BEEP
31670 RESUME *SYS_FLS_EXIT1
31690 *SYS_FLS_ERR0
31700 SYS_MES_TITLE$="ｴﾗｰｶﾞﾊｯｾｲｼﾏｼﾀ"
31710 SYS_MES_MESSAGE$="ERROR No."+STR$(ERR)+CHR$(13)+CHR$(10)
31720 SYS_MES_MODE=&B100110011
31730 SYS_MES_NAME$(0)="ﾁｭｳｼ"
31740 SYS_MES_NAME$(1)="ｻｲｼｺｳ"
31750 GOSUB *SYS_MESSAGEBOX
31760 IF SYS_I=1 THEN RESUME ELSE RESUME *SYS_FLS_EXIT
31780 *SYS_FLS_BUTTONSUB1
31790 SYS_MES$=SYS_DEV$(SYS_I)
31800 SYS_X=SYS_I*32+3:SYS_Y=4:SYS_SX=32:SYS_SY=10:GOSUB *SYS_DRAW_BUTTON
31810 RETURN
31820 '
31830 'ﾎﾞﾀﾝｦ ﾋﾞｮｳｶﾞｽﾙ
31840 '
31860 *SYS_DRAW_BUTTON
31870 COLOR,15,8
31880 LINE (SYS_X,SYS_Y)-(SYS_X+SYS_SX,SYS_Y+SYS_SY),7-(SYS_B<>0)*8,B
31890 LINE (SYS_X+1,SYS_Y)-(SYS_X+SYS_SX,SYS_Y+SYS_SY-1),15+(SYS_B<>0)*8,B
31900 LINE (SYS_X+1,SYS_Y+1)-(SYS_X+SYS_SX-1,SYS_Y+SYS_SY-1),8,BF
31910 KPRINT (SYS_X+1-SYS_B+(SYS_SX-LEN(SYS_MES$)*8)/2,SYS_Y+1+SYS_B,0,-8,-8),FIX SYS_MES$
31920 RETURN
31940 *DEF_BTN_FLS
31950 FLAG_CLICK=0
31960 IF SYS_CAPTURE=SYS_I AND SYS_X<=(EVENTX-40) AND (SYS_X+SYS_SX)>=(EVENTX-40) AND SYS_Y<=(EVENTY-72) AND (SYS_Y+SYS_SY)>=(EVENTY-72) AND EVENT=1 THEN
31970   SYS_CAPTURE=-1
31980   SYS_B=0
31990   GOSUB *SYS_DRAW_BUTTON
32000   FLAG_CLICK=1
32010   RETURN
32020 ENDIF
32030 IF EVENT=1 THEN SYS_CAPTURE=-1:SYS_B=0:GOSUB *SYS_DRAW_BUTTON:RETURN
32040 IF (EVENT=0) AND SYS_CAPTURE=-1 THEN SYS_CAPTURE=SYS_I:SYS_B=1:GOSUB *SYS_DRAW_BUTTON:RETURN
32050 RETURN
32060 '
32080 *SYS_FILENAMEINPUT
32090 SYS_CU=1:SYS_C=1:SYS_C$="_0123456789ABCDEFGHIJLKMNOPQRSTUVWXYZ"
32100 FILENAME$="_       .D"
32120 *SYS_KEYCLEAR:IF INKEY$<>"" GOTO *SYS_KEYCLEAR
32130 GOSUB *QCLEAR
32140 SYS_X1=SYS_X:SYS_Y1=SYS_Y
32160 *FILESELECTLOP
32170 COLOR,1,14
32180 KPRINT (SYS_X1,SYS_Y1,0,-8,-8),FIX FILENAME$
32190 IF SKEYMODE=0 THEN
32200   COLOR,4
32210   KPRINT (SYS_X1+(SYS_CU-1)*8,SYS_Y1,0,-8,-8),FIX MID$(FILENAME$,SYS_CU,1)
32220   COLOR,1
32230   GOSUB *QOUT
32240   IF EVENT=6 THEN
32250     SYS_C=SYS_C+1:IF SYS_C>LEN(SYS_C$) THEN SYS_C=1
32260     MID$(FILENAME$,SYS_CU,1)=MID$(SYS_C$,SYS_C,1)
32270   ENDIF
32280   IF EVENT=10 THEN
32290     IF SYS_CU=1 THEN RETURN
32300     IF SYS_CU>1 THEN MID$(FILENAME$,SYS_CU,1)=" ":SYS_CU=SYS_CU-1:SYS_C=INSTR(SYS_C$,MID$(FILENAME$,SYS_CU,1))
32310   ENDIF
32320   IF (EVENT=0) AND SYS_CU<8 THEN SYS_CU=SYS_CU+1:MID$(FILENAME$,SYS_CU,1)=MID$(SYS_C$,SYS_C,1)
32330   IF EVENT=12 THEN SYS_CU=0:RETURN :' OK
32340 ELSE
32350   GOSUB *QOUT1
32360   SYS_K$=INKEY$
32370    'ｶｰｿﾙ ﾉ ｼｮﾘ
32380   IF SYS_CAPTURE=2 THEN GOSUB *SYS_FLS_OK_ENT    :IF FLAG_CLICK=1 THEN SYS_K$=CHR$(13)
32390   IF SYS_CAPTURE=3 THEN GOSUB *SYS_FLS_CANCEL_ENT:IF FLAG_CLICK=1 THEN SYS_K$=CHR$(27)
32400   'HIT CHECK
32410   IF (EVENTX>226) AND (EVENTX<278) AND SYS_CAPTURE=-1 THEN
32420     FLAG_CLICK=0
32430     IF (EVENTY>=123) AND EVENTY<=133 THEN GOSUB *SYS_FLS_OK_ENT    :IF FLAG_CLICK=1 THEN SYS_K$=CHR$(13)
32440     IF (EVENTY>=137) AND EVENTY<=147 THEN GOSUB *SYS_FLS_CANCEL_ENT:IF FLAG_CLICK=1 THEN SYS_K$=CHR$(27)
32450   ENDIF
32460   'ｷｰﾎﾞｰﾄﾞ ﾉ ｼｮﾘ
32470   IF SYS_K$="" GOTO *FILESELECTLOP
32475   IF SYS_K$>="a" AND SYS_K$<="z" THEN SYS_K$=CHR$(ASC(SYS_K$)-ASC("a")+ASC("A"))
32480   IF INSTR(SYS_C$,SYS_K$)<>0 THEN
32490     IF SYS_CU<=8 THEN MID$(FILENAME$,SYS_CU,1)=SYS_K$
32500     SYS_CU=SYS_CU-(SYS_CU<9)
32510   ENDIF
32520   IF SYS_K$=CHR$(8) OR SYS_K$=CHR$(29) THEN
32530     IF SYS_CU>1 THEN SYS_CU=SYS_CU-1:MID$(FILENAME$,SYS_CU,1)=" "
32540   ENDIF
32550   IF SYS_K$=CHR$(13) THEN SYS_CU=0:RETURN :' OK
32560   IF SYS_K$=CHR$(27) THEN SYS_CU=1:RETURN :' CANCEL
32570 ENDIF
32580 GOTO *FILESELECTLOP
32600 *SYS_FLS_OK_ENT    :SYS_I=2:SYS_X=184:SYS_Y=50:SYS_SX=52:SYS_SY=10:SYS_MES$="Ok"    :GOTO *DEF_BTN_FLS
32620 *SYS_FLS_CANCEL_ENT:SYS_I=3:SYS_X=184:SYS_Y=64:SYS_SX=52:SYS_SY=10:SYS_MES$="Cancel":GOTO *DEF_BTN_FLS
32630 'ファイル存在チェック
32631 *SYS_CHECKFILEEXIST
32632 RET=0
32633 ON ERROR GOTO *SYS_CHECKEX_ERR
32634 OPEN SYS_FILENAME$ FOR INPUT AS #1
32635 CLOSE #1
32636 RET=1
32637 *SYS_CHECKFILEEXIST0
32638 ON ERROR GOTO 0
32639 RETURN
32640 *SYS_CHECKEX_ERR
32641 RESUME *SYS_CHECKFILEEXIST0
32642 '
32650 *SYS_DATA
