12060 'ｸﾘｶｴｼｷｺﾞｳ ﾉ ﾋﾞｮｳｶﾞ
12070 '---------------------
12090 *DRAW_REPEAT_L
12100 LOCK :ACTIVE 30:ACTIVE 0:COLOR,16
12110 LINE (TAMA_X-7,TAMA_Y-34)-(TAMA_X-7,TAMA_Y-44),-1:LINE -(TAMA_X+64,TAMA_Y-44),-1:LOCATE 6,8:PRINT "  "
12120 LINE (TAMA_X-8,TAMA_Y-6)-(TAMA_X,TAMA_Y-30),-1,BF:LINE (TAMA_X-8,TAMA_Y+18)-(TAMA_X,TAMA_Y+42),-1,BF
12130 LINE (TAMA_X+176,TAMA_Y-44)-(318,TAMA_Y-44),-1:LINE -(318,TAMA_Y-38),-1:LOCATE 24,7:PRINT "   "
12140 LINE (TAMA_X+176,TAMA_Y+60)-(318,TAMA_Y+60),-1:LINE -(318,TAMA_Y+54),-1:LOCATE 24,20:PRINT "   "
12150 '
12160 OBJ(161,20)=161
12170 IF PAT=1 THEN
12180  '[ |: ]
12190  LINE (TAMA_X-8,TAMA_Y-6)-(TAMA_X-6,TAMA_Y-30),,BF:LINE (TAMA_X-3,TAMA_Y-6)-(TAMA_X-3,TAMA_Y-30)
12200  LINE (TAMA_X-1,TAMA_Y-21)-(TAMA_X,TAMA_Y-21):LINE (TAMA_X-1,TAMA_Y-15)-(TAMA_X,TAMA_Y-15)
12210  LINE (TAMA_X-8,TAMA_Y+18)-(TAMA_X-6,TAMA_Y+42),,BF:LINE (TAMA_X-3,TAMA_Y+18)-(TAMA_X-3,TAMA_Y+42)
12220  LINE (TAMA_X-1,TAMA_Y+27)-(TAMA_X,TAMA_Y+27):LINE (TAMA_X-1,TAMA_Y+33)-(TAMA_X,TAMA_Y+33)
12230 ENDIF
12240 IF PAT=2 THEN LINE (TAMA_X-7,TAMA_Y-34)-(TAMA_X-7,TAMA_Y-44):LINE -(TAMA_X+64,TAMA_Y-44):LOCATE 6,8:PRINT "1."
12250 IF PAT=3 THEN LINE (TAMA_X-7,TAMA_Y-34)-(TAMA_X-7,TAMA_Y-44):LINE -(TAMA_X+64,TAMA_Y-44):LOCATE 6,8:PRINT "2."
12260 IF PAT=4 THEN
12270  LINE (TAMA_X-8,TAMA_Y-6)-(TAMA_X-8,TAMA_Y-30):LINE (TAMA_X-4,TAMA_Y-6)-(TAMA_X-4,TAMA_Y-30)
12280  LINE (TAMA_X-8,TAMA_Y+18)-(TAMA_X-8,TAMA_Y+42):LINE (TAMA_X-4,TAMA_Y+18)-(TAMA_X-4,TAMA_Y+42)
12290  OBJ(161,20)=0:OBJ(161,4)=TAMA_X-16,TAMA_Y-56,,,,,,,,,,,17,17
12300 ENDIF
12310 IF PAT=5 THEN
12320  LINE (TAMA_X-8,TAMA_Y-6)-(TAMA_X-8,TAMA_Y-30):LINE (TAMA_X-4,TAMA_Y-6)-(TAMA_X-4,TAMA_Y-30)
12330  LINE (TAMA_X-8,TAMA_Y+18)-(TAMA_X-8,TAMA_Y+42):LINE (TAMA_X-4,TAMA_Y+18)-(TAMA_X-4,TAMA_Y+42)
12340  OBJ(161,20)=0:OBJ(161,4)=TAMA_X-16,TAMA_Y-56,,,,,,,,,,,19,19
12350 ENDIF
12360 UNLOCK
12370 RETURN
12380 '
12400 *DRAW_REPEAT_R
12410 LOCK
12420 ACTIVE 30:ACTIVE 0
12430 LINE (310,TAMA_Y-6)-(318,TAMA_Y-30),-1,BF:LINE (310,TAMA_Y+18)-(318,TAMA_Y+42),-1,BF
12440 OBJ(160,20)=160
12450 COLOR,16
12460 IF PAT=1 THEN
12470  '[ :| ]
12480  LINE (316,TAMA_Y-6)-(318,TAMA_Y-30),,BF:LINE (314,TAMA_Y-6)-(314,TAMA_Y-30)
12490  LINE (310,TAMA_Y-21)-(311,TAMA_Y-21):LINE (311,TAMA_Y-15)-(310,TAMA_Y-15)
12500  LINE (316,TAMA_Y+18)-(318,TAMA_Y+42),,BF:LINE (314,TAMA_Y+18)-(314,TAMA_Y+42)
12510  LINE (310,TAMA_Y+27)-(311,TAMA_Y+27):LINE (311,TAMA_Y+33)-(310,TAMA_Y+33)
12520 ENDIF
12530 IF PAT=2 THEN
12540  '[ D.S. ]
12550  OBJ(160,20)=0:OBJ(160,4)=285,TAMA_Y+47,,,,,,,,,,,18,18
12560  LINE (318,TAMA_Y-6)-(318,TAMA_Y-30):LINE (315,TAMA_Y-6)-(315,TAMA_Y-30)
12570  LINE (318,TAMA_Y+18)-(318,TAMA_Y+42):LINE (315,TAMA_Y+18)-(315,TAMA_Y+42)
12580 ENDIF
12590 IF PAT=3 THEN LINE (TAMA_X+176,TAMA_Y-44)-(318,TAMA_Y-44):LINE -(318,TAMA_Y-38):LOCATE 24,7:PRINT "8va"
12600 IF PAT=4 THEN LINE (TAMA_X+176,TAMA_Y+60)-(318,TAMA_Y+60):LINE -(318,TAMA_Y+54):LOCATE 24,20:PRINT "8va"
12610 UNLOCK
12620 RETURN
12630 'ﾁｮｳｦﾋﾞｮｳｶﾞｽﾙ
12650 *DRAW_SIGNITURE
12660 LOCK :ACTIVE 30:ACTIVE 0:LINE (9,TAMA_Y-40)-(46,TAMA_Y+48),-1,BF
12670 IF ARG1=0 THEN UNLOCK :RETURN
12680 IF ARG1>0 THEN RESTORE *SS1 ELSE RESTORE *SS2
12690 FOR I=1 TO ABS(ARG1)
12700  READ X,B:X=X+17
12710  Y=B+TAMA_Y-36:IF ARG1>0 THEN GOSUB *DRAW_SIGNITURE1 ELSE GOSUB *DRAW_SIGNITURE2
12720  Y=B+TAMA_Y+18:IF ARG1>0 THEN GOSUB *DRAW_SIGNITURE1 ELSE GOSUB *DRAW_SIGNITURE2
12730 NEXT
12740 UNLOCK
12750 RETURN
12770 *DRAW_SIGNITURE1:LINE (X,Y)-(X,Y+12),255:LINE (X+3,Y-1)-(X+3,Y+11),255:LINE (X-2,Y+4)-(X+5,Y+1),255:LINE (X-2,Y+10)-(X+5,Y+7),255:RETURN
12790 *DRAW_SIGNITURE2:LOCK :LINE (X,Y)-(X,Y+12),255:LINE -(X+3,Y+6),255:LINE -(X,Y+7),255:UNLOCK :RETURN
12810 *SS1:DATA 0,0, 4,9, 8,-3, 12,6, 16,15, 20,3, 24,12
12830 *SS2:DATA 0,9, 4,0, 8,12, 12,3, 16,15, 20,6, 24,18
12840 '
12850 '「調」変化時の臨時記号テーブルの初期化
12860 '
12880 *SET_SIGNITURE
12890 IF SIG_>=0 THEN
12900  FOR I=12 TO 115 STEP 12
12910   K=(I \ 12)*7-7
12920   KK=K  :IF SIG>=2 THEN N_SIG(I+0)=KK+256:N_SIG(I+1)=KK ELSE N_SIG(I+0)=KK :N_SIG(I+1)=KK+512
12930   KK=K+1:IF SIG>=4 THEN N_SIG(I+2)=KK+256:N_SIG(I+3)=KK ELSE N_SIG(I+2)=KK :N_SIG(I+3)=KK+512
12940   KK=K+2:IF SIG>=6 THEN N_SIG(I+4)=KK+256 ELSE N_SIG(I+4)=KK
12950   KK=K+3:IF SIG>=1 THEN N_SIG(I+5)=KK+256:N_SIG(I+6)=KK ELSE N_SIG(I+5)=KK :N_SIG(I+6)=KK+512
12960   KK=K+4:IF SIG>=3 THEN N_SIG(I+7)=KK+256:N_SIG(I+8)=KK ELSE N_SIG(I+7)=KK :N_SIG(I+8)=KK+512
12970   KK=K+5:IF SIG>=5 THEN N_SIG(I+9)=KK+256:N_SIG(I+10)=KK ELSE N_SIG(I+9)=KK :N_SIG(I+10)=KK+512
12980   KK=K+6:IF SIG>=7 THEN N_SIG(I+11)=KK+256 ELSE N_SIG(I+11)=KK
12990  NEXT
13000 ELSE
13010  FOR I=12 TO 115 STEP 12
13020   K=(I \ 12)*7-7
13030   KK=K  :IF SIG>=6 THEN N_SIG(I+0)=KK+256 ELSE N_SIG(I+0)=KK
13040   KK=K+1:IF SIG>=4 THEN N_SIG(I+1)=KK:N_SIG(I+2)=KK+256 ELSE N_SIG(I+1)=KK+768:N_SIG(I+2)=KK
13050   KK=K+2:IF SIG>=2 THEN N_SIG(I+3)=KK:N_SIG(I+4)=KK+256 ELSE N_SIG(I+3)=KK+768:N_SIG(I+4)=KK
13060   KK=K+3:IF SIG>=7 THEN N_SIG(I+5)=KK+256 ELSE N_SIG(I+5)=KK
13070   KK=K+4:IF SIG>=5 THEN N_SIG(I+6)=KK:N_SIG(I+7)=KK+256 ELSE N_SIG(I+6)=KK+768:N_SIG(I+7)=KK
13080   KK=K+5:IF SIG>=3 THEN N_SIG(I+8)=KK:N_SIG(I+9)=KK+256 ELSE N_SIG(I+8)=KK+768:N_SIG(I+9)=KK
13090   KK=K+6:IF SIG>=1 THEN N_SIG(I+10)=KK:N_SIG(I+11)=KK+256 ELSE N_SIG(I+10)=KK+768:N_SIG(I+11)=KK
13100  NEXT
13110 ENDIF
13120 RETURN
13130 '
13140 'ノート番号から位置を求める
13150 'ENTRY :ARG1
13160 'RETURN:RET
13180 *QUERYPOSTAMA
13190  IF ARG1<0 OR ARG1>127 THEN RET=-1:RETURN
13200  RET=N_SIG(ARG1) AND &HFF
13210 RETURN
13220 '
13230 '臨時記号を求める
13250 *QUERYSTATUS
13260  IF ARG1<0 OR ARG1>127 THEN RET=0:RETURN
13270  RET=N_SIG(ARG1) \ 256
13280 RETURN
13290 '臨時記号を設定する
13300 'ENTRY : ARG1 NOTE NO
13310 '        ARG2 SIG   0....なし
13320 '        ARG2 SIG   1....n
13330 '        ARG2 SIG   2....#
13340 '        ARG2 SIG   3....b
13360 *SETNEWSIGNITURE
13370  IF ARG2<=0 OR ARG1<0 THEN RETURN
13380  GOSUB *QUERYPOSTAMA
13390   IF (ARG1 MOD 12)=0 THEN
13400    'C
13410    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1+0)=RET:N_SIG(ARG1+1)=RET+512
13420    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1+0)=RET
13430    IF ARG2=2 THEN N_SIG(ARG1+0)=RET+256:N_SIG(ARG1+1)=RET
13440    IF ARG2=3 THEN N_SIG(ARG1+0)=RET+256
13450   ENDIF
13460   IF (ARG1 MOD 12)=1 THEN
13470    'C#
13480    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+512
13490    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1+0)=RET+768:N_SIG(ARG1+1)=RET
13500    IF ARG2=2 THEN N_SIG(ARG1-1)=RET+256:N_SIG(ARG1+0)=RET
13510    IF ARG2=3 THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+256
13520   ENDIF
13530   IF (ARG1 MOD 12)=2 THEN
13540    'D
13550    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+512
13560    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1-1)=RET+768:N_SIG(ARG1+0)=RET
13570    IF ARG2=2 THEN N_SIG(ARG1+0)=RET+256:N_SIG(ARG1+1)=RET
13580    IF ARG2=3 THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+256
13590   ENDIF
13600   IF (ARG1 MOD 12)=3 THEN
13610    'D#
13620    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+512
13630    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1+0)=RET+768:N_SIG(ARG1+1)=RET
13640    IF ARG2=2 THEN N_SIG(ARG1-1)=RET+256:N_SIG(ARG1+0)=RET
13650    IF ARG2=3 THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+256
13660  ENDIF
13670   IF (ARG1 MOD 12)=4 THEN
13680    'E
13690    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1)=RET
13700    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1-1)=RET+768:N_SIG(ARG1+0)=RET
13710    IF ARG2=2 THEN N_SIG(ARG1)=RET+256
13720    IF ARG2=3 THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+256
13730   ENDIF
13740   IF (ARG1 MOD 12)=5 THEN
13750    'F
13760    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+512
13770    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1+0)=RET
13780    IF ARG2=2 THEN N_SIG(ARG1+0)=RET+256:N_SIG(ARG1+1)=RET
13790    IF ARG2=3 THEN N_SIG(ARG1+0)=RET+256
13800   ENDIF
13810   IF (ARG1 MOD 12)=6 THEN
13820    'F#
13830    IF ARG2=1 AND SIG_=1 THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+512
13840    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1+0)=RET+768:N_SIG(ARG1+1)=RET
13850    IF ARG2=2 THEN N_SIG(ARG1-1)=RET+256:N_SIG(ARG1+0)=RET
13860    IF ARG2=3 THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+256
13870   ENDIF
13880   IF (ARG1 MOD 12)=7 THEN
13890    'F
13900    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+512
13910    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1-1)=RET+768:N_SIG(ARG1+0)=RET
13920    IF ARG2=2 THEN N_SIG(ARG1+0)=RET+256:N_SIG(ARG1+1)=RET
13930    IF ARG2=3 THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+256
13940   ENDIF
13950   IF (ARG1 MOD 12)=8 THEN
13960    'F#
13970    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+512
13980    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1+0)=RET+768:N_SIG(ARG1+1)=RET
13990    IF ARG2=2 THEN N_SIG(ARG1-1)=RET+256:N_SIG(ARG1+0)=RET
14000    IF ARG2=3 THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+256
14010   ENDIF
14020   IF (ARG1 MOD 12)=9 THEN
14030    'F
14040    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+512
14050    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1-1)=RET+768:N_SIG(ARG1+0)=RET
14060    IF ARG2=2 THEN N_SIG(ARG1+0)=RET+256:N_SIG(ARG1+1)=RET
14070    IF ARG2=3 THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+256
14080   ENDIF
14090   IF (ARG1 MOD 12)=10 THEN
14100    'F#
14110    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1-1)=RET    :N_SIG(ARG1+0)=RET+512
14120    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1+0)=RET+768:N_SIG(ARG1+1)=RET
14130    IF ARG2=2 THEN N_SIG(ARG1-1)=RET+256:N_SIG(ARG1+0)=RET
14140    IF ARG2=3 THEN N_SIG(ARG1+0)=RET    :N_SIG(ARG1+1)=RET+256
14150   ENDIF
14160   IF (ARG1 MOD 12)=11 THEN
14170    'B
14180    IF ARG2=1 AND SIG_=1  THEN N_SIG(ARG1)=RET
14190    IF ARG2=1 AND SIG_=-1 THEN N_SIG(ARG1-1)=RET+768:N_SIG(ARG1+0)=RET
14200    IF ARG2=2 THEN N_SIG(ARG1)=RET+256
14210    IF ARG2=3 THEN N_SIG(ARG1-1)=RET:N_SIG(ARG1+0)=RET+256
14220   ENDIF
14230 RETURN
14240 '---------------------
14250 'ﾎﾞﾘｭｰﾑｳｲﾝﾄﾞｳ ﾉ ﾋﾞｮｳｶﾞ
14260 '---------------------
14280 *DRAW_VOLUME:TEMP$="Vol":WIN(17,7)=0
14300 *DRAW_SUBWINDOW:LOCATE 2,25:PRINT TEMP$;
14310 Y=216:ACTIVE 30:ACTIVE 1:LINE (0,Y-16)-(319,Y),0,BF
14320 WIN(17,4)=1:WIN(17,0)=TAMA_X-24:WIN(17,1)=319:WIN(17,2)=Y-16:WIN(17,3)=Y
14330 K=TAMA_Q:IF SC_MODE=0 THEN A=(312-TAMA_X)/K ELSE A=8
14340 FOR I=TAMA_X TO TAMA_X+319 STEP A:LINE (I,Y-15)-(I+A-2,Y-15),9:LINE (I,Y-8)-(I+A-2,Y-8),9:NEXT
14350 LINE (0,Y)-(319,Y),9:FOR I=0 TO K:TEMP=I*A+TAMA_X:FOR K=0 TO 15 STEP 2:PSET (TEMP,Y-K),8:NEXT :NEXT
14360 GOSUB *DRAW_SUBWINDOW_CNT
14370 RETURN
14390 *DRAW_SUBWINDOW1
14400 Y=216:ACTIVE 30:ACTIVE 0
14410 IF SC_MODE=0 THEN K=(312-TAMA_X)/TAMA_Q ELSE K=8
14420 LINE (TAMA_X+K*CX,Y-16)-(TAMA_X+K*CX+K-1,Y),-1,BF
14430 IF CX=TAMA_Q THEN LINE (TAMA_X+K*CX,Y-CY)-(TAMA_X+K*CX+K-1,Y-CY),3:RETURN
14440 IF WIN(17,7)=2 AND CY=8 THEN LINE (TAMA_X+K*CX,Y-CY)-(TAMA_X+K*CX+K-1,Y-CY),15:RETURN
14450 IF WIN(17,7)<>1 THEN LINE (TAMA_X+K*CX,Y-CY)-(TAMA_X+K*CX+K-1,Y-CY),16:RETURN
14460 'PAN
14470 IF CY>8 THEN
14480  LINE (TAMA_X+K*CX,Y-CY)-(TAMA_X+K*CX+K-1,Y-CY),5
14490 ELSE
14500  IF CY=8 THEN
14510   LINE (TAMA_X+K*CX,Y-CY)-(TAMA_X+K*CX+K-1,Y-CY),15
14520  ELSE
14530   LINE (TAMA_X+K*CX,Y-CY)-(TAMA_X+K*CX+K-1,Y-CY),16
14540  ENDIF
14550 ENDIF
14560 RETURN
14570 '---------------------
14580 'ﾚﾝｸﾞｽ ｳｲﾝﾄﾞｳﾉﾋﾞｮｳｶﾞ
14590 '---------------------
14610 *DRAW_LENGTH:TEMP$="Len":WIN(17,7)=3:GOTO *DRAW_SUBWINDOW
14620 '---------------------
14630 'ﾋﾟｯﾁﾍﾞﾝﾄﾞ ｳｲﾝﾄﾞｳﾉﾋﾞｮｳｶﾞ
14640 '---------------------
14660 *DRAW_PITCH:TEMP$="Pit":WIN(17,7)=2:GOTO *DRAW_SUBWINDOW
14670 '---------------------
14680 'ﾊﾟﾝ ｳｲﾝﾄﾞｳﾉﾋﾞｮｳｶﾞ
14690 '---------------------
14710 *DRAW_PAN:TEMP$="Pan":LOCATE 2,25:PRINT TEMP$;:Y=216:ACTIVE 30:ACTIVE 1:LINE (0,Y-16)-(319,Y),0,BF
14720 FOR I=TAMA_X TO TAMA_X+32*8+7 STEP 8:LINE (I,Y-15)-(I+5,Y-15),9:LINE (I,Y)-(I+5,Y),9:NEXT
14730 LINE (TAMA_X,Y-8)-(319,Y-8),9:FOR I=0 TO 32:TEMP=I*8+TAMA_X:FOR K=0 TO 15 STEP 2:PSET (TEMP,Y-K),8:NEXT :NEXT
14740 WIN(17,7)=1
14750 GOSUB *DRAW_SUBWINDOW_CNT
14760 RETURN
14770 '---------------------
14780 'ﾀﾏ ｦ ﾋﾞｮｳｶﾞｽﾙ
14790 '---------------------
14800 'entry:TAMA_NOTE
14810 '      TAMA_LEN
14820 'etc
14830 '      TAMA_ONLYONE:0...EDIT MODE
14840 '                   1...PRINT MODE
14860 *TAMA_DRAW
14870 IF SC_MODE=0 THEN GOTO *DRAW_TAMA1
14880 'LINE_MODE
14890 IF TAMA_NOTE>0 AND DRAW_RANGE_O*12<=TAMA_NOTE AND DRAW_RANGE_O*12+35>=TAMA_NOTE THEN
14900  OBJ(TAMA_NUM+64,4)=TAMA_NUM*8+TAMA_X,TM0(TAMA_NOTE-DRAW_RANGE_O*12),,,,,,,TAMA_LEN,1,1,,117,117,,,0
14910 ELSE
14920  OBJ(TAMA_NUM+64,20)=TAMA_NUM+64
14930 ENDIF
14940 RETURN
14960 *DRAW_TAMA1
14970 IF TAMA_LEN<0 THEN OBJ(TAMA_NUM+64,20)=TAMA_NUM+64:OBJ(128+TAMA_NUM,20)=128+TAMA_NUM:RETURN
14980 IF TAMA_NOTE<0 THEN
14990  'ｷｭｳﾌ
15000  OBJ(TAMA_NUM+64,4)=TAMA_NUM*8+TAMA_X,TAMA_Y+TMR(TAMA_LEN),,,,,,,1,1,1,,TAMA_LEN(TAMA_LEN)+64,TAMA_LEN(TAMA_LEN)+64,,,0
15010  OBJ(128+TAMA_NUM,20)=128+TAMA_NUM
15020  RETURN
15030 ENDIF
15040 IF TAMA_NOTE>=72 THEN
15050  AAA=TAMA_POS(N_SIG(TAMA_NOTE) AND 255)+TAMA_Y+5
15060  IF TMT(TAMA_LEN) AND &H40 THEN AAA=AAA-7
15070  OBJ(TAMA_NUM+64,4)=TAMA_NUM*8+TAMA_X,AAA,1,,,,,,1,1,1,,TAMA_LEN(TAMA_LEN)+32,TAMA_LEN(TAMA_LEN)+32,,,0
15080 ELSE
15090  AAA=TAMA_POS(N_SIG(TAMA_NOTE) AND 255)+TAMA_Y-10
15100  OBJ(TAMA_NUM+64,4)=TAMA_NUM*8+TAMA_X,AAA,1,,,,,,1,1,1,,TAMA_LEN(TAMA_LEN),TAMA_LEN(TAMA_LEN),,,0
15110 ENDIF
15120 ARG1=TAMA_NOTE:GOSUB *QUERYSTATUS
15130 IF RET<>0 THEN
15140  IF TAMA_NOTE>=72 THEN
15150   OBJ(128+TAMA_NUM,4)=TAMA_NUM*8+TAMA_X-7,AAA-4
15160  ELSE
15170   OBJ(128+TAMA_NUM,4)=TAMA_NUM*8+TAMA_X-8,AAA+11
15180  ENDIF
15190  OBJ(128+TAMA_NUM,16)=117+RET,117+RET,,,0
15200 ELSE
15210  OBJ(128+TAMA_NUM,20)=128+TAMA_NUM
15220 ENDIF
15230 RETURN
15240 '--------------------
15250 'ｼｬﾄﾙﾏｳｽ ﾃｷｽﾄﾆｭｳﾘｮｸ
15260 '--------------------
15270 'INPUT :
15280 'OUTPUT:
15290 '
15310 *TEXT_INPUT_L
15320 ED=1:GOSUB *TEXT_INPUT_S0
15340 *TEXT_INPUT_L1
15350 GOSUB *QOUT
15360 IF EVENT=-3 THEN
15370  IF EVENTX=27 OR EVENTX=13 THEN RETURN :'ESC or Return
15380  IF EVENTX>=0 AND EVENT<=255 THEN
15390   IF INSTR(A$,CHR$(EVENTX)) THEN
15400    MID$(RET$,ED,1)=CHR$(EVENTX)
15410    IF ED<S THEN ED=ED+1
15420    GOSUB *TEXT_INPUT_S0
15430    GOTO *TEXT_INPUT_L1
15440   ENDIF
15450  ENDIF
15460  IF EVENTX=29 OR EVENTX=8 THEN :'BS or Left
15470   MID$(RET$,ED,1)=" "
15480   IF ED>1 THEN ED=ED-1
15490   GOSUB *TEXT_INPUT_S0
15500   GOTO *TEXT_INPUT_L1
15510  ENDIF
15520 ENDIF
15530 IF EVENT=2 THEN :'CLICK
15540  IF EVENTY>=Y*8+8 AND EVENTY<=Y*8+15 AND EVENTX>=X*8+8 AND EVENTX<X*8+S*8+8 THEN
15550   PO=(EVENTX-X*8)\8
15560   IF ED=PO THEN
15570    IF INSTR(A$,MID$(RET$,ED,1))<LEN(A$) THEN
15580     MID$(RET$,ED,1)=MID$(A$,INSTR(A$,MID$(RET$,ED,1))+1,1)
15590    ELSE
15600     MID$(RET$,ED,1)=LEFT$(A$,1)
15610    ENDIF
15620    GOSUB *TEXT_INPUT_S0
15630    GOTO *TEXT_INPUT_L1
15640   ELSE
15650    ED=PO
15660    GOSUB *TEXT_INPUT_S0
15670    GOTO *TEXT_INPUT_L1
15680   ENDIF
15690  ELSE
15700   'ﾊﾝｲｶﾞｲﾃﾞｸﾘｯｸｻﾚﾀﾗﾆｭｳﾘｮｸｼｭｳﾘｮｳ
15710   RETURN
15720  ENDIF
15730 ENDIF
15740 IF EVENT=6 THEN :'CLICK
15750  IF EVENTY>=Y*8+8 AND EVENTY<=Y*8+15 AND EVENTX>=X*8+8 AND EVENTX<X*8+S*8+8 THEN
15760   PO=(EVENTX-X*8)\8
15770   IF ED=PO THEN
15780    IF INSTR(A$,MID$(RET$,ED,1))>1 THEN
15790     MID$(RET$,ED,1)=MID$(A$,INSTR(A$,MID$(RET$,ED,1))-1,1)
15800    ELSE
15810     MID$(RET$,ED,1)=RIGHT$(A$,1)
15820    ENDIF
15830    GOSUB *TEXT_INPUT_S0
15840    GOTO *TEXT_INPUT_L1
15850   ELSE
15860    ED=PO
15870    GOSUB *TEXT_INPUT_S0
15880    GOTO *TEXT_INPUT_L1
15890   ENDIF
15900  ENDIF
15910 ENDIF
15920 IF EVENT=12 THEN RETURN
15930 GOTO *TEXT_INPUT_L1
15950 *TEXT_INPUT_S0
15960 LOCATE X     ,Y:COLOR 6:PRINT MID$(RET$, 1,S)
15970 LOCATE X+ED-1,Y:COLOR 5:PRINT MID$(RET$,ED,1)
15980 RETURN
15990 '
16000 '
16020 *INIT
16030 DIM TAMA_POS(128),TAMA_LEN(32),KEY_TABLE(255)
16040 ON ERROR GOTO *INIT_ERROR
16050 A$="ﾃﾞｰﾀﾌｧｲﾙ["+WK$+"OTO_DATA.D]ｶﾞﾐﾂｶﾘﾏｾﾝ"
16060 OPEN WK$+"OTO_DATA" FOR INPUT AS #1
16070 ON ERROR GOTO *INIT_ERROR1
16080 A$="[OTO_DATA.D]ﾖﾐｺﾐﾁｭｳﾆｴﾗｰｶﾞﾊｯｾｲｼﾏｼﾀ"
16090 FOR I=0 TO 67:FREAD #1,F$,2:TAMA_POS(I)=ASC(LEFT$(F$,1))*256+ASC(RIGHT$(F$,1))-32768:NEXT
16100 FOR I=0 TO 32:FREAD #1,F$,1:TAMA_LEN(I)=ASC(F$):NEXT
16110 CLOSE #1
16120 RESTORE *KEY_DEF:FOR I=0 TO 255:READ KEY_TABLE(I):NEXT :'ﾃﾞﾌｫﾙﾄ
16130 ON ERROR GOTO *INIT_ERROR
16140 A$=""
16150 OPEN "BRAM:OTO_KEY" FOR INPUT AS #1
16160 PRINT "ｷｰﾎﾞｰﾄﾞｱｸｾﾗﾚｰﾀ ﾌｧｲﾙ"+CHR$(13)+CHR$(10)+"ﾆ ﾀｲｵｳｼﾏｽ"
16170 ON ERROR GOTO *INIT_ERROR1
16180 A$="[OTO_KEY.D]ﾖﾐｺﾐﾁｭｳﾆｴﾗｰｶﾞﾊｯｾｲｼﾏｼﾀ"
16190 FOR I=0 TO 255:FREAD #1,F$,1:KEY_TABLE(I)=ASC(LEFT$(F$,1)):NEXT
16210 *INIT_EXIT1
16220 CLOSE #1
16240 *INIT_EXIT
16250 ON ERROR GOTO 0
16260 FOR I=0 TO 31:OBJ(128+I,0)=7,,,,-100:OBJ(I+64,0)=7,,,,-100:ED_TAMA(I,0)=-1:ED_TAMA(I,1)=-1:NEXT
16270 OBJ(96,0)=7,,,,-100
16280 A$=""
16290 RETURN
16310 *INIT_ERROR:PRINT A$:VSYNC 10:RESUME *INIT_EXIT
16330 *INIT_ERROR1:PRINT A$:VSYNC 10:RESUME *INIT_EXIT1
16340 '
16360 *INITSPRITE
16370 'ﾒﾆｭｰﾊﾞｰ ｾｯﾃｲ
16380 OBJ(2,0)=7,,,,14,-23,100,,,,,,,,,,1,1
16390 WIN(12,0)=14
16400 WIN(12,1)=14+24*12
16410 WIN(12,2)=0
16420 WIN(12,3)=1
16430 WIN(12,4)=1   :'Enabled
16440 WIN(12,5)=2   :'Obj. No.
16450 WIN(12,6)=0   :'Kind
16460 WIN(12,7)=0   :'Work
16470 FOR I=3 TO 14
16480  'ｵﾌﾞｼﾞｪｸﾄ ｦ ｾｯﾃｲ
16490  OBJ(I   , 0)=7,,,,(I-3)*24,0,0,,,,,,,,,,1,1,,,2
16500  OBJ(I+15, 0)=7,,,,0,0,0,,,,,,,,,,I,I,,,I
16510  'ｲﾁ ｦ ｾｯﾃｲ
16520  WIN(I-3,0)=(I-3)*24+14
16530  WIN(I-3,1)=(I-3)*24+14+24
16540  WIN(I-3,2)=0
16550  WIN(I-3,3)=23
16560  WIN(I-3,4)=0
16570  WIN(I-3,5)=I
16580  WIN(I-3,6)=1
16590  WIN(I-3,7)=0
16600 NEXT
16610 'ﾋﾀﾞﾘｶﾞﾜﾉｳｴﾉｷｺﾞｳ
16620 OBJ(161,0)=7,,,,-20
16630 'ﾐｷﾞｶﾞﾜﾉｼﾀﾉｷｺﾞｳ
16640 OBJ(160,0)=7,,,,-20
16650 RETURN
