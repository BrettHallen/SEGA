 3580 DA_CH=G_TR:DA_FR=G_FR:GOSUB *PUT_TRACK_OTO
 3590 G_TR=G_TR+1:IF G_FR>=G_MAX_FR(G_TR) THEN FOR I=0 TO G_FR-G_MAX_FR(G_TR):DA_CH=G_TR:DA_DATA$="":GOSUB *DALINK_ADD:NEXT
 3600 ARG1=G_TR:ARG2=G_FR:GOTO *PRINT_FR
