 4270 '----------------------
 4290 *CLK_NEIRO
 4300 IF EVENT=-2 AND CAPTURE<>-1 THEN S_NEIRO=CY1+(EVENTY\3)-CY:GOSUB *SETNEIRO2ED_TAMA:GOTO *DRAW_NEIRO
 4310 IF EVENT=9 AND CAPTURE<>-1 THEN CAPTURE=-1:S_NEIRO=CY1+(EVENTY\3)-CY:GOSUB *SETNEIRO2ED_TAMA:GOTO *DRAW_NEIRO
 4320 IF EVENT=8 AND CAPTURE=-1 THEN CAPTURE=J:CY=EVENTY\3:CY1=ED_TAMA(0,5):RETURN
 4330 IF EVENT=2 AND CAPTURE=-1 THEN S_NEIRO=ED_TAMA(0,5):S_NEIRO=S_NEIRO+1:GOSUB *SETNEIRO2ED_TAMA:GOTO *DRAW_NEIRO
 4340 IF EVENT=6 AND CAPTURE=-1 THEN S_NEIRO=ED_TAMA(0,5):S_NEIRO=S_NEIRO-1:GOSUB *SETNEIRO2ED_TAMA:GOTO *DRAW_NEIRO
 4350 RETURN
