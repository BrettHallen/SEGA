 3460 'ﾌﾚｰｽﾞ-1
 3470 '--------
 3490 *MV_FR_MINUS
 3500 IF G_FR<=0 THEN RETURN
 3510 DA_CH=G_TR:DA_FR=G_FR:GOSUB *PUT_TRACK_OTO:G_FR=G_FR-1:ARG1=G_TR:ARG2=G_FR:GOTO *PRINT_FR
