6990 *INIT_SCR:'Ê²¹²É ËÞ®³¶Þ
7000 FOR DP=0 TO 15
7010  GC=RGB(0,16-DP,0)
7020  BC=RGB(0,0,16-DP)
7030  IF DP=0 THEN YY1=YOFS+YSIZ-1:YY3=YOFS ELSE YY1=YC+(YSIZ/DP/2):YY3=YC-(YSIZ/DP/2)
7040  YY2=YC+(YSIZ/(DP+1)/2)
7050  YY4=YC-(YSIZ/(DP+1)/2)
7060  LINE (XOFS,YY1)-(XOFS+XSIZ-1,YY2),GC,BF
7070  LINE (XOFS,YY3)-(XOFS+XSIZ-1,YY4),BC,BF
7080 NEXT DP
7090 '----------------------------------
7100 SETDISP 7
7110 OBJ(0,ORDER)=7:OBJ(0,XP)=0,0,0
7120 OBJ(1,PARENT)=0:OBJ(1,TYPE)=4:OBJ(1,ORDER)=7
7130 OBJ(2,PARENT)=1:OBJ(2,TYPE)=4:OBJ(2,ATR)=0,0
7140 OBJ(3,PARENT)=0:OBJ(3,TYPE)=4:OBJ(3,RADIUS)=SIZE/2:OBJ(3,GTEST)=1:OBJ(3,GROUP)=1
7150 RETURN
