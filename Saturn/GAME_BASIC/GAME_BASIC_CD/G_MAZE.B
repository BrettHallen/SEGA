7280 *ATARI
7290 IF OBJ(3,COLIDIST)=-1 THEN RETURN
7300 EFFECT -2
7310 OBJ(OBJ(3,COLIOBJ),TYPE)=0
7320 ITEM=MAPATR(MX,MY)
7330 LOCATE 14,8
7340 IF ITEM=1 THEN TIME=TIME+60:PRINT "TIME EXTEND!":COLOROFS (0,0,0)
7350 IF ITEM=2 THEN ITEM_X=ITEM_X+1:PRINT "GET X ITEM!"
7360 IF ITEM=3 THEN ITEM_Z=ITEM_Z+1:PRINT "GET Z ITEM!"
7370 MAPATR(MX,MY)=0
7380 OBJ(3,GTEST)=1
7390 ON INTERVAL (4) GOSUB *DISPOFF
