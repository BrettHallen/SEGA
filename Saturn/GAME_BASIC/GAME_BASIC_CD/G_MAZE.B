2530 'MakeMap
2540 *MAKEMAP
2550 WALL=1:ROAD=0
2560 'Map Clear
2570 FOR Y=0 TO MAPY-1
2580  FOR X=0 TO MAPX-1
2590   MAPDATA(X,Y)=WALL
2600  NEXT X
2610 NEXT Y
2620 STEPS=0
2630 PX=MXC:PY=MYC
2640 MAPDATA(PX,PY)=ROAD
2650 STEPMAX=0
2660 '
2670 *MAPLOOP
2680 'gosub *Showmaze
2690 IF STEPS>STEPMAX THEN STEPMAX=STEPS
2700 '
2710 GOSUB *COUNTWALL
2720 IF NUMOFWALL=0 THEN *DECENT
2730 '
2740 IF NUMOFWALL<>1 THEN HISTX(STEPS)=PX:HISTY(STEPS)=PY:STEPS=STEPS+1
2750 *RANDOM
2760 DIR=RND(4)
2770 ON DIR+1 GOTO *TO_NORTH,*TO_EAST,*TO_SOUTH,*TO_WEST
2780 '
2790 *TO_NORTH
2800 IF PY<2 THEN *RANDOM
2810 IF MAPDATA(PX,PY-2)=ROAD THEN *RANDOM
2820 MAPDATA(PX,PY-1)=ROAD
2830 MAPDATA(PX,PY-2)=ROAD
2840 PY=PY-2
2850 GOTO *MAPLOOP
2860 '
2870 *TO_EAST
2880 IF PX>MAPX-3 THEN *RANDOM
2890 IF MAPDATA(PX+2,PY)=ROAD THEN *RANDOM
2900 MAPDATA(PX+1,PY)=ROAD
2910 MAPDATA(PX+2,PY)=ROAD
2920 PX=PX+2
2930 GOTO *MAPLOOP
2940 '
2950 *TO_SOUTH
2960 IF PY>MAPY-3 THEN *RANDOM
2970 IF MAPDATA(PX,PY+2)=ROAD THEN *RANDOM
2980 MAPDATA(PX,PY+1)=ROAD
2990 MAPDATA(PX,PY+2)=ROAD
3000 PY=PY+2
3010 GOTO *MAPLOOP
3020 '
3030 *TO_WEST
3040 IF PX<2 THEN *RANDOM
3050 IF MAPDATA(PX-2,PY)=ROAD THEN *RANDOM
3060 MAPDATA(PX-1,PY)=ROAD
3070 MAPDATA(PX-2,PY)=ROAD
3080 PX=PX-2
3090 GOTO *MAPLOOP
3100 '
3110 *DECENT
3120 IF STEPS=0 THEN RETURN
3130 STEPS=STEPS-1
3140 PX=HISTX(STEPS)
3150 PY=HISTY(STEPS)
3160 GOTO *MAPLOOP
3170 '
3180 *COUNTWALL
3190 NUMOFWALL=0
3200 IF PX>1 THEN NUMOFWALL=NUMOFWALL+MAPDATA(PX-2,PY)
3210 IF PY>1 THEN NUMOFWALL=NUMOFWALL+MAPDATA(PX,PY-2)
3220 IF PX<MAPX-2 THEN NUMOFWALL=NUMOFWALL+MAPDATA(PX+2,PY)
3230 IF PY<MAPY-2 THEN NUMOFWALL=NUMOFWALL+MAPDATA(PX,PY+2)
3240 RETURN
3250 '-------------------------------------------------------
3260 *SCANMAP
3270 PNUM=0
3280 FOR Y=0 TO MAPY-1
3290  FOR X=0 TO MAPX-1
3300   IF MAPDATA(X,Y)=WALL THEN :
3310    IF Y>1 THEN SN=1-MAPDATA(X,Y-1) ELSE SN=0
3320    IF X<MAPX-1 THEN SE=1-MAPDATA(X+1,Y) ELSE SE=0
3330    IF Y<MAPY-1 THEN SS=1-MAPDATA(X,Y+1) ELSE SS=0
3340    IF X>1 THEN SW=1-MAPDATA(X-1,Y) ELSE SW=0
3350    SCAN=SW*8+SS*4+SE*2+SN
3360    MAPATR(X,Y)=SCAN:PNUM=PNUM+1:'ÃÝ¼Þ®³
3370    IF SW=1 THEN PNUM=PNUM+1
3380    IF SS=1 THEN PNUM=PNUM+1
3390    IF SE=1 THEN PNUM=PNUM+1
3400    IF SN=1 THEN PNUM=PNUM+1
3410   ENDIF
3420  NEXT X
3430 NEXT Y
3440 RETURN
3450 '-------------------------------------------------------
3460 *SET_POLYDATA
3470 SETVERTEX 0,(MAPX+1)*(MAPY+1)*2
3480 FOR Z=0 TO 1
3490  FOR Y=0 TO MAPY
3500   FOR X=0 TO MAPX
3510    SETVERTEX ((X-MAPX/2)*SIZE,-(Z-.5)*SIZE,-(Y-MAPY/2)*SIZE)
3520   NEXT X
3530  NEXT Y
3540 NEXT Z
3550 SETPOLYGON 0,PNUM,0
3560 SETATR 0,PNUM
3570 FOR Y=0 TO MAPY-1
3580  FOR X=0 TO MAPX-1
3590   IF MAPDATA(X,Y)=WALL THEN :
3600    ATTR=MAPATR(X,Y):POFS=Y*(MAPX+1)+X
3610    P0=POFS+1
3620    P1=POFS+(MAPX+1)+1
3630    P2=POFS+((MAPX+1)*(MAPY+1)+1)
3640    P3=POFS+((MAPX+1)*(MAPY+1)+MAPX+1)+1
3650    P4=POFS+0
3660    P5=POFS+(MAPX+1)
3670    P6=POFS+((MAPX+1)*(MAPY+1))
3680    P7=POFS+((MAPX+1)*(MAPY+1)+MAPX+1)
3690    COL=(X+Y) AND 1
3700    IF (ATTR AND  1)<>0 THEN GOSUB *SP_N
3710    IF (ATTR AND  2)<>0 THEN GOSUB *SP_E
3720    IF (ATTR AND  4)<>0 THEN GOSUB *SP_S
3730    IF (ATTR AND  8)<>0 THEN GOSUB *SP_W
3740    GOSUB *SP_U:'ÃÝ¼Þ®³Ê ¶Å×½Þ Â¹Ù
3750   ENDIF
3760  NEXT X
3770 NEXT Y
3780 RETURN
3790 '-------------------------------------------------------
3800 'ÒÝÊ ½ÍÞÃ ¿Ä¦ Ñ¸
3810 *SP_N
3820  SETPOLYGON,(P2,P6,P4,P0)
3830  IF COL=0 THEN SETATR (4,0,3,0,RGB(10,10,25),0) ELSE SETATR (4,0,3,0,RGB( 5, 5,13),0):'NORTH
3840  RETURN
3850 *SP_E
3860  SETPOLYGON,(P3,P2,P0,P1)
3870  IF COL=0 THEN SETATR (4,0,3,0,RGB(10,25,10),0) ELSE SETATR (4,0,3,0,RGB( 5,13, 5),0):'EAST
3880  RETURN
3890 *SP_S
3900  SETPOLYGON,(P7,P3,P1,P5)
3910  IF COL=0 THEN SETATR (4,0,3,0,RGB(25,10,25),0) ELSE SETATR (4,0,3,0,RGB(13, 5,13),0):'SOUTH
3920  RETURN
3930 *SP_W
3940  SETPOLYGON,(P6,P7,P5,P4)
3950  IF COL=0 THEN SETATR (4,0,3,0,RGB(25,10,10),0) ELSE SETATR (4,0,3,0,RGB(13, 5, 5),0):'WEST
3960  RETURN
3970 *SP_U
3980  SETPOLYGON,(P7,P6,P2,P3)
3990  SETATR (4,0,3,0,RGB(25,25,25),0):'UP
4000  RETURN
