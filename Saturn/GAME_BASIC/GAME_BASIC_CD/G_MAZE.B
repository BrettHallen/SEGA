1430 TRIG = PAD(0,2)
1440 IF (TRIG AND @PAD_START) = 0 THEN *WTLP
1450 CLS
1460 '----------------------------------
1470 ON INTERVAL (3) GOSUB *ATARI
1480 ON INTERVAL (0) GOSUB *CLOCK:ON INTERVAL (1) GOSUB *CLICK
1490 '----------------------------------
1500 INTERVAL (0) ON,3:INTERVAL (1) ON,15:INTERVAL (3) ON,1
1510 *LOOP:IF MAPATR(OX,OY)=-1 THEN *GOOD
1520 PDL = PAD(0,1)
1530 IF PDL AND PADU THEN *FWRD
1540 IF PDL AND PADD THEN *BACK
1550 IF PDL AND LBTN THEN *LEFT
1560 IF PDL AND RBTN THEN *RIGT
1570 IF PDL AND PADL THEN *LTRN
1580 IF PDL AND PADR THEN *RTRN
1590 IF PDL AND ABTN THEN *ITMA
1600 IF PDL AND BBTN THEN *ITMB
1610 IF PDL AND CBTN THEN *ITMC
1620 IF PDL AND XBTN THEN *ITMX
1630 IF PDL AND YBTN THEN *ITMY
1640 IF PDL AND ZBTN THEN *ITMZ
1650 GOTO *LOOP
1660 '----------------------------------
1670 *FWRD
1680 ON DIR GOSUB *MV_N,*MV_E,*MV_S,*MV_W
1690 GOTO *LOOP
1700 '
1710 *BACK
1720 ON DIR GOSUB *MV_S,*MV_W,*MV_N,*MV_E
1730 GOTO *LOOP
1740 '
1750 *LEFT
1760 ON DIR GOSUB *MV_W,*MV_N,*MV_E,*MV_S
