1300 *GAMESTART
1310 CLS
1320 MX=MXC:MY=MXC
1330 OX=MX:OY=MY
1340 DIR=NORTH:ODIR=DIR
1350 OBJ(1,XP)=-(MX-MXC)*SIZE,0,(MY-MYC)*SIZE
