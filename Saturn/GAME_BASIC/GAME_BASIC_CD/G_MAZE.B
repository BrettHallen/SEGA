1930 '----------------------------------
1940 *MV_N
1950 IF MY=0 THEN RETURN
1960 IF MAPDATA(MX,MY-1)=1 THEN RETURN
1970 MV=MY-MYC:MDIR=-1:MP=ZP
1980 MY=MY-1
1990 GOTO *MV_VIEW
2000 '
2010 *MV_E
2020 IF MX>=MAPX-1 THEN RETURN
2030 IF MAPDATA(MX+1,MY)=1 THEN RETURN
2040 MV=-(MX-MXC):MDIR=-1:MP=XP
2050 MX=MX+1
2060 GOTO *MV_VIEW
2070 '
2080 *MV_S
2090 IF MY>=MAPY-1 THEN RETURN
2100 IF MAPDATA(MX,MY+1)=1 THEN RETURN
2110 MV=MY-MYC:MDIR=1:MP=ZP
2120 MY=MY+1
2130 GOTO *MV_VIEW
2140 '
2150 *MV_W
2160 IF MX=0 THEN RETURN
2170 IF MAPDATA(MX-1,MY)=1 THEN RETURN
2180 MV=-(MX-MXC):MDIR=1:MP=XP
2190 MX=MX-1
2200 GOTO *MV_VIEW
2210 '
2220 *TR_W
2230 DIR = 4
2240 GOTO *TR_VIEW
2250 '
