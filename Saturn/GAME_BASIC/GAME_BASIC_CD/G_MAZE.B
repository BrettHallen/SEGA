6640 '±²ÃÑ ÎßØºÞÝ¦ Ê²Á½Ù
6650 N=4
6660 FOR Y=0 TO MAPY-1
6670  FOR X=0 TO MAPX-1
6680   IF (MAPATR(X,Y)>0 AND MAPATR(X,Y)<>-1) THEN :
6690    OBJ(N,ATR)=MAPATR(X,Y),1
6700    OBJ(N,XP)=(X-MXC)*SIZE,0,-(Y-MYC)*SIZE
6710    OBJ(N,PARENT)=1
6720    OBJ(N,TYPE)=4
6730    OBJ(N,ORDER)=0
6740    OBJ(N,GTEST)=1:OBJ(N,GROUP)=1
6750    OBJ(N,XRV)=.05,.03,.01
6760    N=N+1
6770   ENDIF
6780  NEXT X
6790 NEXT Y
6800 '
6810 RETURN
