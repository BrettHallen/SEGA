4020 *VIEWMAP
4030 FOR I=0 TO 160 STEP MVS
4040  OBJ(0,YP)=I:VSYNC
4050 NEXT I
4060 FOR I=(DIR-1)/4 TO (DIR-1)/4+1 STEP RTS
4070  OBJ(0,YR)=-I:VSYNC
