LOAD"COM:DUMMY"
 1000 SCREEN 0: SKCLOSE :'Initialize screen, Close software keyboard
 1002 '
 1003 'Programed by Ninagawa
 1004 CLEAR 10,1360:IF PEEK(0,3)<>78 THEN KLOAD ON:CLEAR 10,1360:POKE 0,0,56:POKE 0,1,2:POKE 0,2,3:POKE 0,3,78:POKE 0,4,1
 1005 PRINT "Polonaise-Heroique"
 1006 PLAYINIT "DSP","PIANO",1 : DSP ON 1,ALL,0,5 : SETSONG : BGM
 1007 PRINT:PRINT " PRESS ANY KEY -> MAIN MENU"
 1008 *LOOP:IF INKEY$="" AND PAD(0,2)=0 THEN *LOOP ELSE PLAYSTOP 0:CLS:PRINT "Loading S_CLASSI.B":LOAD "CD:S_CLASSI",R
 1009 '
