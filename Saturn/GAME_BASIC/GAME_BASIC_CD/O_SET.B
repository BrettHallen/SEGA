 1095 '1998/3/31
 1100 SKCLOSE:SCREEN 1,,,1:KLOAD OFF :CLEAR 257,1360,1
 1110 DIM SNAME$(255),SX(255),SY(255),SC(255)
 1120 FOR J=0 TO 15:READ R,G,B:PALETTE 10,J,RGB(R*31/255,G*31/255,B*31/255):NEXT
 1140 *LOOP:READ TEXNAME$:SNAME$(I)=TEXNAME$
 1150 IF TEXNAME$="@ENDDATA" THEN GOTO *ZAP1
 1160 READ TEX_X,TEX_Y,TEX_COL:SX(I)=TEX_X:SY(I)=TEX_Y:SC(I)=TEX_COL
 1170 SETTEX,TEX_X,TEX_Y,TEX_COL,READ
 1180 SETVERTEX,4,(0,0,0),(TEX_X,0,0),(TEX_X,TEX_Y,0),(0,TEX_Y,0)
 1190 SETPOLYGON,1,I,,(0,1,2,3)
 1200 SETATR,1,(0,1,3,I,0,0)
 1210 I=I+1:READ A$
 1230 *ZAP
 1240 GOTO *LOOP
 1260 *ZAP1
 1270 LOAD "O_MAIN",R
 1280 OBJ(1,0)=7:J=1
 1300 *OPO:CLS :LOCATE 0,22:PRINT "SPRITE –Ÿ–Ÿ":LOCATE 10,23:PRINT "Version 0.00 ±ŸÃß":LOCATE 7,5:PRINT " NO.";J,SNAME$(J-1)
 1310 LOCATE 7,6:PRINT "SIZE";SX(J-1);"x";SY(J-1)
 1320 LOCATE 7,7:PRINT "COL.";SC(J-1)
 1330 OBJ(1,16)=J-1,J-1
 1340 OBJ(1,4)=-SX(J-1)/2,-SY(J-1)/2+16,0:VSYNC 10
 1360 *OPOP1:IF PAD(15,1)=&H400 THEN EFFECT -1,"@16C":J=J-1:IF J < 1 THEN J=I:GOTO *OPO ELSE GOTO *OPO
 1370 IF PAD(15,1)=&H200 THEN EFFECT -1,"@16C":J=J+1:IF J > I THEN J=1:GOTO *OPO ELSE GOTO *OPO
 1380 IF PAD(15,1)=&H800 THEN OBJ(1,20)=20:CLS :END
 1390 GOTO *OPOP1
