  100 SCREEN 2,4,256:SKCLOSE
  110 ON TIMER (7) GOSUB *SYNCCOUNT
  120 DIM PR(256),PG(256),PB(256)
  130 DIM MAZD(128,64),ENED(40,10)
  140 DIM DOORD(20,10),ITEMD(40,10)
  150 DIM MAZF$(20),ITMF$(20),ENEF$(20),INIF$(20)
  160 DIM BMES$(10)
  170 RESTORE *MESDATA
  171 READ MESNUM
  180 FOR I=1 TO MESNUM:READ BMES$(I):NEXT
  190 RESTORE *LEVDATA
  200 READ ENDLEV
  210 FOR I=1 TO ENDLEV:READ MAZF$(I),ITMF$(I),ENEF$(I),INIF$(I):NEXT
  220 ENDLEV = ENDLEV+1
  230 *LEVDATA
  240 DATA 10
  250 DATA "MAZE01.D","ITEM01.D","ENEM01.D","INID01.D"
  260 DATA "MAZE01.D","ITEM02.D","ENEM02.D","INID02.D"
  270 DATA "MAZE01.D","ITEM03.D","ENEM03.D","INID03.D"
  280 DATA "MAZE04.D","ITEM04.D","ENEM04.D","INID04.D"
  290 DATA "MAZE04.D","ITEM05.D","ENEM05.D","INID05.D"
  300 DATA "MAZE06.D","ITEM06.D","ENEM06.D","INID06.D"
  310 DATA "MAZE06.D","ITEM07.D","ENEM07.D","INID07.D"
  320 DATA "MAZE08.D","ITEM08.D","ENEM08.D","INID08.D"
  325 DATA "MAZE09.D","ITEM09.D","ENEM09.D","INID09.D"
  326 DATA "MAZE10.D","ITEM10.D","ENEM10.D","INID10.D"
  330 PRIORITY 10,4
  340 LOCATE 0,25:PRINT "charactor initializing"
  350 GOSUB *CHRCONV
  355 GOSUB *MANOUT
  360 FOR Y=0 TO 2:FOR X=0 TO 79:PUTCHR 4,(X,Y),78:NEXT :NEXT
  370 FOR Y=25 TO 27:FOR X=0 TO 79:PUTCHR 4,(X,Y),78:NEXT :NEXT
  380 NUL$="":FOR I=0 TO 80:NUL$=NUL$+CHR$(39):NEXT
  390 MES$="DATA'INITIALIZING.'JUST'MOMENT":GOSUB *MESOUT
  400 ROTOVER 0
  410 GOSUB *PALINIT
  420 GOSUB *SEINIT
  430 GOSUB *CHRINIT
  440 GOSUB *SPRINIT
  450 GOSUB *BGBFILL
  460 REM -------MAZEDATAINIT
  464 *PLACL
  465 CTCLEV = 1:CTLIFE =1400
  470 *TITLE
  480 GOSUB *STWAIT:SCROLL 5,0,0
  485 PLAYSTOP -1
  490 FOR I=1 TO 255
  500 PALETTE 8,I,RGB(0,0,0)
  510 PALETTE 10,I,RGB(0,0,0)
  520 NEXT
  530 CLEV = 1:LIFE=1400:SCORE = 0
  535 IF CTFLAG = 1 THEN CLEV=CTCLEV:LIFE=CTLIFE
  540 *LEVLOOP
  550 MES$="LEVEL'"+RIGHT$(STR$(CLEV),LEN(STR$(CLEV))-1)+"'START":GOSUB *MESOUT
  560 GOSUB *VINIT
  570 GOSUB *ITEMREAD
  580 GOSUB *ENEREAD
  590 GOSUB *ITEMDISP
  600 GOSUB *DOORDISP
  610 GOSUB *ENEDISP
  620 GOSUB *HERODISP
  630 VSYNC 20
  640 GOSUB *MAZEINIT
  650 FOR I=1 TO 255
  660 PALETTE 8,I,RGB(PR(I),PG(I),PB(I))
  670 PALETTE 10,I,RGB(PR(I),PG(I),PB(I))
  680 PALFLAG=0
  685 CTLIFE = LIFE-200:CTCLEV=CLEV
  686 IF CTLIFE < 100 THEN CTLIFE = 100
  690 BGM :GOSUB *GLOOP:PLAYSTOP
  700 TIMER (7) OFF
  710 IF DEADFLAG=1 THEN GOTO *TITLE
  720 CLEV=CLEV+1:IF CLEV=ENDLEV THEN GOTO *ALLCLEAR
  730 FOR I=1 TO 255
  740 PALETTE 8,I,RGB(0,0,0)
  750 PALETTE 10,I,RGB(0,0,0)
  760 NEXT
  770 GOTO *LEVLOOP
  790 *ALLCLEAR
  791 VSYNC 2:BGM 16:VSYNC 2
  792 GOSUB *ENDMES
  799 GOTO *PLACL
  800 *MAZEINIT
  810 OPEN MAZF$(CLEV) FOR INPUT AS 1
  820 FOR Y=0 TO 63:FOR X=0 TO 127
  830 FREAD #1,D$,1:MAZD(X,Y)=ASC(D$)
  840 PUTCHR 8,(X,Y),MAZD(X,Y)*2
  850 IF MAZD(X,Y)=0 THEN PUTCHR 8,(X,Y),(120+RND(2))*2
  860 NEXT :NEXT
  870 CLOSE
  880 RETURN
  890 *BGBFILL
  900 FOR Y=0 TO 255:FOR X=0 TO 255
  910 PUTCHR 8,(X,Y),(120+RND(2))*2
  920 NEXT :NEXT :RETURN
  930 *GLOOP
  940 IF ABS(HX-CX)<10 AND ABS(HY-CY)<10 THEN GOSUB *LCCHECK
  950 IF CLFLAG = 1 THEN GOTO *LEVCLR
  960 IF LIFE<=0 THEN LIFE = 0:DEADFLAG = 1
  970 GOSUB *STPRINT
  980 FREEZE=FREEZE-1:IF FREEZE<0 THEN FREEZE=0
  990 IF FREEZE = 100 THEN PLAYSTOP FRZSND:VSYNC :EFFECT (FRZSND),12
 1000 IF FREEZE = 1 THEN PLAYSTOP FRZSND
 1010 IF FREEZE= 0 THEN CTIME=CTIME-.1
 1020 IF CTIME<0 THEN CTIME=0:IF (GCTR MOD 10)=0 THEN LIFE = LIFE -1
 1030 'LOCATE 0,2:PRINT SNCCW;
 1040 SPD=PAD(0,1)
 1050 IF DEADFLAG = 1 THEN SPD = 0
 1060 IF (SPD AND 32768)<>0 THEN GOSUB *RON
 1070 IF (SPD AND 16384)<>0 THEN GOSUB *LON
 1080 IF (SPD AND 49152)=0  THEN GOSUB *XBR
 1090     IF (SPD AND 512)<>0 AND (JFLAG=1 OR FFLAG=1) THEN JFLAG =1:FFLAG =0:GOSUB *YUP
 1100     IF DFLAG=1 THEN GOSUB *YFALL
 1110 OLDCX = CX: OLDCY = CY
 1120 GOSUB *MOVE
 1130 GOSUB *SPSCRL
 1140 GOSUB *CDISP
 1150 GOSUB *CFSTAT
 1160 IF WDEAD=80 THEN RETURN
 1170 IF GCTR=0 THEN MES$=BMES$(RND(MESNUM)+1):GOSUB *MESOUT
 1180 IF PALFLAG=0 THEN GOSUB *PALSET:PALFLAG=1
 1190 GOTO *GLOOP
 1200 *PALSET
 1210 FOR I=1 TO 255
 1220 PALETTE 8,I,RGB(PR(I),PG(I),PB(I))
 1230 PALETTE 10,I,RGB(PR(I),PG(I),PB(I))
 1240 NEXT
 1250 RETURN
 1260 *RON
 1270 CVX=CVX+1 : IF CVX > 6 THEN CVX = 6
 1280 RETURN
 1290 *LON
 1300 CVX=CVX-1:IF CVX<-6 THEN CVX=-6
 1310 RETURN
 1320 *XBR
 1330 IF GCTR MOD 4 <> 0 THEN RETURN
 1340 IF CVX>0 THEN CVX=CVX-1
 1350 IF CVX<0 THEN CVX=CVX+1
 1360 RETURN
 1370 *YUP
 1380 CVY = CVY-2 : IF CVY < -4 THEN CVY = -4
 1390 RETURN
 1400 *YFALL
 1410 CVY = CVY+1 : IF CVY > 7 THEN CVY = 7
 1420 RETURN
 1430 *MOVE
 1440 NCX = CX + CVX
 1450 NCY = CY + CVY
 1460 NBLX = INT(NCX/8):NFRX = NCX-NBLX*8
 1470 NBLY = INT(NCY/8):NFRY = NCY-NBLY*8
 1480 XFLAG=0:YFLAG=0
 1490 IF NBLX < BLX THEN XFLAG = -1
 1500 IF ( NBLX>BLX AND NFRX>0 ) OR ( NBLX=BLX AND NFRX>0 AND FRX=0 ) THEN XFLAG = 1
 1510 IF NBLY < BLY THEN YFLAG = -1
 1520 IF ( NBLY>BLY AND NFRY>0 ) OR ( NBLY=BLY AND NFRY>0 AND FRY=0 ) THEN YFLAG = 1
 1530 IF XFLAG=0 AND YFLAG=0 THEN RETURN
 1540 IF YFLAG= 0 AND XFLAG=-1 THEN GOTO *CHECKLEFT
 1550 IF YFLAG= 0 AND XFLAG= 1 THEN GOTO *CHECKRIGHT
 1560 IF YFLAG=-1 AND XFLAG= 0 THEN GOTO *CHECKUP
 1570 IF YFLAG= 1 AND XFLAG= 0 THEN GOTO *CHECKDOWN
 1580 IF YFLAG=-1 AND XFLAG=-1 THEN GOTO *CHECKUL
 1590 IF YFLAG=-1 AND XFLAG= 1 THEN GOTO *CHECKUR
 1600 IF YFLAG= 1 AND XFLAG=-1 THEN GOTO *CHECKDL
 1610 GOTO *CHECKDR
 1620 *CHECKLEFT
 1630 CFLAG = 0
 1640 IF MAZD(NBLX,NBLY)   > 127 THEN CFLAG = 1
 1650 IF MAZD(NBLX,NBLY+1) > 127 THEN CFLAG = 1
 1660 IF MAZD(NBLX,NBLY+2) > 127 THEN CFLAG = 1
 1670 IF NFRY > 0 AND MAZD(NBLX,NBLY+3) > 127 THEN CFLAG = 1
 1680 IF CFLAG = 0 THEN RETURN
 1690 XBACK = 8 - NFRX
 1700 NCX = NCX + XBACK
 1710 NBLX = INT(NCX/8)
 1720 NFRX = 0
 1730 CVX = NCX - CX
 1740 RETURN
 1750 *CHECKRIGHT
 1760 CFLAG = 0
 1770 IF NFRX=0 THEN XFC=1 ELSE XFC=0
 1780 IF MAZD(NBLX+2-XFC,NBLY)   > 127 THEN CFLAG = 1
 1790 IF MAZD(NBLX+2-XFC,NBLY+1) > 127 THEN CFLAG = 1
 1800 IF MAZD(NBLX+2-XFC,NBLY+2) > 127 THEN CFLAG = 1
 1810 IF NFRY > 0 AND MAZD(NBLX+2-XFC,NBLY+3) > 127 THEN CFLAG = 1
 1820 IF CFLAG = 0 THEN RETURN
 1830 XBACK = NFRX
 1840 IF XBACK = 0 THEN XBACK = 8
 1850 NCX = NCX-XBACK
 1860 NFRX = 0
 1870 NBLX = INT(NCX/8)
 1880 CVX = NCX-CX
 1890 RETURN
