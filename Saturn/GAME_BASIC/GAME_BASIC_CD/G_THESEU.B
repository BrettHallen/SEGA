 7670 PLAYINIT "DSP","STANDARD",16,0,16,20
 7680 EFFECT 13,0,"@16V14L32C.G"  :'door open
 7690 EFFECT  2,0,"@28V13L32CEG"  :'get item
 7700 EFFECT  3,0,"@28V13L32GAB"
 7710 EFFECT  4,0,"@28V13L32CDE"
 7720 EFFECT  5,0,"@28V13L64CEGCEG"
 7730 EFFECT  6,0,"@28V13L64CEGCEG"
 7740 EFFECT  7,0,"@28V13L64CEGCEG"
 7750 EFFECT  8,0,"@29V11L64O4dcCGACBAdc"  :'damege star
 7760 EFFECT  9,0,"@19V14L32O3dcFEdc"      :'damege blood
 7770 EFFECT 10,0,"@24O3L32BB-AA-GG-FEE-DD-C"  :'dead
 7780 EFFECT 11,0,"@37O6L8dcV14CV10CV12CV10CCdc"
 7785 EFFECT 14,0,"@28V13L32O3CEGEG>C<GEG>CEG>C<G>C<GECEG>CEGEC4"
 7790 EFFECT 12,0,"@37O6L16dcV14CV10CV12CV10CCdc"
 7791 RESTORE *MUSDATA:SETSONG
 7792 TPROP(31,1,71)=0
 7800 RETURN
 7810 *CHRCONV
 7811 A$=READCHR$(4,1 ,255)
 7812 SETCHR 5,1,A$
 7820 A$=READCHR$(4,33,60)
 7830 FOR I=1 TO LEN(A$)
 7840 B$=MID$(A$,I,1)
 7850 IF ASC(B$)=0 THEN B$=CHR$(1)
 7860 MID$(A$,I,1)=B$
 7870 NEXT
 7880 SETCHR 4,33,A$
 7890 A$="":FOR I=0 TO 63:A$=A$+CHR$(1):NEXT
 7900 SETCHR 4,39,A$
 7910 RETURN
 7920 *SYNCCOUNT
 7930 TIMER (7) 1
 7940 SNCC=SNCC+1
 7950 RETURN
 7960 *LEVCLR
 7970 PLAYSTOP -1:VSYNC
 7980 MES$="I'WAS'SURE'YOU'WOULD'COME'TO'ME":GOSUB *MESOUT
 7985 EFFECT 14
 7990 TBONUS=INT(CTIME)
 8000 LCCTR=0
 8010 CVX=0:CVY=0:CX=HX+16:CY=HX
 8020 GOSUB *SPSCRL
 8030 CSX=HX+16-SX:CSY=HY-SY
 8040 GOSUB *CDISP
 8050 LCDT=LCCTR:IF LCDT>40 THEN LCDT=40
 8060 IF LCCTR<41 THEN SCORE=SCORE+INT(TBONUS/10)+1
 8070 CTIME=(1-LCDT/40)*TBONUS
 8080 GOSUB *STPRINT
 8090 LCCTR=LCCTR+1
 8100 OBJ(120,16)=89
 8110 OBJ(121,0)=5
 8120 WCLR=WCLR+1
 8130 IF LCCTR=100 THEN RETURN
 8140 CVX=0:CVY=0:GOTO 8010
 8150 *LCCHECK
 8160 IF RINGFLAG=1 AND KEYFLAG=1 THEN CLFLAG=1:RETURN
 8170 MES$="YOU'NEED'BOTH'KEY'AND'RING":GOSUB *MESOUT
 8180 RETURN
 8190 *STPRINT
 8200 'LOCATE 2,0:PRINT "LIFE''SCORE'TIME'LEV''KEY'RING"
 8210 SCO$=RIGHT$(STR$(SCORE),LEN(STR$(SCORE))-1)
 8220 SCO$=RIGHT$(NUL$+SCO$,6)
 8230 LIF$=RIGHT$(STR$(LIFE),LEN(STR$(LIFE))-1)
 8240 LIF$=RIGHT$(NUL$+LIF$,5)
 8250 TIM$=RIGHT$(STR$(INT(CTIME)),LEN(STR$(INT(CTIME)))-1)
 8260 TIM$=RIGHT$(NUL$+TIM$,4)
 8270 'LOCATE 1,0:PRINT "LIFE:"+LIF$
 8280 LOCATE 1,1:PRINT LIF$
 8290 LOCATE 7,1:PRINT SCO$
 8300 LOCATE 14,1:PRINT TIM$
 8310 'LOCATE 12,0:PRINT "SCORE:"+SCO$
 8320 'LOCATE 24,0:PRINT "TIME:"+TIM$
 8330 RETURN
 8340 *MESOUT
 8350 LOCATE 0,25:PRINT LEFT$(MES$+"''''''''''''''''''''''''''''''''''''''''''''''''''",36);
 8360 RETURN
