 8371 MST$="PUSH'C'BUTTON'TO'START"  
 8375 IF CTCLEV > 1 THEN MST$="'C'BUTTUN'RESTART/B'BUTTON'CONTINUE"
 8380 I=I+1:IF I=500 THEN I=0
 8390 IF (PAD(0,1) AND 512) THEN CTFLAG = 0:RETURN
 8395 IF (PAD(0,1) AND 256) AND CLEV > 1 THEN CTFLAG = 1:RETURN
 8400 IF I>350 THEN MES$="'" ELSE MES$=MST$
 8410 GOSUB *MESOUT
 8420 GOTO *STWAIT
