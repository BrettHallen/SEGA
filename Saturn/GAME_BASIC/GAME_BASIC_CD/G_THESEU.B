 4650 FREAD #1,D$,5:CX=VAL(D$)
 4660 FREAD #1,D$,5:CY=VAL(D$)
 4670 FREAD #1,D$,5:HX=VAL(D$)
 4680 FREAD #1,D$,5:HY=VAL(D$)
 4690 FREAD #1,D$,5:CTIME=VAL(D$)
 4700 SX=CX:CVX=0:CSVX=0:CSX=0
 4710 SY=CY:CVY=0:CSVY=0:CSY=0
 4720 OBJSPFR = 0 : DEADFLAG = 0 : DEADSEFLAG = 0 :WDEAD=0
 4730 RINGFLAG=0:KEYFLAG=0:CLFLAG =0:FFLAG=0 : FREEZE = 0
 4740 LIFE = LIFE+100
 4750 BLX = INT(CX/8):BLY = INT(CY/8)
 4760 CLOSE
 4770 FRX = 0:FRY = 0
 4780 FOR I=11 TO 200:OBJ(I,0)=0:NEXT
 4790 RETURN
 4800 *SPSCRL
 4810 CSVX = 0:CSVY = 0
 4820 IF CVX > 1 AND CSX>-100 THEN CSVX = -2
 4830 IF CVX = 1 AND CSX>-100 THEN CSVX = -1
 4840 IF CVX = 0 AND CSX>0    THEN CSVX = -1
 4850 IF CVX = 0 AND CSX<0    THEN CSVX =  1
 4860 IF CVX <-1 AND CSX <100 THEN CSVX =  2
 4870 IF CVX =-1 AND CSX <100 THEN CSVX =  1
 4880 IF CVY > 1 AND CSY>-50  THEN CSVY = -2
 4890 IF CVY = 1 AND CSY>-50  THEN CSVY = -1
 4900 IF CVY = 0 AND CSY>0    THEN CSVY = -1
 4910 IF CVY = 0 AND CSY<0    THEN CSVY =  1
 4920 IF CVY <-1 AND CSY <50  THEN CSVY =  2
 4930 IF CVY =-1 AND CSY <50  THEN CSVY =  1
 4940 CSX = CSX+CSVX
 4950 CSY = CSY+CSVY
 4960 SVX = CVX-CSVX
 4970 SVY = CVY-CSVY
 4980 SX  = SX+SVX
 4990 SY  = SY+SVY
 5000 CX = NCX
 5010 CY = NCY
 5020 BLX = INT(CX/8):FRX = CX-BLX*8
 5030 BLY = INT(CY/8):FRY = CY-BLY*8
 5040 RETURN
 5050 *CFSTAT
 5060 OFFLAG = FFLAG
 5070 P1 = MAZD(BLX,BLY+3):P2 = MAZD(BLX+1,BLY+3):P3 = MAZD(BLX+2,BLY+3)
 5080 IF (SPD AND 512)>0 AND CVY<0 AND JFLAG=1 THEN RETURN
 5090 IF (SPD AND 512)=0 THEN JFLAG = 0
 5100 IF (SPD AND 512)=0 AND FRY>0 THEN DFLAG = 1:FFLAG=0
 5110 IF FRY=0 AND FRX=0 AND (P1>127 OR P2>127) THEN FFLAG=1:DFLAG=0
 5120 IF FRY=0 AND FRX>0 AND (P1>127 OR P2>127 OR P3>127) THEN FFLAG=1:DFLAG=0
 5130 IF FRY=0 AND FRX=0 AND (P1<128 AND P2<128) THEN FFLAG=0:DFLAG=1
 5140 IF FRY=0 AND FRX>0 AND (P1<128 AND P2<128 AND P3<128) THEN FFLAG=0:DFLAG=1
 5150 IF DFLAG =1 THEN JFLAG =0
 5160 IF OFFLAG = 0 AND FFLAG =1 THEN LANDCTR=2
 5170 RETURN
 5180 *PALINIT
 5190 OPEN "PALWIN.D" FOR INPUT AS 1
 5200 FOR I=1 TO 255
 5210 FREAD #1,DR$,1:R=ASC(DR$)
 5220 FREAD #1,DG$,1:G=ASC(DG$)
 5230 FREAD #1,DB$,1:B=ASC(DB$)
 5240 PR(I)=R:PG(I)=G:PB(I)=B
 5250 PALETTE 8,I,RGB(0,0,0)
 5260 PALETTE 10,I,RGB(0,0,0)
 5270 NEXT
 5280 CLOSE
 5290 RETURN
 5300 *CHRINIT
 5310 OPEN "BGCHR.D"FOR INPUT AS 1
 5320 FOR C=0 TO 7
 5330 FREAD #1,D$,64
 5340 SETCHR 8,120+C,D$
 5350 NEXT
 5360 CLOSE
 5370 OPEN "WLCHR.D"FOR INPUT AS 1
 5380 FOR C=0 TO 7
 5390 FREAD #1,D$,64
 5400 SETCHR 8,248+C,D$
 5410 NEXT
 5420 CLOSE
 5430 RETURN
 5440 *SPRINIT
 5450 SETVERTEX 0,4,(-8,12,0),(-8,-12,0),(8,-12,0),(8,12,0)
 5460 SETPOLYGON 0,1,0,,(1,2,3,0)
 5470 OPEN "MYCHR.D" FOR INPUT AS 1
 5480 FOR I=0 TO 19
 5490 FREAD #1,A$,384
 5500 SETTEX I,16,24,256,A$
 5510 SETATR I*2,1,(0,1,3,I,0,0)
 5520 SETATR I*2+1,1,(1,1,3,I,0,0)
 5530 NEXT
 5540 OBJ(1,16)=0,0:OBJ(1,0)=5:OBJ(1,2)=1
 5550 OBJ(2,16)=0,0:OBJ(2,0)=6:OBJ(2,2)=1:OBJ(2,20)=1
 5560 OBJ(3,16)=0,0:OBJ(3,0)=6:OBJ(3,2)=1:OBJ(3,20)=1
 5570 OBJ(4,16)=0,0:OBJ(4,0)=6:OBJ(4,2)=1:OBJ(4,20)=1
 5580 OBJ(10,16)=0,0:OBJ(10,0)=6
 5590 CLOSE
 5600 OPEN "ENECHR.D" FOR INPUT AS 1
 5610 SETVERTEX 1,4,(-8,8,0),(-8,-8,0),(8,-8,0),(8,8,0)
 5620 SETPOLYGON 1,1,1,,(1,2,3,0)
 5630 FOR I=20 TO 35
 5640 FREAD #1,A$,256
 5650 SETTEX I,16,16,256,A$
 5660 SETATR I+20,1,(0,1,3,I,0,0)
 5670 NEXT
 5680 CLOSE
 5690 OPEN "YAKCHR.D" FOR INPUT AS 1
 5700 FOR I=36 TO 67
 5710 FREAD #1,A$,256
 5720 SETTEX I,16,16,256,A$
 5730 SETATR I+20,1,(0,1,3,I,0,0)
 5740 NEXT
 5750 CLOSE
 5760 OPEN "HEROCHR.D" FOR INPUT AS 1
 5770 FREAD #1,A$,384
 5780 SETTEX 68,16,24,256,A$
 5790 SETATR 88,1,(0,1,3,68,0,0)
 5800 FREAD #1,A$,384
 5810 SETTEX 69,16,24,256,A$
 5820 SETATR 89,1,(0,1,3,69,0,0)
 5830 FREAD #1,A$,256
 5840 SETTEX 70,16,16,256,A$
 5850 SETATR 90,1,(0,1,3,70,0,0)
 5860 CLOSE
 5870 RETURN
 5880 *ENEMOVE
 5890 ENEFRAME=GCTR MOD 4
 5900 ENEFLASH=GCTR MOD 7
 5910 IF ENEFLASH >0 THEN ENEFLASH=1
 5920 IF FREEZE>0 THEN RETURN
 5930  FOR I=1 TO ENENUM
 5940  ENED(I,1)=ENED(I,1)+ENED(I,3)
 5950  ENED(I,2)=ENED(I,2)+ENED(I,4)
 5960  ENED(I,5)=ENED(I,5)-1
 5970  IF ENED(I,5)>0 THEN GOTO *ENEMEND
 5980 ENED(I,5)=ENED(I,6)
 5990 ENED(I,3)=ENED(I,3)*(-1)
 6000 ENED(I,4)=ENED(I,4)*(-1)
 6010 *ENEMEND
 6020 NEXT
 6030 RETURN
 6040 *ENEDISP
 6050  FOR I=1 TO ENENUM
 6060  OBJ(I+10,4)=ENED(I,1)-SX
 6070  OBJ(I+10,5)=ENED(I,2)-4-SY
 6080 EATR=ENED(I,7)*4*ENEFLASH+ENEFRAME+40
 6090 OBJ(I+10,16)=EATR
 6100  NEXT
 6110 RETURN
 6120 *ENEREAD
 6130 OPEN ENEF$(CLEV) FOR INPUT AS 1
 6140 FREAD #1,D$,3
 6150 ENENUM = VAL(D$)
 6160 FOR I=1 TO ENENUM
 6170  FOR J=1 TO 8
 6180  FREAD #1,D$,3
 6190  ENED(I,J) = VAL(D$)
 6200  NEXT
 6210  OBJ(10+I,17)=1:OBJ(10+I,0)=5:OBJ(10+I,2)=2
 6220 NEXT
 6230 CLOSE
 6240 RETURN
 6250 *ITEMREAD
 6260 OPEN ITMF$(CLEV) FOR INPUT AS 1
 6270 FREAD #1,D$,3
 6280 DOORNUM = VAL(D$)
 6290 FOR I=1 TO DOORNUM
 6300  FOR J=1 TO 7
 6310  FREAD #1,D$,3
 6320  DOORD(I,J) = VAL(D$)
 6330  NEXT : DOORD(I,8)=0
 6340  OBJ(50+I,17)=1:OBJ(50+I,0)=5:OBJ(50+I,2)=4
 6350 NEXT
 6360 FREAD #1,D$,3
 6370 ITEMNUM = VAL(D$)
 6380 FOR I=1 TO ITEMNUM
 6390  FOR J=1 TO 5
 6400  FREAD #1,D$,3
 6410  ITEMD(I,J) = VAL(D$)
 6420  NEXT : ITEMD(I,6)=0
 6430  OBJ(70+I,17)=1:OBJ(70+I,0)=5:OBJ(70+I,2)=8
 6440 NEXT
 6450 CLOSE
 6460 RETURN
 6470 *DOORDISP
 6480 DOORFRAME=INT((GCTR MOD 40)/10)
 6490  FOR I=1 TO DOORNUM
 6500  OBJ(I+50,4)=DOORD(I,1)
 6510  OBJ(I+50,5)=DOORD(I,2)-4
 6520  OBJ(I+50,20)=10
 6530  DATR=DOORD(I,3)*4+DOORFRAME+56
 6540  OBJ(I+50,16)=DATR
 6550  NEXT
 6560 RETURN
 6570 *DOORDISP2
 6580 DOORFRAME=INT((GCTR MOD 40)/10)
 6590  FOR I=1 TO DOORNUM
 6600  DATR=DOORD(I,3)*4+DOORFRAME+56
 6610  OBJ(I+50,16)=DATR
 6620  NEXT
 6630 RETURN
 6640 *ITEMDISP
 6650  ITEMFRAME = GCTR MOD 4
 6660  FOR I=1 TO ITEMNUM
 6670  OBJ(I+70,4)=ITEMD(I,1)
 6680  OBJ(I+70,5)=ITEMD(I,2)-4
 6690  OBJ(I+70,20)=10
 6700  IATR=ITEMD(I,3)*4+ITEMFRAME+64
 6710  OBJ(I+70,16)=IATR
 6720  NEXT
 6730 RETURN
 6740 *ITEMDISP2
 6750  ITEMFRAME = GCTR MOD 4
 6760  FOR I=1 TO ITEMNUM
 6770  IATR=ITEMD(I,3)*4+ITEMFRAME+64
 6780  OBJ(I+70,16)=IATR
 6790  NEXT
 6800 RETURN
 6810 *HERODISP
 6820 OBJ(120,0)=5:OBJ(120,16)=88,0:OBJ(120,20)=10
 6830 OBJ(121,0)=0:OBJ(121,16)=90,1:OBJ(121,20)=10
 6840 OBJ(120,4)=HX,HY:OBJ(121,4)=HX+8,HY-24
 6850 RETURN
 6860 *SPCOLCHK
 6870 IF DEADFLAG = 1 THEN GOTO *SPCOLCE
 6880 IF OBJ(1,62)=-1 THEN  GOTO *SPCOLCE
 6890 GOSUB *ENEMYCOLC
 6900 I= OBJ(3,63) - 50
 6910 GOSUB *ITEMCOLC
 6920 GOSUB *DOORCOLC
 6930 *SPCOLCE
 6940 OBJ(1,60) = 14
 6950 OBJ(2,60) = 2
 6960 OBJ(3,60) = 4
 6970 OBJ(4,60) = 8
 6980 RETURN
 6990 *ENEMYCOLC
 7000 DAMAGEFLAG = 0
 7010 IF OBJ(2,62)=-1 THEN RETURN
 7020 I=OBJ(2,63) - 10
 7030 DX = OLDCX - ENED(I,1)
 7040 DY = OLDCY - ENED(I,2)
 7050 IF DX<-10 OR DX>10 OR DY<-18 OR DY>10 THEN GOTO *NOTECOL
 7060 IF DESCTR = 0 THEN EFFECT (DMSEC),-8
 7070 DAMAGEFLAG = 1:DESCTR=8
 7080 LIFE = LIFE - ENED(I,8)
 7090 *NOTECOL
 7100 RETURN
 7110 *DOORCOLC
 7120 IF OBJ(3,62)=-1 THEN RETURN
 7130 DX = OLDCX - DOORD(I,1)
 7140 DY = OLDCY - DOORD(I,2)
 7150 IF DX<-10 OR DX>10 OR DY<-18 OR DY>10 THEN DOORD(I,8)=0:GOTO *NOTDCOL
 7160 IF DOORD(I,8)=1 THEN GOTO *NOTDCOL
 7170 DOORD(I,8)=1
 7180 IF MAZD(DOORD(I,5),DOORD(I,6))<>DOORD(I,7) THEN EFFECT -13
 7190 IF DOORD(I,4)=0 THEN GOSUB *HDOOR ELSE GOSUB *VDOOR
 7200 *NOTDCOL
 7210 RETURN
 7220 *HDOOR
 7230 FOR J=0 TO 6
 7240 MAZD(DOORD(I,5)+J,DOORD(I,6))=DOORD(I,7)
 7250 PUTCHR 8,(DOORD(I,5)+J,DOORD(I,6)),DOORD(I,7)*2
 7260 NEXT
 7270 RETURN
 7280 *VDOOR
 7290 FOR J=0 TO 6
 7300 MAZD(DOORD(I,5),DOORD(I,6)+J)=DOORD(I,7)
 7310 PUTCHR 8,(DOORD(I,5),DOORD(I,6)+J),DOORD(I,7)*2
 7320 NEXT
 7330 RETURN
 7340 *ITEMCOLC
 7350 GETFLAG = 0
 7360 IF OBJ(4,62)=-1 THEN RETURN
 7370 I= OBJ(4,63) - 70
 7380 DX = OLDCX - ITEMD(I,1)
 7390 DY = OLDCY - ITEMD(I,2)
 7400 IF DX<-10 OR DX>10 OR DY<-18 OR DY>10 THEN GOTO *NOTICOL
 7410 IF ITEMD(I,6)=1 THEN GOTO *NOTICOL
 7420 ITEMD(I,6)=1
 7430 GETFLAG = ITEMD(I,3)+1:EFFECT 1*(GETFLAG + 1)
 7440 OBJ(I+70,0)=0
 7450 IF GETFLAG = 3 THEN KEYFLAG = 1:GOSUB *KEYMES
 7460 IF GETFLAG = 2 THEN RINGFLAG = 1:GOSUB *RINGMES
 7470 IF GETFLAG = 5 THEN GOSUB *FRZMES
 7480 LIFE = LIFE + ITEMD(I,5)
 7490 SCORE= SCORE+ ITEMD(1,4)
 7500 *NOTICOL
 7510 RETURN
 7520 *KEYMES
 7530 MES$="YOU'GET'A'KEY":GOSUB *MESOUT
 7540 LOCATE 25,1:PRINT "OK";
 7550 RETURN
 7560 *RINGMES
 7570 MES$="YOU'GET'A'RING":GOSUB *MESOUT
 7580 LOCATE 30,1:PRINT "OK";
 7590 RETURN
 7591 *FRZMES
 7592 IF FREEZE > 0 THEN PLAYSTOP FRZSND
 7593 FREEZE = 500:EFFECT (FRZSND),-11
 7594 MES$="YOU'GET'ELIXIR":GOSUB *MESOUT
 7599 RETURN
 7600 *BPCHECK
 7610 IF MAZD(BLX,BLY+2)<>122 THEN RETURN
 7620 IF DEADFLAG=0 AND BESCTR=0 THEN EFFECT (BMSEC),-9
 7630 BESCTR = 3
 7640 LIFE = LIFE -80
 7650 RETURN
