 4110 *CDISP
 4120 MCFR= GCTR MOD 6
 4130 IF DEADFLAG = 1 THEN GOSUB *DEADSPR:GOTO *MSPEND
 4140 IF CVX < 0 AND FFLAG =1 THEN OBJ(1,16)=MCFR*2+2
 4150 IF CVX = 0 AND FFLAG =1 THEN OBJ(1,16)=0
 4160 IF CVX > 0 AND FFLAG =1 THEN OBJ(1,16)=MCFR*2+3
 4170 IF FFLAG=0 AND CVX = 0 THEN OBJ(1,16)=14
 4180 IF FFLAG=0 AND CVX<0 THEN OBJ(1,16)=22
 4190 IF FFLAG=0 AND CVX>0 THEN OBJ(1,16)=23
 4200 IF LANDCTR=2 AND CVX=0 THEN OBJ(1,16)=18
 4210 IF LANDCTR=1 AND CVX=0 THEN OBJ(1,16)=16
 4220 IF LANDCTR>0 AND CVX<0 THEN OBJ(1,16)=24
 4230 IF LANDCTR>0 AND CVX>0 THEN OBJ(1,16)=25
 4240 *MSPEND
 4250 GOSUB *ENEMOVE
 4260 GOSUB *BPCHECK
 4270 OBJ(1,4)=CSX:OBJ(1,5)=CSY
 4280 OBJ(10,4)=-SX:OBJ(10,5)=-SY
 4290 GOSUB *ENEDISP
 4300 GOSUB *ITEMDISP2
 4310 GOSUB *DOORDISP2
 4320 GOSUB *SPCOLCHK
 4330 IF DEADSEFLAG=1 THEN GOSUB *DEADSE
 4340 IF DESCTR=1 THEN PLAYSTOP DMSEC
 4350 DESCTR=DESCTR-1:IF DESCTR<0 THEN DESCTR=0
 4360 IF BESCTR=1 THEN PLAYSTOP BMSEC
 4370 BESCTR=BESCTR-1:IF BESCTR<0 THEN BESCTR=0
 4380 SNCCW = SNCC:TIMER (7) ON,1
 4390 IF SNCCW=0 THEN VSYNC 3
 4400 IF SNCCW=1 THEN VSYNC 2
 4410 IF SNCCW=2 THEN VSYNC 1
 4420 SNCC=0
 4430  ROTCENTER -SX+312,-SY+213
 4440 GCTR=GCTR+1 : IF GCTR=120 THEN GCTR=0
 4450 LANDCTR=LANDCTR-1: IF LANDCTR<0 THEN LANDCTR=0
 4460 RETURN
 4470 *DEADSPR
 4480 IF FFLAG = 0 THEN OBJ(1,16)=0 : RETURN
 4490 IF OBJSPFR = 0 THEN OBJSPFR = 8:DEADSEFLAG = 1
 4500 OBJSPFR=OBJSPFR-1
 4510 IF OBJSPFR = 0 THEN OBJSPFR = 1:WDEAD = WDEAD+1
 4520 OBJ(1,16)=(7-OBJSPFR)*2+26
 4530 RETURN
 4540 *DEADSE
 4550 PLAYSTOP -1:VSYNC
 4560 EFFECT 10:DEADSEFLAG = 0
 4570 DESCTR=0:BESCTR=0:FREEZE=0
 4580 RETURN
 4590 *VINIT
