 1930 IF MAZD(NBLX+1,NBLY) > 127 THEN CFLAG = 1
 1940 IF NFRX > 0 AND MAZD(NBLX+2,NBLY) > 127 THEN CFLAG = 1
 1950 IF CFLAG = 0 THEN RETURN
