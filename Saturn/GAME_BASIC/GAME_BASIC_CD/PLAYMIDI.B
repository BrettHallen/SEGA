 3540 '
 3560 *ENV2MML
 3570 ON ERROR GOTO *ENV2MML_ERR
 3580 NOW#=0
 3590 A$=""
 3600 N$=""
 3610 PAN=-2
 3620 PAN0=-2
 3630 N_CNT=0
 3640 EX=127
 3650 TRK_VOL=127
 3660 VOL=127
 3670 VOL0=127
 3680 PRO1=0
 3690 PRO=0
 3700 PIT=64
 3710 PIT0=64
 3720 DAN=0
 3730 DAN0=0
 3740 COLOR 7:PRINT       "Prg Exp Pan Pit TrkVol Dan"
 3750 COLOR 5:PRINT USING "### ### ### ###    ### ###";PRO;EX;PAN;PIT;TRK_VOL;DAN:COLOR 7
 3760 MML$(CNV_TRACK)="V15P64@V127"
 3770 IF CNV_TRACK=9 THEN MML$(CNV_TRACK)=MML$(CNV_TRACK)+"@1"
 3780 FOR I=0 TO ENV_CNT-1
 3790  EV=EVENT(I)
 3800  IF NOW#<>DELTA#(I) THEN
 3810   GOSUB *MSET
 3820   NOW#=DELTA#(I)
 3830   MML$(CNV_TRACK)=MML$(CNV_TRACK)+A$
 3840   A$=""
 3850  ENDIF
 3860  IF EV=1 THEN
 3870   EX=PARAM1(I) AND 127
 3880   VOL=INT((EX*TRK_VOL)/127)
 3890  ENDIF
 3900  IF EV=2 THEN
 3910   PAN=PARAM1(I) AND 127
 3920  ENDIF
 3930  IF EV=3 THEN
 3940   PIT=PARAM1(I) AND 127
 3950  ENDIF
 3960  IF EV=4 THEN
 3970   TRK_VOL=PARAM1(I) AND 127
 3980   VOL=INT((EX*TRK_VOL)/127)
 3990  ENDIF
 4000  IF EV=5 THEN
 4010   IF CNV_TRACK<>9 THEN PRO=(PARAM1(I) AND 127)+1
 4020  ENDIF
 4030  IF EV=6 THEN
 4040   DAN=PARAM1(I) AND 127
 4050  ENDIF
 4060  IF EV=0 THEN
 4070   IF N_CNT<MAX_TR THEN
 4080    KEY_VOL=INT((PARAM1(I)/128) AND &H7F)
 4090    N$=N$+"N"+MID$(STR$(PARAM1(I) AND 127),2,255)+"'l"+MID$(STR$(LENGTH#(I)),2,255)+";"+MID$(STR$(INT(11.3*SQR(KEY_VOL))),2,255)
 4100    N_CNT=N_CNT+1
 4110   ENDIF
 4120  ENDIF
 4130  PRINT CHR$(30);
 4140  COLOR 5:PRINT USING "### ### ### ###    ### ### ###%";PRO;EX;PAN;PIT;TRK_VOL;DAN;INT((I+1)*10/ENV_COUNT(CNV_TRACK))*10:COLOR 7
 4150 NEXT
 4160 PRINT CHR$(30);
 4170 'Éº¯ÀÓÉ¦¶·ÀÞ½
 4180 GOSUB *MSET
 4190 NOW#=DELTA#(I)
 4200 MML$(CNV_TRACK)=MML$(CNV_TRACK)+A$
 4210 A$=""
