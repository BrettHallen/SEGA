 4340 *MSET
 4350 IF PRO<>PRO1 THEN
 4360   PRO1=PRO
 4370   A$=A$+"@"+MID$(STR$(PRO),2,255)
 4380   IF PAN>=0 THEN A$=A$+"P"+MID$(STR$(PAN),2,255)
 4390 ENDIF
 4400 IF PAN0<>PAN THEN PAN0=PAN:A$=A$+"P"+MID$(STR$(PAN),2,255)
 4410 IF VOL0<>VOL THEN
 4420   VOL0=VOL
 4430   IF VOL<>0 THEN A$=A$+"@V"+MID$(STR$(INT(11.3*SQR(VOL))),2,255) ELSE A$=A$+"@V1"
 4440 ENDIF
 4450 IF PIT0<>PIT THEN
 4460   PIT0=PIT
 4470   A$=A$+"Rl0~"+MID$(STR$(PIT),2,255)+";"+MID$(STR$(PIT),2,255)+";1"
 4480 ENDIF
 4490 IF DAN0<>DAN THEN
 4500   DAN0=DAN
 4510   A$=A$+"%"+MID$(STR$(DAN),2,255)
 4520 ENDIF
 4530 'NOTE
 4540 IF N$<>"" THEN
 4550   A$=A$+"("+N$+"Rl1)"
 4560   N$=""
 4570   N_CNT=0
 4580   NOW#=NOW#+1
 4590 ENDIF
 4600 'ËÂÖ³ÃÞ±ÚÊÞR¦¿³Æ­³½Ù
 4610 IF NOW#<>DELTA#(I) THEN
 4620  TEMP# = DELTA#(I)-NOW#
 4640 *L000
 4650  IF TEMP#>=1920 THEN
 4660    A$=A$+"R1"
 4670    TEMP#=TEMP#-1920
 4680    GOTO *L000
 4690  ENDIF
 4700  IF TEMP#>0 THEN A$=A$+"Rl"+MID$(STR$(TEMP#),2,255)
 4710 ENDIF
 4720 RETURN
