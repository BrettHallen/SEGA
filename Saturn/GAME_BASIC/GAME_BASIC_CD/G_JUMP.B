 1760 PALETTE 8,238,RGB( 31, 3, 31)
 1770 PALETTE 8,239,RGB( 31, 31, 31)
 1780 'PALETTE 8,238,RGB(30,30,31)
 1790 'PALETTE 8,239,RGB(31,0,0)
 1800 '
 1810 PALETTE 8,240,RGB(0,0,20)
 1820 PALETTE 8,241,RGB(18,18,18)
 1830 '
 1840 PALETTE 10,17,RGB(24,0,0)
 1850 '
