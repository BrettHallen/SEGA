 1870 PALETTE 10,28,RGB(15,15,15)
 1880 PALETTE 10,29,RGB(18,18,18)
 1890 PALETTE 10,30,RGB(21,21,21)
 1900 PALETTE 10,31,RGB(24,24,24)
 1910 '
 1920 FOR GX= 0 TO 127
 1930 FOR GY = 0 TO 127
 1940 GR = RND(2)+3
 1950 PUTCHR 8,(GX,GY),GR*2
 1960 NEXT
 1970 NEXT
 1980 '
 1990 FOR G=0 TO 31
 2000 GX = RND(31)*4
 2010 GY = RND(31)*4
 2020 GR = RND(4)+1
 2030 FOR X = 0 TO 7
 2040 FOR Y = 0 TO 7
 2050 PUTCHR 8,(GX+X,GY+Y),GR*2
 2060 NEXT
 2070 NEXT
 2080 NEXT
 2090 '
 2100 LOCX = 32
 2110 LOCY = 32
 2120 READ GX,GY
 2130 FOR Y = 0 TO GY-1
 2140 FOR X = 0 TO GX-1
 2150 READ GR
 2160 PUTCHR 8,(LOCX+X,LOCY+Y),GR*2
 2170 NEXT
 2180 NEXT
 2190 '----------------------------------
 2200 FOR Y = 0 TO 8
 2210 READ BACK
 2220 FOR X= 0 TO 127
 2230 PUTCHR 9,(X,Y),(BACK+256)*2
 2240 NEXT
 2250 NEXT
 2260 '----------------------------------
 2270 FOR Y = 6 TO 7
 2280 FOR X = 0 TO 119
 2290 READ BACK
 2300 PUTCHR 9,(X,Y),(BACK+256)*2
 2310 NEXT
 2320 NEXT
 2330 '----------------------------------
 2340 FOR G = 0 TO 9
 2350 READ GG
 2360 GAGE(G) = GG
 2370 NEXT
 2380 '----------------------------------
 2390 SETTEX 0,8,8,256,READ
 2400 SETTEX 1,8,8,256,READ
 2410 SETTEX 2,8,8,256,READ
 2420 SETTEX 3,8,8,256,READ
 2430 SETTEX 4,8,8,256,READ
 2440 SETTEX 5,8,8,256,READ
 2450 SETTEX 6,8,8,256,READ
 2460 SETTEX 7,8,8,256,READ
 2470 SETTEX 8,8,8,256,READ
 2480 SETTEX 9,8,8,256,READ
