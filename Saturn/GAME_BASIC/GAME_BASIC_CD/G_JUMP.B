 2790 SETPOLYGON 7,16,7,READ
 2800 SETATR     7,16,READ
 2810 '
 2820 SETVERTEX  8,8,READ
 2830 SETPOLYGON 8,5,8,READ
 2840 SETATR     8,5,READ
 2850 '
 2860 SETVERTEX  9,8,READ
 2870 SETPOLYGON 9,5,9,READ
 2880 SETATR     9,5,READ
 2890 '----------------------------------
 2900 POAL(0)=-104
 2910 POAL(1)=-168
 2920 POAL(2)=-56
 2930 '
 2940 OBJ(0,@XP) = 0,0,10
 2950 OBJ(0,@ORDER) = 7
 2960 '
 2970 FOR MAPY=0 TO 127
 2980 FOR MAPX=0 TO 127
 2990 MAP(MAPX,MAPY) = 0
 3000 NEXT
 3010 NEXT
 3020 '
 3030 'Gen pole and terget
 3040 FOR P = 0 TO 7
 3050 *GEN_POLE
 3060 *RND_LPX
 3070 X = RND(96)+16
 3080 IF X >= 48 AND X < 80 THEN *RND_LPX
 3090 *RND_LPY
 3100 Y = RND(96)+16
 3110 IF Y >= 48 AND Y < 80 THEN *RND_LPY
 3120 IF MAP(X,Y)<>0 THEN *GEN_POLE
 3130 MAP(X,Y) = 1
 3140 X = X * 16
 3150 Y = Y * 16
 3160 POAL = RND(3)
 3170 '
 3180 OBJ(P+1,@ATR) = 4,4
 3190 OBJ(P+1,@TYPE) = 4
 3200 OBJ(P+1,@XP) = X,POAL(POAL),-Y
 3210 OBJ(P+1,@ORDER) = 0
 3220 OBJ(P+1,@XRV) = ,.01
 3230 POALX(P) = X
 3240 POALY(P) = Y
 3250 POALH(P) = POAL(POAL)
 3260 '
 3270 FOR LP = 0 TO 7
 3280 OBJ(P*8+9+LP,@ATR) = 6,6
 3290 OBJ(P*8+9+LP,@TYPE) = 0
 3300 OBJ(P*8+9+LP,@XP) = 30*XCOS(LP*.125),30*XSIN(LP*.125)
 3310 OBJ(P*8+9+LP,@ZR) = (LP*.125)+.25
 3320 OBJ(P*8+9+LP,@ORDER) = 0
 3330 OBJ(P*8+9+LP,@PARENT) = P+1
 3340 NEXT
 3350 NEXT
 3360 '
 3370 '----------------------------------
 3380 'control_tower
 3390 OBJ(73,@ATR)  = 0,0
 3400 OBJ(73,@TYPE) = 4
 3410 OBJ(73,@XP) = 60*8*2,,-69*8*2-10
 3420 OBJ(73,@ORDER) = 0
 3430 'Rader
 3440 OBJ(74,@ATR)  = 1,1
 3450 OBJ(74,@TYPE) = 4
 3460 OBJ(74,@XP) = 0,0
 3470 OBJ(74,@ORDER) = 0
 3480 OBJ(74,@PARENT) = 73
 3490 OBJ(74,@XRV) = ,.005
 3500 'Hunger "A"
 3510 OBJ(75,@ATR)  = 2,2
 3520 OBJ(75,@TYPE) = 4
 3530 OBJ(75,@XP) = 56*8*2,,-71*8*2
 3540 OBJ(75,@ORDER) = 0
 3550 'Hunger "B"
 3560 OBJ(76,@ATR)  = 3,3
 3570 OBJ(76,@TYPE) = 4
 3580 OBJ(76,@XP) = 54*8*2+8,,-76*8*2
 3590 OBJ(76,@ORDER) = 0
 3600 '
 3610 READ CC
 3620 FOR MP=0 TO CC-1
 3630 READ TP
 3640 READ MX,MY
 3650 OBJ(77+MP,@ATR)  = TP,TP
 3660 OBJ(77+MP,@TYPE) = 4
 3670 OBJ(77+MP,@XP) = MX+(32*16),,-MY-(32*16)
 3680 OBJ(77+MP,@ORDER) = 0
 3690 NEXT
 3700 '----------------------------------
 3710 ZOOM 4,1,2
 3720 DISPLAY ON
 3730 '
 3740 *DEMO_PLAY
 3750 '
 3760 GOSUB *GAME_INIT
 3770 PX=38*8*2:PY=64*8*2:PZ=32
 3780 DIR     = .25           :' ¼®·¼¾ÝÎ³º³
 3790 DIR_PRM = .0004          :' ÌßÚ²ÔÀ°ÝÊß×Ò°À
 3800 PV=1
 3810 '
 3820 FOR TERGET = 0 TO 7
 3830 GOSUB *OPEN_TGT
 3840 NEXT
 3850 '
 3860 INTERVAL (0) ON,3
 3870 *DEMO_LOOP
 3880 '
 3890 IF MSG_T <> 0 THEN *DEMO_MSG
 3900 MSG$ = "PRESS START !"
 3910 MSG_T = 30
 3920 *DEMO_MSG
 3930 '
 3940 PDL = PAD(0,1)
 3950 IF PDL AND @PAD_START THEN *MAIN_PLAY
 3960 '
 3970 DIR = DIR - DIR_PRM
 3980 IF DIR < 0 THEN DIR = DIR + 1
 3990 '
 4000 PVX= PV*XCOS(DIR)
 4010 PVY=-PV*XSIN(DIR)
 4020 PX=PX+PVX:PY=PY-PVY
 4030 '
 4040 OBJ(0,@XR) = EYE,-DIR
 4050 OBJ(0,@XP) = -PX,PZ,PY
 4060 '
 4070 ACTIVE 8
 4080 ROTPOS PX/2,PY/2,PZ
 4090 ROTATE BANK,,DIR
 4100 '
 4110 ACTIVE 9
 4120 ROTPOS DIR*128*8
 4130 GOSUB *MSG
 4140 VSYNC
 4150 GOTO *DEMO_LOOP
 4160 '
 4170 '----------------------------------
 4180 *MAIN_PLAY
 4190 BGM 2
 4200 GOSUB *MSG_CLEAR
 4210 CLS
 4220 GOSUB *GAME_INIT
 4230 TERGET  = 0
 4240 GOSUB *OPEN_TGT
 4250 '
 4260 INTERVAL (0) ON,3
 4270 MSG$ = "START !!"
 4280 MSG_T = 15
 4290 *LOOP
 4300 '
 4310 MIN = INT(TIME/60)
 4320 SEC = TIME-INT(TIME/60)*60
 4330 LOCATE 1,11:PRINT USING "##:##.##";MIN,SEC
 4340 '
 4350 GOSUB *H_GAGE
 4360 GOSUB *MSG
 4370 '
 4380 DY = ABS(POALY(TERGET)-PY)
 4390 IF DY > 4 THEN *NO_TOUCH
 4400 '
 4410 DX = ABS(POALX(TERGET)-PX)
 4420 IF DX > 30 THEN *NO_TOUCH
 4430 DY = ABS(-POALH(TERGET)-PZ)
 4440 IF DY > 30 THEN *NO_TOUCH
 4450 DL = DX*DX + DY*DY
 4460 IF DL > DR THEN *NO_TOUCH
 4470 GOSUB *CLOSE_TGT
 4480 EFFECT -1
 4490 MSG$ = "NEXT RING !"
 4500 MSG_T = 10
 4510 TERGET = TERGET + 1
 4520 IF TERGET = 8 THEN *ALL_CLR
 4530 GOSUB *OPEN_TGT
 4540 GOTO *NXT_R
 4550 *ALL_CLR
 4560 MSG$ = "ALL RING CLEAR !"
 4570 MSG_T = 10
 4580 '
 4590 *NXT_R
 4600 *NO_TOUCH
 4610 '
 4620 PDL = PAD(0,1)
 4630 '
 4640 IF PDL AND @PAD_LEFT  THEN DIR = DIR - DIR_PRM
 4650 IF PDL AND @PAD_RIGHT THEN DIR = DIR + DIR_PRM
 4660 IF DIR > 1 THEN DIR = DIR - 1
 4670 IF DIR < 0 THEN DIR = DIR + 1
 4680 '
 4690 SIND = XSIN(DIR)
 4700 COSD = XCOS(DIR)
 4710 '
 4720 IF PDL AND @PAD_A THEN JSP = JSP +JUMP
 4730 IF PDL AND @PAD_B THEN JSP = JSP +JUMP_H
 4740 IF JSP > 1 THEN JSP = 1
 4750 JSP = JSP + GRV
 4760 PZ = PZ + JSP
 4770 IF PZ >10002+JSP THEN PZ = 10002
 4780 IF PZ < 2 THEN PZ = 2 : JSP = -(.2*JSP)
 4790 IF TIME_S = 0 THEN *RAND_CHECK
 4800 IF TERGET <> 8 THEN *RAND_CHECK
 4810 IF PZ > 2 THEN *RAND_CHECK
 4820 IF ABS(PX-38*8*2) > 32 THEN *RAND_CHECK
 4830 IF ABS(PY-64*8*2) > 32 THEN *RAND_CHECK
 4840 GOTO *GAME_END
 4850 *RAND_CHECK
 4860 IF PZ = 2 THEN *WALK
 4870 *FLY
 4880 TIME_S = 1            :' Clock start
 4890 AX=PVA*SIND
 4900 AY=PVA*COSD
 4910 IF PDL AND @PAD_DOWN THEN PVX=PVX-AX: PVY=PVY-AY
 4920 IF PDL AND @PAD_UP   THEN PVX=PVX+AX: PVY=PVY+AY
 4930 GOTO *MOVE
 4940 '
 4950 *WALK
 4960 PVX=0:PVY=0
 4970 IF PDL AND @PAD_DOWN THEN PVX =-SPEED*SIND: PVY=-SPEED*COSD
 4980 IF PDL AND @PAD_UP   THEN PVX = SPEED*SIND: PVY= SPEED*COSD
 4990 '
 5000 *MOVE
 5010 PX=PX+PVX:PY=PY-PVY
 5020 PVX=PVX-PVX*.001
 5030 PVY=PVY-PVY*.001
 5040 '
 5050 IF PDL AND @PAD_X THEN BANK =  -.25:EYE =    0
 5060 IF PDL AND @PAD_Y THEN BANK = -.175:EYE = .075
 5070 IF PDL AND @PAD_Z THEN BANK =     0:EYE =  .25
 5080 '
 5090 OBJ(0,@XR) = EYE,-DIR
 5100 OBJ(0,@XP) = -PX,PZ,PY
 5110 '
 5120 ACTIVE 8
 5130 ROTPOS PX/2,PY/2,PZ
 5140 ROTATE BANK,,DIR
 5150 '
 5160 ACTIVE 9
 5170 ROTPOS DIR*128*8
 5180 VSYNC
 5190 GOTO *LOOP
 5200 '----------------------------------
 5210 *GAME_END
 5220 INTERVAL (0) OFF
 5230 PLAYSTOP 0
 5240 MIN = INT(TIME/60)
 5250 SEC = TIME-INT(TIME/60)*60
 5260 CLS
 5270 MSG$ = "LANDING !!"
 5280 MSG_T = 30
 5290 *END_DEMO
 5300 PDL = PAD(0,1)
 5310 IF PDL AND @PAD_START THEN *MAIN_PLAY
 5320 LOCATE 9,9:PRINT USING "CLEAR TIME: ##:##.##";MIN,SEC
 5330 GOSUB *MSG
 5340 IF MSG_T = 0 THEN *DEMO_PLAY
 5350 VSYNC
 5360 GOTO *END_DEMO
 5370 END
 5380 '----------------------------------
 5390 *GAME_INIT
 5400 PX=38*8*2:PY=64*8*2:PZ=2
 5410 DIR     = 0           :' ¼®·¼¾ÝÎ³º³
 5420 SPEED   = .075
 5430 PVY     = 0           :' ÌßÚ²Ô¼®·X¿¸ÄÞ
 5440 PVX     = 0           :' ÌßÚ²Ô¼®·Y¿¸ÄÞ
 5450 PVA     = .005        :' ÌßÚ²Ô¶¿¸ÄÞÊß×Ò°À
 5460 DIR_PRM = .0012      :' ÌßÚ²ÔÀ°ÝÊß×Ò°À
 5470 GRV     = -.0016      :' ¼Þ­³Ø®¸Êß×Ò°À
 5480 JUMP    = .0025       :
 5490 JUMP_H  = .006        :
 5500 JSP     = 0           :' ¼Þ®³¼®³¿¸ÄÞ
 5510 DR      = 30*30
 5520 TIME    = 0
 5530 TIME_S  = 0           :' Clock Stop flag
 5540 BANK    = -.25
 5550 EYE     = 0
 5560 '
 5570 GOSUB *INIT_TGT
 5580 RETURN
 5590 '----------------------------------
 5600 *INIT_TGT
 5610 FOR TGT =0 TO 7
 5620 OBJ(TGT+1,@ATR)  = 4,4
 5630 OBJ(TGT+1,@TYPE) = 4
 5640 OBJ(TGT+1,@XRV)  = ,.01,0
 5650 OBJ(TGT+1,@XR)   = 0,0,0
 5660 FOR LP = 0 TO 7
 5670 OBJ(TGT*8+9+LP,@TYPE) = 0
 5680 NEXT
 5690 NEXT
 5700 RETURN
 5710 '----------------------------------
 5720 *OPEN_TGT
 5730 OBJ(TERGET+1,@TYPE) = 6
 5740 OBJ(TERGET+1,@XRV)  = ,0,.01
 5750 OBJ(TERGET+1,@XR)   = 0,0,0
 5760 FOR LP = 0 TO 7
 5770 OBJ(TERGET*8+9+LP,@TYPE) = 4
 5780 NEXT
 5790 RETURN
 5800 '----------------------------------
 5810 *CLOSE_TGT
 5820 OBJ(TERGET+1,@ATR)  = 5,5
 5830 OBJ(TERGET+1,@TYPE) = 4
 5840 OBJ(TERGET+1,@XRV)  = ,.01,0
 5850 OBJ(TERGET+1,@XR)   = 0,0,0
 5860 FOR LP = 0 TO 7
 5870 OBJ(TERGET*8+9+LP,@TYPE) = 0
 5880 NEXT
 5890 RETURN
 5900 '----------------------------------
 5910 '
 5920 *MSG_CLEAR
 5930 MSG_T = 0
 5940 LOCATE 20-LEN(MSG$)/2,7
 5950 PRINT LEFT$(SP$,LEN(MSG$))
 5960 RETURN
 5970 '----------------------------------
 5980 'input msg$,msg_t
 5990 *MSG 
 6000 MSG_TM = MSG_TM +1
 6010 MSG_TM = MSG_TM AND &HFF
 6020 IF MSG_TM AND &HF THEN RETURN
 6030 IF MSG_T = 0 THEN RETURN
 6040 MSG_T = MSG_T - 1
 6050 MSGG$=LEFT$(SP$,LEN(MSG$))
 6060 IF MSG_T AND 1 THEN MSGG$=MSG$
 6070 LOCATE 20-LEN(MSG$)/2,7
 6080 PRINT MSGG$
 6090 RETURN
 6100 '----------------------------------
 6110 *H_GAGE
 6120 HG = PZ-2
 6130 H  = HG
 6140 FOR G = 0 TO 4
 6150 HC = H MOD 9
 6160 IF H < 0 THEN HC = 0
 6170 IF H > 8 THEN HC = 8
 6180 HC = HC + 1
 6190 H = H - 8
 6200 IF HG > 40 THEN HC = 0
 6210 LOCATE 35,9-G:PRINT CHR$(GAGE(HC));CHR$(GAGE(HC)+10)
 6220 NEXT
 6230 LOCATE 30,11
 6240 IF HG > 9999 THEN PRINT "      " ELSE PRINT USING "####.#";HG
 6250 RETURN
 6260 '----------------------------------
 6270 *CLOCK
 6280 IF TIME_S = 0 THEN RETURN
 6290 TIME = TIME + .05
 6300 RETURN
