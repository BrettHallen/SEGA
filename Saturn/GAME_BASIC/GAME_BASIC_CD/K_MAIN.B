23460 '---------------------------------------
23480 *SYS_DEVICECHECK
23490 PRINT "Æ­³Ø®¸ ¿³Á ¹Ý¼­Â":PRINT
23500 FOR SYS_I=28 TO 0 STEP -1
23510   SYS_J=PAD(SYS_I,0)
23520   IF (SYS_J>=&H0) AND (SYS_J<=&HF) AND SPADMODE<>2 THEN SPADNO=SYS_I:SPADMODE=1:PRINT "#";SYS_I;" ºÝÄÛ°ÙÊß¯ÄÞ ¦ ÆÝ¼·¼Ï¼À¡"
23530   IF (SYS_J>=&HE0) AND SYS_J<=&HFE THEN SPADNO=SYS_I:SPADMODE=2:PRINT "#";SYS_I;" ¼¬ÄÙÏ³½ ¦ ÆÝ¼·¼Ï¼À¡"
23540   IF (SYS_J>=&H30) AND SYS_J<=&HDF THEN SKEYNO=SYS_I:SKEYMODE=1:PRINT "#";SYS_I;" ¾¶Þ»À°Ý·°ÎÞ°ÄÞ ¦ ÆÝ¼·¼Ï¼À¡"
23550 NEXT
23560 IF SPADMODE<>0 THEN
23570   OBJ(1,16)=0,0:OBJ(1,20)=0:OBJ(1,0)=7
23580   ON INTERVAL (1) GOSUB *SYS_ANIME
23590   IF SPADMODE=1 THEN ON INTERVAL (0) GOSUB *SYS_PAD
23600   IF SPADMODE=2 THEN ON INTERVAL (0) GOSUB *SYS_MOUSE
23610 ENDIF
23620 VSYNC 30:RETURN
