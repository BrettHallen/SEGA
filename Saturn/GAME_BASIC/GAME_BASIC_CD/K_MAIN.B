26730 *SYS_FLS_FILEDRAW
26740 SYS_X=2:SYS_Y=18:SYS_SX=176:SYS_SY=58:SYS_B=1:SYS_MES$="":GOSUB *SYS_DRAW_BUTTON
26750 ON ERROR GOTO *SYS_FLS_ERR1:SYS_DEV$=SYS_DEV$(SYS_TEMP)+":":SYS_A$=FILES$(SYS_DEV$+"*.0")
26760 IF SYS_SAVEFLAG=0 THEN SYS_A$=SYS_A$+FILES$(SYS_DEV$+"*.1")
26770 IF (SYS_TEMP=4) AND SYS_SAVEFLAG=0 THEN SYS_A$=SYS_A$+FILES$(SYS_DEV$+"*.D")
26780 IF (SYS_TEMP<>5) AND SYS_SAVEFLAG=1 THEN SYS_A$=SYS_A$+"*¼Ý· »¸¾²*       "
26800 *SYS_FLS_EXIT1:ON ERROR GOTO 0
26820 *SYS_FLS_FILEDRAW1
26830 IF LEN(SYS_A$)>17*14+1 THEN
26840   SYS_X=181:SYS_Y=18:SYS_SX=12:SYS_SY=12:SYS_B=0:SYS_MES$=CHR$(250):GOSUB *SYS_DRAW_BUTTON
26850   SYS_Y=32:SYS_MES$=CHR$(251):GOSUB *SYS_DRAW_BUTTON
26860 ELSE
26870   LINE (181,18)-(193,44),8,BF
26880 ENDIF
26890 COLOR,1
26900 FOR SYS_I=0 TO 13
26910   COLOR,,14+(SYS_I<>SYS_FLS_SEL-SYS_BASE)*6
26920   IF MID$(SYS_A$,(SYS_I+SYS_BASE)*17+1,10)="*¼Ý· »¸¾²*" THEN COLOR,4 ELSE COLOR,1
26930   KPRINT (7+(SYS_I AND 1)*88,20+INT(SYS_I/2)*8,0,-8,-8),FIX RIGHT$("          "+MID$(SYS_A$,(SYS_I+SYS_BASE)*17+1,10),10)
26940 NEXT
26950 RETURN
26970 *SYS_FLS_UP
26980 SYS_I=0
26990 SYS_X=181:SYS_Y=18:SYS_SX=12:SYS_SY=12:SYS_MES$=CHR$(250):GOSUB *DEF_BTN_FLS
27000 IF FLAG_CLICK=1 THEN
27010   SYS_BASE=SYS_BASE+(SYS_BASE>1)*2
27020   IF SYS_FLS_SEL>(SYS_BASE+13) THEN SYS_FLS_SEL=SYS_BASE+12+(SYS_FLS_SEL AND 1)
27030   GOSUB *SYS_FLS_FILEDRAW1
27040 ENDIF
27050 RETURN
27070 *SYS_FLS_DOWN
27080 SYS_I=1
27090 SYS_X=181:SYS_Y=32:SYS_SX=12:SYS_SY=12:SYS_MES$=CHR$(251):GOSUB *DEF_BTN_FLS
27100 IF (FLAG_CLICK=1) AND (LEN(SYS_A$)/17-14)>SYS_BASE THEN
27110   SYS_BASE=SYS_BASE+2:IF SYS_FLS_SEL<SYS_BASE THEN SYS_FLS_SEL=SYS_BASE+(SYS_FLS_SEL AND 1)
27120   GOSUB *SYS_FLS_FILEDRAW1
27130 ENDIF
27140 RETURN
27160 *SYS_FLS_OK
27170 SYS_I=2
27180 SYS_X=184:SYS_Y=50:SYS_SX=52:SYS_SY=10:SYS_MES$="Ok":GOSUB *DEF_BTN_FLS
27200 *SYS_FLS_OK1
