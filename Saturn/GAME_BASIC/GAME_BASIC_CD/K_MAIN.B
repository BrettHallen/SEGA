27550 *SYS_DRAW_BUTTON
27560 COLOR,15,8
27570 LINE (SYS_X,SYS_Y)-(SYS_X+SYS_SX,SYS_Y+SYS_SY),7-(SYS_B<>0)*8,B
27580 LINE (SYS_X+1,SYS_Y)-(SYS_X+SYS_SX,SYS_Y+SYS_SY-1),15+(SYS_B<>0)*8,B
27590 LINE (SYS_X+1,SYS_Y+1)-(SYS_X+SYS_SX-1,SYS_Y+SYS_SY-1),8,BF
27600 KPRINT (SYS_X+1-SYS_B+(SYS_SX-LEN(SYS_MES$)*8)/2,SYS_Y+1+SYS_B,0,-8,-8),FIX SYS_MES$
27610 RETURN
27630 *DEF_BTN_FLS
27640 FLAG_CLICK=0
27650 IF SYS_CAPTURE=SYS_I AND SYS_X<=(EVENTX-40) AND (SYS_X+SYS_SX)>=(EVENTX-40) AND SYS_Y<=(EVENTY-72) AND (SYS_Y+SYS_SY)>=(EVENTY-72) AND EVENT=1 THEN
27660   SYS_CAPTURE=-1
27670   SYS_B=0
27680   GOSUB *SYS_DRAW_BUTTON
27690   FLAG_CLICK=1
27700   RETURN
27710 ENDIF
27720 IF EVENT=1 THEN SYS_CAPTURE=-1:SYS_B=0:GOSUB *SYS_DRAW_BUTTON:RETURN
27730 IF (EVENT=0) AND SYS_CAPTURE=-1 THEN SYS_CAPTURE=SYS_I:SYS_B=1:GOSUB *SYS_DRAW_BUTTON:RETURN
27740 RETURN
27750 '
27770 *SYS_FILENAMEINPUT
27780 SYS_CU=1:SYS_C=1:SYS_C$="_0123456789ABCDEFGHIJLKMNOPQRSTUVWXYZ"
27790 FILENAME$="_       .0"
27810 *SYS_KEYCLEAR:IF INKEY$<>"" GOTO *SYS_KEYCLEAR
27820 GOSUB *QCLEAR
27830 SYS_X1=SYS_X:SYS_Y1=SYS_Y
27850 *FILESELECTLOP
27860 COLOR,1,14
27870 KPRINT (SYS_X1,SYS_Y1,0,-8,-8),FIX FILENAME$
27880 IF SKEYMODE=0 THEN
27890   COLOR,4
27900   KPRINT (SYS_X1+(SYS_CU-1)*8,SYS_Y1,0,-8,-8),FIX MID$(FILENAME$,SYS_CU,1)
27910   COLOR,1
27920   GOSUB *QOUT
27930   IF EVENT=6 THEN
27940     SYS_C=SYS_C+1:IF SYS_C>LEN(SYS_C$) THEN SYS_C=1
27950     MID$(FILENAME$,SYS_CU,1)=MID$(SYS_C$,SYS_C,1)
27960   ENDIF
27970   IF EVENT=10 THEN
27980     IF SYS_CU=1 THEN RETURN
27990     IF SYS_CU>1 THEN MID$(FILENAME$,SYS_CU,1)=" ":SYS_CU=SYS_CU-1:SYS_C=INSTR(SYS_C$,MID$(FILENAME$,SYS_CU,1))
28000   ENDIF
28010   IF (EVENT=0) AND SYS_CU<8 THEN SYS_CU=SYS_CU+1:MID$(FILENAME$,SYS_CU,1)=MID$(SYS_C$,SYS_C,1)
28020   IF EVENT=12 THEN SYS_CU=0:RETURN :' OK
28030 ELSE
28040   GOSUB *QOUT1
28050   SYS_K$=INKEY$
28060    '¶°¿Ù É ¼®Ø
28070   IF SYS_CAPTURE=2 THEN GOSUB *SYS_FLS_OK_ENT    :IF FLAG_CLICK=1 THEN SYS_K$=CHR$(13)
28080   IF SYS_CAPTURE=3 THEN GOSUB *SYS_FLS_CANCEL_ENT:IF FLAG_CLICK=1 THEN SYS_K$=CHR$(27)
28090   'HIT CHECK
28100   IF (EVENTX>226) AND (EVENTX<278) AND SYS_CAPTURE=-1 THEN
28110     FLAG_CLICK=0
28120     IF (EVENTY>=123) AND EVENTY<=133 THEN GOSUB *SYS_FLS_OK_ENT    :IF FLAG_CLICK=1 THEN SYS_K$=CHR$(13)
28130     IF (EVENTY>=137) AND EVENTY<=147 THEN GOSUB *SYS_FLS_CANCEL_ENT:IF FLAG_CLICK=1 THEN SYS_K$=CHR$(27)
28140   ENDIF
28150   '·°ÎÞ°ÄÞ É ¼®Ø
28160   IF SYS_K$="" GOTO *FILESELECTLOP
28165   IF SYS_K$>="a" AND SYS_K$<="z" THEN SYS_K$=CHR$(ASC(SYS_K$)-ASC("a")+ASC("A"))
28170   IF INSTR(SYS_C$,SYS_K$)<>0 THEN
28180     IF SYS_CU<=8 THEN MID$(FILENAME$,SYS_CU,1)=SYS_K$
28190     SYS_CU=SYS_CU-(SYS_CU<9)
28200   ENDIF
28210   IF SYS_K$=CHR$(8) OR SYS_K$=CHR$(29) THEN
28220     IF SYS_CU>1 THEN SYS_CU=SYS_CU-1:MID$(FILENAME$,SYS_CU,1)=" "
28230   ENDIF
28240   IF SYS_K$=CHR$(13) THEN SYS_CU=0:RETURN :' OK
28250   IF SYS_K$=CHR$(27) THEN SYS_CU=1:RETURN :' CANCEL
28260 ENDIF
28270 GOTO *FILESELECTLOP
28290 *SYS_FLS_OK_ENT    :SYS_I=2:SYS_X=184:SYS_Y=50:SYS_SX=52:SYS_SY=10:SYS_MES$="Ok"    :GOTO *DEF_BTN_FLS
28310 *SYS_FLS_CANCEL_ENT:SYS_I=3:SYS_X=184:SYS_Y=64:SYS_SX=52:SYS_SY=10:SYS_MES$="Cancel":GOTO *DEF_BTN_FLS
