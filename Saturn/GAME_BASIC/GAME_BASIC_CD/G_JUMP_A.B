 5560 *GAME_INIT
 5570 PX=38*8*2:PY=64*8*2:PZ=2
 5580 DIR     = 0           :' ¼®·¼¾ÝÎ³º³
 5590 PVY     = 0           :' ÌßÚ²Ô¼®·X¿¸ÄÞ
 5600 PVX     = 0           :' ÌßÚ²Ô¼®·Y¿¸ÄÞ
 5610 PVA     = 0           :' ÌßÚ²Ô¶¿¸ÄÞÊß×Ò°À
 5620 DIR_PRM = .0012      :' ÌßÚ²ÔÀ°ÝÊß×Ò°À
 5630 GRV     = -.0016      :' ¼Þ­³Ø®¸Êß×Ò°À
 5640 JUMP    = 0           :
 5650 JSP     = 0           :' ¼Þ®³¼®³¿¸ÄÞ
 5660 DR      = 30*30
