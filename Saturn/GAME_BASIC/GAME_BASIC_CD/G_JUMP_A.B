 5380 *GAME_END
 5390 INTERVAL (0) OFF
 5400 PLAYSTOP 0
 5410 MIN = INT(TIME/60)
 5420 SEC = TIME-INT(TIME/60)*60
 5430 CLS
 5440 MSG$ = "LANDING !!"
 5450 MSG_T = 30
 5460 *END_DEMO
 5470 PDL = PAD(0,1)
 5480 IF PDL AND @PAD_START THEN *MAIN_PLAY
 5490 LOCATE 9,9:PRINT USING "CLEAR TIME: ##:##.##";MIN,SEC
 5500 GOSUB *MSG
 5510 IF MSG_T = 0 THEN *DEMO_PLAY
 5520 VSYNC
 5530 GOTO *END_DEMO
 5540 END
