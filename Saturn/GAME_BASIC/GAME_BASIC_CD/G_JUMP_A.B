 3040 POAL(0)=-104
 3050 POAL(1)=-168
 3060 POAL(2)=-56
 3070 '
 3080 OBJ(0,@XP) = 0,0,10
 3090 OBJ(0,@ORDER) = 7
 3100 '
 3110 FOR MAPY=0 TO 127
 3120 FOR MAPX=0 TO 127
 3130 MAP(MAPX,MAPY) = 0
 3140 NEXT
 3150 NEXT
 3160 '
 3170 'Gen pole and terget
 3180 FOR P = 0 TO 7
 3190 *GEN_POLE
 3200 *RND_LPX
 3210 X = RND(96)+16
 3220 IF X >= 48 AND X < 80 THEN *RND_LPX
 3230 *RND_LPY
 3240 Y = RND(96)+16
 3250 IF Y >= 48 AND Y < 80 THEN *RND_LPY
 3260 IF MAP(X,Y)<>0 THEN *GEN_POLE
 3270 MAP(X,Y) = 1
 3280 X = X * 16
 3290 Y = Y * 16
 3300 POAL = RND(3)
 3310 '
 3320 OBJ(P+1,@ATR) = 4,4
 3330 OBJ(P+1,@TYPE) = 4
 3340 OBJ(P+1,@XP) = X,POAL(POAL),-Y
 3350 OBJ(P+1,@ORDER) = 0
 3360 OBJ(P+1,@XRV) = ,.01
 3370 POALX(P) = X
 3380 POALY(P) = Y
 3390 POALH(P) = POAL(POAL)
 3400 '
 3410 FOR LP = 0 TO 7
 3420 OBJ(P*8+9+LP,@ATR) = 6,6
 3430 OBJ(P*8+9+LP,@TYPE) = 0
 3440 OBJ(P*8+9+LP,@XP) = 30*XCOS(LP*.125),30*XSIN(LP*.125)
 3450 OBJ(P*8+9+LP,@ZR) = (LP*.125)+.25
 3460 OBJ(P*8+9+LP,@ORDER) = 0
 3470 OBJ(P*8+9+LP,@PARENT) = P+1
 3480 NEXT
 3490 NEXT
 3500 '
