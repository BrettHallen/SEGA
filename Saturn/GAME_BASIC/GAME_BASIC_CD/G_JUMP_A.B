 5740 '----------------------------------
 5750 *INIT_TGT
 5760 FOR TGT =0 TO 7
 5770 OBJ(TGT+1,@ATR)  = 4,4
 5780 OBJ(TGT+1,@TYPE) = 4
 5790 OBJ(TGT+1,@XRV)  = ,.01,0
 5800 OBJ(TGT+1,@XR)   = 0,0,0
 5810 FOR LP = 0 TO 7
 5820 OBJ(TGT*8+9+LP,@TYPE) = 0
 5830 NEXT
 5840 NEXT
 5850 RETURN
 5860 '----------------------------------
 5870 *OPEN_TGT
 5880 OBJ(TERGET+1,@TYPE) = 6
 5890 OBJ(TERGET+1,@XRV)  = ,0,.01
 5900 OBJ(TERGET+1,@XR)   = 0,0,0
 5910 FOR LP = 0 TO 7
 5920 OBJ(TERGET*8+9+LP,@TYPE) = 4
 5930 NEXT
 5940 RETURN
 5950 '----------------------------------
 5960 *CLOSE_TGT
 5970 OBJ(TERGET+1,@ATR)  = 5,5
 5980 OBJ(TERGET+1,@TYPE) = 4
 5990 OBJ(TERGET+1,@XRV)  = ,.01,0
 6000 OBJ(TERGET+1,@XR)   = 0,0,0
 6010 FOR LP = 0 TO 7
 6020 OBJ(TERGET*8+9+LP,@TYPE) = 0
 6030 NEXT
 6040 RETURN
 6050 '----------------------------------
 6060 '
 6070 *MSG_CLEAR
 6080 MSG_T = 0
 6090 LOCATE 20-LEN(MSG$)/2,7
 6100 PRINT LEFT$(SP$,LEN(MSG$))
 6110 RETURN
 6120 '----------------------------------
 6130 'input msg$,msg_t
 6140 *MSG 
 6150 MSG_TM = MSG_TM +1
 6160 MSG_TM = MSG_TM AND &HFF
 6170 IF MSG_TM AND &HF THEN RETURN
 6180 IF MSG_T = 0 THEN RETURN
 6190 MSG_T = MSG_T - 1
 6200 MSGG$=LEFT$(SP$,LEN(MSG$))
 6210 IF MSG_T AND 1 THEN MSGG$=MSG$
 6220 LOCATE 20-LEN(MSG$)/2,7
 6230 PRINT MSGG$
 6240 RETURN
 6250 '----------------------------------
 6260 *H_GAGE
 6270 HG = PZ-2
 6280 H  = HG
 6290 FOR G = 0 TO 4
 6300 HC = H MOD 9
 6310 IF H < 0 THEN HC = 0
 6320 IF H > 8 THEN HC = 8
 6330 HC = HC + 1
 6340 H = H - 8
 6350 IF HG > 40 THEN HC = 0
 6360 LOCATE 35,9-G:PRINT CHR$(GAGE(HC));CHR$(GAGE(HC)+10)
 6370 NEXT
 6380 LOCATE 30,11
 6390 IF HG > 9999 THEN PRINT "      " ELSE PRINT USING "####.#";HG
 6400 RETURN
