 4040 MSG$ = "PRESS START !"
 4050 MSG_T = 30
 4060 *DEMO_MSG
 4070 '
 4080 PDL = PAD(0,1)
 4090 IF PDL AND @PAD_START THEN *MAIN_PLAY
 4100 '
 4110 DIR = DIR - DIR_PRM
 4120 IF DIR < 0 THEN DIR = DIR + 1
 4130 '
 4140 PVX= PV*XCOS(DIR)
 4150 PVY=-PV*XSIN(DIR)
 4160 PX=PX+PVX:PY=PY-PVY
 4170 '
 4180 OBJ(0,@XR) = EYE,-DIR
 4190 OBJ(0,@XP) = -PX,PZ,PY
 4200 '
 4210 ACTIVE 8
