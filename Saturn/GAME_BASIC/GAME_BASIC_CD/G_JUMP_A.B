 4290 GOTO *DEMO_LOOP
 4300 '
 4310 '----------------------------------
 4320 *MAIN_PLAY
 4330 BGM 2
 4340 GOSUB *MSG_CLEAR
 4350 CLS
 4360 GOSUB *GAME_INIT
 4370 TERGET  = 0
 4380 GOSUB *OPEN_TGT
 4390 '
 4400 INTERVAL (0) ON,3
 4410 MSG$ = "START !!"
 4420 MSG_T = 15
 4430 *LOOP
 4440 '
 4450 MIN = INT(TIME/60)
 4460 SEC = TIME-INT(TIME/60)*60
 4470 LOCATE 1,11:PRINT USING "##:##.##";MIN,SEC
 4480 '
 4490 GOSUB *H_GAGE
 4500 GOSUB *MSG
 4510 '
 4520 DY = ABS(POALY(TERGET)-PY)
 4530 IF DY > 4 THEN *NO_TOUCH
 4540 '
 4550 DX = ABS(POALX(TERGET)-PX)
 4560 IF DX > 30 THEN *NO_TOUCH
 4570 DY = ABS(-POALH(TERGET)-PZ)
 4580 IF DY > 30 THEN *NO_TOUCH
 4590 DL = DX*DX + DY*DY
 4600 IF DL > DR THEN *NO_TOUCH
 4610 GOSUB *CLOSE_TGT
 4620 EFFECT -1
 4630 MSG$ = "NEXT RING !"
 4640 MSG_T = 10
 4650 TERGET = TERGET + 1
 4660 IF TERGET = 8 THEN *ALL_CLR
 4670 GOSUB *OPEN_TGT
 4680 GOTO *NXT_R
 4690 *ALL_CLR
 4700 MSG$ = "ALL RING CLEAR !"
 4710 MSG_T = 10
 4720 '
 4730 *NXT_R
 4740 *NO_TOUCH
 4750 '
 4760 PDL = (PAD(0,3) -128) /30000
 4770 DIR = DIR + PDL
 4780 IF DIR > 1 THEN DIR = DIR - 1
 4790 IF DIR < 0 THEN DIR = DIR + 1
 4800 '
 4810 SIND = XSIN(DIR)
 4820 COSD = XCOS(DIR)
 4830 '
 4840 JUMP = PAD(0,5) /30000
 4850 '
 4860 JSP = JSP +JUMP
 4870 IF JSP > 1 THEN JSP = 1
 4880 JSP = JSP + GRV
 4890 PZ = PZ + JSP
 4900 IF PZ >10002+JSP THEN PZ = 10002
 4910 IF PZ < 2 THEN PZ = 2 : JSP = -(.2*JSP)
 4920 IF TIME_S = 0 THEN *RAND_CHECK
 4930 IF TERGET <> 8 THEN *RAND_CHECK
 4940 IF PZ > 2 THEN *RAND_CHECK
 4950 IF ABS(PX-38*8*2) > 32 THEN *RAND_CHECK
 4960 IF ABS(PY-64*8*2) > 32 THEN *RAND_CHECK
 4970 GOTO *GAME_END
 4980 *RAND_CHECK
 4990 IF PZ = 2 THEN *WALK
 5000 *FLY
 5010 TIME_S = 1            :' Clock start
 5020 '
 5030 PVA = (PAD(0,4) -128) /10000
 5040 AX=PVA*SIND
 5050 AY=PVA*COSD
 5060 PVX=PVX-AX: PVY=PVY-AY
 5070 GOTO *MOVE
 5080 '
 5090 *WALK
 5100 PVX=0:PVY=0
 5110 SPEED = (PAD(0,4) -128) /1500
 5120 PVX = -SPEED*SIND: PVY= -SPEED*COSD
 5130 '
 5140 *MOVE
 5150 PX=PX+PVX:PY=PY-PVY
 5160 PVX=PVX-PVX*.001
 5170 PVY=PVY-PVY*.001
 5180 '
 5190 'AGL = PAD(0,6)
 5200 'BANK =-.25*(255-agl)/255:EYE = .25*agl/255
 5210 PDL = PAD(0,1)
 5220 IF PDL AND @PAD_X THEN BANK =  -.25:EYE =    0
 5230 IF PDL AND @PAD_Y THEN BANK = -.175:EYE = .075
 5240 IF PDL AND @PAD_Z THEN BANK =     0:EYE =  .25
 5250 '
 5260 OBJ(0,@XR) = EYE,-DIR
 5270 OBJ(0,@XP) = -PX,PZ,PY
 5280 '
 5290 ACTIVE 8
 5300 ROTPOS PX/2,PY/2,PZ
 5310 ROTATE BANK,,DIR
 5320 '
 5330 ACTIVE 9
 5340 ROTPOS DIR*128*8
 5350 VSYNC
 5360 GOTO *LOOP
