LOAD"COM:DUMMY"
 1000 ' GAME BASIC for SEGASATURN Sound Sample Program Ver 1.1
 1001 ' [ S_LUNARB.B ]
 1002 ' Programmed by Naozumi Honma (nao)
 1003 '               Kanayama Motoyuki (motos)
 1004 '               Yukihiro Ninagawa
 1005 '
 1006   SCREEN 0: SKCLOSE         :'Initialize screen, Close software keyboard
 1007   CLEAR 10,1360:IF PEEK(0,3)<>78 THEN KLOAD ON:CLEAR 10,1360:POKE 0,0,56:POKE 0,1,1:POKE 0,2,16:POKE 0,3,78:POKE 0,4,11:POKE 0,5,1
 1008   WIDTH 1,1,38,26:PLAYINIT:COLOR ,RGB(31,31,31):COLOROFS ON,0:COLOROFS(-255,-255,-255):VSYNC:OFS=255
 1009 '
 1010   TITLE$="LUNAR B"    :'<<< Polygon Title   >>>
 1011   NUM_OF_MSTR=15      :'<<< MENU ｺｳﾓｸ ﾉ ｶｽﾞ >>>
 1012   PROG$="***** MUSIC COMPOSER : TWO FIVE / Noriyuki Iwadare ***** MML Programed by Yukihiro Ninagawa ***** Sound System Programed by Naozumi Honma (nao) / Bits Laboratory ***** BASIC Main System Programed by Motoyuki Kanayama (motos)"
 1013   PROG$=PROG$+" / Bits Laboratory ***** Special Thanks - Kenichi Kunishima, Masakuni Mitsuhashi, Tomoyuki Shimada, Yukihiro Yoshida *****"
 1014   Q$=SPACE$(40)+PROG$+SPACE$(300):QCUT=1
 1015   GOTO *START_THIS_PROGRAM
 1016 '
 1017 '---------------- MENU DATA
 1018 *MENU_STR
 1019   DATA " LUNAR-SS Version B     (C)GAME ARTS "
 1020   DATA " 1: M01 雑魚戦闘１                   "
 1021   DATA " 2: M02 酒場                         "
 1022   DATA " 3: M06 フィールドＡ                 "
 1023   DATA " 4: M08 村Ａ（ホンメル島の村）       "
 1024   DATA " 5: M12 街Ａ（活気ある街）           "
 1025   DATA " 6: M15 ダンジョンＡ（緊張感）       "
 1026   DATA " 7: M21 神殿                         "
 1027   DATA " 8: M40 悲しみ                       "
 1028   DATA " 9: M43 コミカルな曲                 "
 1029   DATA "10: M54 勇気･そして突撃              "
 1030   DATA "11: M55 敗北                         "
 1031   DATA "12: M59 機械城                       "
 1032   DATA "13: M62 戦闘勝利２                   "
 1033   DATA "14: M27 出会いのテーマ               "
 1034   DATA "15: M46 戦いへの決意                 "
 1035 '
 1036 '---------------- Exit Program
 1037 *EXIT_THIS_PROGRAM
 1038   GOSUB *MUSIC_FADE_OUT:OBJ CLEAR:GOSUB *FADEOUT:INTERVAL (0) OFF:INTERVAL (1) OFF:SCREEN 0:LOCATE 5,0:COLOR 7:PRINT "Loading S_G_ARTS.B":LOAD"CD:S_G_ARTS",R
 1039   END
 1040 '
 1041 '---------------- Start Program
 1042 *START_THIS_PROGRAM
 1043   GOSUB *INIT_SYS
 1044   GOSUB *SET_OBJECTS
 1045 '
 1046 '================ Main Loop
 1047 *PAD_WATCH
 1048   TRIGGA=0
 1049   *PAD_W2:IF TRIGGA THEN KEY$="":KEY=0:GOTO *PAD_TRIGGA
 1050     IF PLAYSTAT(0)=0 THEN EMNUM=-1:GOSUB *DISPLAY_MENU
 1051     KEY$=INKEY$:IF KEY$="" THEN *PAD_W2 ELSE KEY=ASC(KEY$)
 1052   *PAD_TRIGGA
 1053     WTIME=0
 1054     IF KEY=KEY_DOWN  OR KEY=KEY_D2 OR (TRIGGA AND @PAD_DOWN) THEN GOSUB *MOVE_DOWN:GOTO *PAD_WATCH
 1055     IF KEY=KEY_UP    OR KEY=KEY_U2 OR (TRIGGA AND @PAD_UP)   THEN GOSUB *MOVE_UP:  GOTO *PAD_WATCH
 1056     IF KEY=KEY_ENTER OR (TRIGGA AND (@PAD_START OR @PAD_C))  THEN IF EMNUM=CNUM THEN BGM:GOTO *PAD_WATCH ELSE EMNUM=CNUM:GOSUB *MUSIC_FADE_OUT:GOTO *PLAY_GO
 1057     IF KEY=KEY_ESC   OR (TRIGGA AND (@PAD_Y     OR @PAD_B))  THEN *EXIT_THIS_PROGRAM
 1058     GOTO *PAD_WATCH
 1059 '
 1060 '================
 1061 *MOVE_DOWN
 1062   IF CNUM < NUM_OF_MSTR THEN CNUM=CNUM+1
 1063   IF (CNUM > 4) AND (CNUM <= (NUM_OF_MSTR - 3)) THEN MTOP=MTOP+1
 1064   GOSUB *DISPLAY_MENU
 1065   RETURN
 1066 '
 1067 '----------------
 1068 *MOVE_UP
 1069   IF CNUM > 1 THEN CNUM=CNUM-1
 1070   IF (CNUM > 3) AND (CNUM < (NUM_OF_MSTR - 3)) THEN MTOP=MTOP-1
 1071   GOSUB *DISPLAY_MENU
 1072   RETURN
 1073 '
 1074 '----------------
 1075 *DISPLAY_MENU
 1076   MDY=38
 1077   FOR I=MTOP TO MTOP+6
 1078     IF I=CNUM THEN
 1079       IF I=EMNUM THEN
 1080         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31),,RGB(20,20,0)
 1081       ELSE
 1082         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31),,RGB(0,20,20)
 1083       ENDIF
 1084     ELSE
 1085       IF I=EMNUM THEN
 1086         KPRINT (10,MDY),MSTR$(I),RGB(31,31,0),,RGB(16,16,16)
 1087       ELSE
 1088         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31)
 1089       ENDIF
 1090     ENDIF
 1091     MDY=MDY+18
 1092   NEXT
 1093   RETURN
 1094 '
 1095 '================ Subroutines
 1096 *INIT_SYS
 1097   MTOP=1:EMNUM=-1
 1098   DIM MSTR$(NUM_OF_MSTR)
 1099   RESTORE *MENU_STR:FOR I=0 TO NUM_OF_MSTR:READ MSTR$(I):NEXT
 1100 '
 1101   PAD_ABCXYZSTART = @PAD_A+@PAD_B+@PAD_C+@PAD_START+@PAD_X+@PAD_Y+@PAD_Z
 1102   PAD_UDLR  = @PAD_RIGHT+@PAD_LEFT+@PAD_DOWN+@PAD_UP+@PAD_L+@PAD_R
 1103   KEY_DOWN  = 31:  KEY_D2=ASC("X")-64
 1104   KEY_UP    = 30:  KEY_U2=ASC("E")-64
 1105   KEY_ENTER = 13: KEY_ESC = 27
 1106 '
 1107   SCREEN 0:WIDTH 1,1,38,26
 1108   INITIAL_TOUCH=20:AFTER_TOUCH=3
 1109   ON INTERVAL (0) GOSUB *INT_COUNT: INTERVAL (0) ON,1
 1110   ON INTERVAL (1) GOSUB *DISPLAY_PFONT: INTERVAL (1) ON,1
 1111 *CLEAR_INKEY: IF INKEY$<>"" THEN *CLEAR_INKEY
 1112   TRIGGA=PAD(0,2) :' Clear trigga
 1113   KPRINT (10,20),MSTR$(0),,,RGB(20,0,20)    :'ﾀｲﾄﾙﾋｮｳｼﾞ
 1114   LINE(10,164)-(307,164),RGB(31,31,0)
 1115   KPRINT (10,166),"↑↓";,RGB(31,22,22):KPRINT FIX "(ﾎｳｺｳ ﾎﾞﾀﾝ )--- ";,RGB(21,21,10):KPRINT FIX "Move Cursor",RGB(0,31,20)
 1116   KPRINT (10,182-8),FIX "  START / Cﾎﾞﾀﾝ";,RGB(31,22,22):KPRINT FIX " --- ";,RGB(21,21,10):KPRINT FIX "Start BGM  ",RGB(0,31,20)
 1117   KPRINT (10,198-16),FIX "          Bﾎﾞﾀﾝ";,RGB(31,22,22):KPRINT FIX " --- ";,RGB(21,21,10):KPRINT FIX "RETURN Main Menu",RGB(0,31,20)
 1118   CNUM=-1:GOSUB *DISPLAY_MENU:CNUM=1
 1119   GOSUB *SOUND_INIT:GOSUB *DISPLAY_MENU    :'Sound Sample ｺﾕｳﾉ ｼｮｷｶ ﾙｰﾁﾝ
 1120   RETURN
 1121 '
 1122 '----------------
 1123 *INT_COUNT:' Make repeat trigga of PAD ULDR
 1124   IF PAD(0)=52 THEN *INT_COUNT_RET: 'Ignore keyboard pad
 1125   TRIGGA=TRIGGA OR (PAD(0,2) AND PAD_ABCXYZSTART): 'Update A,B,C,START buttons
 1126   TESTBTN=PAD(0,1):IF (TESTBTN AND PAD_UDLR) = 0 THEN REPEAT_COUNT=0: GOTO *INT_COUNT_RET
 1127   IF TESTBTNL<>TESTBTN THEN TESTBTNL=TESTBTN: REPEAT_COUNT=0
 1128   IF REPEAT_COUNT=0 THEN REPEAT_COUNT=INITIAL_TOUCH: TRIGGA=TESTBTN: GOTO *INT_COUNT_RET
 1129   REPEAT_COUNT=REPEAT_COUNT-1: IF REPEAT_COUNT <= 0 THEN REPEAT_COUNT=AFTER_TOUCH: TRIGGA=TESTBTN
 1130 *INT_COUNT_RET
 1131   SKCLOSE
 1132   RETURN
 1133 '
 1134 '----------------
 1135 *SET_OBJECTS
 1136 'Object Item Number
 1137   TYPE = 0: XP = 4: XR = 8: XS = 12
 1138   PARENT = 20: XRV= 36
 1139 '
 1140   SETDISP 3: SETPERS 105
 1141   SETLIGHT .5,-1,.5:PRIORITY 10,1
 1142   PFONT$=TITLE$:GOSUB *MAKE_PFONT
 1143   WTIME = 0:SOFS=-255: COLOROFS ON,10:COLOROFS (SOFS,SOFS,SOFS)
 1144   OBJ(1,TYPE)=6:OBJ(1,XRV)=&H0.0018,&H0.0024,-&H0.002
 1145   OBJ(0,XP+2)=110
 1146   RETURN
 1147 '
 1148 '----------------
 1149 *MAKE_PFONT
 1150   SLEN=LEN(PFONT$): PT=-SLEN/2*45 : ND=RND(255)/255:OBJ(1,XP+2)=90+SLEN*10
 1151   FOR SP=1 TO SLEN
 1152     CH$=MID$(PFONT$,SP,1): CH2$=MID$(PFONT$,SP+1,1)
 1153     IF CH$=" " THEN
 1154       PT=PT+40
 1155     ELSE
 1156       OBJ(SP+2,XP)=PT,60:OBJ(SP+2,PARENT)=1:OBJ(SP+2,TYPE)=4: OBJ(SP+2,XRV)=&H0.001
 1157       SETPFONT SP+2,ASC(CH$),(1,1.2,3),RGB(30,24,30)
 1158       IF CH$="I" OR CH2$="I" THEN PT=PT+50 ELSE PT=PT+60
 1159     ENDIF
 1160   NEXT SP
 1161   RETURN
 1162 '
 1163 '----------------
 1164 *DISPLAY_PFONT:GOSUB *DISP_COPYRIGHT
 1165   IF WTIME = 0 THEN *DISP_HIDDEN
 1166   IF WTIME > 60*20 THEN *DISP_APEAR
 1167   WTIME = WTIME + 1: RETURN
 1168 *DISP_HIDDEN
 1169   IF SOFS > -330 THEN SOFS = SOFS - 5
 1170   IF SOFS <= -330 THEN SOFS = -330: WTIME = 1
 1171   GOTO *DISP_RET
 1172 *DISP_APEAR
 1173   IF SOFS < -110 THEN SOFS = SOFS + .5
 1174 *DISP_RET
 1175   OX=SOFS+XSIN(ND)*50: IF OX < -255 THEN OX = -255
 1176   OY=SOFS+XSIN(ND+1/3)*50: IF OY < -255 THEN OY = -255
 1177   OZ=SOFS+XSIN(ND+2/3)*50: IF OZ < -255 THEN OZ = -255
 1178   ND=ND+&H0.0004: COLOROFS (OX,OY,OZ)
 1179   RETURN
 1180 '
 1181 '---------------- SCREEN Fade Out
 1182 *FADEOUT
 1183   COLOROFS ON,0:IF OFS=255 THEN RETURN
 1184   FOR OFS=0 TO 255 STEP 32
 1185     COLOROFS(-OFS,-OFS,-OFS)
 1186     VSYNC
 1187   NEXT OFS
 1188   OFS=255
 1189   COLOROFS(-255,-255,-255)
 1190   CLS 0
 1191   VSYNC
 1192   RETURN
 1193 '
 1194 '================ Sound Sample ｺﾕｳﾉ ｼｮｷｶ ﾙｰﾁﾝ
 1195 *SOUND_INIT
 1196   RETURN
 1197 'このプログラムは、一曲ずつアレンジが違うので、その都度初期化する。
 1198 '
 1199 '================ MUSIC FADE OUT
 1200 *MUSIC_FADE_OUT:IF PLAYSTAT(0)=0 THEN RETURN
 1201   TMP_F=CNUM:CNUM=-1:GOSUB *DISPLAY_MENU:LOCATE 5,0:COLOR 7:PRINT " Music Fade Out...":PLAYFADE 0,0,4:VSYNC 2
 1202   *MFO_LOOP
 1203     IF PLAYSTAT(0)=1 THEN *MFO_LOOP
 1204   CNUM=TMP_F:GOSUB *DISPLAY_MENU:LOCATE 5,0:PRINT "                  ":RETURN
 1205 '
 1206 '================ Start Sound Sample Program
 1207 *PLAY_GO
 1208   PLAYSTOP:VSYNC 2
 1209   TMP=CNUM:CNUM=-1:GOSUB *DISPLAY_MENU
 1210   ON TMP GOSUB *SONG1,*SONG2,*SONG3,*SONG4,*SONG5,*SONG6,*SONG7,*SONG8,*SONG9,*SONG10,*SONG11,*SONG12,*SONG13,*SONG14,*SONG15
 1211   LOCATE 5,0:PRINT "                 "
 1212   CNUM=TMP:GOSUB *DISPLAY_MENU
 1213   BGM:VSYNC 2
 1214   GOTO *PAD_WATCH
 1215 '
 1216 '================ SONG SET
 1217 *SONG1:LOCATE 5,0:COLOR 7:PRINT " DSPEXT MODE INIT"
 1218   IF PEEK(0,5)=1 THEN PLAYINIT "DSPEXT","LUNAR_B1",1 ELSE PLAYINIT "DSPEXT",1:LOCATE 5,0:COLOR 7:PRINT " Arrange Tone....":RESTORE *M1_TARG:TARG READ:GOSUB *M1_TPROP
