 1358 DATA "^Mid Tom^ \K=\N45\"
 1359 DATA "^Hi Tom^ \L=\N48\"
 1360 DATA "^Hi-Hat Close^ \M=\N42';82\ \N=\N42';70\ \O=\N42';66\ \P=\N42';60\ \Q=\N42';46\"
 1361 DATA "^Hi-Hat Open^ \R=\N46';70;4/1\ \S=\N46';64;4/1\ \T=\N46'8;58\"
 1362 DATA "^Crash Cymbal1^ \U=\N49';102\ \V=\N49';90\ \W=\N49';67\ \X=\N49';43\ \Y=\N49';20\"
 1363 DATA "^Crash Cymbal2^ \Z=\N52';102\ \a=\N52';79\ \b=\N52';56\ \c=\N52';34\"
 1364 DATA "^Ride Cymbal^ \d=\N51';91\ \e=\N51';78\ \f=\N51';65\"
 1365 '
