 1335 '================ MML Data
 1336 *M1_MML
 1337 '------DATA SET ------
 1338 DATA SONG 1
 1339 DATA #0,"^Drum^T146@10V12L16"
 1340 DATA #1,"^OD.Guitar^S-3@2V9P64O6L8"
 1341 DATA #2,"^OD.Guitar^S-3@2V5P64O5L8"
 1342 DATA #3,"^OD.Guitar^S-3@2V8P64O5L8"
 1343 DATA #4,"^D.Guitar^S-3@9V5P64O3L8el4;2ep4;44"
 1344 DATA #5,"^Brass^S-3@4V10P84O5L8"
 1345 DATA #6,"^Brightness^S-3@5V11P44O6L16"
 1346 DATA #7,"^Muted Guitar^S-3@8V4P44O2L16"
 1347 DATA #8,"^Bass^S-3@1V11P64O2L16"
 1348 DATA #9,"^Drum^@10V12L16"
