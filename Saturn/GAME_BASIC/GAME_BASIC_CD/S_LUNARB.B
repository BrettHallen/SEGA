 1351 DATA #12,"^Strings^S-3@6V11P64O4L8"
 1352 DATA #13,"^Strings^S-3@6V10P127O4L8"
 1353 '
 1354 DATA -=> MACRO SET <=-
 1355 DATA "^Kick^ \A=\N36\ \B=\N36';86\ \C=\N36';77N36';89N36';102N36';114\"
 1356 DATA "^Snare^ \D=\N74';116\ \E=\N74';104\ \F=\N74';68\ \G=\N74';55\"
