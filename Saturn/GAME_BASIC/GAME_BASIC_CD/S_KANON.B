load"com:dummy"
 1000 SCREEN 0: SKCLOSE :'Initialize screen, Close software keyboard
 1002 '
 1003 'Programed by Ninagawa
 1004 CLEAR 10,1360:IF PEEK(0,3)<>78 THEN KLOAD ON:CLEAR 10,1360:POKE 0,0,56:POKE 0,1,2:POKE 0,2,6:POKE 0,3,78:POKE 0,4,1
 1005 CLS
 1006 PRINT "Êß¯ÍÙÍÞÙ É ¶ÉÝ"
 1007 PLAYINIT "DSP","PIANO"
 1008 SETSONG
 1009 FOR I=0 TO TPROP(1,0,@LAYER):TPROP(1,I,@IMIX)=6:NEXT  :'Layer É ¶½ÞÀÞ¹ set
 1010 BGM
 1011 PRINT:PRINT " PRESS ANY KEY -> MAIN MENU"
 1012 *LOOP:IF INKEY$="" AND PAD(0,2)=0 THEN *LOOP ELSE PLAYSTOP 0:CLS:PRINT "Loading S_CLASSI.B":LOAD "CD:S_CLASSI",R
