LOAD"COM:D"
 1000 ' [ S_WAVE.B ]
 1001 CLEAR 200,1360:CLS:PRINT "TARG ...WAVE file"
 1002 PLAYINIT:TARG READ:CLS
 1003 PRINT "BEAT_W.D (Press any key)":A$=INPUT$(1)
 1004 EFFECT "@1 %1 C"
 1005 PRINT "SAMPLE_W.D (Press any key)":A$=INPUT$(1)
 1006 EFFECT "@2 %1 C"
 1007 PRINT "WAVE1_W.D  (Press any key)":A$=INPUT$(1)
 1008 EFFECT "@3 %1 C"
 1009 END
 1010 '
 1011 DATA FILE, "CD:BEAT_W", 0, 0, 0, 127, 78
 1012 DATA FILE, "CD:SAMPLE_W", 0, 0, 0, 127, 78
 1013 DATA FILE, "CD:WAVE1_W", 0, 0, 0, 127, 78
 1014 DATA ENDARRANGE
