LOAD"COM:D"
 1000 ' GAME BASIC for SEGASATURN Sound Sample Program Ver 1.1
 1001 ' [ S_SILPH.B ]
 1002 ' Programmed by Naozumi Honma (nao)
 1003 '               Kanayama Motoyuki (motos)
 1004 '               Yukihiro Ninagawa
 1005 '
 1006   SCREEN 0: SKCLOSE         :'Initialize screen, Close software keyboard
 1007   CLEAR 10,1360:IF PEEK(0,3)<>78 THEN KLOAD ON:CLEAR 10,1360:POKE 0,0,56:POKE 0,1,1:POKE 0,2,10:POKE 0,3,78:POKE 0,4,7:POKE 0,5,1
 1008   WIDTH 1,1,38,26:PLAYINIT:COLOR ,RGB(31,31,31):COLOROFS ON,0:COLOROFS(-255,-255,-255):VSYNC:OFS=255
 1009 '
 1010   TITLE$="SILPHEED"         :'<<< Polygon Title   >>>
 1011   NUM_OF_MSTR=22            :'<<< MENU ∫≥”∏ … ∂Ωﬁ >>>
 1012   PROG$="***** MUSIC COMPOSER : Masakuni Mitsuhashi / Hibiki Godai / MECANO ASSOCIATES ***** Score Arrange & MML Programed by Yukihiro Ninagawa ***** Sound System Programed by Naozumi Honma (nao) / Bits Laboratory *****"
 1013   PROG$=PROG$+" BASIC Main System Programed by Motoyuki Kanayama (motos) / Bits Laboratory ***** Special Thanks - Kenichi Kunishima, Tomoyuki Shimada, Yukihiro Yoshida *****"
 1014   Q$=SPACE$(40)+PROG$+SPACE$(300):QCUT=1
 1015   GOTO *START_THIS_PROGRAM
 1016 '
 1017 '---------------- MENU DATA
 1018 *MENU_STR
 1019   DATA " ÉVÉãÉtÉBÅ[Éh           (C)GAME ARTS "
 1020   DATA " 1: The Legend of SILPHEED /éOã¥ ê≥ñM"
 1021   DATA " 2: Silph of wind       /Hibiki Godai"
 1022   DATA " 3: Battlestar OLLEYUS     /éOã¥ ê≥ñM"
 1023   DATA " 4: King Jupiter           /éOã¥ ê≥ñM"
 1024   DATA " 5: Battle on Orbit           /MECANO"
 1025   DATA " 6: Double Star            /éOã¥ ê≥ñM"
 1026   DATA " 7: Asteroid                  /MECANO"
 1027   DATA " 8: Going in Fortress         /MECANO"
 1028   DATA " 9: Landing Base           /éOã¥ ê≥ñM"
 1029   DATA "10: Return of XACALITE     /éOã¥ ê≥ñM"
 1030   DATA "11: Little moments peace      /MECANO"
 1031   DATA "12: The Legend of SILPHEED (Original)"
 1032   DATA "13: Silph of wind          (Original)"
 1033   DATA "14: Battlestar OLLEYUS     (Original)"
 1034   DATA "15: King Jupiter           (Original)"
 1035   DATA "16: Battle on Orbit        (Original)"
 1036   DATA "17: Double Star            (Original)"
 1037   DATA "18: Asteroid               (Original)"
 1038   DATA "19: Going in Fortress      (Original)"
 1039   DATA "20: Landing Base           (Original)"
 1040   DATA "21: Return of XACALITE     (Original)"
 1041   DATA "22: Little moments peace   (Original)"
 1042 '
 1043 '---------------- Exit Program
 1044 *EXIT_THIS_PROGRAM
 1045   GOSUB *MUSIC_FADE_OUT:OBJ CLEAR:GOSUB *FADEOUT:INTERVAL (0) OFF:INTERVAL (1) OFF:SCREEN 0:LOCATE 5,0:COLOR 7:PRINT "Loading S_G_ARTS.B":LOAD"CD:S_G_ARTS",R
 1046   END
 1047 '
 1048 '---------------- Start Program
 1049 *START_THIS_PROGRAM
 1050   GOSUB *INIT_SYS
 1051   GOSUB *SET_OBJECTS
 1052 '
 1053 '================ Main Loop
 1054 *PAD_WATCH
 1055   TRIGGA=0
 1056   *PAD_W2:IF TRIGGA THEN KEY$="":KEY=0:GOTO *PAD_TRIGGA
 1057     IF PLAYSTAT(0)=0 THEN EMNUM=-1:GOSUB *DISPLAY_MENU
 1058     KEY$=INKEY$:IF KEY$="" THEN *PAD_W2 ELSE KEY=ASC(KEY$)
 1059   *PAD_TRIGGA
 1060     WTIME=0
 1061     IF KEY=KEY_DOWN  OR KEY=KEY_D2 OR (TRIGGA AND @PAD_DOWN) THEN GOSUB *MOVE_DOWN:GOTO *PAD_WATCH
 1062     IF KEY=KEY_UP    OR KEY=KEY_U2 OR (TRIGGA AND @PAD_UP)   THEN GOSUB *MOVE_UP:  GOTO *PAD_WATCH
 1063     IF KEY=KEY_ENTER OR (TRIGGA AND (@PAD_START OR @PAD_C))  THEN IF EMNUM=CNUM THEN BGM:GOTO *PAD_WATCH ELSE EMNUM=CNUM:GOSUB *MUSIC_FADE_OUT:GOTO *PLAY_GO
 1064     IF KEY=KEY_ESC   OR (TRIGGA AND (@PAD_Y     OR @PAD_B))  THEN *EXIT_THIS_PROGRAM
 1065     GOTO *PAD_WATCH
 1066 '
 1067 '================
 1068 *MOVE_DOWN
 1069   IF CNUM < NUM_OF_MSTR THEN CNUM=CNUM+1
 1070   IF (CNUM > 4) AND (CNUM <= (NUM_OF_MSTR - 3)) THEN MTOP=MTOP+1
 1071   GOSUB *DISPLAY_MENU
 1072   RETURN
 1073 '
 1074 '----------------
 1075 *MOVE_UP
 1076   IF CNUM > 1 THEN CNUM=CNUM-1
 1077   IF (CNUM > 3) AND (CNUM < (NUM_OF_MSTR - 3)) THEN MTOP=MTOP-1
 1078   GOSUB *DISPLAY_MENU
 1079   RETURN
 1080 '
 1081 '----------------
 1082 *DISPLAY_MENU
 1083   MDY=38
 1084   FOR I=MTOP TO MTOP+6
 1085     IF I=CNUM THEN
 1086       IF I=EMNUM THEN
 1087         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31),,RGB(20,20,0)
 1088       ELSE
 1089         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31),,RGB(0,20,20)
 1090       ENDIF
 1091     ELSE
 1092       IF I=EMNUM THEN
 1093         KPRINT (10,MDY),MSTR$(I),RGB(31,31,0),,RGB(16,16,16)
 1094       ELSE
 1095         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31)
 1096       ENDIF
 1097     ENDIF
 1098     MDY=MDY+18
 1099   NEXT
 1100   RETURN
 1101 '
 1102 '================ Subroutines
 1103 *INIT_SYS
 1104   MTOP=1:EMNUM=-1
 1105   DIM MSTR$(NUM_OF_MSTR)
 1106   RESTORE *MENU_STR:FOR I=0 TO NUM_OF_MSTR:READ MSTR$(I):NEXT
 1107 '
 1108   PAD_ABCXYZSTART = @PAD_A+@PAD_B+@PAD_C+@PAD_START+@PAD_X+@PAD_Y+@PAD_Z
 1109   PAD_UDLR  = @PAD_RIGHT+@PAD_LEFT+@PAD_DOWN+@PAD_UP+@PAD_L+@PAD_R
 1110   KEY_DOWN  = 31:  KEY_D2=ASC("X")-64
 1111   KEY_UP    = 30:  KEY_U2=ASC("E")-64
 1112   KEY_ENTER = 13: KEY_ESC = 27
 1113 '
 1114   SCREEN 0:WIDTH 1,1,38,26
 1115   INITIAL_TOUCH=20:AFTER_TOUCH=3
 1116   ON INTERVAL (0) GOSUB *INT_COUNT: INTERVAL (0) ON,1
 1117   ON INTERVAL (1) GOSUB *DISPLAY_PFONT: INTERVAL (1) ON,1
 1118 *CLEAR_INKEY: IF INKEY$<>"" THEN *CLEAR_INKEY
 1119   TRIGGA=PAD(0,2) :' Clear trigga
 1120   KPRINT (10,20),MSTR$(0),,,RGB(20,0,20)    :'¿≤ƒŸÀÆ≥ºﬁ
 1121   LINE(10,164)-(307,164),RGB(31,31,0)
 1122   KPRINT (10,166),"Å™Å´";,RGB(31,22,22):KPRINT FIX "(Œ≥∫≥ Œﬁ¿› )--- ";,RGB(21,21,10):KPRINT FIX "Move Cursor",RGB(0,31,20)
 1123   KPRINT (10,182-8),FIX "  START / CŒﬁ¿›";,RGB(31,22,22):KPRINT FIX " --- ";,RGB(21,21,10):KPRINT FIX "Start BGM  ",RGB(0,31,20)
 1124   KPRINT (10,198-16),FIX "          BŒﬁ¿›";,RGB(31,22,22):KPRINT FIX " --- ";,RGB(21,21,10):KPRINT FIX "RETURN Main Menu",RGB(0,31,20)
 1125   CNUM=-1:GOSUB *DISPLAY_MENU:CNUM=1
 1126   GOSUB *SOUND_INIT:GOSUB *DISPLAY_MENU    :'Sound Sample ∫’≥… ºÆ∑∂ Ÿ∞¡›
 1127   RETURN
 1128 '
 1129 '----------------
 1130 *INT_COUNT:' Make repeat trigga of PAD ULDR
 1131   IF PAD(0)=52 THEN *INT_COUNT_RET: 'Ignore keyboard pad
 1132   TRIGGA=TRIGGA OR (PAD(0,2) AND PAD_ABCXYZSTART): 'Update A,B,C,START buttons
 1133   TESTBTN=PAD(0,1):IF (TESTBTN AND PAD_UDLR) = 0 THEN REPEAT_COUNT=0: GOTO *INT_COUNT_RET
 1134   IF TESTBTNL<>TESTBTN THEN TESTBTNL=TESTBTN: REPEAT_COUNT=0
 1135   IF REPEAT_COUNT=0 THEN REPEAT_COUNT=INITIAL_TOUCH: TRIGGA=TESTBTN: GOTO *INT_COUNT_RET
 1136   REPEAT_COUNT=REPEAT_COUNT-1: IF REPEAT_COUNT <= 0 THEN REPEAT_COUNT=AFTER_TOUCH: TRIGGA=TESTBTN
 1137 *INT_COUNT_RET
 1138   SKCLOSE
 1139   RETURN
 1140 '
 1141 '----------------
 1142 *SET_OBJECTS
 1143 'Object Item Number
 1144   TYPE = 0: XP = 4: XR = 8: XS = 12
 1145   PARENT = 20: XRV= 36
 1146 '
 1147   SETDISP 3: SETPERS 105
 1148   SETLIGHT .5,-1,.5:PRIORITY 10,1
 1149   PFONT$=TITLE$:GOSUB *MAKE_PFONT
 1150   WTIME = 0:SOFS=-255: COLOROFS ON,10:COLOROFS (SOFS,SOFS,SOFS)
 1151   OBJ(1,TYPE)=6:OBJ(1,XRV)=&H0.0018,&H0.0024,-&H0.002
 1152   OBJ(0,XP+2)=110
 1153   RETURN
 1154 '
 1155 '----------------
 1156 *MAKE_PFONT
 1157   SLEN=LEN(PFONT$): PT=-SLEN/2*45 : ND=RND(255)/255:OBJ(1,XP+2)=90+SLEN*10
 1158   FOR SP=1 TO SLEN
 1159     CH$=MID$(PFONT$,SP,1): CH2$=MID$(PFONT$,SP+1,1)
 1160     IF CH$=" " THEN
 1161       PT=PT+40
 1162     ELSE
 1163       OBJ(SP+2,XP)=PT,60:OBJ(SP+2,PARENT)=1:OBJ(SP+2,TYPE)=4: OBJ(SP+2,XRV)=&H0.001
 1164       SETPFONT SP+2,ASC(CH$),(1,1.2,3),RGB(30,24,30)
 1165       IF CH$="I" OR CH2$="I" THEN PT=PT+50 ELSE PT=PT+60
 1166     ENDIF
 1167   NEXT SP
 1168   RETURN
 1169 '
 1170 '----------------
 1171 *DISPLAY_PFONT:GOSUB *DISP_COPYRIGHT
 1172   IF WTIME = 0 THEN *DISP_HIDDEN
 1173   IF WTIME > 60*20 THEN *DISP_APEAR
 1174   WTIME = WTIME + 1: RETURN
 1175 *DISP_HIDDEN
 1176   IF SOFS > -330 THEN SOFS = SOFS - 5
 1177   IF SOFS <= -330 THEN SOFS = -330: WTIME = 1
 1178   GOTO *DISP_RET
 1179 *DISP_APEAR
 1180   IF SOFS < -110 THEN SOFS = SOFS + .5
 1181 *DISP_RET
 1182   OX=SOFS+XSIN(ND)*50: IF OX < -255 THEN OX = -255
 1183   OY=SOFS+XSIN(ND+1/3)*50: IF OY < -255 THEN OY = -255
 1184   OZ=SOFS+XSIN(ND+2/3)*50: IF OZ < -255 THEN OZ = -255
 1185   ND=ND+&H0.0004: COLOROFS (OX,OY,OZ)
 1186   RETURN
 1187 '
 1188 '---------------- SCREEN Fade Out
 1189 *FADEOUT
 1190   COLOROFS ON,0:IF OFS=255 THEN RETURN
 1191   FOR OFS=0 TO 255 STEP 32
 1192     COLOROFS(-OFS,-OFS,-OFS)
 1193     VSYNC
 1194   NEXT OFS
 1195   OFS=255
 1196   COLOROFS(-255,-255,-255)
 1197   CLS 0
 1198   VSYNC
 1199   RETURN
 1200 '
 1201 '================ Sound Sample ∫’≥… ºÆ∑∂ Ÿ∞¡›
 1202 *SOUND_INIT
 1203   LOCATE 5,0:COLOR 7
 1204   IF PEEK(0,5)=1 THEN PRINT " Tone Data Set...":PLAYINIT "DSP","SILPH",1,78 ELSE PRINT " Arrange Tone....":PLAYINIT "DSP",1,78:RESTORE *SET_TONE:TARG READ
 1206   GOSUB *TPROP_SUB:LOCATE 5,0:PRINT "                 "
 1207   RETURN
 1208 '
 1209 '================ MUSIC FADE OUT
 1210 *MUSIC_FADE_OUT:IF PLAYSTAT(0)=0 THEN RETURN
 1211   TMP_F=CNUM:CNUM=-1:GOSUB *DISPLAY_MENU:LOCATE 5,0:COLOR 7:PRINT " Music Fade Out...":PLAYFADE 0,0,4:VSYNC 2
 1212   *MFO_LOOP
 1213     IF PLAYSTAT(0)=1 THEN *MFO_LOOP
 1214   CNUM=TMP_F:GOSUB *DISPLAY_MENU:LOCATE 5,0:PRINT "                  ":RETURN
 1215 '
 1216 '================ Start Sound Sample Program
 1217 *PLAY_GO
 1218   PLAYSTOP:VSYNC 2
 1219   LOCATE 5,0:COLOR 7:PRINT " Set Song Data..."
 1220   TMP=CNUM
 1221   ON CNUM RESTORE *Legend_P,*Silph_P,*OLLEYUS_P,*Jupiter_P,*Orbit_P,*Double_P,*Asteroid_P,*Fortress_P,*Landing_P,*XACALITE_P,*peace_P,*Legend_O,*Silph_O,*OLLEYUS_O,*Jupiter_O,*Orbit_O,*Double_O,*Asteroid_O,*Fortress_O,*Landing_O,*XACALITE_O,*peace_O
 1222   IF CNUM < 12 THEN EFFECT "el0;7 R el1;7 R" ELSE EFFECT "el0;0 R el1;0 R"  :'Original…  ﬁ±≤  DSPº≠¬ÿÆ∏¶ ∂ØƒΩŸ°
 1223   CNUM=-1:GOSUB *DISPLAY_MENU:SETSONG:LOCATE 5,0:PRINT "                 ":CNUM=TMP
 1224   GOSUB *DISPLAY_MENU:BGM:VSYNC 2
 1225   GOTO *PAD_WATCH
