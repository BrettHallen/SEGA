LOAD"COM:D"
 1000 SCREEN 0: SKCLOSE :'Initialize screen, Close software keyboard
 1002 '
 1003 'Programed by Mitsuhashi
 1004 CLEAR 10,1360:IF PEEK(0,3)<>78 THEN KLOAD ON:CLEAR 10,1360:POKE 0,0,56:POKE 0,1,2:POKE 0,2,1:POKE 0,3,78:POKE 0,4,1
 1005 PLAYINIT "DSP","MBOXPO"
 1006 SETSONG
 1007 BGM :VSYNC 2:PLAYTEMPO 0,-900
 1008 PRINT:PRINT " --- S_AREA_P.B ---":PRINT:PRINT " PRESS ANY KEY -> MAIN MENU"
 1009 *LOOP:IF INKEY$="" AND PAD(0,2)=0 THEN *LOOP ELSE PLAYSTOP 0:CLS:PRINT "Loading S_CLASSI.B":LOAD "CD:S_CLASSI",R
