 1034 '---------------- Exit Program
 1035 *EXIT_THIS_PROGRAM
 1036   GOSUB *MUSIC_FADE_OUT:OBJ CLEAR:GOSUB *FADEOUT:INTERVAL (0) OFF:INTERVAL (1) OFF:SCREEN 0:LOCATE 5,0:COLOR 7:PRINT "Loading S_G_ARTS.B":LOAD"CD:S_G_ARTS",R
 1037   END
 1038 '
 1039 '---------------- Start Program
 1040 *START_THIS_PROGRAM
 1041   GOSUB *INIT_SYS
 1042   GOSUB *SET_OBJECTS
 1043 '
 1044 '================ Main Loop
 1045 *PAD_WATCH
 1046   TRIGGA=0
 1047   *PAD_W2:IF TRIGGA THEN KEY$="":KEY=0:GOTO *PAD_TRIGGA
 1048     IF PLAYSTAT(0)=0 THEN EMNUM=-1:GOSUB *DISPLAY_MENU
 1049     KEY$=INKEY$:IF KEY$="" THEN *PAD_W2 ELSE KEY=ASC(KEY$)
 1050   *PAD_TRIGGA
 1051     WTIME=0
 1052     IF KEY=KEY_DOWN  OR KEY=KEY_D2 OR (TRIGGA AND @PAD_DOWN) THEN GOSUB *MOVE_DOWN:GOTO *PAD_WATCH
 1053     IF KEY=KEY_UP    OR KEY=KEY_U2 OR (TRIGGA AND @PAD_UP)   THEN GOSUB *MOVE_UP:  GOTO *PAD_WATCH
 1054     IF KEY=KEY_ENTER OR (TRIGGA AND (@PAD_START OR @PAD_C))  THEN IF EMNUM=CNUM THEN BGM:GOTO *PAD_WATCH ELSE EMNUM=CNUM:GOSUB *MUSIC_FADE_OUT:GOTO *PLAY_GO
 1055     IF KEY=KEY_ESC   OR (TRIGGA AND (@PAD_Y     OR @PAD_B))  THEN *EXIT_THIS_PROGRAM
 1056     GOTO *PAD_WATCH
 1057 '
 1058 '================
 1059 *MOVE_DOWN
 1060   IF CNUM < NUM_OF_MSTR THEN CNUM=CNUM+1
 1061   IF (CNUM > 4) AND (CNUM <= (NUM_OF_MSTR - 3)) THEN MTOP=MTOP+1
 1062   GOSUB *DISPLAY_MENU
 1063   RETURN
 1064 '
 1065 '----------------
 1066 *MOVE_UP
 1067   IF CNUM > 1 THEN CNUM=CNUM-1
 1068   IF (CNUM > 3) AND (CNUM < (NUM_OF_MSTR - 3)) THEN MTOP=MTOP-1
 1069   GOSUB *DISPLAY_MENU
 1070   RETURN
 1071 '
 1072 '----------------
 1073 *DISPLAY_MENU
 1074   MDY=38
 1075   FOR I=MTOP TO MTOP+6
 1076     IF I=CNUM THEN
 1077       IF I=EMNUM THEN
 1078         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31),,RGB(20,20,0)
 1079       ELSE
 1080         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31),,RGB(0,20,20)
 1081       ENDIF
 1082     ELSE
 1083       IF I=EMNUM THEN
 1084         KPRINT (10,MDY),MSTR$(I),RGB(31,31,0),,RGB(16,16,16)
 1085       ELSE
 1086         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31)
 1087       ENDIF
 1088     ENDIF
 1089     MDY=MDY+18
 1090   NEXT
 1091   RETURN
 1092 '
 1093 '================ Subroutines
 1094 *INIT_SYS
 1095   MTOP=1:EMNUM=-1
 1096   DIM MSTR$(NUM_OF_MSTR)
 1097   RESTORE *MENU_STR:FOR I=0 TO NUM_OF_MSTR:READ MSTR$(I):NEXT
 1098 '
 1099   PAD_ABCXYZSTART = @PAD_A+@PAD_B+@PAD_C+@PAD_START+@PAD_X+@PAD_Y+@PAD_Z
 1100   PAD_UDLR  = @PAD_RIGHT+@PAD_LEFT+@PAD_DOWN+@PAD_UP+@PAD_L+@PAD_R
 1101   KEY_DOWN  = 31:  KEY_D2=ASC("X")-64
 1102   KEY_UP    = 30:  KEY_U2=ASC("E")-64
 1103   KEY_ENTER = 13: KEY_ESC = 27
 1104 '
 1105   SCREEN 0:WIDTH 1,1,38,26
 1106   INITIAL_TOUCH=20:AFTER_TOUCH=3
 1107   ON INTERVAL (0) GOSUB *INT_COUNT: INTERVAL (0) ON,1
 1108   ON INTERVAL (1) GOSUB *DISPLAY_PFONT: INTERVAL (1) ON,1
 1109 *CLEAR_INKEY: IF INKEY$<>"" THEN *CLEAR_INKEY
 1110   TRIGGA=PAD(0,2) :' Clear trigga
 1111   KPRINT (10,20),MSTR$(0),,,RGB(20,0,20)    :'¿≤ƒŸÀÆ≥ºﬁ
 1112   LINE(10,164)-(307,164),RGB(31,31,0)
 1113   KPRINT (10,166),"Å™Å´";,RGB(31,22,22):KPRINT FIX "(Œ≥∫≥ Œﬁ¿› )--- ";,RGB(21,21,10):KPRINT FIX "Move Cursor",RGB(0,31,20)
 1114   KPRINT (10,182-8),FIX "  START / CŒﬁ¿›";,RGB(31,22,22):KPRINT FIX " --- ";,RGB(21,21,10):KPRINT FIX "Start BGM  ",RGB(0,31,20)
 1115   KPRINT (10,198-16),FIX "          BŒﬁ¿›";,RGB(31,22,22):KPRINT FIX " --- ";,RGB(21,21,10):KPRINT FIX "RETURN Main Menu",RGB(0,31,20)
 1116   CNUM=-1:GOSUB *DISPLAY_MENU:CNUM=1
 1117   GOSUB *SOUND_INIT:GOSUB *DISPLAY_MENU    :'Sound Sample ∫’≥… ºÆ∑∂ Ÿ∞¡›
 1118   RETURN
 1119 '
 1120 '----------------
 1121 *INT_COUNT:' Make repeat trigga of PAD ULDR
 1122   IF PAD(0)=52 THEN *INT_COUNT_RET: 'Ignore keyboard pad
 1123   TRIGGA=TRIGGA OR (PAD(0,2) AND PAD_ABCXYZSTART): 'Update A,B,C,START buttons
 1124   TESTBTN=PAD(0,1):IF (TESTBTN AND PAD_UDLR) = 0 THEN REPEAT_COUNT=0: GOTO *INT_COUNT_RET
 1125   IF TESTBTNL<>TESTBTN THEN TESTBTNL=TESTBTN: REPEAT_COUNT=0
 1126   IF REPEAT_COUNT=0 THEN REPEAT_COUNT=INITIAL_TOUCH: TRIGGA=TESTBTN: GOTO *INT_COUNT_RET
 1127   REPEAT_COUNT=REPEAT_COUNT-1: IF REPEAT_COUNT <= 0 THEN REPEAT_COUNT=AFTER_TOUCH: TRIGGA=TESTBTN
 1128 *INT_COUNT_RET
 1129   SKCLOSE
 1130   RETURN
 1131 '
 1132 '----------------
 1133 *SET_OBJECTS
 1134 'Object Item Number
 1135   TYPE = 0: XP = 4: XR = 8: XS = 12
 1136   PARENT = 20: XRV= 36
 1137 '
 1138   SETDISP 3: SETPERS 105
 1139   SETLIGHT .5,-1,.5:PRIORITY 10,1
 1140   PFONT$=TITLE$:GOSUB *MAKE_PFONT
 1141   WTIME = 0:SOFS=-255: COLOROFS ON,10:COLOROFS (SOFS,SOFS,SOFS)
 1142   OBJ(1,TYPE)=6:OBJ(1,XRV)=&H0.0018,&H0.0024,-&H0.002
 1143   OBJ(0,XP+2)=110
 1144   RETURN
 1145 '
 1146 '----------------
 1147 *MAKE_PFONT
 1148   SLEN=LEN(PFONT$): PT=-SLEN/2*45 : ND=RND(255)/255:OBJ(1,XP+2)=90+SLEN*10
 1149   FOR SP=1 TO SLEN
 1150     CH$=MID$(PFONT$,SP,1): CH2$=MID$(PFONT$,SP+1,1)
 1151     IF CH$=" " THEN
 1152       PT=PT+40
 1153     ELSE
 1154       OBJ(SP+2,XP)=PT,60:OBJ(SP+2,PARENT)=1:OBJ(SP+2,TYPE)=4: OBJ(SP+2,XRV)=&H0.001
 1155       SETPFONT SP+2,ASC(CH$),(1,1.2,3),RGB(30,24,30)
 1156       IF CH$="I" OR CH2$="I" THEN PT=PT+50 ELSE PT=PT+60
 1157     ENDIF
 1158   NEXT SP
 1159   RETURN
 1160 '
 1161 '----------------
 1162 *DISPLAY_PFONT:GOSUB *DISP_COPYRIGHT
 1163   IF WTIME = 0 THEN *DISP_HIDDEN
 1164   IF WTIME > 60*20 THEN *DISP_APEAR
 1165   WTIME = WTIME + 1: RETURN
 1166 *DISP_HIDDEN
 1167   IF SOFS > -330 THEN SOFS = SOFS - 5
 1168   IF SOFS <= -330 THEN SOFS = -330: WTIME = 1
 1169   GOTO *DISP_RET
 1170 *DISP_APEAR
 1171   IF SOFS < -110 THEN SOFS = SOFS + .5
 1172 *DISP_RET
 1173   OX=SOFS+XSIN(ND)*50: IF OX < -255 THEN OX = -255
 1174   OY=SOFS+XSIN(ND+1/3)*50: IF OY < -255 THEN OY = -255
 1175   OZ=SOFS+XSIN(ND+2/3)*50: IF OZ < -255 THEN OZ = -255
 1176   ND=ND+&H0.0004: COLOROFS (OX,OY,OZ)
 1177   RETURN
 1178 '
 1179 '---------------- SCREEN Fade Out
 1180 *FADEOUT
 1181   COLOROFS ON,0:IF OFS=255 THEN RETURN
 1182   FOR OFS=0 TO 255 STEP 32
 1183     COLOROFS(-OFS,-OFS,-OFS)
 1184     VSYNC
 1185   NEXT OFS
 1186   OFS=255
 1187   COLOROFS(-255,-255,-255)
 1188   CLS 0
 1189   VSYNC
 1190   RETURN
 1191 '
 1192 '================ Sound Sample ∫’≥… ºÆ∑∂ Ÿ∞¡›
 1193 *SOUND_INIT
 1194   LOCATE 5,0:COLOR 7
 1195   IF PEEK(0,5)=1 THEN PRINT " Tone Data Set...":PLAYINIT "LUNAR_A",1,240 ELSE PRINT " Arrange Tone....":PLAYINIT 1,240:RESTORE *TONE_SET:TARG READ
 1197   GOSUB *TONE_EDIT:LOCATE 5,0:PRINT "                 "
 1198   RETURN
 1199 '
 1200 '================ MUSIC FADE OUT
 1201 *MUSIC_FADE_OUT:IF PLAYSTAT(0)=0 THEN RETURN
 1202   TMP_F=CNUM:CNUM=-1:GOSUB *DISPLAY_MENU:LOCATE 5,0:COLOR 7:PRINT " Music Fade Out...":PLAYFADE 0,0,4:VSYNC 2
 1203   *MFO_LOOP
 1204     IF PLAYSTAT(0)=1 THEN *MFO_LOOP
 1205   CNUM=TMP_F:GOSUB *DISPLAY_MENU:LOCATE 5,0:PRINT "                  ":RETURN
 1206 '
 1207 '================ Start Sound Sample Program
 1208 *PLAY_GO
 1209   PLAYSTOP:VSYNC 2
 1210   LOCATE 5,0:COLOR 7:PRINT " Set Song Data..."
 1211   TMP=CNUM
 1212   ON CNUM RESTORE *M1_MML,*M2_MML,*M6_MML,*M8_MML,*M12_MML,*M15_MML,*M21_MML,*M40_MML,*M43_MML,*M54_MML,*M55_MML,*M59_MML,*M62_MML
 1213   CNUM=-1:GOSUB *DISPLAY_MENU:SETSONG:LOCATE 5,0:PRINT "                 ":CNUM=TMP
 1214   GOSUB *DISPLAY_MENU:BGM:VSYNC 2
 1215   GOTO *PAD_WATCH
 1216 '
