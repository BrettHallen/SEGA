 1210 '= SUBMAIN    =
 1220 '==============
 1240 *SUB_MAIN
 1250  GOSUB *SUB_MOVE
 1260  GOSUB *SUB_JUD
 1270  IF OLD_TIME<>0 THEN GOSUB *SUB_WINDOW
 1280  IF STARTFG=-1 THEN
 1290    COLOROFS ON :COLOROFS ON 10:OBJK=1
 1300    FOR N=55 TO -255 STEP -10:COLOROFS (N,N,N):VSYNC
 1310     IF MAP_NO=1 THEN OBJ(90,12)=OBJK,OBJK
 1320     IF MAP_NO=2 THEN OBJ(91,12)=OBJK,OBJK
 1330     IF MAP_NO=3 THEN OBJ(92,12)=OBJK,OBJK
 1340    OBJK=OBJK+.5:NEXT
 1350     GOSUB *SUB_MAPSET
 1360     GOSUB *SUB_OBJSET
 1370    FOR N=-255 TO 0 STEP 10:COLOROFS (N,N,N):VSYNC :NEXT
 1380    STARTFG=2
 1390  ENDIF
 1400  IF STARTFG=2 THEN GOTO *MAIN
 1410  'IF EDIT_FG=1 THEN GOTO *EDITO
 1420 GOTO *SUB_MAIN
 1430 '===========
 1440 '= MAIN    =
 1450 '===========
 1470 *MAIN
 1480   GOSUB *MAIN_JUD
 1490   GOSUB *HIT_JUD
 1500   GOSUB *MOVE_OBJ
 1510   GOSUB *MAIN_TIME
 1520   GOSUB *BG_SCROLL
 1530   IF STARTFG=4 THEN
 1540    COLOROFS ON :COLOROFS ON 10:BOMM=1
 1550    FOR N=255 TO -255 STEP -10:COLOROFS (N,N,N):VSYNC
 1560     IF HIT_P>3 THEN OBJ(183,12)=BOMM,BOMM:BOMM=BOMM+.5:OBJ(183,20)=0
 1570     IF HIT_P<=3 THEN OBJ(181,12)=BOMM,BOMM:BOMM=BOMM+.5
 1580    NEXT
 1590  '****end start ÄÞ³ÌÞÂÀÁ É ¼®·¶
 1600     OBJ(180,12)=1,1,1:'START
 1610     OBJ(181,12)=1,1,1:'END
 1620     OBJ(90,12)=1,1,1:'START
 1630     OBJ(91,12)=1,1,1:'END
 1640     OBJ(92,12)=1,1,1:'START
 1650    GOSUB *INIT_ALL
 1660    FOR N=-255 TO 0 STEP 10:COLOROFS (N,N,N):VSYNC :NEXT
 1670    GOTO *SUB_MAIN
 1680   ENDIF
 1690 GOTO *MAIN
