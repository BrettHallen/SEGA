10510   IF PN2=3 THEN GOSUB *GUN
10520   IF PN2=1 THEN GOSUB *MOUSE
10530  ' IF PN2=2 THEN GOSUB *CONTL
10540  ' IF APPAD=0 THEN GOSUB *PADMOVE
10550   'IF P=3072 AND PP=1024 THEN GOTO *FIRST
10560   IF P=1024 AND PP=0 THEN POP=1 ELSE POP=0
10570   IF P=2048 AND PP=0 THEN POST=1 ELSE POST=0
10580   PP=P
10590   IF OBJ(1,20)=0 THEN
10600     OBJ(1,4)=PX,PY,,,,,,,XSIN(SK)/5+.8,XSIN(SK)/5+.8:IF SK<9999 THEN SK=SK+.003 ELSE SK=0
10610     OBJ(2,4)=XSIN(SK)*32,XCOS(SK)*32,,,,,,,XSIN(SK)/2+.3,XSIN(SK)/2+.3
10620   ENDIF
10630  ' IF OBJ(80,20)=0 AND STARTFG<>0 THEN GOSUB *WINDOW_MOVE
10640   IF OBJ(80,20)=0  THEN GOSUB *WINDOW_MOVE
10650  UNLOCK
10660 RETURN
10670 '
10690 *WINDOW_MOVE
10700 '********¼Þ¶Ý Ô×É Ë®³¼ÞÊÞ°
10710 '
10720 IF OBJ(80,4)>70 OR PX>30 THEN OBJ(80,24)=-WINXY
10730 IF OBJ(80,4)<-70 OR PX<-30 THEN OBJ(80,24)=WINXY
10740 IF OBJ(80,5)>90 OR PY>30 THEN OBJ(80,25)=-WINXY
10750 IF OBJ(80,5)<-90 OR PY<-30 THEN OBJ(80,25)=WINXY
10760  IF PY<>0 THEN
10770    IF ABS(ABS(OBJ(80,5))-90)<10 AND OBJ(80,5)/PY<0 THEN OBJ(80,25)=0
10780  ENDIF
10790  IF PX<>0 THEN
10800    IF ABS(ABS(OBJ(80,4))-70)<10 AND OBJ(80,4)/PX<0 THEN OBJ(80,24)=0
10810  ENDIF
10820 '
10830 RETURN
10840 '
10860 *GUN
10870   P=PAD(PN1,1):PX1=(PAD(PN1,3)-100)/1.8562-160:PY=PAD(PN1,4)-112
10880   IF ABS(PX2-PX1)<=18 THEN
10890     PX=PX2
10900   ELSE
10910     IF 28>=ABS(PX2-PX1) AND ABS(PX2-PX1)>18 THEN
10920       PX=(PX2+PX2+PX2+PX1)/4
10930     ELSE
10940       IF 38>=ABS(PX2-PX1) AND ABS(PX2-PX1)>28 THEN
10950         PX=(PX2+PX2+PX1)/3
10960       ELSE
10970         IF 42>=ABS(PX2-PX1) AND ABS(PX2-PX1)>38 THEN
10980           PX=(PX2+PX1)/2
10990         ELSE :IF 48>=ABS(PX2-PX1) AND ABS(PX2-PX1)>42 THEN
11000             PX=(PX2+PX1+PX1)/3
11010           ELSE :PX=PX1:ENDIF
11020         ENDIF
11030       ENDIF
11040     ENDIF
11050   ENDIF :PX2=PX
11060 RETURN
11070 '
11090 *MOUSE
11100   P=PAD(PN1,1):D_MOUSE=1
11110   IF PX1<10000 AND PAD(PN1,3)>50000 THEN
11120     PX1=PX1+65535
11130   ENDIF
11140   IF PY1<10000 AND PAD(PN1,4)>50000 THEN
11150     PY1=PY1+65535
11160   ENDIF
11170   DX=(PAD(PN1,3)-PX1)/D_MOUSE
11180   DY=(PAD(PN1,4)-PY1)/D_MOUSE
11190   PX=PX+DX:PY=PY+DY
11200   IF ABS(PX)>160 THEN PX=160*ABS(PX)/PX
11210   IF ABS(PY)>112 THEN PY=112*ABS(PY)/PY
11220   PX1=PAD(PN1,3):PY1=PAD(PN1,4)
11230 RETURN
