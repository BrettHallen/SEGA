 1830 '* MAIN      *
 1840 '*************
 1860 *MAIN_TIME
 1870   IF STARTFG=3 THEN
 1880    ACTIVE 70
 1890    KPRINT (0,0,0,0,2),FIX "HIT!",RGB(1,1,2):KPRINT (32,0),FIX STR$(HIT_P),RGB(1,1,3)
 1900    ACTIVE 71
 1910    KPRINT (0,0,0,0,2),FIX "TIME",RGB(2,1,1):KPRINT (32,0),FIX RIGHT$("  " + STR$(INT(TIME)),3),RGB(3,1,1)
 1920    ACTIVE 0
 1930    OLD_TIME=TIME:OLD_HIT_P=HIT_P
 1940   ENDIF
 1950 RETURN
 1960 '
 1980 *MAIN_JUD
 1990    IF HIT_P>3 OR TIME>600 THEN STARTFG=4
 2000   IF STARTFG=2 AND ABS(PX-OBJ(180,4))<32 AND ABS(PY-OBJ(180,5))<32 AND P=2048 THEN
 2010     STARTFG=3
 2020     TIME_FG=1
 2030     OLD_TIME=0:TIME=0
 2040 '
 2050   ENDIF
 2060   IF STARTFG=3 AND ABS(PX-OBJ(181,4))<24 AND ABS(PY-OBJ(181,5))<24 THEN
 2070     STARTFG=4
 2080     TIME_FG=0
 2090   ENDIF
 2100 RETURN
 2110 '
 2130 *BG_SCROLL
 2140  IF STARTFG=3 THEN
 2150  IF SCROLL_X>=0 AND SCROLL_X<128*8-320 THEN
 2160     DEC_PX=PX/50
 2170     SCROLL_X=SCROLL_X+DEC_PX
 2180     IF SCROLL_X<0 THEN
 2190     DEC_PX=-PX/50
 2200       SCROLL_X=SCROLL_X+DEC_PX
 2210     ENDIF
 2220  ELSE
 2230     DEC_PX=0
 2240     IF SCROLL_X<0 THEN
 2250       SCROLL_X=0
 2260     ELSE
 2270       IF SCROLL_X>128*8-320 THEN
 2280          SCROLL_X=128*8-320
 2290       ENDIF
 2300     ENDIF
 2310  ENDIF
 2320 ' IF ABS(PY)>60 THEN SCROLL_Y=INT(SCROLL_Y+PY/100)
 2330  SCROLL 5,SCROLL_X,SCROLL_Y
 2340  ENDIF
 2350 RETURN
 2360 '
 2380 *HIT_JUD
 2390 '
 2400 IF STARTFG=3 THEN
 2410 '
 2420 '***********³ÃÞ¦ÏÜ½ÔÂ É ±ÀØÊÝÃ²
 2430  IF UDE<100 THEN UDE=UDE+.002 ELSE UDE=0
 2440  FOR OBJ_NOM=100 TO 135 STEP 5
 2450   IF OBJ(OBJ_NOM,20)=0 THEN
 2460   B_X=OBJ(OBJ_NOM,4)                                      :B_Y=OBJ(OBJ_NOM,5)
 2470 '
 2480 '****************µÌÞ¼Þª¸Ä Æ ±À¯ÀÄ·
 2490   IF ABS(PX-B_X)<240 AND ABS(PY-B_Y)<200 THEN
 2500 '
 2510   OBJ(OBJ_NOM+1,12)=ABS(XSIN(UDE))*4                      :OBJ(OBJ_NOM+2,4)=16+16*(OBJ(OBJ_NOM+1,12)-1)
 2520   OBJ(OBJ_NOM+3,12)=ABS(XSIN(UDE))*4                      :OBJ(OBJ_NOM+4,4)=-16-16*(OBJ(OBJ_NOM+3,12)-1)
 2530 '
 2540   B6_X1=OBJ(OBJ_NOM+1,4)+B_X                              :B6_Y1=OBJ(OBJ_NOM+1,5)+B_Y
 2550   B8_X1=OBJ(OBJ_NOM+3,4)+B_X                              :B8_Y1=OBJ(OBJ_NOM+3,5)+B_Y
 2560   B6_X2=B6_X1+16*OBJ(OBJ_NOM+1,12)*XCOS(OBJ(OBJ_NOM+1,10)):B6_Y2=B6_Y1+16*OBJ(OBJ_NOM+1,12)*XSIN(OBJ(OBJ_NOM+1,10))
 2570   B8_X2=B8_X1-16*OBJ(OBJ_NOM+3,12)*XCOS(OBJ(OBJ_NOM+3,10)):B8_Y2=B8_Y1-16*OBJ(OBJ_NOM+3,12)*XSIN(OBJ(OBJ_NOM+3,10))
 2580 '
 2590   B7_X1=B6_X2                                             :B9_X1=B8_X2
 2600   B7_Y1=B6_Y2                                             :B9_Y1=B8_Y2
 2610   B7_X2=B7_X1+16*OBJ(OBJ_NOM+2,12)*XCOS(OBJ(OBJ_NOM+2,10)):B7_Y2=B7_Y1+16*OBJ(OBJ_NOM+2,12)*XSIN(OBJ(OBJ_NOM+2,10))
 2620   B9_X2=B9_X1-16*OBJ(OBJ_NOM+4,12)*XCOS(OBJ(OBJ_NOM+4,10)):B9_Y2=B9_Y1-16*OBJ(OBJ_NOM+4,12)*XSIN(OBJ(OBJ_NOM+4,10))
 2630 '
 2640 '
 2650 '****************OBJ105
 2660   IF ABS(PX-B_X)<14 AND ABS(PY-B_Y)<14 THEN
 2670    CA$="(B<E<G)":A$="(CEG>D)":EFFECT -1,"@3"+CA$
 2680    HIT_P=HIT_P+1
 2690   ENDIF
 2700 '
 2710 '
 2720 '****************CHECK!!>>>>OBJ106 & OBJ108
 2730 '
 2740  A=XTAN(OBJ(OBJ_NOM+1,10)):B=B6_Y1-A*B6_X1
 2750  IF ABS(A)>.0001 THEN
 2760   IF (PY>B6_Y1 AND B6_Y2>B6_Y1) OR (PY<=B6_Y1 AND B6_Y2<=B6_Y1) THEN
 2770    IF (PX<B6_X1 AND B6_X2<B6_X1) OR (PX>=B6_X1 AND B6_X2>=B6_X1) THEN
 2780    IF ((PX-B6_X1)^2+(PY-B6_Y1)^2)<256*OBJ(OBJ_NOM+1,12)^2 THEN :'³ÃÞ É ÊÝ¹²Å² Æ ²Ù¶ÄÞ³¶
 2790    OBJX1=(PY+PX/A-B)/(A+1/A)
 2800    OBJY1=A*OBJX1+B
 2810     IF (OBJY1-PY)^2+(OBJX1-PX)^2<64 THEN
 2820       CB$="(B<C<G)":B$="(DFA>E)":EFFECT -1,"@14"+CB$
 2830       HIT_P=HIT_P+1
 2840     ENDIF
 2850     ENDIF
 2860    ENDIF
 2870   ENDIF
 2880  ENDIF
 2890 '
 2900  A=XTAN(OBJ(OBJ_NOM+3,10)):B=B8_Y1-A*B8_X1
 2910  IF ABS(A)>.0001 THEN
 2920   IF (PY>B8_Y1 AND B8_Y2>B8_Y1) OR (PY<=B8_Y1 AND B8_Y2<=B8_Y1) THEN
 2930    IF (PX<B8_X1 AND B8_X2<B8_X1) OR (PX>=B8_X1 AND B8_X2>=B8_X1) THEN
 2940    IF ((PX-B8_X1)^2+(PY-B8_Y1)^2)<256*OBJ(OBJ_NOM+3,12)^2 THEN :'³ÃÞ É ÊÝ¹²Å² Æ ²Ù¶ÄÞ³¶
 2950    OBJX1=(PY+PX/A-B)/(A+1/A)
 2960    OBJY1=A*OBJX1+B
 2970     IF (OBJY1-PY)^2+(OBJX1-PX)^2<64 THEN
 2980       CB$="(B<C<G)":B$="(DFA>E)":EFFECT -1,"@24"+CB$
 2990       HIT_P=HIT_P+1
 3000     ENDIF
 3010     ENDIF
 3020    ENDIF
 3030   ENDIF
 3040  ENDIF
 3050 '
 3060 '****************CHECK!!>>>>OBJ107 & OBJ109
 3070   IF (B7_X1<=PX+16 AND PX-16<=B7_X2) OR (B7_X1>=PX-16 AND PX+16>=B7_X2) THEN
 3080    IF ABS(PX-B7_X1)<14 AND ABS(PY-B7_Y1)<14 THEN
 3090     CB$="(B<C<G)":B$="(DFA>E)":EFFECT -1,"@5"+CB$
 3100     HIT_P=HIT_P+1
 3110    ENDIF
 3120   ENDIF
 3130   IF (B9_X1<=PX+16 AND PX-16<=B9_X2) OR (B9_X1>=PX-16 AND PX+16>=B9_X2) THEN
 3140    IF ABS(PX-B9_X1)<14 AND ABS(PY-B9_Y1)<14 THEN
 3150     CB$="(B<C<G)":B$="(DFA>E)":EFFECT -1,"@5"+CB$
 3160     HIT_P=HIT_P+1
 3170    ENDIF
 3180   ENDIF
 3190 '*********************************************
 3200 '
 3210   ENDIF
 3220  ENDIF
 3230 NEXT
 3240 '
 3250 '******************Ø®³Ã
 3260    FOR RK=0 TO 9
 3270      IF OBJ(140+RK,20)=0 THEN
 3280        IF ABS(PX-OBJ(140+RK,4))<40 AND ABS(PY-OBJ(140+RK,5))<10 THEN
 3290           CB$="(B<C<G)":B$="(DFA>E)":EFFECT -1,"@4"+CB$
 3300           HIT_P=HIT_P+1
 3310        ENDIF
 3320      ENDIF
 3330    NEXT
 3340 '******************ÄÞ³ÌÞÂ
 3350   FOR RK=0 TO 29
 3360     IF OBJ(150+RK,20)=0 AND NONHIT=0 THEN :'»Ù
 3370        IF ABS(PX-OBJ(150+RK,4))<20 AND ABS(PY-OBJ(150+RK,5))<24 THEN
 3380           NONHIT=1
 3390        ELSE
 3400           NONHIT=0
 3410        ENDIF
 3420     ENDIF
 3430   NEXT
 3440 '****************À²Ù
 3450   FOR RK=0 TO 69
 3460    IF OBJ(10+RK,20)=0 AND NONHIT4=0 THEN
 3470      IF ABS(OBJ(10+RK,4)-PX)<12 AND ABS(OBJ(10+RK,5)-PY)<12 THEN
 3480        IF ABS(OBJ(10+RK,12))>.45 THEN
 3490           NONHIT4=1
 3500        ENDIF
 3510      ENDIF
 3520    ENDIF
 3530   NEXT
 3540 '    IF NONNIT3=1 THEN NONHIT4=1:NONHIT3=0
 3550 '
 3560   IF HIT_PP<>HIT_P THEN
 3570      OBJ(183,4)=PX,PY:OBJ(183,20)=0:FOR HU=1 TO 0 STEP .002:OBJ(183,12)=HU:NEXT :VSYNC 5:OBJ(182,20)=0:OBJ(182,4)=PX,PY,-30:FOR HU=1 TO 0 STEP .002:OBJ(182,12)=HU:NEXT :OBJ(182,20)=182:OBJ(183,20)=183
 3580   ENDIF
 3590  HIT_PP=HIT_P
 3600 '
 3610 '****ÉØÓÉ Æ É¯ÃÙÄ·
 3620 IF NONHIT=0 AND NONHIT4=0 THEN :'ÉØÓÉ Æ É¯ÃÅ²
 3630 '****º°½¶Þ² Æ Ê½ÞÚÀÄ·
 3640   CHRPAT=GETCHR(5,(INT((PX+160+SCROLL_X)/8),INT((PY+112+SCROLL_Y)/8)))
 3650   IF HITPOI=0 AND P<>1024 AND ((CHRPAT>=40 AND CHRPAT<=46) OR CHRPAT>=56) AND HIT_TIMER>5 THEN
 3660           CB$="(B<C<G)":B$="(DFA>E)":EFFECT -1,"@4"+CB$
 3670     HITPOI=1:HIT_P=HIT_P+1
 3680     HIT_TIMER=0
 3690   ENDIF
 3700    IF HITPOI=1 AND (CHRPAT<40 OR CHRPAT>46) THEN HITPOI=0
 3710 ELSE
 3720  NONHIT=0:NONHIT4=0
 3730 ENDIF
 3740 '
 3750   IF HIT_TIMER<10 THEN HIT_TIMER=HIT_TIMER+1 ELSE HIT_TIMER=10
 3760 ENDIF
 3770 RETURN
 3780 '
 3800 *MOVE_OBJ
 3810 '***********START AND END
 3820    OBJ(180,4)=OBJXY(180,4)-SCROLL_X
 3830    OBJ(181,4)=OBJXY(181,4)-SCROLL_X
 3840 '***********Ø®³ÃÉ³ºÞ· ¼Þ®³¹Þ
 3850    FOR RK=0 TO 9
 3860     IF OBJ(140+RK,20)=0 THEN
 3870 '      OBJ(140+RK,5)=OBJXY(140+RK,5)+XCOS(K0*(RK+1))*(64-2*RK)
 3880        OBJ(140+RK,25)=XCOS(K0+1)
 3890        IF K0>999 THEN K0=0 ELSE K0=K0+.008
 3900     ENDIF
 3910       OBJ(140+RK,4)=OBJXY(140+RK,4)-SCROLL_X
 3920    NEXT
 3930 '************³ÃÞÉ³ºÞ· ¶²ÃÝ
 3940    FOR OBJ_NOM=100 TO 135 STEP 5
 3950      IF OBJ(OBJ_NOM,20)=0 THEN
 3960          OBJ(OBJ_NOM,4)=OBJXY(OBJ_NOM,4)-SCROLL_X
 3970 '         FOR J=OBJ_NOM+1 TO OBJ_NOM+4:OBJ(J,10)=XSIN(K1/J):NEXT
 3980 '         IF K1>999 THEN K1=0 ELSE K1=K1+.05
 3990      ENDIF
 4000    NEXT
 4010 '************À²Ù±×ÜÚ
 4020    FOR RK=0 TO 69
 4030      IF OBJ(10+RK,20)=0 AND ABS(PX-OBJ(10+RK,4))<320 THEN
 4040         TI_SIZE=ABS(XCOS(K2*(RK+1))+1)
 4050         IF TI_SIZE>1 THEN TI_SIZE=1
 4060         OBJ(10+RK,12)=TI_SIZE,TI_SIZE
 4070      ENDIF
 4080         OBJ(10+RK,4)=OBJXY(10+RK,4)-SCROLL_X
 4090 '    IF K2>999 THEN K2=0 ELSE K2=K2+.001
 4100    NEXT
 4110         IF K2>999 THEN K2=0 ELSE K2=K2+.005
 4120 '************ÄÞ³ÌÞÂÀÁÉ³ºÞ·
 4130 DOUXY=MAP_NO
 4140   FOR RK=0 TO 29
 4150     IF OBJ(150+RK,20)=0 THEN
 4160      DOX=INT((OBJ(150+RK,4)+160+SCROLL_X)/8)
 4170      DOY=INT((OBJ(150+RK,5)+112)/8)
 4180        DOUBG=GETCHR(5,(DOX,DOY))/2
 4190 '::::::::::::::::
 4200 ':OBJXY(?,6)= DY:
 4210 ':OBJXY(?,7)= DX:
 4220 '::::::::::::::::
 4230 'ÀÃ Æ ³ºÞ¸
 4240        IF DOUBG>=28 AND DOUBG<=31 THEN
 4250           IF OBJXY(150+RK,6)=0 THEN OBJXY(150+RK,6)=DOUXY
 4260             OBJXY(150+RK,7)=0
 4270             OBJXY(150+RK,8)=0
 4280        ELSE
 4290           IF OBJXY(150+RK,3)>=28 AND OBJXY(150+RK,3)<=31 AND DOUBG<28 THEN
 4300              OBJXY(150+RK,6)=-OBJXY(150+RK,6)
 4310              OBJXY(150+RK,8)=0
 4320           ENDIF
 4330        ENDIF
 4340 'ÖºÆ³ºÞ¸
 4350        IF DOUBG>=32 AND DOUBG<=35 THEN
 4360           IF OBJXY(150+RK,7)=0 THEN OBJXY(150+RK,7)=DOUXY
 4370             OBJXY(150+RK,6)=0
 4380             OBJXY(150+RK,8)=0
 4390        ELSE
 4400           IF OBJXY(150+RK,3)>=32 AND OBJXY(150+RK,3)<=35 AND DOUBG<28 THEN
 4410              OBJXY(150+RK,7)=-OBJXY(150+RK,7)
 4420              OBJXY(150+RK,8)=0
 4430           ENDIF
 4440        ENDIF
 4450 'Î³º³ÃÝ¶Ý
 4460        IF DOUBG>=36 AND DOUBG<=39 THEN
 4470          DOUBG1=36
 4480      '    IF ((OBJXY(150+RK,3)=DOUBG1 OR OBJXY(150+RK,3)=(DOUBG1+2)) AND (DOUBG=(DOUBG1+1) OR DOUBG=(DOUBG1+3))) OR ((OBJXY(150+RK,3)=(DOUBG1+1) OR OBJXY(150+RK,3)=(DOUBG1+3)) AND (DOUBG=(DOUBG1+2) OR DOUBG=DOUBG1)) THEN
 4490      '      OBJXY(150+RK,8)=0
 4500      '    ENDIF
 4510      '    IF ((OBJXY(150+RK,3)=DOUBG1 OR OBJXY(150+RK,3)=(DOUBG1+1)) AND (DOUBG=(DOUBG1+2) OR DOUBG=(DOUBG1+3))) OR ((OBJXY(150+RK,3)=(DOUBG1+2) OR OBJXY(150+RK,3)=(DOUBG1+3)) AND (DOUBG=(DOUBG1+1) OR DOUBG=DOUBG1)) THEN
 4520      '      OBJXY(150+RK,8)=0
 4530      '    ENDIF
 4540          IF OBJXY(150+RK,6)<>0 AND OBJXY(150+RK,8)<>1 THEN
 4550             DO_Y(150+RK)=DO_Y(150+RK)+OBJXY(150+RK,6)*6
 4560             IF GETCHR(5,(DOX-2,DOY))>=64 AND GETCHR(5,(DOX-2,DOY))<=70 THEN
 4570               OBJXY(150+RK,6)=0:OBJXY(150+RK,7)=-ABS(DOUXY)
 4580             ENDIF
 4590             IF GETCHR(5,(DOX+2,DOY))>=64 AND GETCHR(5,(DOX+2,DOY))<=70 THEN
 4600                OBJXY(150+RK,6)=0:OBJXY(150+RK,7)=ABS(DOUXY)
 4610             ENDIF
 4620             OBJXY(150+RK,8)=1:GOTO *OBJ_FM2
 4630          ELSE
 4640           IF OBJXY(150+RK,7)<>0 AND OBJXY(150+RK,8)<>1 THEN
 4650             DO_X(150+RK)=DO_X(150+RK)+OBJXY(150+RK,7)*6
 4660             IF GETCHR(5,(DOX,DOY-2))>=56 AND GETCHR(5,(DOX,DOY-2))<=62 THEN
 4670               OBJXY(150+RK,6)=-ABS(DOUXY):OBJXY(150+RK,7)=0
 4680             ENDIF
 4690             IF GETCHR(5,(DOX,DOY+2))>=56 AND GETCHR(5,(DOX,DOY+2))<=62 THEN
 4700               OBJXY(150+RK,6)=ABS(DOUXY):OBJXY(150+RK,7)=0
 4710             ENDIF
 4720             OBJXY(150+RK,8)=1:GOTO *OBJ_FM2
 4730           ENDIF
 4740          ENDIF
 4750        ENDIF
 4760 '
 4770       DO_Y(150+RK)=DO_Y(150+RK)+OBJXY(150+RK,6)*1.5
 4780       DO_X(150+RK)=DO_X(150+RK)+OBJXY(150+RK,7)*1.5
 4800 *OBJ_FM2
 4810       OBJ(150+RK,4)=OBJXY(150+RK,4)-SCROLL_X+DO_X(150+RK)
 4820       OBJ(150+RK,5)=OBJXY(150+RK,5)-SCROLL_Y+DO_Y(150+RK)
 4830      OBJXY(150+RK,3)=DOUBG
 4840 '
 4850     ENDIF
 4860   NEXT
 4870 '
 4880 '
 4890 RETURN
