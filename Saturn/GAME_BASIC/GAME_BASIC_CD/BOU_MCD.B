 5070 *SUB_MOVE
 5080   'IF OBJ(80,20)=0 THEN OBJ(80,4)=XSIN(TI_K/20)*10,XCOS(TI_K/20)*20,,,,,,,WIN_X,WIN_Y
 5090   'IF OBJ(80,20)=0 THEN OBJ(80,4)=XSIN(TI_K/20)*10,XCOS(TI_K/20)*20
 5100   OBJ(90,4)=-80-XSIN(TI_K/10)*60,32-XSIN(TI_K)*80,,,,,,,.9+ABS(XCOS(TI_K/3))/2,.9+ABS(XCOS(TI_K))/2
 5110   OBJ(91,4)=0-XSIN(TI_K/11)*54,32-XSIN(TI_K)*70,,,,,,,.9+ABS(XCOS(TI_K/4))/3,.9+ABS(XCOS(TI_K))/3
 5120   OBJ(92,4)=80-XSIN(TI_K/12)*50,32-XSIN(TI_K)*82,,,,,,,.9+ABS(XCOS(TI_K/5))/5,.9+ABS(XCOS(TI_K))/5
 5130   OBJ(93,4)=XSIN(TI_K/25)*140,80,,,,,,,.9+ABS(XCOS(TI_K/3))/5,.9+ABS(XCOS(TI_K/3))/5
 5140   IF TI_K<9999 THEN TI_K=TI_K+.003 ELSE TI_K=0
 5150 RETURN
