 6580 '*********
 6590 '* EDIT  *
 6600 '*********
 6620 *ED_SET
 6630   IF EDIT_FG=1 THEN
 6640     FOR B_ED=70 TO 73:OBJ(B_ED,20)=B_ED:NEXT
 6650     FOR B_ED=75 TO 78:OBJ(B_ED,20)=0:NEXT
 6660     OBJ(10,20)=79:OBJ(20,20)=79:OBJ(10,4)=16,16,,,,,,,1,1:OBJ(20,4)=48,16,,,,,,,1,1
 6670     B_NOB=70:OBJ(B_NOB,4)=64,16:OBJ(B_NOB,20)=79
 6680     EDIT_FG=2:ED_OBJ=1:ED_OBJ2=0:ED_OBJ3=0:ED_OBJ4=0
 6690     FOR X=0 TO 63:FOR Y=0 TO 30:CHA=20:PUTCHR 5,(X*2,Y*2),(CHA)*2:PUTCHR 5,(X*2+1,Y*2),(CHA+1)*2:PUTCHR 5,(X*2,Y*2+1),(CHA+2)*2:PUTCHR 5,(X*2+1,Y*2+1),(CHA+3)*2:NEXT :NEXT
 6700   ENDIF
 6710   IF PY>30 THEN OBJ(79,20)=0:OBJ(79,4)=0,70
 6720   IF PY<-30 THEN OBJ(79,20)=0:OBJ(79,4)=0,-70
 6730 RETURN
 6750 *ED_PUT
 6760   IF P=1024 THEN
 6770     X=INT((PX+160+SCROLL_X-4)/16)*2:Y=INT((PY+160+SCROLL_Y-4)/16)*2
 6780     IF ED_OBJ=1 THEN CHA=4:'UP
 6790     IF ED_OBJ=2 THEN CHA=8:'DOWN
 6800     IF ED_OBJ=3 THEN CHA=16:'LEFT
 6810     IF ED_OBJ=4 THEN CHA=12:'RIGHT
 6820     IF ED_OBJ=5 THEN OBJ(11,20)=0:OBJ(11,4)=INT(PX),INT(PY):ED_START=1
 6830     IF ED_OBJ=6 THEN OBJ(21,20)=0:OBJ(21,4)=INT(PX),INT(PY):ED_END=1
 6840     IF ED_OBJ=7 THEN CHA=24:START,END
 6850     IF ED_OBJ=70 THEN OBJ(30+ED_OBJ2,4)=INT(PX),INT(PY):OBJ(30+ED_OBJ2,20)=0:ED_OBJ2=ED_OBJ2+1:IF ED_OBJ2>9 THEN ED_OBJ2=0
 6860     IF ED_OBJ=71 THEN OBJ(30+ED_OBJ2,4)=INT(PX),INT(PY):OBJ(30+ED_OBJ2,20)=0:ED_OBJ2=ED_OBJ2+1:IF ED_OBJ2>9 THEN ED_OBJ2=0
 6870     IF ED_OBJ=72 THEN OBJ(30+ED_OBJ2,4)=INT(PX),INT(PY):OBJ(30+ED_OBJ2,20)=0:ED_OBJ2=ED_OBJ2+1:IF ED_OBJ2>9 THEN ED_OBJ2=0
 6880     IF ED_OBJ=100 THEN OBJ(100+ED_OBJ3,4)=INT(PX),INT(PY):OBJ(100+ED_OBJ3,20)=0:ED_OBJ3=ED_OBJ3+5:IF ED_OBJ3>15 THEN ED_OBJ3=0
 6890     IF ED_OBJ=140 THEN OBJ(140+ED_OBJ4,4)=INT(PX),INT(PY):OBJ(140+ED_OBJ4,20)=0:ED_OBJ4=ED_OBJ4+1:IF ED_OBJ4>9 THEN ED_OBJ4=0
 6900       PUTCHR 5,(X*2,Y*2),(CHA)*2:PUTCHR 5,(X*2+1,Y*2),(CHA+1)*2:PUTCHR 5,(X*2,Y*2+1),(CHA+2)*2:PUTCHR 5,(X*2+1,Y*2+1),(CHA+3)*2
 6910    ENDIF
 6920    IF P=2048 THEN
 6930      CHA=20:PUTCHR 5,(X*2,Y*2),(CHA)*2:PUTCHR 5,(X*2+1,Y*2),(CHA+1)*2:PUTCHR 5,(X*2,Y*2+1),(CHA+2)*2:PUTCHR 5,(X*2+1,Y*2+1),(CHA+3)*2
 6940    ENDIF
 6950 RETURN
 6970 *ED_CHO
 6980    IF ABS(OBJ(10,4)-PX)<16 AND ABS(OBJ(10,5)-PY)<16 THEN
 6990      IF ED_OBJ<=6 THEN ED_OBJ=ED_OBJ+1
 7000      IF ED_OBJ=7 OR ED_OBJ<=0 THEN ED_OBJ=1
 7010    ENDIF
 7020 RETURN
 7040 *ED_SVLD
 7050   IF ED_SAVE=1 THEN
 7060     FOR X=0 TO 63
 7070       FOR Y=0 TO 30
 7080         ED_CHR=GETCHR(5,X,Y)
 7090         BG_CHR(X,Y)=ED_CHR
 7100       NEXT
 7110     NEXT
 7120       BG_CHR(11,100)=OBJ(11,20):BG_CHR(11,101)=OBJ(11,4):BG_CHR(1,102)=OBJ(11,5)
 7130       BG_CHR(21,100)=OBJ(21,20):BG_CHR(21,101)=OBJ(21,4):BG_CHR(2,102)=OBJ(11,5)
 7140     FOR X=100 TO 119
 7150       BG_CHR(X,100)=OBJ(X,20):BG_CHR(X,101)=OBJ(X,4):BG_CHR(X,102)=OBJ(X,5)
 7160     NEXT
 7170     FOR X=140 TO 149
 7180       BG_CHR(X,100)=OBJ(X,20):BG_CHR(X,101)=OBJ(X,4):BG_CHR(X,102)=OBJ(X,5)
 7190     NEXT
 7200     ED_SAVE=0
 7210   ENDIF
 7220   IF ED_LOAD=1 THEN
 7230     FOR X=0 TO 63
 7240       FOR Y=0 TO 30
 7250         PUTCHR 5,(X,Y),BG_CHR(X,Y)
 7260       NEXT
 7270     NEXT
 7280       OBJ(11,20)=BG_CHR(11,100):OBJ(11,4)=BG_CHR(11,101):OBJ(11,5)=BG_CHR(1,102)
 7290       OBJ(21,20)=BG_CHR(21,100):OBJ(21,4)=BG_CHR(21,101):OBJ(11,5)=BG_CHR(2,102)=
 7300     FOR X=100 TO 119
 7310       OBJ(X,20)=BG_CHR(X,100):OBJ(X,4)=BG_CHR(X,101):OBJ(X,5)=BG_CHR(X,102)
 7320     NEXT
 7330     FOR X=140 TO 149
 7340       OBJ(X,20)=BG_CHR(X,100):OBJ(X,4)=BG_CHR(X,101):OBJ(X,5)=BG_CHR(X,102)
 7350     NEXT
 7360     ED_LOAD=0
 7370   ENDIF
 7380 RETURN
