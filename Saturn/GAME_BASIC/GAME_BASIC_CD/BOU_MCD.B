 5170 '******SUB_MAIN JUD
 5190 *SUB_JUD
 5200   FOR TI_OK=90 TO 93
 5210     IF ABS(PX-OBJ(TI_OK,4))<32 AND ABS(OBJ(TI_OK,5)-PY)<32 AND POP=1 AND OBJ(TI_OK,20)=0 THEN
 5220       FOR IJ=0 TO 2000 STEP 5:OBJ(TI_OK,10)=XSIN(IJ),,(2000-IJ)/1000,(2000-IJ)/1000:NEXT
 5230     ENDIF
 5240     IF ABS(PX-OBJ(TI_OK,4))<32 AND ABS(OBJ(TI_OK,5)-PY)<32 AND POST=1 AND OBJ(TI_OK,20)=0 THEN
 5250       IF TI_OK<>93 THEN
 5260         MAP_NO=TI_OK-89
 5270         STARTFG=-1
 5280       ELSE
 5290         EDIT_FG=1
 5300       ENDIF
 5310     ENDIF
 5320   NEXT
 5330  ' IF ABS(PX-OBJ(80,4))<32 AND ABS(OBJ(80,5)-PY)<32 AND POP=1 AND OBJ(80,20)=0 THEN
 5340  '  IF WIN_X=1 THEN
 5350  '   FOR WIN=WIN_X TO .1 STEP -.001
 5360  '     OBJ(80,12)=WIN,WIN
 5370  '     OBJ(81,12)=0.5*WIN,0.21*WIN
 5380  '     OBJ(82,12)=0.5*WIN,0.21*WIN
 5390  '     OBJ(82,4)=-100*WIN^2
 5400  '     OBJ(83,12)=WIN,WIN
 5410  '     OBJ(84,12)=WIN,WIN
 5420  '   NEXT
 5430  '   WIN_X=.1:WIN_Y=.1
 5440  '  ELSE
 5450  '   FOR WIN=WIN_X TO 1 STEP .001
 5460  '     OBJ(80,12)=WIN,WIN
