 1470 *FADE
 1480 IF (FADE>0 AND F>0) OR (FADE<-255 AND F<0) THEN
 1490   INTERVAL (0) OFF
 1500   F=0
 1510 ELSE
 1520   COLOROFS (FADE,FADE,FADE)
 1530   FADE=FADE+F
 1540 ENDIF
 1550 RETURN
