LOAD"COM:DUMMY"
1000 ' GAME BASIC for SEGASATURN Sound Sample Program Ver 1.1
1001 ' [ S_TUBASA.B ]
1002 ' Programmed by Yukihiro Ninagawa
1003 '               Naozumi Honma (nao)
1004 '
1006 SCREEN 0: SKCLOSE         :'Initialize screen, Close software keyboard
1007 CLEAR 10,1360:IF PEEK(0,3)<>78 THEN KLOAD ON:CLEAR 10,1360:POKE 0,0,56:POKE 0,1,1:POKE 0,2,17:POKE 0,3,78:POKE 0,4,11:POKE 0,5,1
1008 WIDTH 1,1,38,26:CLS -1
1010 PRINT "[TSU BA SA]"
1020 PRINT " Just a moment..."
1021 PROG$="***** MUSIC COMPOSER : TWO FIVE / Noriyuki Iwadare ***** MML Programed by Yukihiro Ninagawa ***** Sound System Programed by Naozumi Honma (nao) / Bits Laboratory ***** BASIC Main System Programed by Motoyuki Kanayama (motos)"
1022 PROG$=PROG$+" / Bits Laboratory ***** Special Thanks - Yukihiro Yoshida *****"
1023 Q$=SPACE$(40)+PROG$+SPACE$(300):QCUT=1
1124 ON INTERVAL (1) GOSUB *DISP_COPYRIGHT
1125 ON MMLSTAT GOSUB *WORD
1030 IF PEEK(0,5)=1 THEN PLAYINIT "DSP","TSUBASA",1 ELSE PLAYINIT "DSP",1:RESTORE *TONE_SET:TARG READ:GOSUB *TONE_EDIT
1060 RESTORE *MUSIC:SETSONG 1
1070 COLOROFS (0,0,0):COLOROFS ON,0
1080 TI=0:WO=1:EF=0:DIM PL(15,2)
1090 RESTORE *WORD_PALLETE
1100 FOR PLSET=0 TO 15
1110 READ PR,PG,PB
1120 PL(PLSET,0)=PR
1130 PL(PLSET,1)=PG
1140 PL(PLSET,2)=PB
1150 NEXT PLSET
1160 CLS:BGM :VSYNC 2
1165 '-------------------------
1170 *LOOP
1190 IF EF=1 THEN INTERVAL (1) OFF:SCREEN 0:PRINT "Loading S_G_ARTS.B":LOAD "CD:S_G_ARTS",R
1191 IF INKEY$="" AND PAD(0,2)=0 THEN *LOOP ELSE PLAYSTOP 0:INTERVAL (1) OFF:SCREEN 0:PRINT "Loading S_G_ARTS.B":LOAD "CD:S_G_ARTS",R
1200 '-------------------------
1210 *WORD
1220 ST=MMLSTAT(0,0)
1230 ON ST GOSUB *W_WRITE,*W_FADEIN,*W_FADEOUT,*W_TITLE,*MUSIC_STOP
1240 RETURN
1250 *W_WRITE
1260 READ X,Y,W$
1270 FOR WP=0 TO 15
1280 KPRINT (X,Y),W$,RGB(PL(WP,0),PL(WP,1),PL(WP,2))
1290 VSYNC
1300 NEXT WP
1310 RETURN
1320 *W_FADEIN
1330 ON WO GOSUB *W1,*W2,*W3,*W4
1340 COLOROFS (-255,-255,-255)
1350 *WORD_READ
1360 READ X,Y,W$
1370 IF W$="END" THEN *FI
1380 KPRINT (X,Y),W$,RGB(PL(0,0),PL(0,1),PL(0,2))
1390 GOTO *WORD_READ
1400 *FI
1410 FOR FI=255 TO 0 STEP -4
1420 COLOROFS (-FI,-FI,-FI)
1430 VSYNC
1440 NEXT FI
1450 ON WO GOSUB *W1,*W2,*W3,*W4
1460 WO=WO+1
1470 RETURN
1480 *W1
1490 RESTORE *WORD_1
1491 INTERVAL (1) ON,1
1500 RETURN
1510 *W2
1520 RESTORE *WORD_2
1530 RETURN
1540 *W3
1550 RESTORE *WORD_3
1560 RETURN
1570 *W4
1580 RESTORE *WORD_4
1590 RETURN
1600 *W_FADEOUT
1610 FOR FO=0 TO 255 STEP 4
1620 COLOROFS (-FO,-FO,-FO)
1630 VSYNC
1640 NEXT FO
1650 CLS 0
1660 RETURN
1670 *W_TITLE
1680 IF TI=0 THEN RESTORE *WORD_OPENING
1690 IF TI=2 THEN COLOROFS (0,0,0)
1700 IF TI=6 THEN RESTORE *WORD_ENDING:COLOROFS (0,0,0)
1710 READ X,Y,W$,SC
1720 FOR WCL=0 TO 31
1730 KPRINT (X,Y),W$,RGB(WCL,WCL,WCL),SC
1740 VSYNC
1750 NEXT WCL
1760 TI=TI+1
1770 RETURN
1780 *MUSIC_STOP
1790 EF=1:SCREEN 0
1800 RETURN
