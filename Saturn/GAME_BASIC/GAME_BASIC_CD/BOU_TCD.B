 1000 '--------------------------------------
 1010 '  BOU 1.03   OBJSET
 1020 '  
 1030 '  Programed by Script Arts.Co.,Ltd.
 1035 '               Keita Kobayashi
 1040 '--------------------------------------
 1045 '1998/3/19
 1050 '*********************
 1060 '* µÌÞ¼Þª¸Ä Ä³Û¸     *
 1070 '*********************
 1080 SCREEN 0,4,256,2:SKCLOSE
 1090 CLEAR,600
 1100 LOCATE 10,10:PRINT "LET'S TRY..."
 1110 PLAYINIT "STANDARD"
 1120 COLOROFS ON 10:COLOROFS (-255,-255,-255)
 1130 GOSUB *OBJ_SET
 1140 GOSUB *BG_SET
 1150 '
 1160 LOAD "CD:BOU_MCD.B",R
 1170 END
 1180 '
 1190 '**********BG É ¾¯Ä
 1210 *BG_SET
 1220    ACTIVE 5
 1230    RESTORE *BG
 1240    'tail 1gunjou 2tya 3hai
 1250    FOR CHA=1 TO 3 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1260    'up
 1270    FOR CHA=4 TO 7 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1280    'down
 1290    FOR CHA=8 TO 11 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1300    'right
 1310    FOR CHA=12 TO 15 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1320    'left
 1330    FOR CHA=16 TO 19 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1340    'PLUS
 1350    FOR CHA=20 TO 23 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1360    'GRAY
 1370    FOR CHA=24 TO 27 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1380    'HAI
 1390    FOR CHA=28 TO 31 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1400    'MAINA
 1410    FOR CHA=32 TO 35 STEP 1:SETCHR 5,CHA,1,READ :NEXT
 1420    CHR_MAX=CHA
 1430 RETURN
 1440 '*********OBJ É Ä³Û¸**********
 1460 *OBJ_SET
 1470    '
 1480    RESTORE *S1
 1490    DIM SNAME$(255),SX(255),SY(255),SC(255)
 1500    '*LOOP:READ TEXNAME$:PRINT TEXNAME$:SNAME$(I)=TEXNAME$
 1520 *LOOP:READ TEXNAME$:SNAME$(I)=TEXNAME$
 1530    IF TEXNAME$="@ENDDATA" THEN GOTO *ZAP1
 1540    READ TEX_X,TEX_Y,TEX_COL:SX(I)=TEX_X:SY(I)=TEX_Y:SC(I)=TEX_COL
 1550    ' PRINT TEX_X,TEX_Y,TEX_COL:SETTEX,TEX_X,TEX_Y,TEX_COL,READ
 1560    SETTEX,TEX_X,TEX_Y,TEX_COL,READ
 1570    IF I=16-1 OR I=18-1 THEN
 1580      SETVERTEX,4,(0,-TEX_Y/2,0),(TEX_X,-TEX_Y/2,0),(TEX_X,TEX_Y/2,0),(0,TEX_Y/2,0)
 1590    ELSE
 1600      IF I=17-1 OR I=19-1 THEN
 1610        SETVERTEX,4,(-TEX_X,-TEX_Y/2,0),(0,-TEX_Y/2,0),(0,TEX_Y/2,0),(-TEX_X,TEX_Y/2,0)
 1620      ELSE
 1630        IF I=12-1 THEN
 1640           SETVERTEX,4,(-TEX_X+5,-TEX_Y/2,0),(5,-TEX_Y/2,0),(5,TEX_Y/2,0),(-TEX_X+5,TEX_Y/2,0)
 1650        ELSE
 1660           SETVERTEX,4,(-TEX_X/2,-TEX_Y/2,0),(TEX_X/2,-TEX_Y/2,0),(TEX_X/2,TEX_Y/2,0),(-TEX_X/2,TEX_Y/2,0)
 1670        ENDIF
 1680      ENDIF
 1690    ENDIF
 1700    SETPOLYGON,1,I,,(0,1,2,3)
 1710    IF I>=31 THEN
 1720      SETATR,1,(0,1,3,I,256,0)
 1730    ELSE
 1740      SETATR,1,(0,1,3,I,0,0)
 1750    ENDIF
 1760    I=I+1:READ A$
 1780 *ZAP
 1790    GOTO *LOOP
 1800    '
 1810    '
 1830 *ZAP1
 1840    FOR TEX_NO=60 TO 69
 1850      SETTEX TEX_NO,64,32,256
 1860      SETVERTEX TEX_NO,4,(0,-90,0),(180,-90,0),(180,90,0),(0,90,0)
 1870      SETPOLYGON TEX_NO,1,TEX_NO,,(0,1,2,3)
 1880      SETATR TEX_NO,1,(0,1,3,TEX_NO,0,0)
 1890    NEXT
 1900    RESTORE *S2:FOR J=0 TO 255:READ R,G,B:PALETTE 10,J,RGB(R*31/255,G*31/255,B*31/255):NEXT
 1910    RESTORE *PL2:FOR J=256 TO 511:READ R,G,B:PALETTE 10,J,RGB(R*31/255,G*31/255,B*31/255):NEXT
 1920    RESTORE *BGPL
 1930    FOR J=0 TO 255:READ R,G,B:PALETTE 5,J,RGB(R*31/255,G*31/255,B*31/255):NEXT
 1940   RETURN
 1950 'SPRITE
 1960 '1-11:tama  12:ya 13:ryoute 14,15:karasu 16,17:ude 18:hidarite 19:migite 20:kao
 1970 '21-24:tailu 25:tama 26-27:hako 28:ya 29:saru 30:pannda 31:gorira
 1980 'OBJ
 1990 '1:PAD 2-
