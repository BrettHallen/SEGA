 1970 '
 1980 *OP_OB
 1990  CAMERA (C_X,C_Y,C_Z) TO TARGET_OBJ
 2000  R_X=R_X+DR_X
 2010 RETURN
 2020 '********∫›ƒ€∞Ÿ ﬂØƒﬁ… ›√≤
 2030 *GPAD:LOCK
 2040   'PRINT C_X;C_Y;C_Z;CC_X;TARGET_OBJ
 2050   IF OPENDFG=0 THEN CAMERA (CC_X,CC_Y,C_Z) TO TARGET_OBJ
 2060   P=PAD(0,1)
 2070   IF P<>0 THEN GOTO *OP_END3
 2080 RETURN
 2090 '
