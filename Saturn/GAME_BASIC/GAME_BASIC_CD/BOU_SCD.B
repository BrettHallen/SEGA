  150 '**************
  160 '* µ∞Ãﬂ∆›∏ﬁ   *
  170 '**************
  180 SKCLOSE
  185 SCREEN 0:CLEAR:KLOAD ON
  190 PLAYINIT "STANDARD"
  191 *P_LOOP
  192 P=PAD(0,0) 
  193 IF P=37 OR P=&HE3 THEN GOTO *START
  194   KPRINT (16,32),"ÉoÅ[É`ÉÉÉKÉìÇ©ÉVÉÉÉgÉãÉ}ÉEÉX"
  195   KPRINT (16,48),"Çê⁄ë±ÇµÇƒÇ≠ÇæÇ≥Ç¢"
  196 VSYNC
  197 GOTO *P_LOOP
  198 *START
  199 SCREEN 0,,,-1:KLOAD OFF
  200 COLOROFS ON
  210 COLOROFS ON 10
  220 COLOROFS (-255,-255,-255)
  230 'GOSUB *SUB5
  240 GOSUB *OP_GRAPHIC
  250 GOSUB *OP_OBJSET
  260 '
  270 TARGET_OBJ=35
  280 ON INTERVAL (0) GOSUB *GPAD
  290 INTERVAL (0) ON,1
  300 '
  310 *OP_LOOP
  320 GOSUB *OP_MOVE
  330 IF (FFG=1 AND PAD(15,1)=0) OR OP_ENDFG=1 THEN GOTO *OP_END
  340 GOTO *OP_LOOP
  350 *OP_END
  360 'VSYNC 120
  361 OPENDFG=1
  370 CC_Y=C_Y
  371   DXX=-OBJ(35,4)/10000
  372   DYY=-OBJ(35,5)/10000
  373   XXX=OBJ(35,4)
  374   YYY=OBJ(35,5)
  380 FOR CC_X=C_X TO 0 STEP -C_X/10000
  390     CC_Y=CC_Y-C_Y/10000
  430   XXX=XXX+DXX
  431   YYY=YYY+DYY
  440       CAMERA (CC_X,CC_Y,C_Z) TO (XXX,YYY,0)
  450       IF ABS(CC_X)<.01 THEN GOTO *OP_END2
  460 NEXT
  480 *OP_END2
  490 VSYNC 120
  500 FOR N=0 TO 5100
  510    CAMERA (XSIN(N/10000)*XCOS(N/10000)*300,XSIN(N/10000)*XSIN(N/10000)*300,C_Z-N/10) TO (0,0,0)
  520    LN=-N/20:COLOROFS (LN,LN,LN)
  530 '
  540    IF N>2000 AND RND(4)=1 THEN
  550      RND_OBJ=RND(60)+1
  560      IF OBJ(RND_OBJ,36)=0 THEN OBJ(RND_OBJ,24)=RND(16)*(.5-RND(2)),RND(16)*(.5-RND(2)),RND(32)*(.5-RND(2)):OBJ(RND_OBJ,36)=(RND(100)+1)/1000,RND(101)/1000,RND(101)/1000
  570    ENDIF
  580 '
  590 '
  600 NEXT
  610 *OP_END3
  620 FOR N=1 TO 70:OBJ(N,20)=N:NEXT
  630 VSYNC 3:COLOROFS OFF
  640 LOCATE 10,10:PRINT "NOW LOADING......."
  650 'RUN :END :'LOAD "CD:BOU_TCD.B",R
  660 LOAD "CD:BOU_TCD.B",R
  670 '***************
  680 '
  690 '
  700 '*************************
  710 '* µ∞Ãﬂ∆›∏ﬁ ∂›π≤         *
  720 '*************************
  730 *OP_MOVE
  740  GOSUB *OP_COL
  750  GOSUB *OP_OB
  760  GOSUB *OP_CA
  770 RETURN
  780 '
  790 *OP_COL
  800  IF OP_ENDFG=2 THEN OP_VS=OP_VS+1:GOSUB *OP_COL1
  810  IF DDCOL1=0 THEN DDCOL1=(RND(50)+50)/75:DCOL1=-255
  820  IF DDCOL2=0 THEN DDCOL2=(RND(50)+50)/75:DCOL2=-255
  830  IF DDCOL3=0 THEN DDCOL3=(RND(50)+50)/75:DCOL3=-255
  840  DCOL1=DCOL1+DDCOL1
  850  DCOL2=DCOL2+DDCOL2
  860  DCOL3=DCOL3+DDCOL3
  870  IF DCOL1>=0 THEN DCOL1=0
  880  IF DCOL2>=0 THEN DCOL2=0
  890  IF DCOL3>=0 THEN DCOL3=0
  900  COLOROFS (DCOL1,DCOL2,DCOL3)
  910 ' IF DCOL1+DCOL2+DCOL3>=0 THEN OP_ENDFG=2
  920 *OP_COL1
  930  IF OP_VS>30 THEN OP_ENDFG=0
  940 RETURN
  950 *OP_OBJSET
  960  IF OM=0 THEN OM=1:DIM A(80):DIM B(80):DIM C(80):DIM OB(100,10)
  970  X=0:Y=0
  980  OP_OBJMAX=60
  990  IF X=0 THEN X=-144:Y=-95
 1000  FOR OP_K=1 TO OP_OBJMAX
 1010   OBJ(OP_K,0)=4,,,,,,,,,,,,,,,,,,,,0
 1020   OB(OP_K,4)=X:OB(OP_K,5)=Y:OB(OP_K,6)=0
 1030   X=X+32:IF X=176 THEN X=-144:Y=Y+38
 1040  NEXT
 1050 RETURN
 1060 *OP_GRAPHIC
 1070  GOSUB *OP_GR
 1080 RETURN
 1090 '
 1100 '
 1110 '***********************
 1120 '* OPENING CAMERA WORK *
 1130 '***********************
 1140 '    C_X,C_Y,C_Z   ∂“◊…≤¡
 1150 '    CN_X,CN_Y,CN_Z   ∂“◊ ªﬁÀÆ≥ … øﬁ≥∂¡
 1160 '    CD_X,CD_Y,CD_Z   ª≤º≠≥ µÃﬁºﬁ™ … ≤¡
 1170 '    C_N    Ãﬁ›∂¬Ω≥
 1180 '
 1190 *OP_CA
 1200  IF OPC=0 THEN
 1210    TARGET_OBJ=35
 1220   ' C_X=100:C_Y=0 :C_Z=-215 :OPC=1
 1230    CC_X=C_X
 1240    C_X=RND(600)*(.5-RND(2)):C_Y=RND(600)*(.5-RND(2)) :C_Z=-215 :OPC=1
 1260    CC_X=C_X:CC_Y=C_Y
 1270    CD_X=0:CD_Y=0:CD_Z=-200
 1280    C_N=3000:CD_N=0
 1290    GOSA=500
 1300    ROT_ERR=.8
 1310    END_ROT=.003
 1320    CN_X=(CD_X-C_X)/C_N:CN_Y=(CD_Y-C_Y)/C_N:CN_Z=(CD_Z-C_Z)/C_N
 1330    CDR_N=1/C_N
 1340    DR_X=3.1416/C_N
 1350    FOR OBJ_NUM=1 TO 60
 1360      OB(OBJ_NUM,7)=RND(8880)*(.5-RND(2))
 1370      OB(OBJ_NUM,8)=RND(8880)*(.5-RND(2))
 1380      OB(OBJ_NUM,9)=RND(8880)*(.5-RND(2))
 1390      OBJ(OBJ_NUM,4)=OB(OBJ_NUM,7)
 1400      OBJ(OBJ_NUM,5)=OB(OBJ_NUM,8)
 1410      OBJ(OBJ_NUM,6)=OB(OBJ_NUM,9)
 1420      OBJ(OBJ_NUM,24)=(OB(OBJ_NUM,4)-OB(OBJ_NUM,7))/GOSA
 1430      OBJ(OBJ_NUM,25)=(OB(OBJ_NUM,5)-OB(OBJ_NUM,8))/GOSA
 1440      OBJ(OBJ_NUM,26)=(OB(OBJ_NUM,6)-OB(OBJ_NUM,9))/GOSA
 1450      OBJ(OBJ_NUM,36)=(RND(22)+10)/700
 1460      OBJ(OBJ_NUM,37)=(RND(22)+10)/700
 1470      OBJ(OBJ_NUM,38)=(RND(22)+10)/700
 1480    NEXT
 1490  ENDIF
 1500  IF ABS(OBJ(2,4)-OB(2,4))>=16 OR ABS(OBJ(1,4)-OB(1,4))>=16 THEN
 1510    CD_N=CD_N+1
 1520  ELSE
 1530    FOR OBJ_NUM=1 TO 60
 1540 '     OBJ(OBJ_NUM,4)=OB(OBJ_NUM,4),OB(OBJ_NUM,5),OB(OBJ_NUM,6)
 1550      OBJ(OBJ_NUM,24)=0,0,0
 1560      OBJ(OBJ_NUM,4)=OB(OBJ_NUM,4),OB(OBJ_NUM,5),OB(OBJ_NUM,6)
 1570    NEXT
 1580    FOR COUNT=1 TO 120
 1590    FOR OBJ_NUM=1 TO 60
 1600     IF A(OBJ_NUM)=0 AND ABS(INT(OBJ(OBJ_NUM,8)/2)-OBJ(OBJ_NUM,8)/2)<ROT_ERR THEN OBJ(OBJ_NUM,36)=0:OBJ(OBJ_NUM,8)=0:A(OBJ_NUM)=1
 1610     IF B(OBJ_NUM)=0 AND ABS(INT(OBJ(OBJ_NUM,9)/2)-OBJ(OBJ_NUM,9)/2)<ROT_ERR THEN OBJ(OBJ_NUM,37)=0:OBJ(OBJ_NUM,9)=0:B(OBJ_NUM)=1
 1620     IF C(OBJ_NUM)=0 AND ABS(INT(OBJ(OBJ_NUM,10)/2)-OBJ(OBJ_NUM,10)/2)<ROT_ERR THEN OBJ(OBJ_NUM,38)=0:OBJ(OBJ_NUM,10)=0:C(OBJ_NUM)=1
 1630     IF A(OBJ_NUM)+B(OBJ_NUM)+C(OBJ_NUM)=3 THEN
 1640      FOR COL=RND(255)+1 TO 0 STEP -1:COLOROFS (COL,COL,COL):NEXT
 1650      A(OBJ_NUM)=2
 1660      ROT_JUD=ROT_JUD+1
 1670     ENDIF
 1680    NEXT
 1690      IF ROT_JUD=60 THEN GOTO *ROT_END
 1700    NEXT
 1710 *ROT_END
 1720 '   FOR OBJ_NUM=1 TO 60:OBJ(OBJ_NUM,36)=END_ROT:NEXT
 1730 '   FOR OBJ_NUM=1 TO 60:OBJ(OBJ_NUM,37)=END_ROT:NEXT
 1740 '   FOR OBJ_NUM=1 TO 60:OBJ(OBJ_NUM,38)=END_ROT:NEXT
 1750    FOR OBJ_NUM=1 TO 60:A(OBJ_NUM)=0:NEXT
 1760    FOR OBJ_NUM=1 TO 60:B(OBJ_NUM)=0:NEXT
 1770    FOR OBJ_NUM=1 TO 60:C(OBJ_NUM)=0:NEXT
 1780    OPC=0:ROT_JUD=0
 1790    COLL=8.2258:  FOR COL=255 TO 0 STEP -2.5:COLOROFS (COL,COL,COL):COLOR,,,RGB((COL)/COLL,(COL)/COLL,(COL)/COLL):VSYNC :NEXT
 1800 '   COLL=8.2258:  FOR COL=0 TO -255 STEP -5:COLOROFS (COL,COL,COL):VSYNC :NEXT
 1810  GOTO *OP_END
 1820 '  IF PAD(15,1)=0 THEN FFG=1 ELSE RUN
 1830 '   GOSUB *OP_OBJSET
 1840    FOR OBJ_NUM=1 TO 60:OBJ(OBJ_NUM,36)=0:NEXT
 1850    FOR OBJ_NUM=1 TO 60:OBJ(OBJ_NUM,37)=0:NEXT
 1860    FOR OBJ_NUM=1 TO 60:OBJ(OBJ_NUM,38)=0:NEXT
 1870  ENDIF
 1880 RETURN
 1890 '
