 2130 *OP_GR
 2140 '
 2150 SETDISP 3
 2160 RESTORE *START_DATA
 2170 READ PT,SF,N  :'í∏ì_êî, ñ êîì«Ç›çûÇ›
 2180 'READ N   :'ÉeÉNÉXÉ`ÉÉêîì«Ç›çûÇ›
 2190 IF N<1 GOTO *SKIP1
 2200 X1=32:Y1=38             :'√∏Ω¡¨∞ … µµ∑ª
 2210 FOR I=1 TO N
 2220 '  READ X1,Y1  :'ÉeÉNÉXÉ`ÉÉÉTÉCÉYì«Ç›çûÇ›
 2230   SETTEX I,X1,Y1,256,READ
 2240 NEXT
 2250 *SKIP1
 2260 '
 2270 RESTORE *PAL_DATA2:FOR J=0 TO 255:READ R,G,B:PALETTE 10,J,RGB(R*31/255,G*31/255,B*31/255):NEXT
 2280 '
 2290 FOR I=1 TO N
 2300  RESTORE *VER_DATA
 2310  SETVERTEX I,PT,READ
 2320  SETPOLYGON I,SF,I,READ
 2330  SETATR I,SF,(0, 0, 2, I, &H0, 8),(0, 0, 2, I, &H0, 8),(0, 0, 2, I, &H0, 8),(0, 0, 2, I, &H0, 8),(0, 0, 2, I, &H0, 8),(0, 0, 2, I, &H0, 8)
 2340 *SKIP2
 2350  OBJ(I,0)=4:OBJ(I,16)=I,I
 2360  OBJ(I,61)=X1/2
 2370 ' OBJ(I,36)=0.02-RND(5)/100,0.02-RND(5)/100,0.02-RND(5)/100
 2380 NEXT
 2390 '
 2400 RETURN
