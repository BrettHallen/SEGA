  100 CLEAR,400
  101 DIM CST$(24),SCD$(3,4)
  110 DIM OFX(20),OFY(20),OFZ(20),PAR(20)
  115 DIM R(3,20,200),BP(3,200)
  116 DIM PLNUM(20)
  117 DIM FT(200)
  200 SCREEN 0
  300 PP1 = 1:PP2 = 1:FRPOS = 1:VDIF = 4
  310 FRMAX = 200
  400 FOR I=1 TO 19
  401 READ CST$(I)
  402 NEXT
  410 FOR I=20 TO 23
  411 READ CST$(I),SCD$(1,I-19),SCD$(2,I-19),SCD$(3,I-19)
  412 NEXT
 1002 '----------------------------------
 1003 'Object Item Number
 1004 TYPE = 0: FLAG = 1
 1005 XP = 4: XR = 8: XS = 12
 1006 ATR = 16: POLYGON = 17: ORDER = 18
 1007 PARENT = 20: CHILD = 21
 1008 XV = 24: XA = 28: XL = 32: XRV= 36
 1009 '----------------------------------
 1800 FOR I=1 TO FRMAX:BP(1,I)=0:BP(2,I)=0:BP(3,I)=0:FT(I)=20:NEXT
 1810 PLNUM(1)=36
 1900 SETVERTEX 1,144,READ,(2,10,2)
 2000 FOR I=2 TO 18
 2010 READ VN
 2020 READ OFX(I),OFY(I),OFZ(I),PAR(I)
 2030 SETVERTEX  I,VN,READ,(10,10,10,-10*OFX(I),-10*OFY(I),-10*OFZ(I))
 2040 NEXT
 2900 OBJ(0,XP) = 0,0,900
 2910 SETPOLYGON 1,36,1,READ
 2920 SETATR 1,36,(4,1,3,0,7399,8)
 2930 OBJ(1,TYPE) = 4
 2931 OBJ(1,ATR)  = 1,1
 2932 OBJ(1,XP  ) = 0,300,0
 3000 FOR I=2 TO 18
 3010 READ PLNUM(I)
 3020 SETPOLYGON I,PLNUM(I),I,READ
 4010 SETATR I, PLNUM(I),(4, 1, 3, 0, 15855, 8)
 4013 OBJ(I,ATR)  = I,I
 4014 OBJ(I,TYPE) = 4 :' POLYGON
 4015 OBJ(I,XRV) = 0,0,0
 4016 OBJ(I,XP) = (OFX(I)-OFX(PAR(I)))*10,(OFY(I)-OFY(PAR(I)))*10,(OFZ(I)-OFZ(PAR(I)))*10
 4017 OBJ(I,XR) = 0,0,0
 4018 OBJ(I,PARENT) = PAR(I)
 4020 OBJ(I,ORDER) = 2
 4050 NEXT
 4060 FOR J=1 TO FRMAX:R(3,1,J)=500:NEXT
 4065 OBJ(0,XRV)=0,0,0
 4070 *POSLOOP
 4080 GOSUB *GETPADV
 4081 GOSUB *COLCNG
 4090 GOSUB *MOVANGL
 4100 GOTO *POSLOOP
 5000 *MOVANGL
 5010 FOR I=1 TO 18
 5020 OBJ(I,XR) = R(1,I,FRPOS)/1000,R(2,I,FRPOS)/1000,R(3,I,FRPOS)/1000
 5030 NEXT
 5031 OBJ(2,XP) = BP(1,FRPOS),BP(2,FRPOS)+535.4331,BP(3,FRPOS)+15.748
 5040 LOCATE 1,1:PRINT CST$(PP2);
 5050 IF PP1 = 1 THEN COLOR 6 ELSE COLOR 7
 5051 IF PP2>1 AND PP2< 20 THEN LOCATE 15,1:PRINT R(1,PP2-1,FRPOS);"   ";
 5052 IF PP2=1 THEN LOCATE 15,1:PRINT BP(1,FRPOS);"   ";
 5053 IF PP2 > 19 THEN LOCATE 15,1:PRINT SCD$(1,PP2-19);
 5060 IF PP1 = 2 THEN COLOR 6 ELSE COLOR 7
 5061 IF PP2>1 AND PP2< 20 THEN LOCATE 22,1:PRINT R(2,PP2-1,FRPOS);"   ";
 5062 IF PP2=1 THEN LOCATE 22,1:PRINT BP(2,FRPOS);"   ";
 5063 IF PP2 > 19 THEN LOCATE 22,1:PRINT SCD$(2,PP2-19);
 5070 IF PP1 = 3 THEN COLOR 6 ELSE COLOR 7
 5071 IF PP2>1 AND PP2< 20 THEN LOCATE 29,1:PRINT R(3,PP2-1,FRPOS);"   ";
 5072 IF PP2=1 THEN LOCATE 29,1:PRINT BP(3,FRPOS);"   ";
 5073 IF PP2 > 19 THEN LOCATE 29,1:PRINT SCD$(3,PP2-19);
 5080 COLOR 7
 5081 LOCATE 1,2:PRINT USING "FR:### STEP:### VDIF:###",FRPOS,FT(FRPOS),VDIF;
 5100 RETURN
 6000 *GETPADV
 6010 P= PAD(0,1)
 6015 IF P=0 THEN POFF = 0
 6016 IF (P AND 16) AND VDIF < 100 THEN VDIF = VDIF + 1
 6017 IF (P AND 64) AND VDIF > 0 THEN VDIF = VDIF - 1
 6020 IF ((P AND 16384) = 16384) AND PP1 > 1 AND POFF = 0 THEN PP1 = PP1 -1 :POFF = 1
 6030 IF ((P AND 32768) = 32768) AND PP1 < 3 AND POFF = 0 THEN PP1 = PP1 +1 :POFF = 1
 6040 IF ((P AND 4096 ) =  4096) AND PP2 > 1 AND POFF = 0 THEN PP2 = PP2 -1 :POFF = 1
 6050 IF ((P AND 8192 ) =  8192) AND PP2 <23 AND POFF = 0 THEN PP2 = PP2 +1 :POFF = 1
 6100 IF (P AND 128) AND PP2>1 AND PP2<20 THEN R(PP1,PP2-1,FRPOS) = R(PP1,PP2-1,FRPOS)+VDIF
 6110 IF (P AND   8) AND PP2>1 AND PP2<20 THEN R(PP1,PP2-1,FRPOS) = R(PP1,PP2-1,FRPOS)-VDIF
 6120 IF (P AND 128) AND PP2 = 1 THEN BP(PP1,FRPOS) = BP(PP1,FRPOS) + VDIF
 6125 IF (P AND   8) AND PP2 = 1 THEN BP(PP1,FRPOS) = BP(PP1,FRPOS) - VDIF
 6150 IF (P AND 512) AND PP2=20 AND PP1=1 THEN GOSUB *FPREV
 6151 IF (P AND 512) AND PP2=20 AND PP1=2 THEN GOSUB *FTIME
 6152 IF (P AND 512) AND PP2=20 AND PP1=3 THEN GOSUB *FNEXT
 6153 IF (P AND 512) AND PP2=21 AND PP1=1 THEN GOSUB *FINS
 6154 IF (P AND 512) AND PP2=21 AND PP1=2 THEN GOSUB *FCOPY
 6155 IF (P AND 512) AND PP2=21 AND PP1=3 THEN GOSUB *FDEL
 6156 IF (P AND 512) AND PP2=22 AND PP1=1 THEN GOSUB *FSAVE
 6157 IF (P AND 512) AND PP2=22 AND PP1=3 THEN GOSUB *FLOAD
 6158 IF (P AND 512) AND PP2=23 AND PP1=1 THEN GOSUB *FPLAY
 6159 IF (P AND 512) AND PP2=23 AND PP1=3 THEN GOSUB *FEND
 6160 IF (P AND 32) THEN GOSUB *WROT
 6200 RETURN
 6210 *WROT
 6211 IF WRFLAG=0 THEN OBJ(0,37)=.001:WRFLAG=1 ELSE OBJ(0,37)=0:OBJ(0,9)=0:WRFLAG=0
 6212 IF PAD(0,1) > 0 THEN GOTO 6212 ELSE RETURN
 6300 *FPREV
 6301 IF FRPOS>1 THEN FRPOS=FRPOS-1
 6302 IF PAD(0,1) = 0 THEN RETURN ELSE GOTO 6302
 6310 *FNEXT
 6311 IF FRPOS<FRMAX-1 THEN FRPOS=FRPOS+1
 6312 IF PAD(0,1) = 0 THEN RETURN ELSE GOTO 6312
 6320 *FTIME
 6321 LOCATE 1,2:PRINT USING "FRAME STEP SET : ###           ",FT(FRPOS);
 6322 IF (PAD(0,1) AND 128) AND FT(FRPOS)<FRMAX-1 THEN FT(FRPOS)=FT(FRPOS)+1
 6323 IF (PAD(0,1) AND   8) AND FT(FRPOS)>1 THEN FT(FRPOS)=FT(FRPOS)-1
 6324 IF (PAD(0,1) AND 1024) THEN GOTO 6330
 6325 VSYNC 5:GOTO 6321
 6330 LOCATE 1,2:PRINT "                              ";
 6335 RETURN
 6400 *FINS
 6401 FOR FI=FRMAX-2 TO FRPOS STEP -1
 6402  FOR FJ=1 TO 20:FOR FK=1 TO 3:R(FK,FJ,FI+1)=R(FK,FJ,FI):NEXT :NEXT
 6403  FOR FJ=1 TO 3:BP(FJ,FI+1)=BP(FJ,FI):NEXT
 6404  FT(FI+1)=FT(FI)
 6405 NEXT
 6410 IF PAD(0,1)=0 THEN RETURN ELSE GOTO 6410
 6420 *FDEL
 6421 FOR FI=FRPOS TO FRMAX-1
 6422  FOR FJ=1 TO 20:FOR FK=1 TO 3:R(FK,FJ,FI)=R(FK,FJ,FI+1):NEXT :NEXT
 6423  FOR FJ=1 TO 3:BP(FJ,FI)=BP(FJ,FI+1):NEXT
 6424  FT(FI)=FT(FI+1)
 6425 NEXT
 6430 IF PAD(0,1) = 0 THEN RETURN ELSE GOTO 6430
 6450 *FCOPY
 6451 CPFR=FRPOS
 6452 LOCATE 1,2:PRINT USING "COPY FROM ###                 ",CPFR;
 6453 IF (PAD(0,1) AND 128) AND CPFR<FRMAX-1 THEN CPFR=CPFR+1
 6454 IF (PAD(0,1) AND   8) AND CPFR>1 THEN CPFR=CPFR-1
 6460 FOR I=1 TO 18
 6461 OBJ(I,XR) = R(1,I,CPFR)/1000,R(2,I,CPFR)/1000,R(3,I,CPFR)/1000
 6462 NEXT
 6463 OBJ(2,XP) = BP(1,CPFR),BP(2,CPFR)+535.4331,BP(3,CPFR)+15.748
 6470 IF (PAD(0,1) AND 1024) THEN GOTO 6500
 6471 VSYNC 7:GOTO 6452
 6500 FOR I=1 TO 18
 6501  FOR CJ=1 TO 3
 6502  R(CJ,I,FRPOS)=R(CJ,I,CPFR)
 6503  NEXT
 6504 NEXT
 6510 FOR CJ=1 TO 3
 6511  BP(CJ,FRPOS)=BP(CJ,CPFR)
 6512 NEXT
 6520 FT(FRPOS)=FT(CPFR)
 6590 RETURN
 6600 *FSAVE
 6601 ON ERROR GOTO *SVERR
 6602 LOCATE 1,2:PRINT "                              ";
 6603 LOCATE 1,2:INPUT "FILENAME:",FL$:IF FL$="" THEN GOTO 6603
 6604 OPEN FL$+".D" FOR OUTPUT AS 1
 6605 FOR I=1 TO FRMAX-1
 6606 FWRITE 1,RIGHT$("   "+STR$(FT(I)),3)
 6607 FWRITE 1,RIGHT$("   "+STR$(BP(1,I)),5)
 6608 FWRITE 1,RIGHT$("   "+STR$(BP(2,I)),5)
 6609 FWRITE 1,RIGHT$("   "+STR$(BP(3,I)),5)
 6610 FOR SJ=1 TO 18
 6611 FOR SK=1 TO 3
 6612 FWRITE 1,RIGHT$("   "+STR$(R(SK,SJ,I)),5)
 6613 NEXT :NEXT
 6614 NEXT
 6615 LOCATE 1,2:PRINT "                              ";
 6616 CLOSE
 6617 ON ERROR GOTO 0
 6640 RETURN
 6641 *SVERR
 6642 LOCATE 1,2:PRINT "SAVE ERROR                    ";
 6643 IF PAD(0,1) = 0 THEN GOTO 6643
 6644 RESUME 6615
 6650 *FLOAD
 6651 ON ERROR GOTO *LDERR
 6652 LOCATE 1,2:PRINT "                              ";
 6653 LOCATE 1,2:INPUT "FILENAME:",FL$:IF FL$="" THEN GOTO 6653
 6654 OPEN FL$+".D" FOR INPUT AS 1
 6655 FOR I=1 TO FRMAX-1
 6656 FREAD #1,D$,3:FT(I)=VAL(D$)
 6657 FREAD #1,D$,5:BP(1,I)=VAL(D$)
 6658 FREAD #1,D$,5:BP(2,I)=VAL(D$)
 6659 FREAD #1,D$,5:BP(3,I)=VAL(D$)
 6660 FOR SJ=1 TO 18
 6661 FOR SK=1 TO 3
 6662 FREAD #1,D$,5:R(SK,SJ,I)=VAL(D$)
 6663 NEXT :NEXT
 6664 NEXT
 6665 LOCATE 1,2:PRINT "                              ";
 6666 CLOSE
 6667 ON ERROR GOTO 0
 6690 RETURN
 6691 *LDERR
 6692 LOCATE 1,2:PRINT "LOAD ERROR                    ";
 6693 IF PAD(0,1) = 0 THEN GOTO 6693
 6694 RESUME 6665
 6700 *FPLAY
 6701 FOR J=1 TO FT(1)
 6702 FOR I=1 TO 18
 6703 OBJ(I,XR) = R(1,I,1)/1000,R(2,I,1)/1000,R(3,I,1)/1000
 6704 NEXT
 6705 OBJ(2,XP) = BP(1,1),BP(2,1)+535.4331,BP(3,1)+15.748
 6706 LOCATE 1,2:PRINT USING "FRAME:  1  STEP:###           ",J;
 6707 NEXT
 6710 EPL = FRPOS:IF EPL=1 THEN EPL = 2
 6711 FOR I=2 TO EPL
 6712  FOR J=1 TO FT(I)
 6713   FOR PR=1 TO 18
 6714   PXR=(R(1,PR,I)-R(1,PR,I-1))*J/FT(I)+R(1,PR,I-1)
 6715   PYR=(R(2,PR,I)-R(2,PR,I-1))*J/FT(I)+R(2,PR,I-1)
 6716   PZR=(R(3,PR,I)-R(3,PR,I-1))*J/FT(I)+R(3,PR,I-1)
 6717   OBJ(PR,XR)=PXR/1000,PYR/1000,PZR/1000
 6718   NEXT
 6719   PXP=(BP(1,I)-BP(1,I-1))*J/FT(I)+BP(1,I-1)
 6720   PYP=(BP(2,I)-BP(2,I-1))*J/FT(I)+BP(2,I-1)
 6721   PZP=(BP(3,I)-BP(3,I-1))*J/FT(I)+BP(3,I-1)
 6722   OBJ(2,XP)=PXP,PYP+535.4331,PZP+15.748
 6723   LOCATE 1,2:PRINT USING "FRAME:###  STEP:###           ",I,J;
 6724  NEXT
 6725 NEXT
 6726 LOCATE 1,2:PRINT "                              ";
 6750 RETURN
 6790 *FEND
 6791 END
