LOAD"COM:DUMMY"
 1000 ' GAME BASIC for SEGASATURN Sound Sample Program Ver 1.1
 1001 ' [ S_ALISIA.B ]
 1002 ' Programmed by Naozumi Honma (nao)
 1003 '               Kanayama Motoyuki (motos) 
 1004 '               Yukihiro Ninagawa
 1005 '
 1006   SCREEN 0: SKCLOSE         :'Initialize screen, Close software keyboard
 1007   CLEAR 10,1360:IF PEEK(0,3)<>78 THEN KLOAD ON:CLEAR 10,1360:POKE 0,0,56:POKE 0,1,1:POKE 0,2,14:POKE 0,3,78:POKE 0,4,11:POKE 0,5,1
 1008   WIDTH 1,1,38,26:PLAYINIT:COLOR ,RGB(31,31,31):COLOROFS ON,0:COLOROFS(-255,-255,-255):VSYNC:OFS=255
 1009 '
 1010   TITLE$="ALISIA DRAGOON"   :'<<< Polygon Title   >>>
 1011   NUM_OF_MSTR=24            :'<<< MENU ｺｳﾓｸ ﾉ ｶｽﾞ >>>
 1012   PROG$="***** MUSIC COMPOSER : MECANO ASSOCIATES ***** MML Programed by Yukihiro Ninagawa ***** Sound System Programed by Naozumi Honma (nao) / Bits Laboratory ***** BASIC Main System Programed by Motoyuki Kanayama (motos)"
 1013   PROG$=PROG$+" / Bits Laboratory ***** Special Thanks - Kenichi Kunishima, Masakuni Mitsuhashi, Tomoyuki Shimada, Yukihiro Yoshida *****"
 1014   Q$=SPACE$(40)+PROG$+SPACE$(300):QCUT=1
 1015   GOTO *START_THIS_PROGRAM
 1016 '
 1017 '---------------- MENU DATA
 1018 *MENU_STR
 1019   DATA " アリシア ドラグーン    (C)GAME ARTS "
 1020   DATA " 1: オープニング                     "
 1021   DATA " 2: STAGE 1-1 森林地帯               "
 1022   DATA " 3: STAGE 1-2 封印の館               "
 1023   DATA " 4: STAGE 1-3 石切り場               "
 1024   DATA " 5: STAGE 2   湿地                   "
 1025   DATA " 6:         < 中ボス 1 >             "
 1026   DATA " 7: STAGE 3   飛行要塞バルンガ       "
 1027   DATA " 8:         < バルンガ内部(未収録曲)>"
 1028   DATA " 9: STAGE 4   岩場                   "
 1029   DATA "10: STAGE 5-1 洞窟                   "
 1030   DATA "11: STAGE 5-2 溶岩洞窟               "
 1031   DATA "12:         < 中ボス 2 >             "
 1032   DATA "13: STAGE 6-1 宇宙船残骸 1           "
 1033   DATA "14: STAGE 6-2 宇宙船残骸 2           "
 1034   DATA "15:         < 宇宙船残骸からの脱出 > "
 1035   DATA "16:         < 空中神殿出現 >         "
 1036   DATA "17: STAGE 7   空中神殿               "
 1037   DATA "18: STAGE 8-1 教祖との戦い           "
 1038   DATA "19: STAGE 8-2 魔王との戦い           "
 1039   DATA "20: エンディング                     "
 1040   DATA "21: ランキング表示                   "
 1041   DATA "22: オプション                       "
 1042   DATA "23: ステージ･クリア（旧バージョン）  "
 1043   DATA "24: ゲーム･オーバー                  "
 1044 '
 1045 '---------------- Exit Program
 1046 *EXIT_THIS_PROGRAM
 1047   GOSUB *MUSIC_FADE_OUT:OBJ CLEAR:GOSUB *FADEOUT:INTERVAL (0) OFF:INTERVAL (1) OFF:SCREEN 0:LOCATE 5,0:COLOR 7:PRINT "Loading S_G_ARTS.B":LOAD"CD:S_G_ARTS",R
 1048   END
 1049 '
 1050 '---------------- Start Program
 1051 *START_THIS_PROGRAM
 1052   GOSUB *INIT_SYS
 1053   GOSUB *SET_OBJECTS
 1054 '
 1055 '================ Main Loop
 1056 *PAD_WATCH
 1057   TRIGGA=0
 1058   *PAD_W2:IF TRIGGA THEN KEY$="":KEY=0:GOTO *PAD_TRIGGA
 1059     IF PLAYSTAT(0)=0 THEN EMNUM=-1:GOSUB *DISPLAY_MENU
 1060     KEY$=INKEY$:IF KEY$="" THEN *PAD_W2 ELSE KEY=ASC(KEY$)
 1061   *PAD_TRIGGA
 1062     WTIME=0
 1063     IF KEY=KEY_DOWN  OR KEY=KEY_D2 OR (TRIGGA AND @PAD_DOWN) THEN GOSUB *MOVE_DOWN:GOTO *PAD_WATCH
 1064     IF KEY=KEY_UP    OR KEY=KEY_U2 OR (TRIGGA AND @PAD_UP)   THEN GOSUB *MOVE_UP:  GOTO *PAD_WATCH
 1065     IF KEY=KEY_ENTER OR (TRIGGA AND (@PAD_START OR @PAD_C))  THEN IF EMNUM=CNUM THEN BGM:GOTO *PAD_WATCH ELSE EMNUM=CNUM:GOSUB *MUSIC_FADE_OUT:GOTO *PLAY_GO
 1066     IF KEY=KEY_ESC   OR (TRIGGA AND (@PAD_Y     OR @PAD_B))  THEN *EXIT_THIS_PROGRAM
 1067     GOTO *PAD_WATCH
 1068 '
 1069 '================
 1070 *MOVE_DOWN
 1071   IF CNUM < NUM_OF_MSTR THEN CNUM=CNUM+1
 1072   IF (CNUM > 4) AND (CNUM <= (NUM_OF_MSTR - 3)) THEN MTOP=MTOP+1
 1073   GOSUB *DISPLAY_MENU
 1074   RETURN
 1075 '
 1076 '----------------
 1077 *MOVE_UP
 1078   IF CNUM > 1 THEN CNUM=CNUM-1
 1079   IF (CNUM > 3) AND (CNUM < (NUM_OF_MSTR - 3)) THEN MTOP=MTOP-1
 1080   GOSUB *DISPLAY_MENU
 1081   RETURN
 1082 '
 1083 '----------------
 1084 *DISPLAY_MENU
 1085   MDY=38
 1086   FOR I=MTOP TO MTOP+6
 1087     IF I=CNUM THEN
 1088       IF I=EMNUM THEN
 1089         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31),,RGB(20,20,0)
 1090       ELSE
 1091         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31),,RGB(0,20,20)
 1092       ENDIF
 1093     ELSE
 1094       IF I=EMNUM THEN
 1095         KPRINT (10,MDY),MSTR$(I),RGB(31,31,0),,RGB(16,16,16)
 1096       ELSE
 1097         KPRINT (10,MDY),MSTR$(I),RGB(31,31,31)
 1098       ENDIF
 1099     ENDIF
 1100     MDY=MDY+18
 1101   NEXT
 1102   RETURN
 1103 '
 1104 '================ Subroutines
 1105 *INIT_SYS
 1106   MTOP=1:EMNUM=-1
 1107   DIM MSTR$(NUM_OF_MSTR)
 1108   RESTORE *MENU_STR:FOR I=0 TO NUM_OF_MSTR:READ MSTR$(I):NEXT
 1109 '
 1110   PAD_ABCXYZSTART = @PAD_A+@PAD_B+@PAD_C+@PAD_START+@PAD_X+@PAD_Y+@PAD_Z
 1111   PAD_UDLR  = @PAD_RIGHT+@PAD_LEFT+@PAD_DOWN+@PAD_UP+@PAD_L+@PAD_R
 1112   KEY_DOWN  = 31:  KEY_D2=ASC("X")-64
 1113   KEY_UP    = 30:  KEY_U2=ASC("E")-64
 1114   KEY_ENTER = 13: KEY_ESC = 27
 1115 '
 1116   SCREEN 0:WIDTH 1,1,38,26
 1117   INITIAL_TOUCH=20:AFTER_TOUCH=3
 1118   ON INTERVAL (0) GOSUB *INT_COUNT: INTERVAL (0) ON,1
 1119   ON INTERVAL (1) GOSUB *DISPLAY_PFONT: INTERVAL (1) ON,1
 1120 *CLEAR_INKEY: IF INKEY$<>"" THEN *CLEAR_INKEY
 1121   TRIGGA=PAD(0,2) :' Clear trigga
 1122   KPRINT (10,20),MSTR$(0),,,RGB(20,0,20)    :'ﾀｲﾄﾙﾋｮｳｼﾞ
 1123   LINE(10,164)-(307,164),RGB(31,31,0)
 1124   KPRINT (10,166),"↑↓";,RGB(31,22,22):KPRINT FIX "(ﾎｳｺｳ ﾎﾞﾀﾝ )--- ";,RGB(21,21,10):KPRINT FIX "Move Cursor",RGB(0,31,20)
 1125   KPRINT (10,182-8),FIX "  START / Cﾎﾞﾀﾝ";,RGB(31,22,22):KPRINT FIX " --- ";,RGB(21,21,10):KPRINT FIX "Start BGM  ",RGB(0,31,20)
 1126   KPRINT (10,198-16),FIX "          Bﾎﾞﾀﾝ";,RGB(31,22,22):KPRINT FIX " --- ";,RGB(21,21,10):KPRINT FIX "RETURN Main Menu",RGB(0,31,20)
 1127   CNUM=-1:GOSUB *DISPLAY_MENU:CNUM=1
 1128   GOSUB *SOUND_INIT:GOSUB *DISPLAY_MENU    :'Sound Sample ｺﾕｳﾉ ｼｮｷｶ ﾙｰﾁﾝ
 1129   RETURN
 1130 '
 1131 '----------------
 1132 *INT_COUNT:' Make repeat trigga of PAD ULDR
 1133   IF PAD(0)=52 THEN *INT_COUNT_RET: 'Ignore keyboard pad
 1134   TRIGGA=TRIGGA OR (PAD(0,2) AND PAD_ABCXYZSTART): 'Update A,B,C,START buttons
 1135   TESTBTN=PAD(0,1):IF (TESTBTN AND PAD_UDLR) = 0 THEN REPEAT_COUNT=0: GOTO *INT_COUNT_RET
 1136   IF TESTBTNL<>TESTBTN THEN TESTBTNL=TESTBTN: REPEAT_COUNT=0
 1137   IF REPEAT_COUNT=0 THEN REPEAT_COUNT=INITIAL_TOUCH: TRIGGA=TESTBTN: GOTO *INT_COUNT_RET
 1138   REPEAT_COUNT=REPEAT_COUNT-1: IF REPEAT_COUNT <= 0 THEN REPEAT_COUNT=AFTER_TOUCH: TRIGGA=TESTBTN
 1139 *INT_COUNT_RET
 1140   SKCLOSE
 1141   RETURN
 1142 '
 1143 '----------------
 1144 *SET_OBJECTS
 1145 'Object Item Number
 1146   TYPE = 0: XP = 4: XR = 8: XS = 12
 1147   PARENT = 20: XRV= 36
 1148 '
 1149   SETDISP 3: SETPERS 105
 1150   SETLIGHT .5,-1,.5:PRIORITY 10,1
 1151   PFONT$=TITLE$:GOSUB *MAKE_PFONT
 1152   WTIME = 0:SOFS=-255: COLOROFS ON,10:COLOROFS (SOFS,SOFS,SOFS)
 1153   OBJ(1,TYPE)=6:OBJ(1,XRV)=&H0.0018,&H0.0024,-&H0.002
 1154   OBJ(0,XP+2)=110
 1155   RETURN
 1156 '
 1157 '----------------
 1158 *MAKE_PFONT
 1159   SLEN=LEN(PFONT$): PT=-SLEN/2*45 : ND=RND(255)/255:OBJ(1,XP+2)=90+SLEN*10
 1160   FOR SP=1 TO SLEN
 1161     CH$=MID$(PFONT$,SP,1): CH2$=MID$(PFONT$,SP+1,1)
 1162     IF CH$=" " THEN
 1163       PT=PT+40
 1164     ELSE
 1165       OBJ(SP+2,XP)=PT,60:OBJ(SP+2,PARENT)=1:OBJ(SP+2,TYPE)=4: OBJ(SP+2,XRV)=&H0.001
 1166       SETPFONT SP+2,ASC(CH$),(1,1.2,3),RGB(30,24,30)
 1167       IF CH$="I" OR CH2$="I" THEN PT=PT+50 ELSE PT=PT+60
 1168     ENDIF
 1169   NEXT SP
 1170   RETURN
 1171 '
 1172 '----------------
 1173 *DISPLAY_PFONT:GOSUB *DISP_COPYRIGHT
 1174   IF WTIME = 0 THEN *DISP_HIDDEN
 1175   IF WTIME > 60*20 THEN *DISP_APEAR
 1176   WTIME = WTIME + 1: RETURN
 1177 *DISP_HIDDEN
 1178   IF SOFS > -330 THEN SOFS = SOFS - 5
 1179   IF SOFS <= -330 THEN SOFS = -330: WTIME = 1
 1180   GOTO *DISP_RET
 1181 *DISP_APEAR
 1182   IF SOFS < -110 THEN SOFS = SOFS + .5
 1183 *DISP_RET
 1184   OX=SOFS+XSIN(ND)*50: IF OX < -255 THEN OX = -255
 1185   OY=SOFS+XSIN(ND+1/3)*50: IF OY < -255 THEN OY = -255
 1186   OZ=SOFS+XSIN(ND+2/3)*50: IF OZ < -255 THEN OZ = -255
 1187   ND=ND+&H0.0004: COLOROFS (OX,OY,OZ)
 1188   RETURN
 1189 '
 1190 '---------------- SCREEN Fade Out
 1191 *FADEOUT
 1192   COLOROFS ON,0:IF OFS=255 THEN RETURN
 1193   FOR OFS=0 TO 255 STEP 32
 1194     COLOROFS(-OFS,-OFS,-OFS)
 1195     VSYNC
 1196   NEXT OFS
 1197   OFS=255
 1198   COLOROFS(-255,-255,-255)
 1199   CLS 0
 1200   VSYNC
 1201   RETURN
 1202 '
 1203 '================ Sound Sample ｺﾕｳﾉ ｼｮｷｶ ﾙｰﾁﾝ
 1204 *SOUND_INIT
 1205   LOCATE 5,0:COLOR 7
 1206   IF PEEK(0,5)=1 THEN PRINT " Tone Data Set...":PLAYINIT "ALISIA",1,174 ELSE PRINT " Arrange Tone....":PLAYINIT 1,174:RESTORE *TONE_SET:TARG READ
 1208   GOSUB *TPROP_SUB:LOCATE 5,0:PRINT "                 "
 1209   RETURN
 1210 '
 1211 '================ MUSIC FADE OUT
 1212 *MUSIC_FADE_OUT:IF PLAYSTAT(0)=0 THEN RETURN
 1213   TMP_F=CNUM:CNUM=-1:GOSUB *DISPLAY_MENU:LOCATE 5,0:COLOR 7:PRINT " Music Fade Out...":PLAYFADE 0,0,4:VSYNC 2
 1214   *MFO_LOOP
 1215     IF PLAYSTAT(0)=1 THEN *MFO_LOOP
 1216   CNUM=TMP_F:GOSUB *DISPLAY_MENU:LOCATE 5,0:PRINT "                  ":RETURN
 1217 '
 1218 '================ Start Sound Sample Program
 1219 *PLAY_GO
 1220   PLAYSTOP:VSYNC 2
 1221   LOCATE 5,0:COLOR 7:PRINT " Set Song Data..."
 1222   TMP=CNUM
 1223   ON CNUM RESTORE *OPENING,*ST_1,*ST_3,*ST_2,*ST_4,*ST_BOS,*ST_5,*ST_6,*ST_7,*ST_8,*ST_9,*ST_12,*ST_10,*ST_11,*ESCAPE,*SHINDEN,*ST_13,*ST_KYOSO,*ST_MAO,*ENDING,*SELECT,*OPTION_SL,*ST_CLEAR,*OVER
 1224   CNUM=-1:GOSUB *DISPLAY_MENU:SETSONG:LOCATE 5,0:PRINT "                 ":CNUM=TMP
 1225   GOSUB *DISPLAY_MENU:BGM:VSYNC 2
 1226   GOTO *PAD_WATCH
 1227 '
