 4030 MSG$ = "PRESS START !"
 4040 MSG_T = 30
 4050 *DEMO_MSG
 4060 '
 4070 PDL = PAD(0,1)
 4080 IF PDL AND @PAD_START THEN *MAIN_PLAY
 4090 '
 4100 DIR = DIR - DIR_PRM
 4110 IF DIR < 0 THEN DIR = DIR + 1
 4120 '
 4130 PVX= PV*XCOS(DIR)
 4140 PVY=-PV*XSIN(DIR)
 4150 PX=PX+PVX:PY=PY-PVY
 4160 '
 4170 OBJ(0,@XR) = EYE,-DIR
 4180 OBJ(0,@XP) = -PX,PZ,PY
 4190 '
 4200 ACTIVE 8
 4210 ROTPOS PX/2,PY/2,PZ
 4220 ROTATE BANK,,DIR
 4230 '
 4240 ACTIVE 9
 4250 ROTPOS DIR*128*8
 4260 GOSUB *MSG
 4270 VSYNC
 4280 GOTO *DEMO_LOOP
 4290 '
 4300 '----------------------------------
 4310 *MAIN_PLAY
 4320 BGM 2
 4330 GOSUB *MSG_CLEAR
 4340 CLS
 4350 GOSUB *GAME_INIT
 4360 TERGET  = 0
 4370 GOSUB *OPEN_TGT
 4380 '
 4390 INTERVAL (0) ON,3
 4400 MSG$ = "START !!"
 4410 MSG_T = 15
 4420 *LOOP
 4430 '
 4440 MIN = INT(TIME/60)
 4450 SEC = TIME-INT(TIME/60)*60
 4460 LOCATE 1,11:PRINT USING "##:##.##";MIN,SEC
 4470 '
 4480 GOSUB *H_GAGE
 4490 GOSUB *MSG
 4500 '
 4510 DY = ABS(POALY(TERGET)-PY)
 4520 IF DY > 4 THEN *NO_TOUCH
 4530 '
 4540 DX = ABS(POALX(TERGET)-PX)
 4550 IF DX > 30 THEN *NO_TOUCH
 4560 DY = ABS(-POALH(TERGET)-PZ)
 4570 IF DY > 30 THEN *NO_TOUCH
 4580 DL = DX*DX + DY*DY
 4590 IF DL > DR THEN *NO_TOUCH
 4600 GOSUB *CLOSE_TGT
 4610 EFFECT -1
 4620 MSG$ = "NEXT RING !"
 4630 MSG_T = 10
 4640 TERGET = TERGET + 1
 4650 IF TERGET = 8 THEN *ALL_CLR
 4660 GOSUB *OPEN_TGT
 4670 GOTO *NXT_R
 4680 *ALL_CLR
 4690 MSG$ = "ALL RING CLEAR !"
 4700 MSG_T = 10
 4710 '
 4720 *NXT_R
 4730 *NO_TOUCH
 4740 '
 4750 PDL = (PAD(0,3) -128)
 4760 IF ABS(PDL) < 8 THEN PDL = 0
 4770 PDL = PDL / 30000
 4780 DIR = DIR + PDL
 4790 IF DIR > 1 THEN DIR = DIR - 1
 4800 IF DIR < 0 THEN DIR = DIR + 1
 4810 '
 4820 SIND = XSIN(DIR)
 4830 COSD = XCOS(DIR)
 4840 '
 4850 PDL = PAD(0,1)
 4860 IF PDL AND @PAD_A THEN JSP = JSP +JUMP
 4870 IF PDL AND @PAD_B THEN JSP = JSP +JUMP_H
 4880 IF JSP > 1 THEN JSP = 1
 4890 JSP = JSP + GRV
 4900 PZ = PZ + JSP
 4910 IF PZ >10002+JSP THEN PZ = 10002
 4920 IF PZ < 2 THEN PZ = 2 : JSP = -(.2*JSP)
 4930 IF TIME_S = 0 THEN *RAND_CHECK
 4940 IF TERGET <> 8 THEN *RAND_CHECK
 4950 IF PZ > 2 THEN *RAND_CHECK
 4960 IF ABS(PX-38*8*2) > 32 THEN *RAND_CHECK
 4970 IF ABS(PY-64*8*2) > 32 THEN *RAND_CHECK
 4980 GOTO *GAME_END
 4990 *RAND_CHECK
 5000 IF PZ = 2 THEN *WALK
 5010 *FLY
 5020 TIME_S = 1            :' Clock start
 5030 '
 5040 PVA = (PAD(0,4) -128)
 5050 IF ABS(PVA) < 8 THEN PVA = 0
 5060 PVA = PVA / 10000
 5070 AX=PVA*SIND
 5080 AY=PVA*COSD
 5090 PVX=PVX-AX: PVY=PVY-AY
 5100 GOTO *MOVE
 5110 '
 5120 *WALK
 5130 PVX=0:PVY=0
 5140 SPEED = (PAD(0,4) -128)
 5150 IF ABS(SPEED) < 8 THEN SPEED = 0
 5160 SPEED = SPEED / 1500
 5170 PVX = -SPEED*SIND: PVY= -SPEED*COSD
 5180 '
 5190 *MOVE
 5200 PX=PX+PVX:PY=PY-PVY
 5210 PVX=PVX-PVX*.001
 5220 PVY=PVY-PVY*.001
 5230 '
 5240 'AGL = PAD(0,6)
 5250 'BANK =-.25*(255-agl)/255:EYE = .25*agl/255
 5260 PDL = PAD(0,1)
 5270 IF PDL AND @PAD_X THEN BANK =  -.25:EYE =    0
 5280 IF PDL AND @PAD_Y THEN BANK = -.175:EYE = .075
 5290 IF PDL AND @PAD_Z THEN BANK =     0:EYE =  .25
 5300 '
 5310 OBJ(0,@XR) = EYE,-DIR
 5320 OBJ(0,@XP) = -PX,PZ,PY
 5330 '
 5340 ACTIVE 8
 5350 ROTPOS PX/2,PY/2,PZ
 5360 ROTATE BANK,,DIR
 5370 '
 5380 ACTIVE 9
 5390 ROTPOS DIR*128*8
 5400 VSYNC
 5410 GOTO *LOOP
 5420 '----------------------------------
 5430 *GAME_END
 5440 INTERVAL (0) OFF
 5450 PLAYSTOP 0
 5460 MIN = INT(TIME/60)
 5470 SEC = TIME-INT(TIME/60)*60
 5480 CLS
 5490 MSG$ = "LANDING !!"
 5500 MSG_T = 30
 5510 *END_DEMO
 5520 PDL = PAD(0,1)
 5530 IF PDL AND @PAD_START THEN *MAIN_PLAY
 5540 LOCATE 9,9:PRINT USING "CLEAR TIME: ##:##.##";MIN,SEC
 5550 GOSUB *MSG
 5560 IF MSG_T = 0 THEN *DEMO_PLAY
 5570 VSYNC
 5580 GOTO *END_DEMO
 5590 END
