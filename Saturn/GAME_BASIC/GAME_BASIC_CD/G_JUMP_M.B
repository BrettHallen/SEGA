 3030 POAL(0)=-104
 3040 POAL(1)=-168
 3050 POAL(2)=-56
 3060 '
 3070 OBJ(0,@XP) = 0,0,10
 3080 OBJ(0,@ORDER) = 7
 3090 '
 3100 FOR MAPY=0 TO 127
 3110 FOR MAPX=0 TO 127
 3120 MAP(MAPX,MAPY) = 0
 3130 NEXT
 3140 NEXT
 3150 '
 3160 'Gen pole and terget
 3170 FOR P = 0 TO 7
 3180 *GEN_POLE
 3190 *RND_LPX
 3200 X = RND(96)+16
 3210 IF X >= 48 AND X < 80 THEN *RND_LPX
 3220 *RND_LPY
 3230 Y = RND(96)+16
 3240 IF Y >= 48 AND Y < 80 THEN *RND_LPY
 3250 IF MAP(X,Y)<>0 THEN *GEN_POLE
 3260 MAP(X,Y) = 1
 3270 X = X * 16
 3280 Y = Y * 16
 3290 POAL = RND(3)
 3300 '
 3310 OBJ(P+1,@ATR) = 4,4
 3320 OBJ(P+1,@TYPE) = 4
 3330 OBJ(P+1,@XP) = X,POAL(POAL),-Y
 3340 OBJ(P+1,@ORDER) = 0
 3350 OBJ(P+1,@XRV) = ,.01
 3360 POALX(P) = X
 3370 POALY(P) = Y
 3380 POALH(P) = POAL(POAL)
 3390 '
 3400 FOR LP = 0 TO 7
 3410 OBJ(P*8+9+LP,@ATR) = 6,6
 3420 OBJ(P*8+9+LP,@TYPE) = 0
 3430 OBJ(P*8+9+LP,@XP) = 30*XCOS(LP*.125),30*XSIN(LP*.125)
 3440 OBJ(P*8+9+LP,@ZR) = (LP*.125)+.25
 3450 OBJ(P*8+9+LP,@ORDER) = 0
 3460 OBJ(P*8+9+LP,@PARENT) = P+1
 3470 NEXT
 3480 NEXT
 3490 '
