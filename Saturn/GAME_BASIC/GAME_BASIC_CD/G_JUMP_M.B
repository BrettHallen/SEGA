 5610 *GAME_INIT
 5620 PX=38*8*2:PY=64*8*2:PZ=2
 5630 DIR     = 0           :' ¼®·¼¾ÝÎ³º³
 5640 PVY     = 0           :' ÌßÚ²Ô¼®·X¿¸ÄÞ
 5650 PVX     = 0           :' ÌßÚ²Ô¼®·Y¿¸ÄÞ
 5660 PVA     = 0           :' ÌßÚ²Ô¶¿¸ÄÞÊß×Ò°À
 5670 DIR_PRM = .0012      :' ÌßÚ²ÔÀ°ÝÊß×Ò°À
 5680 GRV     = -.0016      :' ¼Þ­³Ø®¸Êß×Ò°À
 5690 JUMP    = .0025       :
 5700 JUMP_H  = .006        :
 5710 JSP     = 0           :' ¼Þ®³¼®³¿¸ÄÞ
 5720 DR      = 30*30
 5730 TIME    = 0
 5740 TIME_S  = 0           :' Clock Stop flag
 5750 BANK    = -.25
 5760 EYE     = 0
 5770 '
 5780 GOSUB *INIT_TGT
 5790 RETURN
 5800 '----------------------------------
 5810 *INIT_TGT
 5820 FOR TGT =0 TO 7
 5830 OBJ(TGT+1,@ATR)  = 4,4
 5840 OBJ(TGT+1,@TYPE) = 4
 5850 OBJ(TGT+1,@XRV)  = ,.01,0
 5860 OBJ(TGT+1,@XR)   = 0,0,0
 5870 FOR LP = 0 TO 7
 5880 OBJ(TGT*8+9+LP,@TYPE) = 0
 5890 NEXT
 5900 NEXT
 5910 RETURN
 5920 '----------------------------------
 5930 *OPEN_TGT
 5940 OBJ(TERGET+1,@TYPE) = 6
 5950 OBJ(TERGET+1,@XRV)  = ,0,.01
 5960 OBJ(TERGET+1,@XR)   = 0,0,0
 5970 FOR LP = 0 TO 7
 5980 OBJ(TERGET*8+9+LP,@TYPE) = 4
 5990 NEXT
 6000 RETURN
 6010 '----------------------------------
 6020 *CLOSE_TGT
 6030 OBJ(TERGET+1,@ATR)  = 5,5
 6040 OBJ(TERGET+1,@TYPE) = 4
 6050 OBJ(TERGET+1,@XRV)  = ,.01,0
 6060 OBJ(TERGET+1,@XR)   = 0,0,0
 6070 FOR LP = 0 TO 7
 6080 OBJ(TERGET*8+9+LP,@TYPE) = 0
 6090 NEXT
 6100 RETURN
 6110 '----------------------------------
 6120 '
 6130 *MSG_CLEAR
 6140 MSG_T = 0
 6150 LOCATE 20-LEN(MSG$)/2,7
 6160 PRINT LEFT$(SP$,LEN(MSG$))
 6170 RETURN
 6180 '----------------------------------
 6190 'input msg$,msg_t
 6200 *MSG 
 6210 MSG_TM = MSG_TM +1
 6220 MSG_TM = MSG_TM AND &HFF
 6230 IF MSG_TM AND &HF THEN RETURN
 6240 IF MSG_T = 0 THEN RETURN
 6250 MSG_T = MSG_T - 1
 6260 MSGG$=LEFT$(SP$,LEN(MSG$))
 6270 IF MSG_T AND 1 THEN MSGG$=MSG$
 6280 LOCATE 20-LEN(MSG$)/2,7
 6290 PRINT MSGG$
 6300 RETURN
 6310 '----------------------------------
 6320 *H_GAGE
 6330 HG = PZ-2
 6340 H  = HG
 6350 FOR G = 0 TO 4
 6360 HC = H MOD 9
 6370 IF H < 0 THEN HC = 0
 6380 IF H > 8 THEN HC = 8
 6390 HC = HC + 1
 6400 H = H - 8
 6410 IF HG > 40 THEN HC = 0
 6420 LOCATE 35,9-G:PRINT CHR$(GAGE(HC));CHR$(GAGE(HC)+10)
 6430 NEXT
 6440 LOCATE 30,11
 6450 IF HG > 9999 THEN PRINT "      " ELSE PRINT USING "####.#";HG
 6460 RETURN
