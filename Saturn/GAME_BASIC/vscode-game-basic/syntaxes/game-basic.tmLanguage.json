{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GAME BASIC",
  "scopeName": "source.game-basic",
  "comment": "GAME BASIC for SEGASATURN. Generated by scripts/build-grammar.js; edit src/keywords.js instead.",
  "patterns": [
    {
      "include": "#include-directive"
    },
    {
      "include": "#line-start"
    },
    {
      "include": "#statement"
    }
  ],
  "repository": {
    "include-directive": {
      "comment": "BASTERM-only #include \"FILE.B\", written without a line number",
      "match": "(?i)^\\s*(#include)\\s+(\"[^\"]*\")",
      "captures": {
        "1": {
          "name": "keyword.control.directive.include.game-basic"
        },
        "2": {
          "name": "string.quoted.double.include.game-basic"
        }
      }
    },
    "line-start": {
      "comment": "Optional line number, then an optional *label definition",
      "match": "^\\s*(?:(\\d+)\\s*(\\*[A-Za-z_][A-Za-z0-9_]*)?|(\\*[A-Za-z_][A-Za-z0-9_]*))",
      "captures": {
        "1": {
          "name": "constant.numeric.line-number.game-basic"
        },
        "2": {
          "name": "entity.name.label.game-basic"
        },
        "3": {
          "name": "entity.name.label.game-basic"
        }
      }
    },
    "statement": {
      "patterns": [
        {
          "include": "#data-statement"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#object-field"
        },
        {
          "include": "#jump-target"
        },
        {
          "include": "#number"
        },
        {
          "include": "#keyword-control"
        },
        {
          "include": "#keyword-operator-word"
        },
        {
          "include": "#function"
        },
        {
          "include": "#keyword-statement"
        },
        {
          "include": "#print-shorthand"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "data-statement": {
      "comment": "DATA items are literal up to ':'; a ' inside them is data, not a comment",
      "begin": "(?<![A-Za-z0-9_$])(?i:DATA)(?![A-Za-z0-9_$])",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.statement.game-basic"
        }
      },
      "end": "(?=:)|$",
      "name": "meta.data.game-basic",
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "match": ",",
          "name": "punctuation.separator.game-basic"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "begin": "'",
          "end": "$",
          "name": "comment.line.apostrophe.game-basic"
        },
        {
          "begin": "(?<![A-Za-z0-9_$])(?i:REM)(?![A-Za-z0-9_$])",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.rem.game-basic"
            }
          },
          "end": "$",
          "name": "comment.line.rem.game-basic"
        }
      ]
    },
    "string": {
      "comment": "BASIC strings may run to the end of the line without a closing quote",
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.game-basic"
    },
    "object-field": {
      "comment": "OBJ(n,@ATR) style field names",
      "match": "@[A-Za-z_][A-Za-z0-9_]*",
      "name": "constant.language.object-field.game-basic"
    },
    "jump-target": {
      "comment": "Line numbers and *labels after GOTO, GOSUB, THEN, RESTORE and friends",
      "patterns": [
        {
          "match": "((?<![A-Za-z0-9_$%!#@])(?i:RESUME|GOSUB|ELSE|GOTO|THEN)(?![A-Za-z0-9_]))\\s*((?:\\d+|\\*[A-Za-z_][A-Za-z0-9_]*)(?:\\s*,\\s*(?:\\d+|\\*[A-Za-z_][A-Za-z0-9_]*))*)",
          "captures": {
            "1": {
              "name": "keyword.control.game-basic"
            },
            "2": {
              "patterns": [
                {
                  "include": "#jump-list"
                }
              ]
            }
          },
          "name": "meta.jump.game-basic"
        },
        {
          "match": "((?<![A-Za-z0-9_$%!#@])(?i:RESTORE|DELETE|LIST|RUN)(?![A-Za-z0-9_]))\\s*((?:\\d+|\\*[A-Za-z_][A-Za-z0-9_]*)(?:\\s*,\\s*(?:\\d+|\\*[A-Za-z_][A-Za-z0-9_]*))*)",
          "captures": {
            "1": {
              "name": "keyword.other.statement.game-basic"
            },
            "2": {
              "patterns": [
                {
                  "include": "#jump-list"
                }
              ]
            }
          },
          "name": "meta.jump.game-basic"
        }
      ]
    },
    "jump-list": {
      "patterns": [
        {
          "match": "\\d+",
          "name": "constant.numeric.line-reference.game-basic"
        },
        {
          "match": "\\*[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.label.reference.game-basic"
        },
        {
          "match": ",",
          "name": "punctuation.separator.game-basic"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "(?i)&H[0-9A-F]+",
          "name": "constant.numeric.hex.game-basic"
        },
        {
          "match": "(?i)&O[0-7]+",
          "name": "constant.numeric.octal.game-basic"
        },
        {
          "match": "(?i)&B[01]+",
          "name": "constant.numeric.binary.game-basic"
        },
        {
          "match": "(?i)(?<![A-Za-z0-9_$%!#.])(?:\\d+\\.?\\d*|\\.\\d+)(?:E[+-]?\\d+)?[!#%]?",
          "name": "constant.numeric.decimal.game-basic"
        }
      ]
    },
    "keyword-control": {
      "match": "(?<![A-Za-z0-9_$%!#@])(?i:RESUME|RETURN|ENDIF|ERROR|GOSUB|WHILE|CONT|ELSE|GOTO|NEXT|STEP|STOP|THEN|WEND|END|FOR|IF|ON|TO)(?![A-Za-z0-9_])",
      "name": "keyword.control.game-basic"
    },
    "keyword-operator-word": {
      "match": "(?<![A-Za-z0-9_$%!#@])(?i:AND|EQV|IMP|MOD|NOT|XOR|OR)(?![A-Za-z0-9_])",
      "name": "keyword.operator.word.game-basic"
    },
    "function": {
      "match": "(?<![A-Za-z0-9_$%!#@])(?i:PLAYSTAT|READCHR\\$|HEXBIN\\$|STRING\\$|CSRLIN|FILES\\$|GETCHR|INKEY\\$|INPUT\\$|RIGHT\\$|SPACE\\$|DATE\\$|INSTR|LEFT\\$|MSTR\\$|STRW\\$|TIME\\$|BIN\\$|CDBL|CHR\\$|CINT|CSNG|HEX\\$|MID\\$|OCT\\$|PEEK|STR\\$|TIME|XCOS|XSIN|ABS|ASC|ATN|COS|EOF|ERL|ERR|EXP|FIX|FRE|INT|LEN|LOC|LOF|LOG|PAD|POS|RGB|RND|SGN|SIN|SPC|SQR|TAB|TAN|VAL)(?![A-Za-z0-9_])",
      "name": "support.function.builtin.game-basic"
    },
    "keyword-statement": {
      "match": "(?<![A-Za-z0-9_$%!#@])(?i:SETPOLYGON|PLAYTEMPO|RANDOMIZE|ROTCENTER|SETVERTEX|SPRWINDOW|COLOROFS|INTERVAL|PLAYFADE|PLAYINIT|PLAYSTOP|PRIORITY|SETLIGHT|SETPFONT|USERDATA|DISPLAY|PALETTE|RESTORE|ROTOVER|ROTZOOM|SETDISP|SETPERS|SETSONG|SKCLOSE|ACTIVE|APPEND|CAMERA|CIRCLE|DELETE|EFFECT|FWRITE|KPRINT|LOCATE|MOSAIC|OUTPUT|PRESET|PUTCHR|ROTATE|ROTPOS|SCREEN|SCROLL|SETATR|SETCHR|SETTEX|UNLOCK|VOLUME|BLOAD|BSAVE|CCOPY|CLEAR|CLOSE|COLOR|ERASE|FIELD|FILES|FREAD|GCOPY|GLOAD|INPUT|KLOAD|LLIST|MERGE|PAINT|PRINT|RENUM|SOUND|TIMER|TPROP|TROFF|USING|VSYNC|WIDTH|AUTO|BEEP|DATA|KILL|LINE|LIST|LOAD|LOCK|OPEN|PLAY|POKE|PSET|READ|SAVE|SWAP|TARG|TRON|ZOOM|BGM|CLS|DEF|DIM|DSP|GET|LET|NEW|OBJ|PUT|RUN|AS|EG|FN)(?![A-Za-z0-9_])",
      "name": "keyword.other.statement.game-basic"
    },
    "print-shorthand": {
      "match": "\\?",
      "name": "keyword.other.statement.print.game-basic"
    },
    "variable": {
      "match": "[A-Za-z][A-Za-z0-9_]*[$%!#]?",
      "name": "variable.other.game-basic"
    },
    "operator": {
      "patterns": [
        {
          "match": "<=|>=|<>|><|=<|=>|[<>=]",
          "name": "keyword.operator.comparison.game-basic"
        },
        {
          "match": "[-+*/\\\\^]",
          "name": "keyword.operator.arithmetic.game-basic"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ":",
          "name": "punctuation.separator.statement.game-basic"
        },
        {
          "match": "[,;]",
          "name": "punctuation.separator.game-basic"
        },
        {
          "match": "[()]",
          "name": "punctuation.parenthesis.game-basic"
        }
      ]
    }
  }
}
